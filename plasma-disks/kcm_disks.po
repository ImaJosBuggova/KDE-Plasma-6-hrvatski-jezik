#: instabilities.cpp:27
#, kde-format
msgctxt "@label"
msgid "Prefail attributes <= threshold."
msgstr "Atributi predkvara (prefail) <= prag."

#: instabilities.cpp:31
#, kde-format
msgctxt "@label"
msgid ""
"SMART status check returned 'DISK OK' but we found that some (usage or "
"prefail) attributes have been <= threshold at some time in the past."
msgstr ""
"Provjera SMART statusa vratila je „DISK OK”, ali utvrđeno je da su neki "
"atributi (iskorištenosti ili predkvara) u prošlosti bili manji ili jednaki pragu."

#: instabilities.cpp:33
#, kde-format
msgctxt "@label"
msgid "The device error log contains records of errors."
msgstr "Zapisnik pogrešaka uređaja sadrži zapise o greškama."

#: instabilities.cpp:37
#, kde-format
msgctxt "@label"
msgid ""
"The device self-test log contains records of errors. [ATA only] Failed self-"
"tests outdated by a newer successful extended self-test are ignored."
msgstr ""
"Zapisnik samotestiranja uređaja sadrži zapise o greškama. [Samo za ATA] "
"Neuspješna samotestiranja koja su zastarjela zbog novijeg uspješnog "
"proširenog samotestiranja se zanemaruju."

#: kcm/ui/main.qml:36
msgctxt "@action/button action button to start partition manager"
msgid "Open Partition Manager"
msgstr "Otvori upravitelj particija"

#: kcm/ui/main.qml:42
msgctxt "@action/button action button to start backup program"
msgid "Perform Backup"
msgstr "Izvedi sigurnosnu kopiju"

#: kcm/ui/main.qml:62
msgctxt "@info/status"
msgid "Unable to obtain data. KDED is not running."
msgstr "Nije moguće dohvatiti podatke. KDED nije pokrenut."

#: kcm/ui/main.qml:73
msgctxt "@info/status"
msgid "No S.M.A.R.T. devices found."
msgstr "Nisu pronađeni S.M.A.R.T. uređaji."

#: kcm/ui/main.qml:95
msgctxt "@info"
msgid ""
"The SMART system of this device is reporting problems. This may be a sign of "
"imminent device failure or data reliability being compromised. Back up your "
"data and replace this drive as soon as possible to avoid losing any data."
msgstr ""
"SMART sustav ovog uređaja javlja probleme. To može biti znak neizbježnog "
"kvara uređaja ili narušene pouzdanosti podataka. Izradite sigurnosnu kopiju "
"svojih podataka i zamijenite ovaj pogon što je prije moguće kako biste "
"izbjegli gubitak podataka."

#: kcm/ui/main.qml:101
msgctxt "@info %1 is a bunch of <li> with the strings from instabilities.cpp"
msgid ""
"<p>The SMART firmware is not reporting a failure, but there are early signs "
"of malfunction. This might not point at imminent device failure but requires "
"longer term analysis. Back up your data and contact the manufacturer of this "
"disk, or replace it preemptively just to be safe.</p><ul>%1</ul>"
msgstr ""
"<p>SMART firmver ne prijavljuje kvar, ali postoje rani znakovi nepravilnog "
"rada. To možda ne ukazuje na neizbježan kvar uređaja, ali zahtijeva "
"dugoročniju analizu. Izradite sigurnosnu kopiju podataka i obratite se "
"proizvođaču ovog diska ili ga preventivno zamijenite radi sigurnosti.</p><ul>"
"%1</ul>"

#: kcm/ui/main.qml:107
msgctxt "@info"
msgid "This device appears to be working as expected."
msgstr "Čini se da ovaj uređaj radi ispravno."

#: kcm/ui/main.qml:114
msgctxt "@action/button action button to monitor a device for smart failure"
msgid "Monitor"
msgstr "Nadziranje"

#: kcm/ui/main.qml:115
msgctxt "@action/button action button to ignore smart failures for a device"
msgid "Ignore"
msgstr "Zanemari"

#: kcm/ui/main.qml:123
msgctxt "@action/button show detailed smart report"
msgid "Show Details"
msgstr "Prikaži pojedinosti"

#: kcm/ui/ReportPage.qml:24
msgctxt "@action:button copies all displayed text"
msgid "Copy to Clipboard"
msgstr "Kopiraj u međuspremnik"

#: smartctl.cpp:33
#, kde-format
msgctxt ""
"@label description of authentication request to read SMART data. %1 is a "
"device path e.g. /dev/sda"
msgid "Read SMART report for storage device %1"
msgstr "Pročitaj SMART izvještaj za uređaj za pohranu %1"

#: smartnotifier.cpp:29
#, kde-format
msgctxt "@title notification"
msgid "Storage Device Problems"
msgstr "Problemi s uređajem za pohranu"

#: smartnotifier.cpp:32
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"likely to fail soon!"
msgstr ""
"Uređaj za pohranu <emphasis>%1</emphasis> (<filename>%2</filename>) će "
"vjerojatno uskoro otkazati!"

#: smartnotifier.cpp:37
#, kde-kuit-format
msgctxt ""
"@info notification; text %1 is a pretty product name; %2 the device path e."
"g. /dev/sda"
msgid ""
"The storage device <emphasis>%1</emphasis> (<filename>%2</filename>) is "
"showing indications of instability."
msgstr ""
"Uređaj za pohranu <emphasis>%1</emphasis> (<filename>%2</filename>) pokazuje "
"znakove nestabilnosti."

#: smartnotifier.cpp:44
#, kde-format
msgctxt "@action:button notification action to manage device problems"
msgid "Manage"
msgstr "Upravljaj"