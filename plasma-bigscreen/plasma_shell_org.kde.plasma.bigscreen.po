#: contents/logout/Logout.qml:174
msgid ""
"One other user is currently logged in. If the computer is shut down or "
"restarted, that user may lose work."
msgid_plural ""
"%1 other users are currently logged in. If the computer is shut down or "
"restarted, those users may lose work."
msgstr[0] "Još je %1 korisnik prijavljen. Ako se računalo isključi ili ponovno pokrene, taj korisnik može izgubiti svoj rad."
msgstr[1] "Još su %1 korisnika prijavljena. Ako se računalo isključi ili ponovno pokrene, ti korisnici mogu izgubiti svoj rad."
msgstr[2] "Još je %1 korisnika prijavljeno. Ako se računalo isključi ili ponovno pokrene, ti korisnici mogu izgubiti svoj rad."

#: contents/logout/Logout.qml:191
msgid "When restarted, the computer will enter UEFI firmware settings."
msgstr "Nakon ponovnog pokretanja računalo će otvoriti postavke UEFI firmvera."

#: contents/logout/Logout.qml:193
msgid "When restarted, the computer will enter the firmware setup screen."
msgstr "Nakon ponovnog pokretanja računalo će otvoriti zaslon za postavljanje firmvera."

#: contents/logout/Logout.qml:208
msgid "When restarted, the computer will enter the boot loader menu."
msgstr "Nakon ponovnog pokretanja računalo će otvoriti izbornik pokretačkog programa."

#: contents/logout/Logout.qml:221
msgctxt "%1 is a boot loader entry"
msgid "When restarted, the computer will switch to %1."
msgstr "Nakon ponovnog pokretanja računalo će prijeći na %1."

