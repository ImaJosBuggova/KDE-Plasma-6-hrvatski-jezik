#, kde-format
msgid "Game controllers"
msgstr "Kontroleri za igre"

#: ui/main.qml:187
#, kde-format
msgid "Use connected game controllers for system navigation"
msgstr "Koristi povezane kontrolere za igre za navigaciju sustavom"

#: ui/main.qml:206
#, kde-format
msgid "Automatic input suppression"
msgstr "Automatsko potiskivanje unosa"

