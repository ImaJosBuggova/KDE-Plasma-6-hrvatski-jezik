#: ui/GameControllerSidebar.qml:36
#, kde-format
msgid "System navigation"
msgstr "Navigacija sustavom"

#: ui/GameControllerSidebar.qml:51
#, kde-format
msgid "START button when suppressed"
msgstr "Gumb START kad je unos potisnut"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr "Obrađuj gumb START čak i kad je unos potisnut (može biti u sukobu s nekim aplikacijama)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "Ulaz"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "Ulazni demon nije pokrenut"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr "Postavke kontrolera i daljinskog upravljača dostupne su samo dok je pokrenut plasma-bigscreen-inputhandler"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "Navigacija sustavom"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
"always still use them directly)"
msgstr "Upravljaj sučeljem sustava povezanim kontrolerima/daljinskim upravljačima (aplikacije ih i dalje mogu izravno koristiti)"

#: ui/main.qml:130
#, kde-format
msgid "TV remote"
msgstr "Daljinski upravljač televizora"

#: ui/main.qml:131
#, kde-format
msgid "Navigate the system interface with the connected TV remote (CEC)"
msgstr "Upravljaj sučeljem sustava povezanim daljinskim upravljačem televizora (CEC)"

#: ui/main.qml:151
#, kde-format
msgid "TV HDMI port (CEC)"
msgstr "HDMI priključak televizora (CEC)"

#: ui/main.qml:156
#, kde-format
msgid "Automatic"
msgstr "Automatski"

#: ui/main.qml:158
#, kde-format
msgid "HDMI %1"
msgstr "HDMI %1"

#: ui/main.qml:176
#, kde-format
msgid "Game Controllers"
msgstr "Kontroleri za igre"

