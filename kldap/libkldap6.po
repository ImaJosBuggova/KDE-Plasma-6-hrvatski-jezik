#: core/ldapconnection.cpp:129
#, kde-format
msgid "No LDAP Support..."
msgstr "Nema podrške za LDAP..."

#: core/ldapconnection.cpp:246
#, kde-format
msgid "An error occurred during the connection initialization phase."
msgstr "Došlo je do pogreške tijekom inicijalizacije veze."

#: core/ldapconnection.cpp:253
#, kde-format
msgid "Cannot set protocol version to %1."
msgstr "Nije moguće postaviti inačicu protokola na %1."

#: core/ldapconnection.cpp:264
#, kde-format
msgid "Cannot set timeout to %1 second."
msgid_plural "Cannot set timeout to %1 seconds."
msgstr[0] "Nije moguće postaviti vremensko ograničenje na %1 sekundu."
msgstr[1] "Nije moguće postaviti vremensko ograničenje na %1 sekunde."
msgstr[2] "Nije moguće postaviti vremensko ograničenje na %1 sekundi."

#: core/ldapconnection.cpp:276
#, kde-format
msgid "Could not set CA certificate file."
msgstr "Nije moguće postaviti datoteku CA certifikata."

#: core/ldapconnection.cpp:301
#, kde-format
msgid "Invalid TLS require certificate mode."
msgstr "Nevaljan način TLS-a za zahtijevanje certifikata."

#: core/ldapconnection.cpp:306
#, kde-format
msgid "Could not set TLS require certificate mode."
msgstr "Nije moguće postaviti način TLS-a za zahtijevanje certifikata."

#: core/ldapconnection.cpp:315
#, kde-format
msgid "Could not initialize new TLS context."
msgstr "Nije moguće inicijalizirati novi TLS kontekst."

#: core/ldapconnection.cpp:332
#, kde-format
msgid "TLS support not available in the LDAP client libraries."
msgstr "Podrška za TLS nije dostupna u LDAP klijentskim bibliotekama."

#: core/ldapconnection.cpp:342
#, kde-format
msgid "Cannot set size limit."
msgstr "Nije moguće postaviti ograničenje veličine."

#: core/ldapconnection.cpp:352
#, kde-format
msgid "Cannot set time limit."
msgstr "Nije moguće postaviti vremensko ograničenje."

#: core/ldapconnection.cpp:360
#, kde-format
msgid "Cannot initialize the SASL client."
msgstr "Nije moguće inicijalizirati klijent SASL."

#: core/ldapconnection.cpp:437
#, kde-format
msgid ""
"LDAP support not compiled in. Please recompile libkldap with the OpenLDAP "
"(or compatible) client libraries, or complain to your distribution packagers."
msgstr "Podrška za LDAP nije uključena u kompilaciju. Ponovno kompilirajte libkldap s klijentskim bibliotekama OpenLDAP-a (ili kompatibilnima) ili se obratite održavateljima svoje distribucije."

#: core/ldapsearch.cpp:222
#, kde-format
msgid "Cannot access to server. Please reconfigure it."
msgstr "Nije moguće pristupiti poslužitelju. Ponovno ga konfigurirajte."

