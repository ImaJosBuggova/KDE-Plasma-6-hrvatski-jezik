#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "System Notifications"
msgstr "Sistemske obavijesti"

#: plasma_workspace.notifyrc:50
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Smeće: Ispražnjeno"

#: plasma_workspace.notifyrc:106
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "Smeće je ispražnjeno"

#: plasma_workspace.notifyrc:166
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Dovršavanje teksta: Rotacija"

#: plasma_workspace.notifyrc:221
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "Dosegnut je kraj popisa podudaranja"

#: plasma_workspace.notifyrc:280
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Dovršavanje teksta: Nema podudaranja"

#: plasma_workspace.notifyrc:335
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Nije pronađeno odgovarajuće dovršavanje"

#: plasma_workspace.notifyrc:394
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Dovršavanje teksta: Djelomično podudaranje"

#: plasma_workspace.notifyrc:449
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Postoji više od jednog mogućeg podudaranja"

#: plasma_workspace.notifyrc:509
msgctxt "Name"
msgid "Fatal Error"
msgstr "Kobna pogreška"

#: plasma_workspace.notifyrc:567
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Došlo je do ozbiljne pogreške zbog koje se program zatvorio"

#: plasma_workspace.notifyrc:627
msgctxt "Name"
msgid "Notification"
msgstr "Obavijest"

#: plasma_workspace.notifyrc:685
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Nešto se posebno dogodilo u programu"

#: plasma_workspace.notifyrc:744
msgctxt "Name"
msgid "Warning"
msgstr "Upozorenje"

#: plasma_workspace.notifyrc:802
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Došlo je do pogreške u programu koja može uzrokovati probleme"

#: plasma_workspace.notifyrc:862
msgctxt "Name"
msgid "Catastrophe"
msgstr "Katastrofa"

#: plasma_workspace.notifyrc:919
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Došlo je do vrlo ozbiljne pogreške, koja je barem uzrokovala izlazak iz programa"

#: plasma_workspace.notifyrc:978
msgctxt "Name"
msgid "Application Crash"
msgstr "Rušenje aplikacije"

#: plasma_workspace.notifyrc:1031
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Aplikacija se upravo neočekivano zatvorila"

#: plasma_workspace.notifyrc:1086
msgctxt "Name"
msgid "Login"
msgstr "Prijava"

#: plasma_workspace.notifyrc:1143
msgctxt "Comment"
msgid "A new session is starting"
msgstr "Pokreće se nova sesija"

#: plasma_workspace.notifyrc:1202
msgctxt "Name"
msgid "Logout"
msgstr "Odjava"

#: plasma_workspace.notifyrc:1259
msgctxt "Comment"
msgid "Session is exiting"
msgstr "Sesija se zatvara"

#: plasma_workspace.notifyrc:1320
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Odjava otkazana"

#: plasma_workspace.notifyrc:1376
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Plasmina odjava je otkazana"

#: plasma_workspace.notifyrc:1435
msgctxt "Name"
msgid "Print Error"
msgstr "Pogreška pri ispisivanju"

#: plasma_workspace.notifyrc:1493
msgctxt "Comment"
msgid "A print error has occurred"
msgstr "Došlo je do pogreške pri ispisivanju"

#: plasma_workspace.notifyrc:1553
msgctxt "Name"
msgid "Information Message"
msgstr "Informativna poruka"

#: plasma_workspace.notifyrc:1610
msgctxt "Comment"
msgid "An information message is being shown"
msgstr "Prikazuje se informativna poruka"

#: plasma_workspace.notifyrc:1670
msgctxt "Name"
msgid "Warning Message"
msgstr "Poruka upozorenja"

#: plasma_workspace.notifyrc:1727
msgctxt "Comment"
msgid "A warning message is being shown"
msgstr "Prikazuje se poruka upozorenja"

#: plasma_workspace.notifyrc:1787
msgctxt "Name"
msgid "Critical Message"
msgstr "Kritična poruka"

#: plasma_workspace.notifyrc:1844
msgctxt "Comment"
msgid "A critical message is being shown"
msgstr "Prikazuje se kritična poruka"

#: plasma_workspace.notifyrc:1904
msgctxt "Name"
msgid "Question"
msgstr "Pitanje"

#: plasma_workspace.notifyrc:1962
msgctxt "Comment"
msgid "A question is being asked"
msgstr "Postavlja se pitanje"

#: plasma_workspace.notifyrc:2023
msgctxt "Name"
msgid "Beep"
msgstr "Zvučni signal"

#: plasma_workspace.notifyrc:2080
msgctxt "Comment"
msgid "Sound bell"
msgstr "Zvučno zvono"

#: plasma_workspace.notifyrc:2139
msgctxt "Name"
msgid "Widget failed to install"
msgstr "Neuspjelo instaliranje widgeta"

#: plasma_workspace.notifyrc:2192
msgctxt "Comment"
msgid "A widget could not be installed"
msgstr "Widget se nije mogao instalirati"

#: plasma_workspace.notifyrc:2248
msgctxt "Name"
msgid "Widget deleted"
msgstr "Widget izbrisan"

#: plasma_workspace.notifyrc:2303
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Widget je izbrisan"

#: plasma_workspace.notifyrc:2361
msgctxt "Name"
msgid "Device plugged in"
msgstr "Uređaj priključen"

#: plasma_workspace.notifyrc:2407
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "Uređaj je priključen"

#: plasma_workspace.notifyrc:2458
msgctxt "Name"
msgid "Device unplugged"
msgstr "Uređaj odspojen"

#: plasma_workspace.notifyrc:2504
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "Uređaj je odspojen"