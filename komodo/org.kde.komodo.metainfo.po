#. (itstool) path: component/name
#: org.kde.komodo.metainfo.xml:8
msgid "KomoDo"
msgstr "KomoDo"

#. (itstool) path: component/summary
#: org.kde.komodo.metainfo.xml:9
msgid "Work on To-Do lists"
msgstr "Rad s popisima obveza"

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:27
msgid "KomoDo is a todo manager that uses todo.txt specification. It parses any compliant todo.txt files and turns them into easy to use list of tasks."
msgstr "KomoDo je upravitelj zadataka koji koristi specifikaciju todo.txt. Obrađuje sve datoteke kompatibilne s todo.txt i pretvara ih u jednostavne popise zadataka."

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:28
msgid "KomoDo has built-in help for the todo.txt specification, so it's suitable for newcomers too!"
msgstr "KomoDo sadrži ugrađenu pomoć za specifikaciju todo.txt, pa je prikladan i za početnike!"

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:29
msgid "Features"
msgstr "Mogućnosti"

#. (itstool) path: ul/li
#: org.kde.komodo.metainfo.xml:31
msgid "Open and create new todo.txt files"
msgstr "Otvaranje i stvaranje datoteka todo.txt"

#. (itstool) path: ul/li
#: org.kde.komodo.metainfo.xml:32
msgid "Add, delete and edit tasks"
msgstr "Dodavanje, brisanje i uređivanje zadataka"

#. (itstool) path: ul/li
#: org.kde.komodo.metainfo.xml:33
msgid "Filter and search tasks"
msgstr "Filtriranje i pretraživanje zadataka"

#. (itstool) path: screenshot/caption
#: org.kde.komodo.metainfo.xml:44
msgid "Example of KomoDo being used with light colorscheme."
msgstr "Primjer uporabe KomoDoa sa svijetlom shemom boja."

#. (itstool) path: screenshot/caption
#: org.kde.komodo.metainfo.xml:48
msgid "Example of KomoDo being used with dark colorscheme."
msgstr "Primjer uporabe KomoDoa s tamnom shemom boja."

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:62
msgid "Allow markdown style inline links, some parsing fixes, remove monospace font from tasks."
msgstr "Dodana podrška za umetnute poveznice u stilu Markdowna, ispravljena obrada i uklonjen font fiksne širine iz zadataka."

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:67
msgid "Performance improvements to search, added launch arguments, moved help into a docbook, fix loading saved filter."
msgstr "Poboljšane performanse pretraživanja, dodani argumenti pokretanja, pomoć premještena u DocBook i ispravljeno učitavanje spremljenih filtara."

#. (itstool) path: description/p
#: org.kde.komodo.metainfo.xml:72
msgid "Initial release of KomoDo, a To-Do list application."
msgstr "Prvo izdanje KomoDoa, aplikacije za popise obveza."
