msgstr "Podrška za UDP pratitelje"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:28
msgid "Support for private trackers and torrents"
msgstr "Podrška za privatne pratitelje i torrente"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:29
msgid "Support for µTorrent's peer exchange"
msgstr "Podrška za razmjenu sudionika µTorrenta"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:30
msgid "Support for protocol encryption (compatible with Azureus)"
msgstr "Podrška za šifriranje protokola (kompatibilno s Azureusom)"

#. (itstool) path: ul/li
