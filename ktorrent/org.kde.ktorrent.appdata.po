msgid "Importing of partially or fully downloaded files"
msgstr "Uvoz djelomično ili potpuno preuzetih datoteka"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:24
msgid "File prioritization for multi-file torrents"
msgstr "Određivanje prioriteta datoteka u torrentima s više datoteka"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:25
msgid "Selective downloading for multi-file torrents"
msgstr "Selektivno preuzimanje datoteka u torrentima s više datoteka"

