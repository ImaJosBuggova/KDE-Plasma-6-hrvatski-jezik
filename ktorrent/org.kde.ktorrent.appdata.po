#. (itstool) path: component/name
#: org.kde.ktorrent.appdata.xml:10
msgid "KTorrent"
msgstr "KTorrent"

#. (itstool) path: component/summary
#: org.kde.ktorrent.appdata.xml:11
msgid "BitTorrent Client"
msgstr "BitTorrent klijent"

#. (itstool) path: description/p
#: org.kde.ktorrent.appdata.xml:13
msgid "KTorrent is a BitTorrent application by KDE which allows you to download files using the BitTorrent protocol. It enables you to run multiple torrents at the same time and comes with extended features to make it a full-featured client for BitTorrent."
msgstr "KTorrent je KDE-ova BitTorrent aplikacija koja omogućuje preuzimanje datoteka pomoću protokola BitTorrent. Omogućuje istodobno pokretanje više torrenta i nudi napredne značajke koje ga čine potpuno opremljenim BitTorrent klijentom."

#. (itstool) path: description/p
#: org.kde.ktorrent.appdata.xml:18
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:20
msgid "Queuing of torrents"
msgstr "Stavljanje torrenta u red čekanja"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:21
msgid "Global and per torrent speed limits"
msgstr "Globalna ograničenja brzine i ograničenja za svaki torrent"

#. (itstool) path: ul/li
#: org.kde.ktorrent.appdata.xml:22
msgid "Previewing of certain file types, build in (video and audio)"
msgstr "Pregled određenih vrsta datoteka (ugrađena podrška za video i zvuk)"

#. (itstool) path: ul/li
