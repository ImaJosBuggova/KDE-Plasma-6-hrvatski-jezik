#. (itstool) path: component/name
#: org.kde.basket.appdata.xml:10
msgid "Basket"
msgstr "Basket"

#. (itstool) path: component/summary
#: org.kde.basket.appdata.xml:11
msgid "Notes and to-dos organizer"
msgstr "Organizator bilješki i zadataka"

#. (itstool) path: description/p
#: org.kde.basket.appdata.xml:13
msgid "This application provides as many baskets as you wish, and you can drag and drop."
msgstr "Ova aplikacija omogućuje vam stvaranje neograničenog broja košarica te povlačenje i ispuštanje stavki."

#. (itstool) path: description/p
#: org.kde.basket.appdata.xml:14
msgid "Objects can be edited, copied, dragged... So, you can arrange them as you want !"
msgstr "Stavke možete uređivati, kopirati i povlačiti... Stoga ih možete rasporediti kako želite!"

#. (itstool) path: description/p
#: org.kde.basket.appdata.xml:15
msgid "It allows to arrange notes, track to-dos and much more."
msgstr "Omogućuje organiziranje bilješki, praćenje zadataka i još mnogo toga."
