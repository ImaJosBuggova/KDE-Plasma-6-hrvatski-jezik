#: plugin_katexmltools.cpp:117
#, kde-format
msgid "XML Tools"
msgstr "Alati za XML"

#: plugin_katexmltools.cpp:120
#, kde-format
msgid "&Insert Element..."
msgstr "&Umetni element..."

#: plugin_katexmltools.cpp:124
#, kde-format
msgid "&Close Element"
msgstr "&Zatvori element"

#: plugin_katexmltools.cpp:128
#, kde-format
msgid "Assign Meta &DTD..."
msgstr "Dodijeli meta &DTD..."

#: plugin_katexmltools.cpp:440
#, kde-format
msgid "Assign Meta DTD in XML Format"
msgstr "Dodijeli meta DTD u XML formatu"

#: plugin_katexmltools.cpp:446
#, kde-format
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr "Trenutačna je datoteka prepoznata kao dokument vrste \"%1\". Sada će se učitati meta DTD za tu vrstu dokumenta."

#: plugin_katexmltools.cpp:450
#, kde-format
msgid "Loading XML Meta DTD"
msgstr "Učitavanje XML meta DTD-a"

#: plugin_katexmltools.cpp:483
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "Datoteku '%1' nije moguće otvoriti. Poslužitelj je vratio pogrešku."

#: plugin_katexmltools.cpp:486 pseudo_dtd.cpp:46 pseudo_dtd.cpp:58
#, kde-format
msgid "XML Plugin Error"
msgstr "Pogreška XML dodatka"

#: plugin_katexmltools.cpp:993
#, kde-format
msgid "XML entities"
msgstr "XML entiteti"

#: plugin_katexmltools.cpp:995
#, kde-format
msgid "XML attribute values"
msgstr "Vrijednosti XML atributa"

#: plugin_katexmltools.cpp:997
#, kde-format
msgid "XML attributes"
msgstr "XML atributi"

#: plugin_katexmltools.cpp:1000
#, kde-format
msgid "XML elements"
msgstr "XML elementi"

#: plugin_katexmltools.cpp:1039
#, kde-format
msgid "Insert XML Element"
msgstr "Umetni XML element"

#: plugin_katexmltools.cpp:1044
#, kde-format
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr "Unesite naziv XML oznake i atribute (\"<\", \">\" i završna oznaka bit će dodani):"

#: pseudo_dtd.cpp:43
#, kde-format
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr "Datoteku '%1' nije moguće analizirati. Provjerite je li datoteka ispravno oblikovan XML."

#: pseudo_dtd.cpp:52
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr "Datoteka '%1' nije u očekivanom formatu. Provjerite je li datoteka ove vrste:\n-//Norman Walsh//DTD DTDParse V2.0//EN\nTakve datoteke možete izraditi alatom dtdparse. Više informacija potražite u dokumentaciji Kateina dodatka."

#: pseudo_dtd.cpp:68
#, kde-format
msgid "Analyzing meta DTD..."
msgstr "Analiza meta DTD-a..."

#: pseudo_dtd.cpp:68
#, kde-format
msgid "Cancel"
msgstr "Odustani"

