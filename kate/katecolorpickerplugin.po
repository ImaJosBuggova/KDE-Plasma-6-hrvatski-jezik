#: colorpickerconfigpage.cpp:34
#, kde-format
msgid "Show preview for known color names"
msgstr "Prikaži pretpregled poznatih naziva boja"

#: colorpickerconfigpage.cpp:36
#, kde-format
msgid ""
"Also show the color picker for known color names (e.g. skyblue).\n"
"See https://www.w3.org/TR/css-color-4/#named-colors for the list of colors."
msgstr ""
"Prikaži odabir boje i za poznate nazive boja (npr. skyblue).\n"
"Popis boja potražite na https://www.w3.org/TR/css-color-4/#named-colors."

#: colorpickerconfigpage.cpp:39
#, kde-format
msgid "Place preview after text color"
msgstr "Postavi pretpregled nakon boje teksta"

