#: deploymentconfig.cpp:108
#, kde-format
msgid "deployment must be an object"
msgstr "implementacija mora biti objekt"

#: deploymentconfig.cpp:123
#, kde-format
msgid "deployment host must not be empty"
msgstr "poslužitelj implementacije ne smije biti prazan"

#: deploymentconfig.cpp:126 deploymentconfig.cpp:130 deploymentconfig.cpp:193
#, kde-format
msgid "deployment host is invalid"
msgstr "poslužitelj implementacije nije valjan"

#: deploymentconfig.cpp:139
#, kde-format
msgid "deployment port must be between 1 and 65535"
msgstr "priključak implementacije mora biti između 1 i 65535"

#: deploymentconfig.cpp:145
#, kde-format
msgid "project base must not be empty"
msgstr "osnovni direktorij projekta ne smije biti prazan"

#: deploymentconfig.cpp:150
#, kde-format
msgid "project base must be an existing directory"
msgstr "osnovni direktorij projekta mora postojati"

#: deploymentconfig.cpp:157
#, kde-format
msgid "deployment localRoot must not contain traversal"
msgstr "lokalni korijenski direktorij implementacije ne smije sadržavati prolazne putove"

#: deploymentconfig.cpp:165
#, kde-format
msgid ""
"deployment localRoot must be an existing directory inside the project base"
msgstr "lokalni korijenski direktorij implementacije mora biti postojeći direktorij unutar osnovnog direktorija projekta"

#: deploymentconfig.cpp:170
#, kde-format
msgid "deployment remoteRoot must be an absolute path without traversal"
msgstr "udaljeni korijenski direktorij implementacije mora biti apsolutan put bez prolaznih putova"

#: deploymentconfig.cpp:182
#, kde-format
msgid "deployment exclude entries must be strings"
msgstr "stavke za izuzimanje iz implementacije moraju biti nizovi"

#: deploymentconfig.cpp:187
#, kde-format
msgid "deployment exclude must be a list of strings"
msgstr "popis stavki za izuzimanje iz implementacije mora sadržavati nizove"

