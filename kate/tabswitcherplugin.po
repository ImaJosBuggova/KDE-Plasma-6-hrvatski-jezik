#: tabswitcher.cpp:57
#, kde-format
msgid "Document Switcher"
msgstr "Prebacivač dokumenata"

#: tabswitcher.cpp:102
#, kde-format
msgid "Last Used Views"
msgstr "Posljednji korišteni prikazi"

#: tabswitcher.cpp:105
#, kde-format
msgid "Opens a list to walk through the list of last used views."
msgstr "Otvara popis kroz koji se možete kretati među posljednjim korištenim prikazima."

#: tabswitcher.cpp:106 tabswitcher.cpp:114
#, kde-format
msgid "Walk through the list of last used views"
msgstr "Kretanje kroz popis posljednjih korištenih prikaza"

#: tabswitcher.cpp:110
#, kde-format
msgid "Last Used Views (Reverse)"
msgstr "Posljednji korišteni prikazi (obrnuto)"

#: tabswitcher.cpp:113
#, kde-format
msgid "Opens a list to walk through the list of last used views in reverse."
msgstr "Otvara popis kroz koji se možete kretati obrnutim redoslijedom među posljednjim korištenim prikazima."

#: tabswitcher.cpp:118
#, kde-format
msgid "Close View"
msgstr "Zatvori prikaz"

#: tabswitcher.cpp:121 tabswitcher.cpp:122
#, kde-format
msgid "Closes the selected view in the list of last used views."
msgstr "Zatvara odabrani prikaz s popisa posljednjih korištenih prikaza."

