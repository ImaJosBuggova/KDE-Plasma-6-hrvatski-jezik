#. (itstool) path: component/name
#: org.kde.kate.appdata.xml:7
msgid "Kate"
msgstr "Kate"

#. (itstool) path: component/summary
#: org.kde.kate.appdata.xml:8
msgid "Advanced text editor"
msgstr "Napredni uređivač teksta"

#. (itstool) path: description/p
#: org.kde.kate.appdata.xml:10
msgid "Kate is a fast multi-document, multi-view text editor for programmers by KDE. It features stuff like LSP (Language Server Protocol) support, projects, multiple cursors and selections, git integration, folder wide search, horizontal and vertical splits, vi mode, syntax highlighting for 300+ languages, built-in terminal, dynamic word wrap and much more. It is available on Linux, BSD, Windows and MacOS."
msgstr "Kate je brz KDE-ov uređivač teksta za programere s podrškom za više dokumenata i prikaza. Nudi podršku za LSP (Language Server Protocol), projekte, više pokazivača i odabira, integraciju s Gitom, pretraživanje cijelih mapa, vodoravne i okomite podjele, način rada vi, isticanje sintakse za više od 300 jezika, ugrađeni terminal, dinamičko prelamanje riječi i još mnogo toga. Dostupan je za Linux, BSD, Windows i macOS."

