#: plugin_katexmlcheck.cpp:139
#, kde-format
msgid "No DOCTYPE found, will only check well-formedness."
msgstr "DOCTYPE nije pronađen; provjerit će se samo ispravnost strukture."

#: plugin_katexmlcheck.cpp:141
#, kde-format
msgctxt "%1 refers to the XML DTD"
msgid "'%1' not found, will only check well-formedness."
msgstr "'%1' nije pronađen; provjerit će se samo ispravnost strukture."

#: plugin_katexmlcheck.cpp:227
#, kde-format
msgid "<b>Error:</b> Could not create temporary file '%1'."
msgstr "<b>Pogreška:</b> Nije moguće stvoriti privremenu datoteku „%1”."

#: plugin_katexmlcheck.cpp:246
#, kde-format
msgid ""
"<b>Error:</b> Failed to find xmllint. Please make sure that xmllint is "
"installed. It is part of libxml2."
msgstr ""
"<b>Pogreška:</b> Nije moguće pronaći xmllint. Provjerite je li xmllint "
"instaliran. Dio je biblioteke libxml2."

#: plugin_katexmlcheck.cpp:329
#, kde-format
msgid ""
"<b>Error:</b> Failed to execute xmllint. Please make sure that xmllint is "
"installed. It is part of libxml2."
msgstr ""
"<b>Pogreška:</b> Nije moguće pokrenuti xmllint. Provjerite je li xmllint "
"instaliran. Dio je biblioteke libxml2."

