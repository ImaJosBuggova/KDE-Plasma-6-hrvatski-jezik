#. (itstool) path: component/name
#: org.kde.skanlite.appdata.xml:10
msgid "Skanlite"
msgstr "Skanlite"

#. (itstool) path: component/summary
#: org.kde.skanlite.appdata.xml:11
msgid "Image Scanning Application"
msgstr "Aplikacija za skeniranje slika"

#. (itstool) path: description/p
#: org.kde.skanlite.appdata.xml:13
msgid "Skanlite is a simple image scanning application to scan and save images. It is optimized for scanning with flatbed scanners. Skanlite can capture not only photos and documents, but also transparent slides and filmstrips, with supported scanners."
msgstr "Skanlite je jednostavna aplikacija za skeniranje i spremanje slika. Optimizirana je za skeniranje ravnim skenerima. Podržanim skenerima Skanlite može skenirati ne samo fotografije i dokumente nego i prozirne dijapozitive i filmske vrpce."

#. (itstool) path: description/p
#: org.kde.skanlite.appdata.xml:17
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.skanlite.appdata.xml:19
msgid "Save dialog for every image scanned or saving the images immediately in a specified folder with auto-generated names and format"
msgstr "Dijaloški okvir za spremanje svake skenirane slike ili trenutačno spremanje slika u određenu mapu s automatski generiranim nazivima i formatom"

#. (itstool) path: ul/li
#: org.kde.skanlite.appdata.xml:20
msgid "Support for networks scanners"
msgstr "Podrška za mrežne skenere"

#. (itstool) path: ul/li
#: org.kde.skanlite.appdata.xml:21
msgid "Preview with selection feature for the final scan"
msgstr "Pretpregled s mogućnošću odabira područja završnog skeniranja"

#. (itstool) path: ul/li
#: org.kde.skanlite.appdata.xml:22
msgid "Scanning multiple selections of an image"
msgstr "Skeniranje više odabranih područja slike"

#. (itstool) path: screenshot/caption
#: org.kde.skanlite.appdata.xml:27
msgid "Skanlite's basic options screen with a scanned image visible"
msgstr "Zaslon osnovnih mogućnosti Skanlitea s prikazanom skeniranom slikom"
