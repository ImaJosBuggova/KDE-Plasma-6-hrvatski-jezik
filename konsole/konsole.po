#: Application.cpp:53
#, kde-format
msgctxt "@info:shell"
msgid "Name of profile to use for new Konsole instance"
msgstr "Naziv profila koji će se koristiti za novi primjerak Konzole"

#: Application.cpp:54
#, kde-format
msgctxt "@info:shell"
msgid "json layoutfile to be loaded to use for new Konsole instance"
msgstr "json datoteka rasporeda za učitavanje i korištenje u novom primjerku Konzole"

#: Application.cpp:55
#, kde-format
msgctxt "@info:shell"
msgid "Use the built-in profile instead of the default profile"
msgstr "Koristi ugrađeni profil umjesto zadanog profila"

#: Application.cpp:56
#, kde-format
msgctxt "@info:shell"
msgid "Set the initial working directory of the new tab or window to 'dir'"
msgstr "Postavi početni radni direktorij nove kartice ili prozora na 'dir'"

#: Application.cpp:57
#, kde-format
msgctxt "@info:shell"
msgid "Do not close the initial session automatically when it ends."
msgstr "Nemoj automatski zatvoriti početnu sesiju kada završi."

#: Application.cpp:61
#, kde-format
msgctxt "@info:shell"
msgid "Create a new tab in an existing window rather than creating a new window ('Run all Konsole windows in a single process' must be enabled)"
msgstr "Stvori novu karticu u postojećem prozoru umjesto stvaranja novog prozora (opcija 'Pokreni sve prozor Konzole u jednom procesu' mora biti omogućena)"

#: Application.cpp:62
#, kde-format
msgctxt "@info:shell"
msgid "Create tabs as specified in given tabs configuration file"
msgstr "Stvori kartice kako je definirano u zadanoj konfiguracijskoj datoteci kartica"

#: Application.cpp:64
#, kde-format
msgctxt "@info:shell"
msgid "Start Konsole in the background and bring to the front when Ctrl+Shift+F12 (by default) is pressed"
msgstr "Pokreni Konzolu u pozadini i prikaži je u prvom planu pritiskom na Ctrl+Shift+F12 (zadano)"

#: Application.cpp:65
#, kde-format
msgctxt "@info:shell"
msgid "Run in a separate process"
msgstr "Pokreni u odvojenom procesu"

#: Application.cpp:66
#, kde-format
msgctxt "@info:shell"
msgid "Show the menubar, overriding the default setting"
msgstr "Prikaži traku s izbornikom, zanemarujući zadanu postavku"

#: Application.cpp:67
#, kde-format
msgctxt "@info:shell"
msgid "Hide the menubar, overriding the default setting"
msgstr "Sakrij traku s izbornikom, zanemarujući zadanu postavku"

#: Application.cpp:68
#, kde-format
msgctxt "@info:shell"
msgid "Show all the toolbars, overriding the default setting"
msgstr "Prikaži sve trake s alatima, zanemarujući zadanu postavku"

#: Application.cpp:69
#, kde-format
msgctxt "@info:shell"
msgid "Hide all the toolbars, overriding the default setting"
msgstr "Sakrij sve trake s alatima, zanemarujući zadanu postavku"

#: Application.cpp:70
#, kde-format
msgctxt "@info:shell"
msgid "Show the tabbar, overriding the default setting"
msgstr "Prikaži traku s karticama, zanemarujući zadanu postavku"

#: Application.cpp:71
#, kde-format
msgctxt "@info:shell"
msgid "Hide the tabbar, overriding the default setting"
msgstr "Sakrij traku s karticama, zanemarujući zadanu postavku"

#: Application.cpp:72
#, kde-format
msgctxt "@info:shell"
msgid "Start Konsole in fullscreen mode"
msgstr "Pokreni Konzolu u načinu preko cijelog zaslona"

#: Application.cpp:73
#, kde-format
msgctxt "@info:shell"
msgid "Disable transparent backgrounds, even if the system supports them."
msgstr "Onemogući prozirne pozadine, čak i ako ih sustav podržava."

#: Application.cpp:74
#, kde-format
msgctxt "@info:shell"
msgid "List the available profiles"
msgstr "Prikaži popis dostupnih profila"

#: Application.cpp:75
#, kde-format
msgctxt "@info:shell"
msgid "List all the profile properties names and their type (for use with -p)"
msgstr "Prikaži nazive svih svojstava profila i njihove vrste (za upotrebu s -p)"

#: Application.cpp:76
#, kde-format
msgctxt "@info:shell"
msgid "Change the value of a profile property."
msgstr "Promijeni vrijednost svojstva profila."

#: Application.cpp:78
#, kde-format
msgctxt "@info:shell"
msgid "Command to execute. This option will catch all following arguments, so use it as the last option."
msgstr "Naredba za izvršavanje. Ova opcija prihvaća sve sljedeće argumente, pa je upotrijebite kao posljednju opciju."

#: Application.cpp:81
#, kde-format
msgctxt "@info:shell"
msgid "Force re-using the existing instance even if it breaks functionality, e. g. --new-tab. Mostly for debugging."
msgstr "Prisili ponovnu upotrebu postojećeg primjerka čak i ako to naruši funkcionalnost (npr. --new-tab). Ponajviše za otkrivanje pogrešaka."

#: Application.cpp:88
#, kde-format
msgctxt "@info:shell"
msgid "Arguments passed to command"
msgstr "Argumenti proslijeđeni naredbi"

#: Application.cpp:546
#, kde-format
msgctxt "@item"
msgid "Toggle Background Window"
msgstr "Uključi/isključi pozadinski prozor"

