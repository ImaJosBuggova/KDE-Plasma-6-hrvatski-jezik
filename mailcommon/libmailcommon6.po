#: filter/kmfilterdialog.cpp:237
#, kde-format
msgid ""
"<p>The filter will be applied on inbound emails from all folders belonging "
"to all accounts selected above. This is useful when using local filters with "
"IMAP accounts where new emails may have already been moved to different "
"folders by server-side filters.</p>"
msgstr "<p>Filtar će se primijeniti na dolazne poruke e-pošte iz svih mapa svih gore odabranih računa. To je korisno pri upotrebi lokalnih filtara s IMAP računima, kod kojih su nove poruke možda već premještene u druge mape pomoću filtara na poslužitelju.</p>"

#: filter/kmfilterdialog.cpp:243
