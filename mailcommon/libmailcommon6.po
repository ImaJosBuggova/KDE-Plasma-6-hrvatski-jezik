msgstr "Novo"

#: filter/kmfilterlistbox.cpp:143
#, kde-format
msgctxt "@info:tooltip"
msgid "Copy"
msgstr "Kopiraj"

#: filter/kmfilterlistbox.cpp:144
#, kde-format
msgctxt "@info:tooltip"
