msgid "Close"
msgstr "Zatvori"

msgctxt "donation_dialog_header_support"
msgid "Support Krita"
msgstr "Podržite Kritu"

msgctxt "donation_dialog_header_button"
msgid "♥︎ Show Supporter Options"
msgstr "♥︎ Prikaži mogućnosti za podupiratelje"

msgctxt "donation_dialog_supporter_text"
msgid ""
"Thank you for supporting Krita! Your contribution helps to keep its "
"continued development going."
msgstr "Hvala vam na podršci Kriti! Vaš doprinos pomaže u nastavku njezina razvoja."

msgctxt "product_donations_description"
msgid ""
"&lt;h2&gt;Donations&lt;/h2&gt;&lt;p&gt;Help Krita's continued development"
" with a direct donation through PayPal, via credit or debit card and many"
" other payment methods.&lt;/p&gt;"
msgstr "&lt;h2&gt;Donacije&lt;/h2&gt;&lt;p&gt;Pomozite daljnji razvoj Krite izravnom donacijom putem PayPala, kreditne ili debitne kartice i mnogih drugih načina plaćanja.&lt;/p&gt;"

msgctxt "product_donations_button"
msgid "Donate"
msgstr "Doniraj"

msgctxt "product_development_fund_description"
msgid ""
"&lt;h2&gt;Development Fund&lt;/h2&gt;&lt;p&gt;Join Krita's development "
"fund and help its continued development with a monthly contribution. "
"Different tiers with benefits are available.&lt;/p&gt;"
msgstr "&lt;h2&gt;Fond za razvoj&lt;/h2&gt;&lt;p&gt;Pridružite se fondu za razvoj Krite i pomozite njezin daljnji razvoj mjesečnim doprinosom. Dostupne su različite razine s pogodnostima.&lt;/p&gt;"

msgctxt "product_development_fund_button"
msgid "Join the Fund"
msgstr "Pridruži se fondu"

msgctxt "product_button_subscribe"
msgid "Subscribe"
msgstr "Pretplati se"

#, c-format
msgctxt "product_button_subscribe_for_month"
msgid "Subscribe for %s/month"
msgstr "Pretplati se za %s mjesečno"

msgctxt "product_button_buy"
msgid "Buy"
msgstr "Kupi"

#, c-format
msgctxt "product_button_buy_for"
msgid "Buy for %s"
msgstr "Kupi za %s"

msgctxt "product_supporter_badge_title"
msgid "Supporter Badge"
msgstr "Značka podupiratelja"

msgctxt "product_supporter_badge_description"
msgid "&lt;p&gt;A badge for early supporters of Krita on Android.&lt;/p&gt;"
msgstr "&lt;p&gt;Značka za prve podupiratelje Krite na Androidu.&lt;/p&gt;"

msgctxt "product_subscription_title"
msgid "Supporter Subscription"
msgstr "Pretplata podupiratelja"

#, c-format
msgctxt "product_subscription_description"
msgid ""
"&lt;p&gt;Support Krita's development with a monthly contribution. While "
"subscribed, you get access to &lt;strong&gt;all&lt;/strong&gt; supporter "
"benefits as they are released. You currently receive %1$d resource "
"bundles together containing over %2$d brushes, including the paid Digital"
" Atelier bundle, with more planned in the future.&lt;/p&gt;"
msgstr "&lt;p&gt;Podržite razvoj Krite mjesečnim doprinosom. Tijekom pretplate imate pristup &lt;strong&gt;svim&lt;/strong&gt; pogodnostima za podupiratelje čim budu objavljene. Trenutačno dobivate %1$d paketa resursa koji zajedno sadrže više od %2$d kistova, uključujući plaćeni paket Digital Atelier; u budućnosti planiramo još sadržaja.&lt;/p&gt;"

msgctxt "product_onetime_title"
msgid "Krita 5.3 Supporter Pack"
msgstr "Paket za podupiratelje Krite 5.3"

#, c-format
msgctxt "product_onetime_description"
msgid ""
"&lt;p&gt;In this pack you will receive %1$d resource bundles together "
"containing over %2$d brushes, including the paid Digital Atelier bundle. "
"This is a &lt;strong&gt;one-time purchase&lt;/strong&gt;, you won't be "
"entered into a subscription.&lt;/p&gt;"
msgstr "&lt;p&gt;U ovom paketu dobit ćete %1$d paketa resursa koji zajedno sadrže više od %2$d kistova, uključujući plaćeni paket Digital Atelier. Ovo je &lt;strong&gt;jednokratna kupnja&lt;/strong&gt; i nećete biti uključeni u pretplatu.&lt;/p&gt;"

msgctxt "show_this_dialog_when_krita_starts"
msgid "Show this dialog when Krita starts"
msgstr "Prikaži ovaj dijaloški okvir pri pokretanju Krite"

msgctxt "ok"
msgid "OK"
msgstr "U redu"

