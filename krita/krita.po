#: plugins/impex/heif/HeifExport.cpp:552 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:193
#: plugins/impex/png/kis_png_export.cc:167
#, kde-format
msgctxt "Color space name"
msgid "Rec 2100 HLG"
msgstr ""

#: plugins/impex/heif/HeifExport.cpp:552 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:186
#: plugins/impex/png/kis_png_export.cc:167
#, kde-format
msgctxt "Color space name"
msgid "Rec 2100 PQ"
msgstr ""

#: plugins/impex/heif/HeifExport.cpp:553 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:188
#: plugins/impex/png/kis_png_export.cc:168
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be converted to Rec 2020 linear first, and then encoded with "
"a perceptual quantizer curve (also known as SMPTE 2048 curve). Recommended "
"for HDR images where the absolute brightness is important."
msgstr ""

#: plugins/impex/heif/HeifExport.cpp:555 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:195
#: plugins/impex/png/kis_png_export.cc:170
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be converted to Rec 2020 linear first, and then encoded with "
"a Hybrid Log Gamma curve. Recommended for HDR images where the display may "
"not understand HDR."
msgstr "Slika će se najprije pretvoriti u linearni Rec 2020, a zatim kodirati krivuljom Hybrid Log Gamma. Preporučuje se za HDR slike na zaslonima koji možda ne podržavaju HDR."

#: plugins/impex/heif/HeifExport.cpp:561 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:202
#: plugins/impex/png/kis_png_export.cc:176
#, kde-format
msgctxt "Color space option plus transfer function name"
msgid "Keep colorants, encode PQ"
msgstr "Zadrži kolorante, kodiraj PQ"

#: plugins/impex/heif/HeifExport.cpp:562 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:204
#: plugins/impex/png/kis_png_export.cc:177
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be linearized first, and then encoded with a perceptual "
"quantizer curve (also known as the SMPTE 2048 curve). Recommended for images "
"where the absolute brightness is important."
msgstr "Slika će se najprije linearizirati, a zatim kodirati krivuljom perceptivnog kvantizatora (poznatom i kao krivulja SMPTE 2048). Preporučuje se za slike kod kojih je važna apsolutna svjetlina."

#: plugins/impex/heif/HeifExport.cpp:566 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:210
#: plugins/impex/png/kis_png_export.cc:181
#, kde-format
msgctxt "Color space option plus transfer function name"
msgid "Keep colorants, encode HLG"
msgstr "Zadrži kolorante, kodiraj HLG"

#: plugins/impex/heif/HeifExport.cpp:567 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:212
#: plugins/impex/png/kis_png_export.cc:182
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be linearized first, and then encoded with a Hybrid Log Gamma "
"curve. Recommended for images intended for screens which cannot understand PQ"
msgstr "Slika će se najprije linearizirati, a zatim kodirati krivuljom Hybrid Log Gamma. Preporučuje se za slike namijenjene zaslonima koji ne podržavaju PQ."

#: plugins/impex/heif/HeifExport.cpp:571 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:217
#: plugins/impex/png/kis_png_export.cc:186
#, kde-format
msgctxt "Color space option plus transfer function name"
msgid "Keep colorants, encode SMPTE ST 428"
msgstr "Zadrži kolorante, kodiraj SMPTE ST 428"

#: plugins/impex/heif/HeifExport.cpp:572 plugins/impex/jxl/kis_wdg_options_jpegxl.cpp:219
#: plugins/impex/png/kis_png_export.cc:187
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be linearized first, and then encoded with SMPTE ST 428. "
"Krita always opens images like these as linear floating point, this option "
"is there to reverse that"
msgstr "Slika će se najprije linearizirati, a zatim kodirati prema SMPTE ST 428. Krita takve slike uvijek otvara kao linearne slike s pomičnim zarezom; ova opcija poništava tu pretvorbu."

#: plugins/impex/heif/HeifExport.cpp:577 plugins/impex/png/kis_png_export.cc:192
#, kde-format
msgctxt "Color space option"
msgid "No changes, clip"
msgstr "Bez promjena, obreži"

#: plugins/impex/heif/HeifExport.cpp:578
#, kde-format
msgctxt "@tooltip"
msgid ""
"The image will be converted plainly to 12bit integer, and values that are "
