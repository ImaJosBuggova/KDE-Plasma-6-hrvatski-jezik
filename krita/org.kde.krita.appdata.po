msgid "Krita"
msgstr "Krita"

#. (itstool) path: component/summary
#: org.kde.krita.appdata.xml:12
msgid "Digital Painting, Creative Freedom"
msgstr "Digitalno slikanje, kreativna sloboda"

#. (itstool) path: description/p
#: org.kde.krita.appdata.xml:14
msgid "Krita is the full-featured digital art studio."
msgstr "Krita je potpuno opremljen studio za digitalnu umjetnost."

#. (itstool) path: description/p
#: org.kde.krita.appdata.xml:15
msgid "It is perfect for sketching and painting, and presents an end–to–end solution for creating digital painting files from scratch by masters."
msgstr "Savršena je za skiciranje i slikanje te nudi cjelovito rješenje koje umjetnicima omogućuje izradu digitalnih slika od početka do kraja."

#. (itstool) path: description/p
#: org.kde.krita.appdata.xml:16
msgid "Krita is a great choice for creating concept art, comics, textures for rendering and matte paintings. Krita supports many colorspaces like RGB and CMYK at 8 and 16 bits integer channels, as well as 16 and 32 bits floating point channels."
msgstr "Krita je izvrstan izbor za izradu konceptualne umjetnosti, stripova, tekstura za iscrtavanje i matiranih slika. Podržava mnoge prostore boja, poput RGB-a i CMYK-a s cjelobrojnim kanalima od 8 i 16 bitova te kanalima s pomičnim zarezom od 16 i 32 bita."

#. (itstool) path: description/p
#: org.kde.krita.appdata.xml:20
msgid "Have fun painting with the advanced brush engines, amazing filters and many handy features that make Krita enormously productive."
msgstr "Uživajte u slikanju uz napredne pogone kista, sjajne filtre i brojne praktične značajke koje Kritu čine iznimno produktivnom."

#. (itstool) path: screenshot/caption
#: org.kde.krita.appdata.xml:30
