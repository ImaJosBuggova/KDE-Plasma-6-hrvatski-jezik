#. (itstool) path: component/summary
#: org.kde.kio.admin.metainfo.xml:12
msgid "Enables administrative access for KIO-enabled applications"
msgstr "Omogućuje administratorski pristup aplikacijama koje podržavaju KIO"

#. (itstool) path: description/p
#: org.kde.kio.admin.metainfo.xml:14
msgid "KIO Admin is a KIO worker plugin that enables KIO-aware applications (such as Dolphin, Kate or Gwenview) to access files as administrator/root."
msgstr ""
"KIO Admin je priključak KIO radnika koji omogućuje aplikacijama koje "
"podržavaju KIO (kao što su Dolphin, Kate ili Gwenview) pristup datotekama "
"s administratorskim/root ovlastima."

