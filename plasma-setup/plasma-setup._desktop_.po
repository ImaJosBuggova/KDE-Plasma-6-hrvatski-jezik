#: files/plasma-setup.desktop.in:9 src/auth/org.kde.plasmasetup.actions:8
msgctxt "Name"
msgid "Plasma Setup"
msgstr "Postavljanje Plasma sustava"

#: files/plasma-setup.desktop.in:50
msgctxt "Comment"
msgid "Run the initial system setup for KDE"
msgstr "Pokreni početno postavljanje KDE sustava"

#: src/auth/org.kde.plasmasetup.actions:53
msgctxt "Name"
msgid "Create User"
msgstr "Stvori korisnika"

#: src/auth/org.kde.plasmasetup.actions:94
msgctxt "Description"
msgid "Create the initial user account"
msgstr "Stvori početni korisnički račun"

#: src/auth/org.kde.plasmasetup.actions:137
msgctxt "Name"
msgid "Create Completion Flag File"
msgstr "Stvori datoteku oznake dovršetka"

#: src/auth/org.kde.plasmasetup.actions:176
msgctxt "Description"
msgid "Write the /etc/plasma-setup-done marker to prevent rerunning setup"
msgstr "Zapiši oznaku /etc/plasma-setup-done da bi se spriječilo ponovno pokretanje postavljanja"

#: src/auth/org.kde.plasmasetup.actions:218
msgctxt "Name"
msgid "Create New User Autostart Hook"
msgstr "Stvori stavku automatskog pokretanja za novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:258
msgctxt "Description"
msgid "Create an autostart hook for the newly created user"
msgstr "Stvori stavku automatskog pokretanja za novostvorenog korisnika"

#: src/auth/org.kde.plasmasetup.actions:301
msgctxt "Name"
msgid "Remove Autologin"
msgstr "Ukloni automatsku prijavu"

#: src/auth/org.kde.plasmasetup.actions:341
msgctxt "Description"
msgid "Remove Display Manager autologin configuration"
msgstr "Ukloni konfiguraciju automatske prijave upravitelja prijava"

#: src/auth/org.kde.plasmasetup.actions:383
msgctxt "Name"
msgid "Set New User Global Theme"
msgstr "Postavi globalnu temu novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:423
msgctxt "Description"
msgid "Set the global theme for the new user"
msgstr "Postavi globalnu temu za novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:466
msgctxt "Name"
msgid "Set New User Display Scaling"
msgstr "Postavi mjerilo zaslona novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:506
msgctxt "Description"
msgid "Set display scaling for the new user"
msgstr "Postavi mjerilo zaslona za novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:548
msgctxt "Name"
msgid "Set New User Home Directory Ownership"
msgstr "Postavi vlasništvo nad osobnom mapom novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:588
msgctxt "Description"
msgid "Set ownership of the new users home directory to the newly created user"
msgstr "Dodijeli vlasništvo nad osobnom mapom novostvorenom korisniku"

#: src/auth/org.kde.plasmasetup.actions:630
msgctxt "Name"
msgid "Set New User Temporary Autologin"
msgstr "Postavi privremenu automatsku prijavu novog korisnika"

#: src/auth/org.kde.plasmasetup.actions:669
msgctxt "Description"
msgid ""
"Set display manager temporary autologin configuration for the newly created "
"user"
msgstr "Postavi privremenu konfiguraciju automatske prijave upravitelja prijava za novostvorenog korisnika"
