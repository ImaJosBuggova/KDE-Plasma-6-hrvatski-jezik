#. (itstool) path: component/name
#: org.kde.kxstitch.appdata.xml:8
msgid "KXStitch"
msgstr "KXStitch"

#. (itstool) path: component/summary
#: org.kde.kxstitch.appdata.xml:9
msgid "A cross stitch pattern creator"
msgstr "Program za izradu uzoraka za križni vez"

#. (itstool) path: description/p
#: org.kde.kxstitch.appdata.xml:15
msgid "KXStitch is a program that lets you create cross stitch patterns and charts. Patterns can be created from scratch on a user defined size of grid, which can be enlarged or reduced in size as your pattern progresses. Alternatively you can import images from many graphics file formats which will allow you to reduce the number of colors and to restrict the conversion to full stitches or optionally use fractional stitches. You may also use images as backgrounds allowing you to trace over them. These imported images can then be modified using the supplied tools to produce your final design."
msgstr "KXStitch je program koji vam omogućuje izradu uzoraka i dijagrama za križni vez. Uzorke možete izraditi od početka na mreži veličine koju sami odredite, a veličinu možete povećavati ili smanjivati kako uzorak napreduje. Možete i uvesti slike iz mnogih grafičkih formata, smanjiti broj boja i ograničiti pretvorbu na pune bodove ili po želji koristiti djelomične bodove. Slike možete koristiti i kao pozadinu za iscrtavanje. Uvezene slike zatim možete mijenjati priloženim alatima kako biste izradili konačni dizajn."

