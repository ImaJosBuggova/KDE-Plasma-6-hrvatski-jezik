#: src/helper/kcmgrub2.actions:2
msgctxt "Name"
msgid "GRUB2 Bootloader Control Module"
msgstr "Upravljački modul za GRUB2"

#: src/helper/kcmgrub2.actions:55
msgctxt "Name"
msgid "Restore the default GRUB2 Bootloader settings"
msgstr "Vrati zadane postavke GRUB2 pokretačkog programa"

#: src/helper/kcmgrub2.actions:104
msgctxt "Description"
msgid ""
"Administrator authorization is required to restore the default GRUB2 "
"Bootloader settings"
msgstr "Za vraćanje zadanih postavki GRUB2 pokretačkog programa potrebna je administratorska autorizacija"

#: src/helper/kcmgrub2.actions:156
msgctxt "Name"
msgid "Install the GRUB2 Bootloader"
msgstr "Instaliraj GRUB2 pokretački program"

#: src/helper/kcmgrub2.actions:207
msgctxt "Description"
msgid "Administrator authorization is required to install the GRUB2 Bootloader"
msgstr "Za instalaciju GRUB2 pokretačkog programa potrebna je administratorska autorizacija"

#: src/helper/kcmgrub2.actions:260
msgctxt "Name"
msgid "Load the GRUB2 Bootloader settings"
msgstr "Učitaj postavke GRUB2 pokretačkog programa"

#: src/helper/kcmgrub2.actions:310
msgctxt "Description"
msgid ""
"Administrator authorization is required to load the GRUB2 Bootloader settings"
msgstr "Za učitavanje postavki GRUB2 pokretačkog programa potrebna je administratorska autorizacija"

#: src/helper/kcmgrub2.actions:363
msgctxt "Name"
msgid "Save the GRUB2 Bootloader settings"
msgstr "Spremi postavke GRUB2 pokretačkog programa"

#: src/helper/kcmgrub2.actions:413
msgctxt "Description"
msgid ""
"Administrator authorization is required to save the GRUB2 Bootloader settings"
msgstr "Za spremanje postavki GRUB2 pokretačkog programa potrebna je administratorska autorizacija"
