#: ui/CodecError.qml:14
#, kde-format
msgctxt "@info:status"
msgid ""
"Remote desktop cannot be enabled because your system does not support H264 "
"video encoding. Please contact your distribution regarding how to enable it."
msgstr "Udaljena radna površina ne može se uključiti jer sustav ne podržava kodiranje videa H.264. Obratite se svojoj distribuciji za upute o njegovu uključivanju."

