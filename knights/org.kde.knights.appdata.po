#. (itstool) path: component/name
#: org.kde.knights.appdata.xml:9
msgid "KNights"
msgstr "KNights"

#. (itstool) path: component/summary
#: org.kde.knights.appdata.xml:10
msgid "Chess game"
msgstr "Šahovska igra"

#. (itstool) path: description/p
#: org.kde.knights.appdata.xml:12
msgid "KNights is a chess game. As a player, your goal is to defeat your opponent by checkmating their king."
msgstr "KNights je šahovska igra. Cilj je pobijediti protivnika matiranjem njegova kralja."

#. (itstool) path: description/p
#: org.kde.knights.appdata.xml:15
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:17
msgid "Local play between two players on the same computer"
msgstr "Lokalna igra za dva igrača na istom računalu"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:18
msgid "Play against any computer program that supports the XBoard protocol"
msgstr "Igrajte protiv bilo kojeg računalnog programa koji podržava protokol XBoard"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:19
msgid "Play on the Free Internet Chess Server (FICS)"
msgstr "Igrajte na poslužitelju Free Internet Chess Server (FICS)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:20
msgid "Watching two computer engines play against each other"
msgstr "Gledajte kako dva računalna šahovska programa igraju jedan protiv drugoga"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:21
msgid "Support for legal move checking"
msgstr "Podrška za provjeru dopuštenih poteza"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:22
msgid "Markers for possible moves, opponent’s last move and sources of check"
msgstr "Oznake mogućih poteza, posljednjeg protivnikova poteza i izvora šaha"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:23
msgid "Board borders and site notations"
msgstr "Obrubi ploče i koordinatne oznake"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:24
msgid "Complete time control, with Plasma-styled clocks"
msgstr "Potpuno vremensko ograničenje sa satovima u stilu Plasme"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:25
msgid "Several themes, with the possibility of downloading new ones from within the program"
msgstr "Više tema, uz mogućnost preuzimanja novih iz programa"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:26
msgid "Animated moves (configurable)"
msgstr "Animirani potezi (moguće podesiti)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:27
msgid "Views for playing on a chess server, including a seek graph, text console, and chat widget"
msgstr "Prikazi za igranje na šahovskom poslužitelju, uključujući graf izazova, tekstualnu konzolu i razgovor"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:28
msgid "Option to undo and redo moves"
msgstr "Mogućnost poništavanja i ponavljanja poteza"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:29
msgid "Graphic interface for making and receiving offers from remote players"
msgstr "Grafičko sučelje za slanje i primanje ponuda od udaljenih igrača"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:30
msgid "Support for the UCI protocol (used by Stockfish, Chessbase, and many others)"
msgstr "Podrška za protokol UCI (koriste ga Stockfish, Chessbase i mnogi drugi)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:31
msgid "Support for saving and loading Portable game notation (PGN) files"
msgstr "Podrška za spremanje i učitavanje datoteka prijenosne notacije partija (PGN)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:32
msgid "Speak opponent’s moves"
msgstr "Izgovaraj protivnikove poteze"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:33
msgid "Ability to control the program via a D-Bus interface"
msgstr "Mogućnost upravljanja programom putem sučelja D-Bus"

