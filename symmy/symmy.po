msgstr "(c) 2017 Elvis Angelaccio"

#: src/main.cpp:29
#, kde-format
msgid "Elvis Angelaccio"
msgstr "Elvis Angelaccio"

#: src/main.cpp:33
#, kde-format
msgid "List of files to encrypt or decrypt."
msgstr "Popis datoteka za šifriranje ili dešifriranje."

#: src/main.cpp:35
#, kde-format
msgid ""
"Encrypt the given list of files (this is the default if there are no other "
"options)."
msgstr "Šifriraj navedeni popis datoteka (zadano ako nema drugih opcija)."

#: src/main.cpp:37
#, kde-format
msgid "Decrypt the given list of files."
msgstr "Dešifriraj navedeni popis datoteka."

#: src/main.cpp:46
#, kde-format
msgctxt "--encrypt and --decrypt are CLI args, don't translate them"
msgid "Error: either --encrypt or --decrypt, not both."
msgstr "Pogreška: navedite --encrypt ili --decrypt, ne oboje."
