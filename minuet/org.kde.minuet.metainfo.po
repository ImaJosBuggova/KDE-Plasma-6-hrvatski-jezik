#. (itstool) path: component/name
#: org.kde.minuet.metainfo.xml:7
msgid "Minuet"
msgstr "Minuet"

#. (itstool) path: component/summary
#: org.kde.minuet.metainfo.xml:8
msgid "Music education software"
msgstr "Program za glazbeno obrazovanje"

#. (itstool) path: description/p
#: org.kde.minuet.metainfo.xml:14
msgid "Minuet is an application for music education. It features a set of ear training exercises regarding intervals, chords, scales, and more."
msgstr "Minuet je aplikacija za glazbeno obrazovanje. Sadrži skup vježbi za uvježbavanje sluha koje obuhvaćaju intervale, akorde, ljestvice i drugo."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:31
msgid "Find focused exercises for intervals, chords, scales, and rhythm."
msgstr "Pronađite ciljane vježbe za intervale, akorde, ljestvice i ritam."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:35
msgid "Build your ear by identifying notes with keyboard and staff feedback."
msgstr "Uvježbajte sluh prepoznavanjem nota uz povratne informacije na tipkovnici i notnom crtovlju."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:39
msgid "Recognize rhythm patterns, including rests, at your own pace."
msgstr "Prepoznajte ritamske obrasce, uključujući pauze, vlastitim tempom."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:43
msgid "Sing intervals and scales with live pitch and timing feedback."
msgstr "Pjevajte intervale i ljestvice uz izravne povratne informacije o visini tona i vremenu."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:47
msgid "Clap written rhythms and see where each beat lands."
msgstr "Plješćite zapisane ritmove i pogledajte gdje pada svaki takt."

#. (itstool) path: screenshot/caption
#: org.kde.minuet.metainfo.xml:51
msgid "Adjust tempo, instruments, test length, and microphone feedback."
msgstr "Prilagodite tempo, instrumente, duljinu testa i povratne informacije mikrofona."
