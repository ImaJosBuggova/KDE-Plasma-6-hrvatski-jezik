msgid "Plasma Keyboard"
msgstr "Plasma tipkovnica"

#. (itstool) path: component/summary
#: org.kde.plasma.keyboard.metainfo.xml:9
msgid "On-Screen Keyboard for Plasma"
msgstr "Zaslonska tipkovnica za Plasmu"

#. (itstool) path: description/p
#: org.kde.plasma.keyboard.metainfo.xml:13
msgid "Plasma Keyboard provides a virtual, on-screen keyboard for touchscreens, tablets, convertible devices, phones, and traditional computers without a physical keyboard."
msgstr "Plasma tipkovnica pruža virtualnu zaslonsku tipkovnicu za zaslone osjetljive na dodir, tablete, konvertibilne uređaje, telefone i klasična računala bez fizičke tipkovnice."

#. (itstool) path: ul/li
#: org.kde.plasma.keyboard.metainfo.xml:18
msgid "Seamless integration with the Plasma workspace and applications"
msgstr "Besprijekorna integracija s radnim prostorom i aplikacijama Plasme"

#. (itstool) path: ul/li
#: org.kde.plasma.keyboard.metainfo.xml:19
msgid "Automatic appearance when text input is needed"
msgstr "Automatski se prikazuje kad je potreban unos teksta"

#. (itstool) path: ul/li
#: org.kde.plasma.keyboard.metainfo.xml:20
msgid "Support for multiple layouts and languages"
msgstr "Podrška za više rasporeda i jezika"

#. (itstool) path: ul/li
#: org.kde.plasma.keyboard.metainfo.xml:21
msgid "Configurable size and behavior for different form factors"
msgstr "Prilagodljiva veličina i ponašanje za različite oblike uređaja"
