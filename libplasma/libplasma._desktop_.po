#: templates/cpp-plasmoid6/cpp-plasmoid6.kdevtemplate:2
msgctxt "Name"
msgid "Plasma QML/C++ Applet (Qt6)"
msgstr "Plasma QML/C++ plazmoid (Qt6)"

#: templates/cpp-plasmoid6/cpp-plasmoid6.kdevtemplate:50
msgctxt "Comment"
msgid ""
"A Plasma Applet template written in an hybrid mix of QML and C++: a Plasma "
"applet template displaying a SVG picture and a text"
msgstr ""
"Predložak Plasma plazmoida napisan u hibridnoj mješavini QML-a i C++-a: "
"predložak Plasma plazmoida koji prikazuje SVG sliku i tekst"

#: templates/plasma6-wallpaper/plasma6-wallpaper.kdevtemplate:2
msgctxt "Name"
msgid "Simple Plasma Wallpaper (Qt6)"
msgstr "Jednostavna Plasma pozadinska slika (Qt6)"

#: templates/plasma6-wallpaper/plasma6-wallpaper.kdevtemplate:51
msgctxt "Comment"
msgid ""
"Simple Plasma Wallpaper template: a Plasma wallpaper template displaying a "
"text"
msgstr ""
"Jednostavan predložak Plasma pozadinske slike: predložak Plasma pozadinske "
"slike koji prikazuje tekst"

#: templates/plasma6-wallpaper-with-qml-extension/plasma6-wallpaper-with-qml-extension.kdevtemplate:2
msgctxt "Name"
msgid "Simple Plasma Wallpaper with QML extension (Qt6)"
msgstr "Jednostavna Plasma pozadinska slika s QML proširenjem (Qt6)"

#: templates/plasma6-wallpaper-with-qml-extension/plasma6-wallpaper-with-qml-extension.kdevtemplate:50
msgctxt "Comment"
msgid ""
"A Plasma wallpaper which uses custom API provided by an own QML extension "
