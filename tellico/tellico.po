#: src/collectionfieldsdialog.cpp:922
#, kde-format
msgid "A field with this title already exists. Please enter a different title."
msgstr "Polje s ovim naslovom već postoji. Unesite drugi naslov."

#: src/collectionfieldsdialog.cpp:929
#, kde-format
msgid "<qt>The category may not be empty. Please enter a category.</qt>"
msgstr "<qt>Kategorija ne smije biti prazna. Unesite kategoriju.</qt>"

#: src/collectionfieldsdialog.cpp:937
#, kde-format
msgid ""
"<qt>A field may not be in the same category as a <em>Paragraph</em>, "
"<em>Table</em> or <em>Image</em> field. Please enter a different category.</"
"qt>"
msgstr ""
"<qt>Polje ne smije biti u istoj kategoriji kao polje <em>Odlomak</em>, "
"<em>Tablica</em> ili <em>Slika</em>. Unesite drugu kategoriju.</qt>"

#: src/collectionfieldsdialog.cpp:945
#, kde-format
msgid ""
"A field's title may not be the same as an existing category. Please enter a "
"different title."
msgstr "Naslov polja ne smije biti jednak postojećoj kategoriji. Unesite drugi naslov."

#: src/collectionfieldsdialog.cpp:957
#, kde-format
msgid ""
"The range for a rating field must be between 1 and 10, and the lower bound "
"must be less than the higher bound. Please enter different low and high "
"properties."
msgstr ""
"Raspon polja za ocjenu mora biti od 1 do 10, a donja granica mora biti manja "
"od gornje. Unesite drukčije donje i gornje vrijednosti."

#: src/collectionfieldsdialog.cpp:972
#, kde-format
msgid "Tables are limited to a maximum of ten columns."
msgstr "Tablice mogu imati najviše deset stupaca."

#: src/collectionfieldsdialog.cpp:978
#, kde-format
msgid "A field with a derived value must have a value template."
msgstr "Polje s izvedenom vrijednošću mora imati predložak vrijednosti."

