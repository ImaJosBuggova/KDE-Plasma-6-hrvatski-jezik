#. (itstool) path: component/name
#: org.kde.tellico.appdata.xml:9
msgid "Tellico"
msgstr "Tellico"

#. (itstool) path: component/summary
#: org.kde.tellico.appdata.xml:10
msgid "Collection Manager"
msgstr "Upravitelj zbirki"

#. (itstool) path: description/p
#: org.kde.tellico.appdata.xml:12
msgid "Tellico is an application for organizing your collections. It provides default templates for books, bibliographies, videos, music, video games, coins, stamps, trading cards, comic books, and wines. It allows you to enter your collection in a catalogue database, saving many different properties like title, author, etc."
msgstr "Tellico je aplikacija za organiziranje vaših zbirki. Nudi zadane predloške za knjige, bibliografije, videozapise, glazbu, videoigre, kovanice, poštanske marke, kolekcionarske kartice, stripove i vina. Omogućuje unos zbirke u katalošku bazu podataka i spremanje različitih svojstava kao što su naslov, autor i drugo."

#. (itstool) path: description/p
#: org.kde.tellico.appdata.xml:17
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:19
msgid "Supports default collections of books, bibliographic entries, videos, music, video games, comic books, coins, stamps, trading cards, wines, board games, and file catalogs"
msgstr "Podržava zadane zbirke knjiga, bibliografskih zapisa, videozapisa, glazbe, videoigara, stripova, kovanica, poštanskih maraka, kolekcionarskih kartica, vina, društvenih igara i kataloga datoteka"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:20
msgid "Supports user-defined custom collections"
msgstr "Podržava prilagođene zbirke koje definira korisnik"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:21
msgid "Supports any number of user-defined fields, of several different types: text, paragraph, list, checkbox, number, URL, date, images, and combinations"
msgstr "Podržava proizvoljan broj korisnički definiranih polja nekoliko vrsta: tekst, odlomak, popis, potvrdni okvir, broj, URL, datum, slike i njihove kombinacije"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:22
msgid "Handles entries with multiple authors, genres, keywords, etc"
msgstr "Podržava zapise s više autora, žanrova, ključnih riječi i slično"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:23
msgid "Automatically formats titles and names"
msgstr "Automatski oblikuje naslove i imena"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:24
msgid "Supports collection searching and view filtering"
msgstr "Podržava pretraživanje zbirki i filtriranje prikaza"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:25
msgid "Sorts and groups collection by various properties"
msgstr "Razvrstava i grupira zbirke prema različitim svojstvima"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:26
msgid "Allows customizable entry templates through XSLT"
msgstr "Omogućuje prilagodbu predložaka zapisa pomoću XSLT-a"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:27
msgid "Imports MODS, Bibtex, RIS, CSV, PDF metadata, and many other formats"
msgstr "Uvozi MODS, BibTeX, RIS, CSV, metapodatke PDF-a i mnoge druge formate"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:28
msgid "Exports to Bibtex, ONIX, CSV, HTML, and other formats"
msgstr "Izvozi u BibTeX, ONIX, CSV, HTML i druge formate"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:29
msgid "Imports information directly from Amazon.com, IMDb, z39.50 servers, PubMed, SRU servers, CrossRef.org, various other websites, and from external scripts"
msgstr "Uvozi podatke izravno s Amazon.coma, IMDb-a, poslužitelja z39.50, PubMeda, poslužitelja SRU, CrossRef.orga, različitih drugih web-mjesta i vanjskih skripti"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:30
msgid "Imports CDDB data for cataloging audio CDs"
msgstr "Uvozi podatke CDDB-a za katalogiziranje audio CD-ova"

#. (itstool) path: ul/li
#: org.kde.tellico.appdata.xml:31
msgid "Scans and imports audio file collections, such as mp3 or ogg"
msgstr "Skenira i uvozi zbirke audi datoteka kao što su MP3 ili Ogg"

#. (itstool) path: screenshot/caption
#: org.kde.tellico.appdata.xml:44
msgid "The main window showing a movie collection"
msgstr "Glavni prozor s prikazom zbirke filmova"

#. (itstool) path: screenshot/caption
#: org.kde.tellico.appdata.xml:48
msgid "The main window showing a simple item in a book collection"
msgstr "Glavni prozor s prikazom jednostavne stavke u zbirci knjiga"

#. (itstool) path: screenshot/caption
#: org.kde.tellico.appdata.xml:52
msgid "The main window showing side-by-side views of a game collection"
msgstr "Glavni prozor s usporednim prikazom zbirke igara"
