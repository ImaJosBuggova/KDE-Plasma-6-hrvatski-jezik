#. (itstool) path: component/name
#: org.kde.kontact.appdata.xml:9
msgid "Kontact"
msgstr "Kontact"

#. (itstool) path: component/summary
#: org.kde.kontact.appdata.xml:11
msgid "Handle all your emails, calendars, contacts and more within a single window"
msgstr "Upravljajte e-poštom, kalendarima, kontaktima i drugim sadržajem u jednom prozoru"

#. (itstool) path: description/p
#: org.kde.kontact.appdata.xml:13
msgid "Handle your email, calendar, contacts and other personal data with Kontact. Kontact groups everything together in one place and helps you manage your communications, organize your day and work with your colleagues."
msgstr "Upravljajte e-poštom, kalendarom, kontaktima i drugim osobnim podacima uz Kontact. Kontact objedinjuje sve na jednom mjestu te vam pomaže u komunikaciji, organizaciji dana i suradnji s kolegama."

#. (itstool) path: description/p
#: org.kde.kontact.appdata.xml:16
msgid "Kontact unifies several personal information management applications into a single window to give you the best possible experience and boost your productivity. With Kontact you can use all the tools of our powerful suite in one place. Unlike proprietary web applications we value your privacy and support open standards, which is why Kontact gives you full control over your data. You can of course also access your data offline if you want to."
msgstr "Kontact objedinjuje nekoliko aplikacija za upravljanje osobnim podacima u jednom prozoru kako bi vam pružio najbolje moguće iskustvo i povećao produktivnost. Uz Kontact možete koristiti sve alate našeg moćnog paketa na jednom mjestu. Za razliku od vlasničkih web-aplikacija, cijenimo vašu privatnost i podržavamo otvorene standarde, zbog čega vam Kontact daje potpunu kontrolu nad podacima. Naravno, podacima možete pristupati i izvan mreže."

#. (itstool) path: description/p
#: org.kde.kontact.appdata.xml:19
msgid "Kontact consists of several well-integrated components:"
msgstr "Kontact se sastoji od nekoliko dobro integriranih komponenti:"

#. (itstool) path: ul/li
#: org.kde.kontact.appdata.xml:21
msgid "KMail - a powerful and feature-rich email client with support for a wide range of email providers."
msgstr "KMail – moćan i funkcijama bogat klijent e-pošte s podrškom za velik broj pružatelja usluga e-pošte."

#. (itstool) path: ul/li
#: org.kde.kontact.appdata.xml:22
msgid "KOrganizer - a calendar and scheduling component of Kontact which is able to work with NextCloud, Kolab, Google Calendar and other calendaring services."
msgstr "KOrganizer – komponenta Kontacta za kalendar i raspoređivanje koja može raditi s uslugama Nextcloud, Kolab, Google kalendar i drugim kalendarskim uslugama."

#. (itstool) path: ul/li
#: org.kde.kontact.appdata.xml:23
msgid "KAddressBook - an easy to use contact management tool that can synchronize contacts with many popular services."
msgstr "KAddressBook – jednostavan alat za upravljanje kontaktima koji ih može sinkronizirati s mnogim popularnim uslugama."

#. (itstool) path: ul/li
#: org.kde.kontact.appdata.xml:24
msgid "Akregator - a news reader with powerful search and archiving functionality."
msgstr "Akregator – čitač vijesti s moćnim mogućnostima pretraživanja i arhiviranja."

#. (itstool) path: screenshot/caption
#: org.kde.kontact.appdata.xml:43
msgid "KMail, the email component of Kontact"
msgstr "KMail, komponenta Kontacta za e-poštu"

#. (itstool) path: screenshot/caption
#: org.kde.kontact.appdata.xml:47
msgid "Organize your time, manage events, create todos or schedule meetings with KOrganizer"
msgstr "Organizirajte vrijeme, upravljajte događajima, stvarajte zadatke ili zakazujte sastanke uz KOrganizer"

#. (itstool) path: screenshot/caption
#: org.kde.kontact.appdata.xml:51
msgid "KAddressBook provides an easy way to manage your contacts"
msgstr "KAddressBook omogućuje jednostavno upravljanje kontaktima"

#. (itstool) path: screenshot/caption
#: org.kde.kontact.appdata.xml:55
msgid "Stay on top of the new with Akregator, our news reader"
msgstr "Budite u toku s novostima uz Akregator, naš čitač vijesti"

#. (itstool) path: ul/li
#: org.kde.kontact.appdata.xml:68
msgid "Add Akonadi MCP server."
msgstr "Dodaje Akonadijev MCP poslužitelj."
