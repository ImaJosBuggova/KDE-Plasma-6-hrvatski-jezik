#. (itstool) path: component/summary
#: org.kde.okular.kirigami.appdata.xml:7
msgid "Document Viewer"
msgstr "Preglednik dokumenata"

#. (itstool) path: description/p
#: org.kde.okular.kirigami.appdata.xml:13
msgid "Okular is a universal document viewer developed by KDE. Okular works on multiple platforms, including but not limited to Linux, Windows, macOS, *BSD, etc."
msgstr "Okular je univerzalni preglednik dokumenata koji razvija KDE. Radi na različitim platformama, uključujući, ali ne ograničavajući se na Linux, Windows, macOS, *BSD itd."

