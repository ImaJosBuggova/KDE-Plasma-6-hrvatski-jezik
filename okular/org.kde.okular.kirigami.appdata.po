msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.okular.kirigami.appdata.xml:18
msgid "Supported Formats: PDF, PS, Tiff, DjVu, Images, DVI, XPS, Fiction Book, Comic Book, Plucker, EPub, Fax"
msgstr "Podržani formati: PDF, PS, TIFF, DjVu, slike, DVI, XPS, FictionBook, stripovi, Plucker, EPUB, faks"

#. (itstool) path: ul/li
#: org.kde.okular.kirigami.appdata.xml:19
msgid "Sidebar with contents, thumbnails, reviews and bookmarks"
msgstr "Bočna traka sa sadržajem, minijaturama, recenzijama i oznakama"

