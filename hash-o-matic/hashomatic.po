#: hashhelper.cpp:66
#, kde-format
msgctxt "@label"
msgid ""
"This file has been signed VS-NfD compliant using the key <a href=\"%1\">%2</"
"a>."
msgstr "Ova je datoteka potpisana ključem <a href=\"%1\">%2</a> u skladu sa zahtjevima VS-NfD."

#: hashhelper.cpp:71
#, kde-format
msgctxt "@label"
msgid "This file has been signed using the key <a href=\"%1\">%2</a>."
msgstr "Ova je datoteka potpisana ključem <a href=\"%1\">%2</a>."

#: hashhelper.cpp:74
#, kde-format
msgctxt "@label"
msgid "The key details are not available."
msgstr "Pojedinosti ključa nisu dostupne."

#: hashhelper.cpp:77
#, kde-format
msgctxt "@label"
msgid "This file has been signed VS-NfD compliant by %1."
msgstr "Datoteku je potpisao %1 u skladu sa zahtjevima VS-NfD."

#: hashhelper.cpp:79
#, kde-format
msgctxt "@label"
msgid "This file has been signed by %1."
msgstr "Datoteku je potpisao %1."

#: hashhelper.cpp:82
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was revoked."
msgstr "<a href=\"%1\">Ključ</a> je opozvan."

#: hashhelper.cpp:85
#, kde-format
msgctxt "@label"
msgid "The <a href=\"%1\">key</a> was expired."
msgstr "<a href=\"%1\">Ključu</a> je istekao rok valjanosti."

#: hashhelper.cpp:89
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid, but the <a href=\"%1\">key</a>'s validity is unknown."
msgstr "Potpis je valjan, ali valjanost <a href=\"%1\">ključa</a> nije poznata."

#: hashhelper.cpp:91
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid and the <a href=\"%1\">key</a> is marginally trusted."
msgstr "Potpis je valjan, a <a href=\"%1\">ključ</a> je marginalno pouzdan."

#: hashhelper.cpp:93
#, kde-format
msgctxt "@label"
msgid "The signature is valid and the <a href=\"%1\">key</a> is fully trusted."
msgstr "Potpis je valjan, a <a href=\"%1\">ključ</a> je potpuno pouzdan."

#: hashhelper.cpp:95
#, kde-format
msgctxt "@label"
msgid ""
"The signature is valid and the <a href=\"%1\">key</a> is ultimately trusted."
msgstr "Potpis je valjan, a <a href=\"%1\">ključ</a> je bezuvjetno pouzdan."

#: hashhelper.cpp:97
#, kde-format
msgctxt "@label"
msgid "The signature is valid, but the <a href=\"%1\">key</a> is untrusted."
msgstr "Potpis je valjan, ali <a href=\"%1\">ključ</a> nije pouzdan."

#: hashhelper.cpp:101
#, kde-format
msgctxt "@label"
msgid "The signature is invalid."
msgstr "Potpis nije valjan."

#: hashhelper.cpp:159
#, kde-format
msgctxt "list separator"
msgid ", "
msgstr ", "

#: hashhelper.cpp:196
#, kde-format
msgid "Hash-o-matic doesn't support directories."
msgstr "Hash-o-matic ne podržava direktorije."

#: hashhelper.cpp:268
#, kde-format
msgid "The file doesn't exist or is not readable."
msgstr "Datoteka ne postoji ili se ne može čitati."

