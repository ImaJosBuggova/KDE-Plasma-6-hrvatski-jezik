msgstr "Odredišna mapa „%1” mora biti mapa lokalnog datotečnog sustava, a ne udaljeni URL"

#: Archiver.cxx:460
#, kde-format
msgid ""
"The target directory '%1' does not exist.\n"
"\n"
"Shall I create it?"
msgstr "Odredišna mapa „%1” ne postoji.\n\nŽelite li je stvoriti?"

