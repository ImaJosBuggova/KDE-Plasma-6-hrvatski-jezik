#, kde-format
msgid ""
"Automatically run the backup with the given profile in the background "
"(without showing a window) and terminate when done."
msgstr "Automatski pokreni sigurnosno kopiranje s navedenim profilom u pozadini (bez prikaza prozora) i zatvori program po završetku."

#: main.cxx:73
#, kde-format
msgid ""
"In autobg mode be verbose and print every single filename during backup."
msgstr "U načinu autobg opširno ispisuj nazive svih datoteka tijekom sigurnosnog kopiranja."

#: main.cxx:76
#, kde-format
msgid ""
"In auto/autobg mode force the backup to be a full backup instead of acting "
"on the profile settings."
msgstr "U načinu auto/autobg prisilno izradi potpunu sigurnosnu kopiju, neovisno o postavkama profila."

