#, kde-format
msgid "-- Backup successfully finished --"
msgstr "-- Sigurnosno kopiranje uspješno je završeno --"

#: Archiver.cxx:669
#, kde-format
msgid ""
"The backup has finished but files were skipped.\n"
"What do you want to do now?"
msgstr "Sigurnosno kopiranje završeno je, ali neke su datoteke preskočene.\nŠto želite učiniti?"

#: Archiver.cxx:671
#, kde-format
msgid ""
"The backup has finished successfully.\n"
"What do you want to do now?"
msgstr "Sigurnosno kopiranje uspješno je završeno.\nŠto želite učiniti?"

#: Archiver.cxx:689
#, kde-format
