#. (itstool) path: component/name
#: org.kde.kbackup.appdata.xml:6
msgid "KBackup"
msgstr "KBackup"

#. (itstool) path: component/summary
#: org.kde.kbackup.appdata.xml:10
msgid "Create backups as .tar files to a local folder or remote URL"
msgstr "Izradite sigurnosne kopije u obliku .tar datoteka u lokalnoj mapi ili na udaljenom URL-u"

#. (itstool) path: description/p
#: org.kde.kbackup.appdata.xml:12
msgid "KBackup is an application which lets you back up your data in a simple, user friendly way"
msgstr "KBackup je aplikacija koja omogućuje jednostavnu izradu sigurnosnih kopija podataka."

#. (itstool) path: description/p
#: org.kde.kbackup.appdata.xml:15
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.kbackup.appdata.xml:17
msgid "Using profile files with definitions for Folders and files to be included or excluded from the backup"
msgstr "Upotreba datoteka profila s definicijama mapa i datoteka koje treba uključiti u sigurnosnu kopiju ili iz nje izostaviti"

#. (itstool) path: ul/li
#: org.kde.kbackup.appdata.xml:18
msgid "The backup target can be either a locally mounted device like a ZIP drive, USB stick, etc. or any remote URL"
msgstr "Odredište sigurnosne kopije može biti lokalno priključen uređaj, primjerice ZIP pogon ili USB memorija, ili bilo koji udaljeni URL"

#. (itstool) path: ul/li
#: org.kde.kbackup.appdata.xml:19
msgid "Running automated backups without using a graphical user interface"
msgstr "Izrada automatiziranih sigurnosnih kopija bez grafičkog sučelja"
