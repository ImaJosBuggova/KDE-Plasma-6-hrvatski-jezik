#: AccessibilityButton.qml:41
#, kde-format
msgctxt "Button to enable/disable screen reader"
msgid "Screen Reader"
msgstr "Čitač zaslona"

#: config.qml:37
#, kde-format
msgid "Background image:"
msgstr "Slika pozadine:"

#: NetworkWidget.qml:24
#, kde-format
msgid "The connection will be active only on the login screen."
msgstr "Veza će biti aktivna samo na zaslonu za prijavu."

#: NetworkWidget.qml:61
#, kde-format
msgid "Disconnect from %1 ?"
msgstr "Prekinuti vezu s mrežom %1?"

#: NetworkWidget.qml:64
#, kde-format
msgid "Abort connecting to %1 ?"
msgstr "Prekinuti povezivanje s mrežom %1?"

#: NetworkWidget.qml:68
#, kde-format
msgid "Connect to %1 ?"
msgstr "Povezati se s mrežom %1?"

#: NetworkWidget.qml:72
#, kde-format
msgid "Connect to an insecure access point %1 ?"
msgstr "Povezati se s nesigurnom pristupnom točkom %1?"

#: NetworkWidget.qml:77
#, kde-format
msgid "Enter the password to connect to %1"
msgstr "Unesite lozinku za povezivanje s mrežom %1"

#: NetworkWidget.qml:82
#, kde-format
msgid "Enter login and password to connect to %1"
msgstr "Unesite korisničko ime i lozinku za povezivanje s mrežom %1"

#: NetworkWidget.qml:86 NetworkWidget.qml:92
#, kde-format
msgid "%1: Connection error, try again."
msgstr "%1: pogreška povezivanja, pokušajte ponovno."

#: NetworkWidget.qml:97
#, kde-format
msgid "Provide the secrets to connect to %1:"
msgstr "Unesite povjerljive podatke za povezivanje s mrežom %1:"

#: NetworkWidget.qml:101
#, kde-format
msgid "The security protocol is not supported for %1"
msgstr "Sigurnosni protokol za %1 nije podržan"

#: NetworkWidget.qml:104 NetworkWidget.qml:108
#, kde-format
msgid "Failed to connect to %1"
msgstr "Povezivanje s mrežom %1 nije uspjelo"

#: NetworkWidget.qml:112
#, kde-format
msgid "Error: Can't find access point %1"
msgstr "Pogreška: nije moguće pronaći pristupnu točku %1"

#: NetworkWidget.qml:440
#, kde-format
msgid "Login"
msgstr "Prijava"

#: NetworkWidget.qml:455
#, kde-format
msgid "Password"
msgstr "Lozinka"

#: NetworkWidget.qml:507
#, kde-format
msgid "Disable wireless"
msgstr "Onemogući bežičnu mrežu"

#: NetworkWidget.qml:507
#, kde-format
msgid "Enable wireless"
msgstr "Omogući bežičnu mrežu"

#: NetworkWidget.qml:508 NetworkWidget.qml:549
#, kde-format
msgid "Action prohibited"
msgstr "Radnja je zabranjena"

#: NetworkWidget.qml:548
#, kde-format
msgid "Disable networking"
msgstr "Onemogući umrežavanje"

#: NetworkWidget.qml:548
#, kde-format
msgid "Enable networking"
msgstr "Omogući umrežavanje"

#: OtherScreen.qml:27
#, kde-format
msgid "Press %1 to change the primary screen"
msgstr "Pritisnite %1 za promjenu primarnog zaslona"

#: PrimaryScreen.qml:64
#, kde-format
msgid "A fallback version of the login screen is running"
msgstr "Pokrenuta je zamjenska verzija zaslona za prijavu"

#: PrimaryScreen.qml:93
#, kde-format
msgid "Login failed"
msgstr "Prijava nije uspjela"

#: PrimaryScreen.qml:563
#, kde-format
msgid "Caps Lock is on"
msgstr "Caps Lock je uključen"

#: PrimaryScreen.qml:566
#, kde-format
msgid "Num Lock is on"
msgstr "Num Lock je uključen"

#: PrimaryScreen.qml:569
#, kde-format
msgid "Caps Lock and Num Lock is on"
msgstr "Caps Lock i Num Lock su uključeni"

#: PrimaryScreen.qml:582
#, kde-format
msgid "Log in"
msgstr "Prijavi se"

#: PrimaryScreen.qml:601
#, kde-format
msgid "Log in as another user"
msgstr "Prijavi se kao drugi korisnik"

#: PrimaryScreen.qml:794
#, kde-format
msgid "Keyboard layout"
msgstr "Raspored tipkovnice"

#: PrimaryScreen.qml:839
#, kde-format
msgid "Desktop session"
msgstr "Sesija radne površine"

#: PrimaryScreen.qml:866
#, kde-format
msgid "Suspend"
msgstr "Obustavi"

#: PrimaryScreen.qml:878
#, kde-format
msgid "Hibernate"
msgstr "Hiberniraj"

#: PrimaryScreen.qml:891
#, kde-format
msgid "Restart"
msgstr "Ponovno pokreni"

#: PrimaryScreen.qml:903
#, kde-format
msgid "Shutdown"
msgstr "Isključi"

#: PrimaryScreen.qml:940
#, kde-format
msgctxt "Button to show/hide accessibility menu"
msgid "Accessibility"
msgstr "Pristupačnost"

#: PrimaryScreen.qml:950
#, kde-format
msgctxt "Button to show/hide virtual keyboard"
msgid "Virtual Keyboard"
msgstr "Virtualna tipkovnica"
