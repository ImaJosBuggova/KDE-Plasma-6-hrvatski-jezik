#: faces/systemmonitor-faces.knsrc:2
msgctxt "Name"
msgid "System monitor Sensor Display Styles"
msgstr "Stilovi prikaza senzora nadzora sustava"

#: faces/systemmonitor-presets.knsrc:2
msgctxt "Name"
msgid "System monitor Sensor Presets"
msgstr "Predlošci senzora nadzora sustava"

#: processcore/actions.actions:2
msgctxt "Name"
msgid "KSysGuard"
msgstr "KSysGuard"

#: processcore/actions.actions:81
msgctxt "Name"
msgid "Kill or stop etc a process"
msgstr "Uništi, zaustavi ili učini nešto drugo s procesom"

#: processcore/actions.actions:147
msgctxt "Description"
msgid "Sends a given signal to a given process"
msgstr "Šalje zadani signal određenom procesu"

#: processcore/actions.actions:217
msgctxt "Name"
msgid "Change the priority of a process"
msgstr "Promijeni prioritet procesa"

#: processcore/actions.actions:285
msgctxt "Description"
msgid "Change the niceness of a given process"
msgstr "Promijeni prioritet (niceness) zadanog procesa"

#: processcore/actions.actions:354
msgctxt "Name"
msgid "Change IO Scheduler and priority"
msgstr "Promijeni IO raspoređivač i prioritet"

#: processcore/actions.actions:419
msgctxt "Description"
msgid "Change how the read and writes of a given process are prioritized"
msgstr "Promijeni način na koji se određuje prioritet čitanja i pisanja zadanog procesa"

#: processcore/actions.actions:486
msgctxt "Name"
msgid "Change CPU Scheduler and priority"
msgstr "Promijeni CPU raspoređivač i prioritet"

#: processcore/actions.actions:551
msgctxt "Description"
msgid ""
"Change which CPU scheduler is to schedule the running of a given process"
msgstr ""
"Promijeni koji će CPU raspoređivač raspoređivati izvršavanje zadanog procesa"

#: processcore/actions.actions:620
msgctxt "Name"
msgid "Change process scheduling"
msgstr "Promijeni raspoređivanje procesa"

#: processcore/actions.actions:650
msgctxt "Description"
msgid ""
"Change the niceness, CPU scheduler and IO scheduler of a given process in "
"one operation"
msgstr ""
"Promijeni prioritet (niceness), CPU raspoređivač i IO raspoređivač zadanog "
"procesa u jednoj operaciji"