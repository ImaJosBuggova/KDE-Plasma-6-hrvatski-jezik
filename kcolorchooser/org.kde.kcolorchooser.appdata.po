#. (itstool) path: component/name
#: org.kde.kcolorchooser.appdata.xml:9
msgid "KColorChooser"
msgstr "KColorChooser"

#. (itstool) path: component/summary
#: org.kde.kcolorchooser.appdata.xml:10
msgid "Color selector and palette editor"
msgstr "Alat za odabir boja i uređivanje paleta"

#. (itstool) path: description/p
#: org.kde.kcolorchooser.appdata.xml:12
msgid "KColorChooser is a color palette tool, used to mix colors and create custom color palettes. Using the dropper, it can obtain the color of any pixel on the screen. A number of common color palettes are included, such as the standard Web colors and the Oxygen color scheme."
msgstr "KColorChooser je alat za rad s paletama boja koji služi za miješanje boja i izradu prilagođenih paleta. Pomoću kapaljke može dohvatiti boju bilo kojeg piksela na zaslonu. Uključuje niz uobičajenih paleta boja, primjerice standardne web-boje i shemu boja Oxygen."
