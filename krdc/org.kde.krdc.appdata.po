#. (itstool) path: component/summary
#: org.kde.krdc.appdata.xml:5
msgid "Connect with RDP or VNC to another computer"
msgstr "Povežite se s drugim računalom putem RDP-a ili VNC-a"

#. (itstool) path: description/p
#: org.kde.krdc.appdata.xml:11
msgid "KRDC is a client application that allows you to view or even control the desktop session on another machine that is running a compatible server. VNC and RDP is supported."
msgstr "KRDC je klijentska aplikacija koja omogućuje pregled ili upravljanje sesijom radne površine na drugom računalu na kojem je pokrenut kompatibilan poslužitelj. Podržani su VNC i RDP."
