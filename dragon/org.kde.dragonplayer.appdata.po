#. (itstool) path: component/name
#: org.kde.dragonplayer.appdata.xml:9
msgid "Dragon Player"
msgstr "Dragon Player"

#. (itstool) path: component/summary
#: org.kde.dragonplayer.appdata.xml:10
msgid "Play video files and streams"
msgstr "Reproducirajte videodatoteke i streamove"

#. (itstool) path: description/p
#: org.kde.dragonplayer.appdata.xml:12
msgid "Dragon Player is a video player focusing on simplicity instead of features. Its easy-to-use interface is designed to get out of your way and simply play your video files and streams."
msgstr "Dragon Player videoreproduktor je usmjeren na jednostavnost, a ne na mnoštvo značajki. Sučelje jednostavno za korištenje ne smeta vam pri radu, već jednostavno reproducira vaše videodatoteke i streamove."

#. (itstool) path: description/p
#: org.kde.dragonplayer.appdata.xml:15
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:17
msgid "Click to play or pause, and double-click to enter or exit full screen mode."
msgstr "Kliknite za reprodukciju ili pauziranje, a dvaput kliknite za ulazak u cijeli zaslon ili izlazak iz njega."

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:18
msgid "Choose the subtitle language, and automatically load the right one for your language, if possible."
msgstr "Odaberite jezik titlova i, ako je moguće, automatski učitajte titlove na svojem jeziku."

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:19
msgid "Choose the audio track."
msgstr "Odaberite zvučni zapis."

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:20
msgid "Choose the video track."
msgstr "Odaberite vide zapis."

#. (itstool) path: ul/li
#: org.kde.dragonplayer.appdata.xml:21
msgid "Adjust the volume by scrolling."
msgstr "Prilagodite glasnoću pomicanjem kotačića."
