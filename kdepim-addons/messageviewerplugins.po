#: externalscriptplugin/configuredialog/viewerpluginexternaleditwidget.cpp:48
#, kde-format
msgid ""
"<qt><p><strong>These expressions may be used for the arguments:</strong></"
"p><ul><li>%s - the subject of message</li><li>%from - the from email "
"address</li><li>%cc - the list of cc email address</li><li>%bcc - the list "
"of bcc email address</li><li>%body - the body of message</li><li>%inreplyto "
"- the reply email address</li><li>%akonadiUrl - the akonadi url (as akonadi:?"
"item=187020)</li></ul></qt>"
msgstr "<qt><p><strong>These expressions možda biti koriste za argumenti:</strong></p><ul><li>%s - the predmet od message</li><li>%from - the iz e-pošta address</li><li>%cc - the popis od kopija e-pošta address</li><li>%bcc - the popis od skrivena kopija e-pošta address</li><li>%body - the tijelo od message</li><li>%inreplyto - the odgovor e-pošta address</li><li>%akonadiUrl - the akonadi URL (kao akonadi:?stavka=187020)</li></ul></qt>"

