#, kde-format
msgid "Circle by Center && Line"
msgstr ""
"Krug po centru && Linija"

#, kde-format
msgid "A circle constructed by its center and tangent to a given line"
msgstr ""
"A kružnica konstruirana svojim središtem i tangentom na danu liniju"

#, kde-format
msgid "Construct a circle tangent to this line"
msgstr ""
"Konstruirajte kružnicu tangentu na ovu liniju"

#, kde-format
msgid "Select the line that the new circle should be tangent to..."
msgstr ""
"Odaberite liniju na koju bi nova kružnica trebala tangentirati..."

#, kde-format
msgid "Circle by Point && Segment (as the Diameter)"
msgstr ""
"Kružnica po točki && segment (kao Promjer)"

#, kde-format
msgid ""
"A circle defined by its center and the length of a segment as the diameter"
msgstr ""
"A krug definiran svojim središtem i duljinom segmenta kao promjerom"

#, kde-format
msgid ""
"Construct a circle with the diameter given by the length of this segment"
msgstr ""
"Konstruirajte krug s promjerom zadanim duljinom ovog segmenta"

#, kde-format
msgid "Select the segment whose length gives the diameter of the new circle..."
msgstr ""
"Odaberite segment čija duljina daje promjer novog kruga..."

#, kde-format
msgid "Equilateral Triangle"
msgstr ""
"Jednakostranični trokut"

#, kde-format
msgid "Equilateral triangle with given two vertices"
msgstr ""
"Jednakostranični trokut sa zadana dva vrhovi"

#, kde-format
msgid "Evolute"
msgstr ""
"Evolute"

#, kde-format
msgid "Evolute of a curve"
msgstr ""
"Evolute krivulje"

#, kde-format
msgid "Evolute of this curve"
msgstr ""
"Evolute ove krivulje"

#, kde-format
msgid "Osculating Circle"
msgstr ""
"Oskulirajući krug"

#, kde-format
msgid "Osculating circle of a curve at a point"
msgstr ""
"Oskulirajući krug krivulje u točki"

#, kde-format
msgid "Osculating circle of this curve"
msgstr ""
"Oskulirajući krug ovog krivulja"

#, kde-format
msgid "Osculating circle at this point"
msgstr ""
"Oskulirajuća kružnica u ovoj točki"

#, kde-format
msgid "Select the point..."
msgstr ""
"Odaberite točku..."

#, kde-format
msgid "Square"
msgstr ""
"Kvadrat"

#, kde-format
msgid "Square with two given adjacent vertices"
msgstr ""
"Kvadrat s dva zadana susjedna vrha"

#, kde-format
msgid "Vector Difference"
msgstr ""
"Vektorska razlika"

#, kde-format
msgid "Construct the vector difference of two vectors."
msgstr ""
"Konstruirajte vektorsku razliku dva vektora."

#, kde-format
msgid "Construct the vector difference of this vector and another one."
msgstr ""
"Konstruirajte vektorsku razliku ovog i drugog vektora."

#, kde-format
msgid "Construct the vector difference of the other vector and this one."
msgstr ""
"Konstruirajte vektorsku razliku drugog vektora i ovog."

#, kde-format
msgid "Construct the vector difference starting at this point."
msgstr ""
"Konstruirajte vektorsku razliku počevši od ove točke."

#, kde-format
msgid ""
"Select the first of the two vectors of which you want to construct the "
"difference..."
msgstr ""
"Odaberite prvi od dva vektora čija razlika želite konstruirati..."

#, kde-format
msgid ""
"Select the other of the two vectors of which you want to construct the "
"difference..."
msgstr ""
"Odaberite drugi od dva vektora od kojih želite konstruirati razliku..."

#, kde-format
msgid "Select the point to construct the difference vector in..."
msgstr ""
"Odaberite točku za konstruiranje vektora razlike u..."

