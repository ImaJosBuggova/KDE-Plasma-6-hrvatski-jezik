#. (itstool) path: component/name
#: org.kde.juk.metainfo.xml:7
msgid "JuK"
msgstr "JuK"

#. (itstool) path: component/summary
#: org.kde.juk.metainfo.xml:9
msgid "Music Player"
msgstr "Glazbeni reproduktor"

#. (itstool) path: description/p
#: org.kde.juk.metainfo.xml:11
msgid "JuK is an audio jukebox application, supporting collections of MP3, Ogg Vorbis, and FLAC audio files. It allows you to edit the \"tags\" of your audio files, and manage your collection and playlists. Its main focus, in fact, is on music management."
msgstr "JuK je aplikacija za reprodukciju i upravljanje glazbom koja podržava zbirke audiodatoteka u formatima MP3, Ogg Vorbis i FLAC. Omogućuje uređivanje „oznaka” audiodatoteka te upravljanje zbirkom i popisima za reprodukciju. Glavna mu je namjena upravo upravljanje glazbom."

#. (itstool) path: description/p
#: org.kde.juk.metainfo.xml:12
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:14
msgid "Collection list and multiple user defined playlists"
msgstr "Popis zbirke i više korisnički definiranih popisa za reprodukciju"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:15
msgid "Ability to scan directories to automatically import playlists and music files on start up"
msgstr "Mogućnost skeniranja mapa radi automatskog uvoza popisa za reprodukciju i glazbenih datoteka pri pokretanju"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:16
msgid "Dynamic Search Playlists that are automatically updated as fields in the collection change"
msgstr "Dinamički popisi za pretraživanje koji se automatski ažuriraju pri promjeni polja u zbirci"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:17
msgid "A Tree View mode where playlists are automatically generated for sets of albums, artists and genres"
msgstr "Stablasta struktura prikaza u kojoj se popisi za reprodukciju automatski stvaraju za skupove albuma, izvođača i žanrova"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:18
msgid "Playlist history to indicate which files have been played and when"
msgstr "Povijest popisa za reprodukciju koja prikazuje koje su datoteke reproducirane i kada"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:19
msgid "Inline search for filtering the list of visible items"
msgstr "Ugrađeno pretraživanje za filtriranje popisa vidljivih stavki"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:20
msgid "The ability to guess tag information based on the track's file name"
msgstr "Mogućnost prepoznavanja podataka oznaka na temelju naziva datoteke pjesme"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:21
msgid "File renamer that can rename files based on the tag content"
msgstr "Preimenovanje datoteka prema sadržaju oznaka"

#. (itstool) path: ul/li
#: org.kde.juk.metainfo.xml:22
msgid "Tag reading and editing support for many formats including ID3v1, ID3v2 and Ogg Vorbis"
msgstr "Podrška za čitanje i uređivanje oznaka u mnogim formatima, uključujući ID3v1, ID3v2 i Ogg Vorbis"