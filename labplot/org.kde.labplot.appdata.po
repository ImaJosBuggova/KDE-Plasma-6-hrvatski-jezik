#: org.kde.labplot.appdata.xml:14
msgid "LabPlot"
msgstr "LabPlot"

#. (itstool) path: component/summary
#: org.kde.labplot.appdata.xml:15
msgid "Visualize and analyze data"
msgstr "Vizualizirajte i analizirajte podatke"

#. (itstool) path: description/p
#: org.kde.labplot.appdata.xml:17
msgid "LabPlot is a FREE, open source and cross-platform Data Visualization and Analysis software accessible to everyone."
msgstr "LabPlot je besplatan, otvorenog koda i višeplatformski softver za vizualizaciju i analizu podataka dostupan svima."

#. (itstool) path: description/p
#: org.kde.labplot.appdata.xml:20
msgid "LabPlot provides an easy way to create, manage and edit plots. It allows you to produce plots based on data from a spreadsheet or on data imported from external files. Plots can be exported to several pixmap and vector graphic formats."
msgstr "LabPlot omogućuje jednostavno stvaranje, upravljanje i uređivanje grafova. Omogućuje izradu grafova na temelju podataka iz proračunske tablice ili uvezenih iz vanjskih datoteka. Grafove je moguće izvesti u nekoliko rasterskih i vektorskih grafičkih formata."

