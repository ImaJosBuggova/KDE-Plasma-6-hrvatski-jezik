#: mdn.cpp:53
msgctxt "DispositionModifier|"
msgid "The message sent on ${date} to ${to} with subject \"${subject}\" has been displayed. This is no guarantee that the message has been read or understood."
msgstr "Poruka poslana ${date} primatelju ${to} s predmetom „${subject}” prikazana je. To ne jamči da je poruka pročitana ili shvaćena."

#: mdn.cpp:60
msgctxt "DispositionModifier|"
msgid "The message sent on ${date} to ${to} with subject \"${subject}\" has been deleted unseen. This is no guarantee that the message will not be \"undeleted\" and nonetheless read later on."
msgstr "Poruka poslana ${date} primatelju ${to} s predmetom „${subject}” izbrisana je nepročitana. To ne jamči da kasnije neće biti vraćena i pročitana."

#: mdn.cpp:68
msgctxt "DispositionModifier|"
msgid "The message sent on ${date} to ${to} with subject \"${subject}\" has been dispatched. This is no guarantee that the message will not be read later on."
msgstr "Poruka poslana ${date} primatelju ${to} s predmetom „${subject}” otpremljena je. To ne jamči da neće biti pročitana kasnije."

#: mdn.cpp:75
msgctxt "DispositionModifier|"
msgid "The message sent on ${date} to ${to} with subject \"${subject}\" has been processed by some automatic means."
msgstr "Poruka poslana ${date} primatelju ${to} s predmetom „${subject}” obrađena je automatskim postupkom."

#: mdn.cpp:81
msgctxt "DispositionModifier|"
msgid "The message sent on ${date} to ${to} with subject \"${subject}\" has been acted upon. The sender does not wish to disclose more details to you than that."
msgstr "Poduzeta je radnja s porukom poslanom ${date} primatelju ${to} s predmetom „${subject}”. Pošiljatelj ne želi otkriti dodatne pojedinosti."

#: mdn.cpp:88
msgctxt "DispositionModifier|"
msgid "Generation of a Message Disposition Notification for the message sent on ${date} to ${to} with subject \"${subject}\" failed. Reason is given in the Failure: header field below."
msgstr "Stvaranje obavijesti o postupanju s porukom poslanom ${date} primatelju ${to} s predmetom „${subject}” nije uspjelo. Razlog je naveden u polju zaglavlja Failure u nastavku."

