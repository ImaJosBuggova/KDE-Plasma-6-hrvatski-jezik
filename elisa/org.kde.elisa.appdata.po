#. (itstool) path: component/name
#: org.kde.elisa.appdata.xml:15
msgid "Elisa"
msgstr "Elisa"

#. (itstool) path: component/summary
#: org.kde.elisa.appdata.xml:16
msgid "Play local music and listen to online radio"
msgstr "Reproducirajte lokalnu glazbu i slušajte internetski radio"

#. (itstool) path: description/p
#: org.kde.elisa.appdata.xml:18
msgid "The Elisa music player is developed by the KDE community and strives to be simple and pleasant to use."
msgstr "Glazbeni reproduktor Elisa razvija zajednica KDE-a s ciljem da bude jednostavan i ugodan za korištenje."

#. (itstool) path: description/p
#: org.kde.elisa.appdata.xml:19
msgid "With Elisa, you can browse your local music collection by genre, artist, album, or track, listen to online radio, create and manage playlists, display lyrics, and more."
msgstr "Uz Elisu možete pregledavati svoju lokalnu zbirku glazbe prema žanru, izvođaču, albumu ili pjesmi, slušati internetski radio, izrađivati popise izvođenja i upravljati njima, prikazivati tekstove pjesama i još mnogo toga."

#. (itstool) path: description/p
#: org.kde.elisa.appdata.xml:20
msgid "Elisa supports your full KDE color scheme when used on the Plasma desktop, or else the standard light and dark modes."
msgstr "Kada se koristi na radnoj površini Plasma, Elisa podržava cijelu KDE-ovu shemu boja; u suprotnom su dostupni standardni svijetli i tamni način."

#. (itstool) path: description/p
#: org.kde.elisa.appdata.xml:21
msgid "Chill out with Party Mode, which puts your music's album art front and center."
msgstr "Opustite se uz način za zabavu koji stavlja omot albuma vaše glazbe u prvi plan."

#. (itstool) path: screenshot/caption
#: org.kde.elisa.appdata.xml:29
msgid "The Elisa music player"
msgstr "Glazbeni reproduktor Elisa"

