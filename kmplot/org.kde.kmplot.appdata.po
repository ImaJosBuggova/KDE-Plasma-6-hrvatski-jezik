#. (itstool) path: component/name
#: org.kde.kmplot.appdata.xml:10
msgid "KmPlot"
msgstr "KmPlot"

#. (itstool) path: component/summary
#: org.kde.kmplot.appdata.xml:11
msgid "Mathematical Function Plotter"
msgstr "Crtanje grafova matematičkih funkcija"

#. (itstool) path: description/p
#: org.kde.kmplot.appdata.xml:13
msgid "KmPlot is a program to plot graphs of functions, their integrals or derivatives. The graphs can be colorized and the view is highly configurable, is scalable, and can be zoomed. The program features a powerful mathematical parser, different plot types (cartesian, parametric, polar, implicit, differential), and provides simple mathematical tools like for finding maximum/minimum of a function. Parametrized functions can be visualized by adjusting the variable parameter via a slider. Plots can be exported as bitmap format pictures (BMP, PNG) and can be printed."
msgstr "KmPlot je program za crtanje grafova funkcija, njihovih integrala i derivacija. Grafovi mogu biti u boji, a prikaz je vrlo prilagodljiv, može se skalirati i zumirati. Program nudi snažan matematički parser, različite vrste grafova (Kartezijeve, parametarske, polarne, implicitne i diferencijalne) te jednostavne matematičke alate, primjerice za pronalaženje minimuma i maksimuma funkcije. Parametrizirane funkcije mogu se prikazati postavljanjem varijabilnog parametra klizačem. Grafovi se mogu izvesti kao rasterske slike (BMP, PNG) i ispisati."

#. (itstool) path: screenshot/caption
#: org.kde.kmplot.appdata.xml:24
msgid "Quadratic function, its derivative and integral plotted with KmPlot"
msgstr "Kvadratna funkcija, njezina derivacija i integral prikazani grafom u programu KmPlot"
