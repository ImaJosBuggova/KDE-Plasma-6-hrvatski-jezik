#. (itstool) path: component/summary
#: org.kde.krename.appdata.xml:10
msgid "A powerful batch file renamer"
msgstr "Moćan alat za skupno preimenovanje datoteka"

#. (itstool) path: description/p
#: org.kde.krename.appdata.xml:12
msgid "KRename is a very powerful batch file renamer which can rename a list of files based on a set of expressions. It can copy/move the files to another directory or simply rename the input files. KRename supports many conversion operations."
msgstr "KRename je vrlo moćan alat za skupno preimenovanje datoteka koji može preimenovati popis datoteka na temelju skupa izraza. Može kopirati/premjestiti datoteke u drugi direktorij ili jednostavno preimenovati ulazne datoteke. KRename podržava mnoge operacije pretvorbe."
