#, kde-format
msgid "%1 error occurred."
msgid_plural "%1 errors occurred."
msgstr[0] "Dogodila se %1 pogreška."
msgstr[1] "Dogodile su se %1 pogreške."
msgstr[2] "Dogodilo se %1 pogrešaka."

