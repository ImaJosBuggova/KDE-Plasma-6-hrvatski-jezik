msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kapptemplate.appdata.xml:18
msgid "Templates for C++, Ruby, Python and PHP"
msgstr "Predlošci za C++, Ruby, Python i PHP"

#. (itstool) path: ul/li
#: org.kde.kapptemplate.appdata.xml:19
msgid "Categories"
msgstr "Kategorije"

#. (itstool) path: ul/li
#: org.kde.kapptemplate.appdata.xml:20
msgid "Templates for different build-systems and frameworks"
msgstr "Predlošci za različite sustave izgradnje i radne okvire"

#. (itstool) path: ul/li
#: org.kde.kapptemplate.appdata.xml:21
msgid "Templates especially for KDE-development (plugins for Plasma, QtQuick, KTextEditor, KRunner, Akonadi)"
msgstr "Predlošci posebno namijenjeni razvoju za KDE (dodaci za Plasma, QtQuick, KTextEditor, KRunner i Akonadi)"

#. (itstool) path: ul/li
#: org.kde.kapptemplate.appdata.xml:22
