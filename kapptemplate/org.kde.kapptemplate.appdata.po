msgid "KAppTemplate"
msgstr "KAppTemplate"

#. (itstool) path: component/summary
#: org.kde.kapptemplate.appdata.xml:10
msgid "App Code Template Generator"
msgstr "Generator predložaka koda aplikacija"

#. (itstool) path: description/p
#: org.kde.kapptemplate.appdata.xml:12
msgid "KAppTemplate is an application to start development quickly using existing templates providing basic repeatedly written code and a proper structure."
msgstr "KAppTemplate je aplikacija koja omogućuje brz početak razvoja korištenjem postojećih predložaka s osnovnim kodom koji se često iznova piše i odgovarajućom strukturom."

#. (itstool) path: description/p
