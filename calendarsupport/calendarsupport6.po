#: archivedialog.cpp:42
#, kde-format
msgctxt "@title:window"
msgid "Archive/Delete Past Events and To-dos"
msgstr "Arhiviraj/izbriši prošle događaje i zadatke"

#: archivedialog.cpp:49
#, kde-format
msgctxt "@action:button"
msgid "&Archive"
msgstr "&Arhiva"

#: archivedialog.cpp:61
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid "Archiving saves old items into the given file and then deletes them in the current calendar. If the archive file already exists they will be added. (<link url=\"#\">How to restore</link>)"
msgstr "Arhiviranjem se stare stavke spremaju u navedenu datoteku, a zatim brišu iz trenutačnog kalendara. Ako arhivska datoteka već postoji, stavke se dodaju u nju. (<link url=\"#\">Kako vratiti arhivu</link>)"

#: archivedialog.cpp:66
#, kde-format
msgctxt "@info:whatsthis"
msgid "In order to add an archive to your calendar, use the Merge Calendar function. You can view an archive by opening it like you would any other calendar. It is not saved in a special format, but as vCalendar."
msgstr "Za dodavanje arhive u kalendar upotrijebite funkciju spajanja kalendara. Arhivu možete pregledati tako da je otvorite kao bilo koji drugi kalendar. Sprema se u formatu vCalendar, a ne u posebnom formatu."

#: archivedialog.cpp:81
#, kde-format
msgctxt "@option:radio"
msgid "Archive now items older than:"
msgstr "Arhiviraj stavke starije od:"

#: archivedialog.cpp:82
#, kde-format
msgctxt "@info:tooltip"
msgid "Enable one time archiving or purging of older items"
msgstr "Omogući jednokratno arhiviranje ili uklanjanje starih stavki"

#: archivedialog.cpp:84
#, kde-format
msgctxt "@info:whatsthis"
msgid "If you check this box, events and to-dos older than the specified age will be archived or purged. The items will be archived unless the \"Delete only\" option is enabled; else the items will be purged and not saved."
msgstr "Ako označite ovu kućicu, događaji i zadaci stariji od navedenog razdoblja bit će arhivirani ili uklonjeni. Stavke će se arhivirati, osim ako je omogućena opcija „Samo izbriši”; u tom će se slučaju ukloniti bez spremanja."

#: archivedialog.cpp:92
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the one time archiving cut-off date"
msgstr "Postavi datum granice za jednokratno arhiviranje"

#: archivedialog.cpp:94
#, kde-format
msgctxt "@info:whatsthis"
msgid "The date before which items should be archived. All older events and to-dos will be saved and deleted, the newer (and events exactly on that date) will be kept."
msgstr "Stavke prije ovog datuma treba arhivirati. Stariji događaji i zadaci bit će spremljeni i izbrisani, a noviji (kao i događaji na sam datum) bit će zadržani."

#: archivedialog.cpp:106
#, kde-format
msgctxt "@option:radio"
msgid "Automaticall&y archive items older than:"
msgstr "&Automatski arhiviraj stavke starije od:"

#: archivedialog.cpp:107
#, kde-format
msgctxt "@info:tooltip"
msgid "Enable automatic archiving or purging of older items"
msgstr "Omogući automatsko arhiviranje ili uklanjanje starih stavki"

#: archivedialog.cpp:109
#, kde-format
msgctxt "@info:whatsthis"
msgid "If this feature is enabled, the application will regularly check if events and to-dos have to be archived; this means you will not need to use this dialog box again, except to change the settings."
msgstr "Ako je ova značajka omogućena, aplikacija će redovito provjeravati treba li arhivirati događaje i zadatke. Ovaj dijaloški okvir ponovno ćete morati otvoriti samo radi promjene postavki."

#: archivedialog.cpp:122
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the archival age in days, weeks or months"
msgstr "Postavi starost za arhiviranje u danima, tjednima ili mjesecima"

#: archivedialog.cpp:124
#, kde-format
msgctxt "@info:whatsthis"
msgid "The age of the events and to-dos to archive. All older items will be saved and deleted, the newer will be kept."
msgstr "Starost događaja i zadataka koje treba arhivirati. Starije stavke bit će spremljene i izbrisane, a novije zadržane."

#: archivedialog.cpp:129
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the units for the automatic archive age"
msgstr "Postavi jedinice za automatsko arhiviranje prema starosti"

#: archivedialog.cpp:130
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select the time units (days, weeks or months) for automatic archiving."
msgstr "Odaberite vremenske jedinice (dani, tjedni ili mjeseci) za automatsko arhiviranje."

#: archivedialog.cpp:132
#, kde-format
msgctxt "@item:inlistbox expires in daily units"
msgid "Day(s)"
msgstr "Dan(i)"

#: archivedialog.cpp:133
#, kde-format
msgctxt "@item:inlistbox expiration in weekly units"
msgid "Week(s)"
msgstr "Tjedan(ni)"

#: archivedialog.cpp:134
#, kde-format
msgctxt "@item:inlistbox expiration in monthly units"
msgid "Month(s)"
msgstr "Mjesec(i)"

#: archivedialog.cpp:139
#, kde-format
msgctxt "@label"
msgid "Archive &file:"
msgstr "Arhivska &datoteka:"

#: archivedialog.cpp:143
#, kde-format
msgctxt "@label filter for KUrlRequester"
msgid "iCalendar Files (*.ics)"
msgstr "iCalendar datoteke (*.ics)"

#: archivedialog.cpp:144
#, kde-format
msgctxt "@info:tooltip"
msgid "Set the location of the archive"
msgstr "Postavi lokaciju arhive"

#: archivedialog.cpp:146
#, kde-format
msgctxt "@info:whatsthis"
msgid "The path of the archive file. The events and to-dos will be appended to the specified file, so any events that are already in the file will not be modified or deleted. You can later load or merge the file like any other calendar. It is not saved in a special format, it uses the iCalendar format."
msgstr "Putanja arhivske datoteke. Događaji i zadaci dodat će se u navedenu datoteku, a postojeći događaji neće se mijenjati ni brisati. Datoteku možete kasnije učitati ili spojiti kao bilo koji drugi kalendar. Sprema se u formatu iCalendar, a ne u posebnom formatu."

#: archivedialog.cpp:155
#, kde-format
msgctxt "@title:group"
msgid "Type of Items to Archive"
msgstr "Vrsta stavki za arhiviranje"

#: archivedialog.cpp:157
#, kde-format
msgctxt "@info:whatsthis"
msgid "Here you can select which items should be archived. Events are archived if they ended before the date given above; to-dos are archived if they were finished before the date."
msgstr "Ovdje možete odabrati stavke za arhiviranje. Događaji se arhiviraju ako su završili prije navedenog datuma, a zadaci ako su dovršeni prije njega."

#: archivedialog.cpp:165
#, kde-format
msgctxt "@option:check"
msgid "Archive &Events"
msgstr "Arhiviraj &događaje"

#: archivedialog.cpp:166
#, kde-format
msgctxt "@option:check"
msgid "Archive or purge events"
msgstr "Arhiviraj ili ukloni događaje"

#: archivedialog.cpp:167
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to archive events if they ended before the date given above."
msgstr "Odaberite ovu opciju za arhiviranje događaja koji su završili prije navedenog datuma."

#: archivedialog.cpp:170
#, kde-format
msgctxt "@option:check"
msgid "Archive Completed &To-dos"
msgstr "Arhiviraj dovršene &zadatke"

#: archivedialog.cpp:171
#, kde-format
msgctxt "@option:check"
msgid "Archive or purge completed to-dos"
msgstr "Arhiviraj ili ukloni dovršene zadatke"

#: archivedialog.cpp:173
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to archive to-dos if they were completed before the date given above."
msgstr "Odaberite ovu opciju za arhiviranje zadataka dovršenih prije navedenog datuma."

#: archivedialog.cpp:177
#, kde-format
msgctxt "@option:check"
msgid "&Delete only, do not save"
msgstr "Samo &izbriši, nemoj spremati"

#: archivedialog.cpp:178
#, kde-format
msgctxt "@info:tooltip"
msgid "Purge the old items without saving them"
msgstr "Ukloni stare stavke bez spremanja"

#: archivedialog.cpp:180
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to delete old events and to-dos without saving them. It is not possible to recover the events later."
msgstr "Odaberite ovu opciju za brisanje starih događaja i zadataka bez spremanja. Događaje nakon toga nije moguće vratiti."

#: archivedialog.cpp:241
#, kde-format
msgctxt "@info"
msgid "The archive file name is not valid."
msgstr "Naziv arhivske datoteke nije valjan."

