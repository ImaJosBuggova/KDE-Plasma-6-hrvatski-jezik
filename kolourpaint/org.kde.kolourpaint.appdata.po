msgid "KolourPaint"
msgstr "KolourPaint"

#. (itstool) path: component/summary
#: org.kde.kolourpaint.appdata.xml:11
msgid "Paint Program"
msgstr "Program za crtanje"

#. (itstool) path: description/p
#: org.kde.kolourpaint.appdata.xml:13
msgid "KolourPaint is a simple painting program to quickly create raster images. It is useful as a touch-up tool and for simple image editing tasks."
msgstr "KolourPaint je jednostavan program za crtanje za brzo stvaranje rasterskih slika. Koristan je za retuširanje i jednostavne zadatke uređivanja slika."

#. (itstool) path: description/p
