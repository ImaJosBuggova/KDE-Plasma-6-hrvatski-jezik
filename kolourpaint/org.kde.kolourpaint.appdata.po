msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:19
msgid "Support for drawing various shapes - lines, rectangles, rounded rectangles, ovals and polygons"
msgstr "Podrška za crtanje raznih oblika – crta, pravokutnika, zaobljenih pravokutnika, ovala i mnogokuta"

#. (itstool) path: ul/li
#: org.kde.kolourpaint.appdata.xml:20
