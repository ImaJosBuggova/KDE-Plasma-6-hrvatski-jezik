msgstr "Izbrisati prijavljenog korisnika bez brisanja datoteka?"

#: src/ui/UserDetailsPage.qml:115
#, kde-format
msgctxt "@title:window"
msgid "Delete Logged-In User?"
msgstr "Izbrisati prijavljenog korisnika?"

#: src/ui/UserDetailsPage.qml:117
#, kde-kuit-format
msgctxt "@info:usagetip"
msgid ""
"%1 is currently logged in, so their files cannot be deleted. Delete just the "
"account instead?<nl/><nl/>This will make %1 unable to log in again, and they "
"may experience strange behaviors until they log out."
msgstr ""
"Korisnik %1 trenutačno je prijavljen pa se njegove datoteke ne mogu "
"izbrisati. Želite li umjesto toga izbrisati samo račun?<nl/><nl/>Korisnik %1 "
"nakon toga više se neće moći prijaviti i može imati neobično ponašanje dok "
"se ne odjavi."

#: src/ui/UserDetailsPage.qml:118
#, kde-format
msgctxt "@info:usagetip"
msgid ""
"%1 is currently logged in. Deleting the account will make them unable to log "
"in again, and they may experience strange behaviors until they log out."
msgstr ""
"Korisnik %1 trenutačno je prijavljen. Brisanjem računa više se neće moći "
"prijaviti i može imati neobično ponašanje dok se ne odjavi."

#: src/ui/UserDetailsPage.qml:125
#, kde-format
msgctxt "@action: button"
msgid "Delete %1"
msgstr "Izbriši %1"

#: src/ui/UserDetailsPage.qml:144
#, kde-format
msgid "Change avatar"
msgstr "Promijeni avatar"

#: src/ui/UserDetailsPage.qml:185
#, kde-format
msgctxt "@label:tooltip"
msgid ""
"Cannot change your own username while logged in; log out and then log in as "
"another user to change this account’s username."
msgstr ""
"Ne možete promijeniti vlastito korisničko ime dok ste prijavljeni. Odjavite "
"se, a zatim se prijavite kao drugi korisnik da biste promijenili korisničko "
"ime ovog računa."

#: src/ui/UserDetailsPage.qml:186
#, kde-format
msgctxt "@label:tooltip"
msgid ""
"Cannot change the username of a logged-in user; wait until this user logs "
"out first."
msgstr ""
"Ne možete promijeniti korisničko ime prijavljenog korisnika. Pričekajte da "
"se taj korisnik najprije odjavi."

#: src/ui/UserDetailsPage.qml:214
#, kde-format
msgid ""
"Cannot change the account type to Standard unless there is at least one "
"other Administrator account on the system. Without one, authentication would "
"become impossible or require the insecure use of the root password."
msgstr ""
"Vrstu računa nije moguće promijeniti u standardnu ako na sustavu ne postoji "
"barem još jedan administratorski račun. Bez njega autentifikacija bi bila "
"nemoguća ili bi zahtijevala nesigurnu upotrebu lozinke korisnika root."

#: src/ui/UserDetailsPage.qml:222
#, kde-format
msgid "Email address:"
msgstr "Adresa e-pošte:"

#: src/ui/UserDetailsPage.qml:254
#, kde-format
msgid "Delete files"
