#: src/ui/UserDetailsPage.qml:261
#, kde-format
msgid "Keep files"
msgstr "Zadrži datoteke"

#: src/ui/UserDetailsPage.qml:268
#, kde-format
msgid "Delete User…"
msgstr "Izbriši korisnika…"

#: src/ui/UserDetailsPage.qml:274
#, kde-format
msgctxt "@label:tooltip"
msgid ""
"Cannot delete yourself! Log out and then log in as another user to delete "
"this user account."
msgstr ""
"Ne možete izbrisati sami sebe! Odjavite se, a zatim se prijavite kao drugi "
"korisnik da biste izbrisali ovaj korisnički račun."

#: src/ui/UserDetailsPage.qml:286
#, kde-format
msgid "Configure Fingerprint Authentication…"
msgstr "Konfiguriraj autentifikaciju otiskom prsta…"

#: src/ui/UserDetailsPage.qml:318
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Fingerprints can be used in place of a password when unlocking the screen "
"and providing administrator permissions to applications and command-line "
"programs that request them.<nl/><nl/>Logging into the system with your "
"fingerprint is not yet supported."
msgstr ""
"Otisci prstiju mogu se upotrebljavati umjesto lozinke pri otključavanju "
"zaslona i davanju administratorskih ovlasti aplikacijama i programima "
"naredbenog retka koji ih zatraže.<nl/><nl/>Prijava u sustav otiskom prsta "
"još nije podržana."

