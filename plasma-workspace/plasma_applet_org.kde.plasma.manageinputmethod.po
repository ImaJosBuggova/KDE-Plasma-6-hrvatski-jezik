#: qml/main.qml:20
#, kde-format
msgid "On-Screen Keyboard"
msgstr "Tipkovnica na ekranu"

#: qml/main.qml:77
#, kde-format
msgctxt "@action:tray context menu"
msgid "Disabled"
msgstr "Onemogućeno"

#: qml/main.qml:88
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch and Tablet"
msgstr "Dodir i tablet"

#: qml/main.qml:99
#, kde-format
msgctxt "@action:tray context menu"
msgid "Touch, Tablet, Mouse, and Touchpad"
msgstr "Dodir, tablet, miš i touchpad"

#: qml/main.qml:116
#, kde-format
msgctxt "Opens the system settings module"
msgid "Configure On-Screen Keyboards…"
msgstr "Konfiguriraj tipkovnice na ekranu…"

#: qml/main.qml:133
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard: unavailable\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Tipkovnica na ekranu: nedostupno\n"
"Kliknite ili dodirnite za konfiguriranje postavki tipkovnice na ekranu"

#: qml/main.qml:143
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Configured not to show automatically\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Konfigurirano da se ne prikazuje automatski\n"
"Kliknite ili dodirnite za konfiguriranje postavki tipkovnice na ekranu"

#: qml/main.qml:156
#, kde-format
msgctxt ""
"@info:tooltip Hardware emulation mode means it acts like a regular dumb "
"keyboard (no input-method features like preedit/word suggestions/etc)"
msgid ""
"No supported text field is currently active\n"
"Click or tap to show in hardware keyboard emulation mode."
msgstr ""
"Trenutno nije aktivno nijedno podržano tekstualno polje\n"
"Kliknite ili dodirnite za prikaz u načinu emulacije hardverske tipkovnice."

#: qml/main.qml:167
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"On-Screen Keyboard is visible\n"
"Click or tap to hide the on-screen keyboard."
msgstr ""
"Tipkovnica na ekranu je vidljiva\n"
"Kliknite ili dodirnite za sakrivanje tipkovnice na ekranu."

#: qml/main.qml:177
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when tapping a text field\n"
"Tap to configure on-screen keyboard settings"
msgstr ""
"Prikazuje se automatski pri dodiru tekstualnog polja\n"
"Dodirnite za konfiguriranje postavki tipkovnice na ekranu"

#: qml/main.qml:187
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Shows automatically when interacting with a text field\n"
"Click or tap to configure on-screen keyboard settings"
msgstr ""
"Prikazuje se automatski pri interakciji s tekstualnim poljem\n"
"Kliknite ili dodirnite za konfiguriranje postavki tipkovnice na ekranu"
