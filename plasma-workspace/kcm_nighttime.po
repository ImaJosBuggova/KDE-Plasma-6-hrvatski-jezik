#: ui/main.qml:26
#, kde-format
msgctxt "@info"
msgid ""
"Time-based features such as Night Light and dynamic wallpapers can be "
"synchronized with the day-night cycle. Choose your preferred cycle here."
msgstr ""
"Značajke temeljene na vremenu, kao što su Noćno svjetlo i dinamičke "
"pozadine, mogu se sinkronizirati s ciklusom dan/noć. Ovdje odaberite željeni "
"ciklus."

#: ui/main.qml:63
#, kde-format
msgctxt ""
"@label:listbox part of a sentence: 'Determine sunrise and sunset times "
"[based on]'"
msgid "Determine sunrise and sunset times:"
msgstr "Odredi vrijeme izlaska i zalaska sunca:"

