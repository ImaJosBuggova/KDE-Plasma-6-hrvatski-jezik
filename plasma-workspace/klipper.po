#. i18n: ectx: tooltip, entry (URLGrabberEnabled), group (General)
#: klipper.kcfg:43
#, kde-format
msgid ""
"Show the popup menu of applicable actions as soon as a selection is made."
msgstr "Prikaži skočni izbornik primjenjivih radnji čim se odabir napravi."

#. i18n: ectx: label, entry (TimeoutForActionPopups), group (General)
#: klipper.kcfg:47
#, kde-format
msgid "Automatic action menu time:"
msgstr "Vrijeme automatskog izbornika radnji:"

#. i18n: ectx: tooltip, entry (TimeoutForActionPopups), group (General)
#: klipper.kcfg:51
#, kde-format
msgid "Display the automatic action popup menu for this time."
msgstr "Prikaži automatski skočni izbornik radnji tijekom tog vremena."

#. i18n: ectx: label, entry (MaxClipItems), group (General)
#: klipper.kcfg:54
#, kde-format
msgid "History size:"
msgstr "Veličina povijesti:"

#. i18n: ectx: tooltip, entry (MaxClipItems), group (General)
#: klipper.kcfg:58
#, kde-format
msgid "The clipboard history will store up to this many items."
msgstr "Povijest međuspremnika će čuvati do ovog broja stavki."

#. i18n: ectx: label, entry (ActionList), group (General)
#: klipper.kcfg:61
#, kde-format
msgid "Dummy entry for indicating changes in an action's tree widget"
msgstr "Lažna stavka za označavanje promjena u stablastom widgetu radnje"

#. i18n: ectx: label, entry (StripWhiteSpace), group (Actions)
#: klipper.kcfg:71
#, kde-format
msgid "Trim whitespace"
msgstr "Ukloni razmake"

#. i18n: ectx: whatsthis, entry (StripWhiteSpace), group (Actions)
#: klipper.kcfg:73
#, kde-format
msgid ""
"Remove any whitespace from the start and end of the text passed to an "
"action. The text saved in history is not affected."
msgstr ""
"Ukloni sve razmake s početka i kraja teksta proslijeđenog radnji. Tekst "
"spremljen u povijesti nije promijenjen."

#. i18n: ectx: label, entry (ReplayActionInHistory), group (Actions)
#: klipper.kcfg:76
#, kde-format
msgid "For an item chosen from history"
msgstr "Za stavku odabranu iz povijesti"

#. i18n: ectx: tooltip, entry (ReplayActionInHistory), group (Actions)
#: klipper.kcfg:78
#, kde-format
msgid ""
"Show the popup menu of applicable actions if an entry is chosen from the "
"clipboard history."
msgstr ""
"Prikaži skočni izbornik primjenjivih radnji ako je stavka odabrana iz "
"povijesti međuspremnika."

#. i18n: ectx: label, entry (EnableMagicMimeActions), group (Actions)
#: klipper.kcfg:81
#, kde-format
msgid "Offer applications for copied links and files"
msgstr "Ponudi aplikacije za kopirane poveznice i datoteke"

#. i18n: ectx: whatsthis, entry (EnableMagicMimeActions), group (Actions)
#: klipper.kcfg:83
#, kde-format
msgid ""
"For a link starting with <i>http://</i> or <i>https://</i> or for files, "
"applications that can open them will be offered alongside your matching "
"actions, if any."
msgstr ""
"Za poveznice koje počinju s <i>http://</i> ili <i>https://</i> ili za "
"datoteke, a aplikacije koje ih mogu otvoriti bit će ponuđene uz vaše "
"odgovarajuće radnje, ako postoje."

#: klipperpopup.cpp:38
#, kde-format
msgid "Clipboard Popup"
msgstr "Skočni izbornik međuspremnika"

