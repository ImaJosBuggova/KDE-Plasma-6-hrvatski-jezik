#: ui/main.qml:32
#, kde-format
msgid ""
"User Feedback has been disabled centrally. Please contact your distributor."
msgstr ""
"Povratne informacije korisnika centralno su onemogućene. Kontaktirajte svog "
"distributera."

#: ui/main.qml:44
#, kde-kuit-format
msgctxt "@info"
msgid ""
"You can help KDE improve Plasma by contributing information on how you use "
"it, so we can focus on things that matter to you.<nl/><nl/>Contributing this "
"information is optional and entirely anonymous. We never collect your "
"personal data, files you use, websites you visit, or information that could "
"identify you.<nl/>"
msgstr ""
"Možete pomoći KDE-u da poboljša Plasmu dijeljenjem informacija o tome kako "
"je koristite, kako bismo se usredotočili na stvari koje su vam važne.<nl/"
"><nl/>Dijeljenje ovih informacija je opcionalno i potpuno anonimno. Nikad ne "
"prikupljamo vaše osobne podatke, datoteke koje koristite, web-stranice koje "
"posjećujete ili informacije koje vas mogu identificirati.<nl/>"

#: ui/main.qml:51
#, kde-format
msgctxt "@info"
msgid "Read more about our privacy policy"
msgstr "Saznajte više o našoj politici privatnosti"

