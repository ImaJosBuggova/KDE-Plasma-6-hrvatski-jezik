msgid "Name of the current pointer theme"
msgstr "Naziv trenutačne teme pokazivača"

msgid "Current pointer size"
msgstr "Trenutačna veličina pokazivača"

msgid "Unable to create a temporary file."
msgstr "Nije moguće izraditi privremenu datoteku."

msgid "Unable to download the icon theme archive: %1"
msgstr "Nije moguće preuzeti arhivu teme ikona: %1"

msgid "Unable to open the icon theme archive."
msgstr "Nije moguće otvoriti arhivu teme ikona."

msgid "The file is not a valid icon theme archive."
msgstr "Datoteka nije valjana arhiva teme ikona."

msgid "Failed to create 'icons' folder."
msgstr "Izrada mape 'icons' nije uspjela."

msgid "A theme named %1 already exists in your icon theme folder. Do you want replace it with this one?"
msgstr "Tema naziva %1 već postoji u vašoj mapi tema ikona. Želite li je zamijeniti ovom temom?"

msgid "Overwrite Theme?"
msgstr "Prebrisati temu?"

msgid "Theme installed successfully."
msgstr "Tema je uspješno instalirana."

msgid "Timeout in seconds"
msgstr "Istek vremena u sekundama"

msgid "This tool allows you to set the mouse pointer theme for the current Plasma session, without accidentally setting it to one that is either not available, or which is already set."
msgstr "Ovaj alat omogućuje postavljanje teme pokazivača miša za trenutačnu sesiju Plasme bez slučajnog postavljanja teme koja nije dostupna ili je već postavljena."

msgid "The name of the pointer theme you wish to set for your current Plasma session (passing a full path will only use the last part of the path)"
msgstr "Naziv teme pokazivača koju želite postaviti za trenutačnu sesiju Plasme (ako proslijedite punu putanju, upotrijebit će se samo njezin zadnji dio)"

msgid "Show all the themes available on the system (and which is the current theme)"
msgstr "Prikaži sve teme dostupne na sustavu (i onu koja je trenutačna tema)"

msgid "Use a specific size, rather than the theme default size"
msgstr "Koristi određenu veličinu umjesto zadane veličine teme"

msgid "The requested theme “%1” is already set as the theme for the current Plasma session."
msgstr "Zatražena tema \"%1\" već je postavljena kao tema trenutačne sesije Plasme."

msgid "Successfully applied the mouse pointer theme %1 to your current Plasma session"
msgstr "Tema pokazivača miša %1 uspješno je primijenjena na vašu trenutačnu sesiju Plasme"

msgid "You have to restart the Plasma session for your newly applied mouse pointer theme to display correctly."
msgstr "Morate ponovno pokrenuti sesiju Plasme kako bi se novoprimijenjena tema pokazivača miša ispravno prikazala."

msgid "Could not find theme “%1”. The theme should be one of the following options: %2"
msgstr "Tema \"%1\" nije pronađena. Tema mora biti jedna od sljedećih mogućnosti: %2"

msgid "You have the following mouse pointer themes on your system:"
msgstr "Na sustavu imate sljedeće teme pokazivača miša:"

msgid "(Current theme for this Plasma session)"
msgstr "(Trenutačna tema za ovu sesiju Plasme)"

msgid "Remove pointer theme"
msgstr "Ukloni temu pokazivača"

msgid "Cannot delete the active pointer theme"
msgstr "Aktivnu temu pokazivača nije moguće izbrisati"

msgid "Cannot delete system-installed pointer themes"
msgstr "Sistemski instalirane teme pokazivača nije moguće izbrisati"

msgid "Don’t delete this pointer theme"
msgstr "Nemoj izbrisati ovu temu pokazivača"

msgid "Launch Feedback"
msgstr "Povratne informacije pri pokretanju"

msgid "Configure the animations played while an application is launching."
msgstr "Konfigurirajte animacije koje se reproduciraju dok se aplikacija pokreće."

msgid "Pointer feedback:"
msgstr "Povratne informacije pokazivača:"

msgid "None"
msgstr "Nema"

msgid "Static"
msgstr "Statično"

msgid "Blinking"
msgstr "Treperenje"

msgid "Bouncing"
msgstr "Poskakivanje"

msgid "Task Manager feedback:"
msgstr "Povratne informacije upravitelja zadataka:"

msgid "Enable animation"
msgstr "Omogući animaciju"

msgid "Stop animations after:"
msgstr "Zaustavi animacije nakon:"

msgid "%1 second"
msgid_plural "%1 seconds"
msgstr[0] "%1 sekunda"
msgstr[1] "%1 sekunde"
msgstr[2] "%1 sekundi"

msgid "Size: %1"
msgstr "Veličina: %1"

msgid "&Configure Launch Feedback…"
msgstr "&Konfiguriraj povratne informacije pri pokretanju…"

msgid "&Install from File…"
msgstr "&Instaliraj iz datoteke…"

msgid "&Get New…"
msgstr "&Preuzmi novo…"

msgid "Open Theme"
msgstr "Otvori temu"

msgid "Pointer Theme Files (*.tar.gz *.tar.bz2)"
msgstr "Datoteke tema pokazivača (*.tar.gz *.tar.bz2)"

msgid "(Available sizes: %1)"
msgstr "(Dostupne veličine: %1)"
