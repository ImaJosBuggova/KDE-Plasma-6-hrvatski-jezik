#: main.cpp:111
#, kde-format
msgid ""
"The reliable Plasma session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Pouzdani upravitelj sesije za Plasma koji koristi standardni X11R6 protokol "
"upravljanja sesijama (XSMP)."

