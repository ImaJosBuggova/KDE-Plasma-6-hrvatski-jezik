#: module.cpp:68
#, kde-format
msgctxt "@title"
msgid "Memory Shortage Avoided"
msgstr "Izbjegnuta nestašica memorije"

#: module.cpp:71
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<command>%1</command> has been terminated by the Linux kernel because the "
"system is low on memory. Consider closing unused applications or browser "
"tabs."
msgstr ""
"<command>%1</command> je zaustavio Linux kernel jer je sustav gotovo bez "
"memorije. Razmislite o zatvaranju neupotrebljavanih aplikacija ili kartica "
"preglednika."

#: module.cpp:77
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The background service <command>%1</command> has been terminated by the "
"Linux kernel because the system is low on memory. Consider closing unused "
"applications or browser tabs."
msgstr ""
"Pozadinska usluga <command>%1</command> je zaustavila Linux kernel jer je "
"sustav gotovo bez memorije. Razmislite o zatvaranju neupotrebljavanih "
"aplikacija ili kartica preglednika."

#: module.cpp:85
#, kde-format
msgctxt "@action"
msgid "Restart Application"
msgstr "Ponovno pokreni aplikaciju"
