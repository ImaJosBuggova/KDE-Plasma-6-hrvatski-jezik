#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Roko"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "roko@maesdbk.hr"

#: downloadjob.cpp:143
#, kde-format
msgid ""
"This type of file can harm your computer. If you want to keep it, accept "
"this download from the browser window."
msgstr ""
"Ova vrsta datoteke može oštetiti vaše računalo. Ako je želite zadržati, "
"prihvatite ovo preuzimanje iz prozora preglednika."

#: downloadjob.cpp:261
#, kde-format
msgid "Access denied."
msgstr "Pristup odbijen."

#: downloadjob.cpp:262
#, kde-format
msgid "Insufficient free space."
msgstr "Nema dovoljno slobodnog prostora."

#: downloadjob.cpp:263
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "Naziv datoteke koji ste odabrali predugačak je."

#: downloadjob.cpp:264
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "Datoteka je prevelika za preuzimanje."

#: downloadjob.cpp:266
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "Datoteka možda sadrži zlonamjeran sadržaj."

#: downloadjob.cpp:267
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "Došlo je do privremene pogreške. Pokušajte ponovno kasnije."

#: downloadjob.cpp:269
#, kde-format
msgid "A network error has occurred."
msgstr "Došlo je do mrežne pogreške."

#: downloadjob.cpp:270
#, kde-format
msgid "The network operation timed out."
msgstr "Vremensko ograničenje mrežne operacije je isteklo."

#: downloadjob.cpp:271
#, kde-format
msgid "The network connection has been lost."
msgstr "Mrežna veza je izgubljena."

#: downloadjob.cpp:272
#, kde-format
msgid "The server is no longer reachable."
msgstr "Poslužitelj više nije dostupan."

#: downloadjob.cpp:274
#, kde-format
msgid "A server error has occurred."
msgstr "Došlo je do pogreške na poslužitelju."

#: downloadjob.cpp:278
#, kde-format
msgid "The server does not have the requested data."
msgstr "Poslužitelj nema tražene podatke."

#: downloadjob.cpp:280
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "Aplikacija preglednika neočekivano se zatvorila."

#: downloadjob.cpp:286
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "Došlo je do nepoznate pogreške tijekom preuzimanja."

#: downloadjob.cpp:324
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "Preuzimanje"

#: downloadjob.cpp:325
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "Izvor"

#: downloadjob.cpp:326
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "Odredište"

#: historyrunnerplugin.cpp:108
#, kde-format
msgctxt "Dummy search result"
msgid "Additional permissions are required"
msgstr "Potrebna su dodatna dopuštenja"

#: tabsrunnerplugin.cpp:38
#, kde-format
msgid "Mute Tab"
msgstr "Priguši karticu"

#: tabsrunnerplugin.cpp:43
#, kde-format
msgid "Unmute Tab"
msgstr "Ukloni prigušenje kartice"