#. (itstool) path: component/summary
#: org.kde.kblocks.appdata.xml:10
msgid "Falling Blocks Game"
msgstr "Igra padajućih blokova"

#. (itstool) path: description/p
#: org.kde.kblocks.appdata.xml:12
msgid "KBlocks is the classic falling blocks game. The idea is to stack the falling blocks to create horizontal lines without any gaps. When a line is completed it is removed, and more space is available in the play area. When there is not enough space for blocks to fall, the game is over."
msgstr "KBlocks je klasična igra s padajućim blokovima. Cilj je slagati padajuće blokove i stvarati vodoravne redove bez praznina. Kada se red dovrši, uklanja se i oslobađa prostor za igru. Igra završava kada više nema dovoljno mjesta za pad blokova."
