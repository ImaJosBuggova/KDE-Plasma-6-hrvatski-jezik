#. (itstool) path: component/name
#: org.kde.kcharselect.appdata.xml:9
msgid "KCharSelect"
msgstr "KCharSelect"

#. (itstool) path: component/summary
#: org.kde.kcharselect.appdata.xml:10
msgid "Character Selector"
msgstr "Odabir znakova"

#. (itstool) path: description/p
#: org.kde.kcharselect.appdata.xml:12
msgid "KCharSelect is a tool to select special characters from all installed fonts and copy them into the clipboard."
msgstr "KCharSelect je alat za odabir posebnih znakova iz svih instaliranih fontova i njihovo kopiranje u međuspremnik."

#. (itstool) path: description/p
#: org.kde.kcharselect.appdata.xml:15
msgid "You can browse characters by their category or quickly find a certain character by searching for its name."
msgstr "Znakove možete pregledavati po kategorijama ili brzo pronaći određeni znak pretraživanjem njegova naziva."

#. (itstool) path: description/p
#: org.kde.kcharselect.appdata.xml:18
msgid "KCharSelect displays various information about the selected character. This includes not only the Unicode character name, but also aliases, general notes and cross references to similar characters."
msgstr "KCharSelect prikazuje razne podatke o odabranom znaku. To uključuje naziv znaka u Unicodeu, ali i pseudonime, opće napomene te poveznice na slične znakove."

#. (itstool) path: description/p
#: org.kde.kcharselect.appdata.xml:21
msgid "For technical use, different representations of the character are shown."
msgstr "Za tehničku upotrebu prikazuju se različiti prikazi znaka."

#. (itstool) path: description/p
#: org.kde.kcharselect.appdata.xml:24
msgid "KCharSelect also contains Unihan data for East Asian characters to display English definitions and different pronunciations."
msgstr "KCharSelect sadrži i podatke Unihan za istočnoazijske znakove, koji prikazuju engleske definicije i različite izgovore."
