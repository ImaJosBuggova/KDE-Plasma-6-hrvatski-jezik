#: view/kateview.cpp:848
#, kde-format
msgid "Show Non-Printable Spaces"
msgstr "Prikaži bjeline koje se ne ispisuju"

#: view/kateview.cpp:850
#, kde-format
msgid "Show/hide bounding box around non-printable spaces"
msgstr "Prikaži/sakrij okvir oko bjelina koje se ne ispisuju"

#: view/kateview.cpp:854
#, kde-format
msgid "Switch to Command Line"
msgstr "Prebaci se na komandnu liniju"

#: view/kateview.cpp:856
#, kde-format
msgid "Show/hide the command line on the bottom of the view."
msgstr "Pokaži/sakrij naredbenu liniju na dnu prikaza."

#: view/kateview.cpp:859
#, kde-format
msgid "Input Modes"
msgstr "Načini unosa"

#: view/kateview.cpp:868
#, kde-format
msgid "Activate/deactivate %1"
msgstr "Aktiviraj/deaktiviraj %1"

#: view/kateview.cpp:878
#, kde-format
msgid "&End of Line"
msgstr "&Idi na kraj retka"

#: view/kateview.cpp:880
#, kde-format
msgid "Choose which line endings should be used, when you save the document"
msgstr "Odaberite koje završetke redaka koristiti prilikom spremanja dokumenta "

#: view/kateview.cpp:881
#, kde-format
msgctxt "@item:inmenu End of Line"
msgid "&UNIX"
msgstr "&UNIX"

#: view/kateview.cpp:882
#, kde-format
msgctxt "@item:inmenu End of Line"
msgid "&Windows/DOS"
msgstr "&Windows/DOS"

#: view/kateview.cpp:883
#, kde-format
msgctxt "@item:inmenu End of Line"
msgid "&Macintosh"
msgstr "&Macintosh"

#: view/kateview.cpp:888
#, kde-format
msgid "Add &Byte Order Mark (BOM)"
msgstr "Dodaj &oznake za redosljed bitova (BOM)"

#: view/kateview.cpp:891
#, kde-format
msgid ""
"Enable/disable adding of byte order marks for UTF-8/UTF-16 encoded files "
"while saving"
msgstr "Omogući/onemogući dodavanje oznake redoslijeda bajtova pri spremanju datoteka kodiranih u UTF-8/UTF-16"

#: view/kateview.cpp:895
#, kde-format
msgid "E&ncoding"
msgstr "&Kodiranje:"

#: view/kateview.cpp:899
#, kde-format
msgid "Look up the first occurrence of a piece of text or regular expression."
msgstr "Tražite prvo pojavljivanje dijela teksta ili regularnog izraza."

#: view/kateview.cpp:903
#, kde-format
msgid "Find Selected"
msgstr "Traži Odabrano"

#: view/kateview.cpp:905
#, kde-format
msgid "Finds next occurrence of selected text."
msgstr "Pronađi sljedeći slučaj označenog teksta."

#: view/kateview.cpp:909
#, kde-format
msgid "Find Selected Backwards"
msgstr "Traži odabrano unatrag"

#: view/kateview.cpp:911
#, kde-format
msgid "Finds previous occurrence of selected text."
msgstr "Tražite prethodno pojavljivanje zadanog teksta."

#: view/kateview.cpp:915
#, kde-format
msgid "Find and Select Next Occurrence"
msgstr "Pronađi i odaberi sljedeće pojavljivanje"

#: view/kateview.cpp:917
#, kde-format
msgid "Finds next occurrence of the word under cursor and add it to selection."
msgstr "Pronalazi sljedeće pojavljivanje riječi ispod pokazivača i dodaje ga u odabir."

#: view/kateview.cpp:921
#, kde-format
msgid "Mark Currently Selected Occurrence as Skipped"
msgstr "Označi trenutačno odabrano pojavljivanje kao preskočeno"

#: view/kateview.cpp:923
#, kde-format
msgid "Marks the currently selected word as skipped."
msgstr "Označava trenutačno odabranu riječ kao preskočenu."

#: view/kateview.cpp:927
#, kde-format
msgid "Find and Select All Occurrences"
msgstr "Pronađi i odaberi sva pojavljivanja"

#: view/kateview.cpp:929
#, kde-format
msgid "Finds all occurrences of the word under cursor and selects them."
msgstr "Pronalazi sva pojavljivanja riječi ispod pokazivača i odabire ih."

#: view/kateview.cpp:933
#, kde-format
msgid "Look up the next occurrence of the search phrase."
msgstr "Tražite slijedeće pojavljivanje zadane fraze."

#: view/kateview.cpp:937
#, kde-format
msgid "Look up the previous occurrence of the search phrase."
msgstr "Tražite prethodno pojavljivanje zadane fraze."

#: view/kateview.cpp:941
#, kde-format
msgid ""
"Look up a piece of text or regular expression and replace the result with "
"some given text."
msgstr "Tražite dio teksta ili regularni izraz te zamjeni rezultat s zadanim tekstom."

#: view/kateview.cpp:944
#, kde-format
msgid "Add Cursors to Line Ends"
msgstr "Dodaj pokazivače na krajeve redaka"

#: view/kateview.cpp:946
#, kde-format
msgid "Creates a cursor at the end of every line in selection."
msgstr "Stvara pokazivač na kraju svakog retka u odabiru."

#: view/kateview.cpp:950
#, kde-format
msgid "Add Caret below Cursor"
msgstr "Dodaj pokazivač ispod trenutačnog"

#: view/kateview.cpp:952
#, kde-format
msgid "Adds a caret in the line below the current caret."
msgstr "Dodaje pokazivač u redak ispod trenutačnog pokazivača."

#: view/kateview.cpp:956
#, kde-format
msgid "Add Caret above Cursor"
msgstr "Dodaj pokazivač iznad trenutačnog"

#: view/kateview.cpp:958
#, kde-format
msgid "Adds a caret in the line above the current caret."
msgstr "Dodaje pokazivač u redak iznad trenutačnog pokazivača."

#: view/kateview.cpp:962
#, kde-format
msgid "Toggle Camel Case Cursor Movement"
msgstr "Uključi/isključi pomicanje pokazivača po camelCaseu"

#: view/kateview.cpp:963
#, kde-format
msgid "Toggle between normal word movement and camel case cursor movement."
msgstr "Prebacuje između uobičajenog pomicanja po riječima i pomicanja pokazivača po camelCaseu."

#: view/kateview.cpp:967
#, kde-format
msgid "Remove Cursors from Empty Lines"
msgstr "Ukloni pokazivače iz praznih redaka"

#: view/kateview.cpp:968
#, kde-format
msgid "Remove cursors from empty lines"
msgstr "Uklanja pokazivače iz praznih redaka"

#: view/kateview.cpp:972
#, kde-format
msgid "Automatic Spell Checking"
msgstr "Automatska provjera pravopisa"

#: view/kateview.cpp:973
#, kde-format
msgid "Enable/disable automatic spell checking"
msgstr "Omogući/onemogući automatsku provjeru pravopisa"

#: view/kateview.cpp:979
#, kde-format
msgctxt "@action"
msgid "Change Dictionary…"
msgstr "Promijeni rječnik…"

#: view/kateview.cpp:980
#, kde-format
msgid "Change the dictionary that is used for spell checking."
msgstr "Promijeni riječnik koji se koristi za provjeru pravopisa."

#: view/kateview.cpp:984
#, kde-format
msgid "Clear Dictionary Ranges"
msgstr "Ukloni Dijelove Rječnika"

#: view/kateview.cpp:986
#, kde-format
msgid ""
"Remove all the separate dictionary ranges that were set for spell checking."
msgstr "Ukloni sve odvojene dijelove rječnika koji su postavljeni za provjeru pravopisa."

#: view/kateview.cpp:992
#, kde-format
msgid "Copy as &HTML"
msgstr "Kopiraj kao &HTML"

#: view/kateview.cpp:993
#, kde-format
msgid ""
"Copy the selection as HTML, formatted using the current syntax highlighting "
"and color scheme settings."
msgstr "Kopira odabir u obliku HTML-a, oblikovan trenutačnim postavkama isticanja sintakse i sheme boja."

#: view/kateview.cpp:997
#, kde-format
msgctxt "@action"
msgid "E&xport as HTML…"
msgstr "&Izvezi u HTML…"

#: view/kateview.cpp:999
#, kde-format
msgid ""
"This command allows you to export the current document with all highlighting "
"information into a HTML document."
msgstr "Ova naredba omogućuje izvoz trenutačnog dokumenta u HTML datoteku sa svim podacima o isticanju."

#: view/kateview.cpp:1038
#, kde-format
msgid "Move Word Left"
msgstr "Pomakni za riječ lijevo"

#: view/kateview.cpp:1044
#, kde-format
msgid "Select Character Left"
msgstr "Označi znak lijevo"

#: view/kateview.cpp:1050
#, kde-format
msgid "Select Word Left"
msgstr "Označi riječ lijevo"

#: view/kateview.cpp:1060
#, kde-format
msgid "Move Word Right"
msgstr "Pomakni za riječ desno"

#: view/kateview.cpp:1066
#, kde-format
msgid "Select Character Right"
msgstr "Izaberite znak desno"

#: view/kateview.cpp:1072
#, kde-format
msgid "Select Word Right"
msgstr "Označi riječ desno"

#: view/kateview.cpp:1082
#, kde-format
msgid "Start the Marked Selection"
msgstr "Započni označeni odabir"

#: view/kateview.cpp:1083
#, kde-format
msgid ""
"Emulate the Emacs-like selection mode, where the beginning is marked and "
"then the selection is continuously updated."
msgstr "Oponaša način odabira nalik Emacsu: označi se početak, a zatim se odabir neprestano ažurira."

#: view/kateview.cpp:1088
#, kde-format
msgid "Move to Beginning of Line"
msgstr "Pomakni sve do početka retka"

#: view/kateview.cpp:1094
#, kde-format
msgid "Move to Beginning of Document"
msgstr "Pomakni na početak dokumenta"

#: view/kateview.cpp:1100
#, kde-format
msgid "Select to Beginning of Line"
msgstr "Odaberi sve do početka retka"

#: view/kateview.cpp:1110
#, kde-format
msgid "Select to Beginning of Document"
msgstr "Označi do početka dokumenta"

#: view/kateview.cpp:1120
#, kde-format
msgid "Move to End of Line"
msgstr "Pomakni na kraj retka"

#: view/kateview.cpp:1126
#, kde-format
msgid "Move to End of Document"
msgstr "Pomakni na kraj dokumenta"

#: view/kateview.cpp:1132
#, kde-format
msgid "Select to End of Line"
msgstr "Označi do kraja retka"

#: view/kateview.cpp:1142
#, kde-format
msgid "Select to End of Document"
msgstr "Izaberite kraj dokumenta"

#: view/kateview.cpp:1152
#, kde-format
msgid "Select to Previous Line"
msgstr "Izaberite prethodnu liniju"

#: view/kateview.cpp:1158
#, kde-format
msgid "Scroll Line Up"
msgstr "Pomakni za liniju gure"

#: view/kateview.cpp:1167
#, kde-format
msgid "Move to Next Line"
msgstr "Pomakni se do sljedećeg retka"

#: view/kateview.cpp:1173
#, kde-format
msgid "Move to Previous Line"
msgstr "Pomakni se na prethodnu liniju"

#: view/kateview.cpp:1179
#, kde-format
msgid "Move Cursor Right"
msgstr "Pomakni kursor udesno"

#: view/kateview.cpp:1185
#, kde-format
msgid "Move Cursor Left"
msgstr "Pomakni kursor ulijevo"

#: view/kateview.cpp:1191
#, kde-format
msgid "Select to Next Line"
msgstr "Označi do sljedećeg retka"

#: view/kateview.cpp:1197
#, kde-format
msgid "Scroll Line Down"
msgstr "Pomakni za liniju dolje"

#: view/kateview.cpp:1206
#, kde-format
msgid "Scroll Page Up"
msgstr "Pomakni stranicu gore"

#: view/kateview.cpp:1212
#, kde-format
msgid "Select Page Up"
msgstr "Označi stranicu gore"

#: view/kateview.cpp:1218
#, kde-format
msgid "Move to Top of View"
msgstr "Pomaknite na vrh prikaza"

#: view/kateview.cpp:1224
#, kde-format
msgid "Select to Top of View"
msgstr "Označi do vrha prikaza"

#: view/kateview.cpp:1230
#, kde-format
msgid "Scroll Page Down"
msgstr "Pomakni stranicu dolje"

#: view/kateview.cpp:1236
#, kde-format
msgid "Select Page Down"
msgstr "Izaberite Stranica dolje"

#: view/kateview.cpp:1242
#, kde-format
msgid "Move to Bottom of View"
msgstr "Pomaknite na dno prikaza"

#: view/kateview.cpp:1248
#, kde-format
msgid "Select to Bottom of View"
msgstr "Označi do dna prikaza"

#: view/kateview.cpp:1254
#, kde-format
msgid "Go to Matching Bracket"
msgstr "Idi na uparenu zagradu"

#: view/kateview.cpp:1260
#, kde-format
msgid "Select to Matching Bracket"
msgstr "Označi do pripadajuće zagrade"

#: view/kateview.cpp:1267
#, kde-format
msgid "Move Sub-Word Right"
msgstr "Pomakni se udesno za podriječ"

#: view/kateview.cpp:1274
#, kde-format
msgid "Select Sub-Word Right"
msgstr "Odaberi podriječ udesno"

#: view/kateview.cpp:1281
#, kde-format
msgid "Move Sub-Word Left"
msgstr "Pomakni se ulijevo za podriječ"

#: view/kateview.cpp:1288
#, kde-format
msgid "Select Sub-Word Left"
msgstr "Odaberi podriječ ulijevo"

#: view/kateview.cpp:1298
#, kde-format
msgid "Transpose Characters"
msgstr "Zamjeni znakove"

#: view/kateview.cpp:1303
#, kde-format
msgid "Transpose Words"
msgstr "Zamijeni mjesta riječima"

#: view/kateview.cpp:1308
#, kde-format
msgid "Delete Line"
msgstr "Izbriši redak"

#: view/kateview.cpp:1314
#, kde-format
msgid "Delete Word Left"
msgstr "Izbriši riječ lijevo"

#: view/kateview.cpp:1320
#, kde-format
msgid "Delete Word Right"
msgstr "Izbriši riječ desno"

#: view/kateview.cpp:1326
#, kde-format
msgid "Delete Next Character"
msgstr "Izbriši sljedeći znak"

#: view/kateview.cpp:1332
#, kde-format
msgid "Backspace"
msgstr "Backspace"

#: view/kateview.cpp:1340
#, kde-format
msgid "Insert Tab Character"
msgstr "Umetni znak tabulatora"

#: view/kateview.cpp:1345
#, kde-format
msgid "Insert Smart Newline"
msgstr "Ubaci Pametnu Novu Liniju"

#: view/kateview.cpp:1346
#, kde-format
msgid ""
"Insert newline including leading characters of the current line which are "
"not letters or numbers."
msgstr "Ubaci novi redak koji uključuje uvodne znakove trenutnog retka, a koji nisu slova ili brojevi."

#: view/kateview.cpp:1354
#, kde-format
msgid "Insert a Non-Indented Newline"
msgstr "Umetni novi redak bez uvlačenja"

#: view/kateview.cpp:1355
#, kde-format
msgid ""
"Insert a new line without indentation, regardless of indentation settings."
msgstr "Umeće novi redak bez uvlačenja, neovisno o postavkama uvlačenja."

#: view/kateview.cpp:1363
#, kde-format
msgid "Insert a Newline Above Current Line"
msgstr "Umetni novi redak iznad trenutačnog"

#: view/kateview.cpp:1364
#, kde-format
msgid ""
"Insert a new line above current line without modifying the current line."
msgstr "Umeće novi redak iznad trenutačnog bez izmjene trenutačnog retka."

#: view/kateview.cpp:1372
#, kde-format
msgid "Insert a Newline Below Current Line"
msgstr "Umetni novi redak ispod trenutačnog"

#: view/kateview.cpp:1373
#, kde-format
msgid ""
"Insert a new line below current line without modifying the current line."
msgstr "Umeće novi redak ispod trenutačnog bez izmjene trenutačnog retka."

#: view/kateview.cpp:1382
#, kde-format
msgid "&Indent"
msgstr "&Uvlačenje"

#: view/kateview.cpp:1384
#, kde-format
msgid ""
"Use this to indent a selected block of text.<br /><br />You can configure "
"whether tabs should be honored and used or replaced with spaces, in the "
"configuration dialog."
msgstr "Koristite ovo za uvlačenje odabranog bloka teksta (samo tabulacije/samo razmaci)<br /> <br /> U dijalogu s postavkama možete podesiti hoće li se tabulacije poštovati i koristiti ili će biti zamijenjene s razmacima."

#: view/kateview.cpp:1391
#, kde-format
msgid "&Unindent"
msgstr "I&zvuci"

#: view/kateview.cpp:1392
#, kde-format
msgid "Use this to unindent a selected block of text."
msgstr "Koristite ovo da deindentirate označeni blok teksta."

