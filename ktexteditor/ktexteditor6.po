#: utils/katecmds.cpp:52
#, kde-format
msgid "<p>indent</p><p>Indents the selected lines or the current line</p>"
msgstr "<p>indent</p><p>Uvlači odabrane retke ili trenutačni redak.</p>"

#: utils/katecmds.cpp:57
#, kde-format
msgid "<p>unindent</p><p>Unindents the selected lines or current line.</p>"
msgstr "<p>unindent</p><p>Smanjuje uvlačenje odabranih redaka ili trenutačnog retka.</p>"

#: utils/katecmds.cpp:62
#, kde-format
msgid ""
"<p>cleanindent</p><p>Cleans up the indentation of the selected lines or "
"current line according to the indentation settings in the document. </p>"
msgstr "<p>cleanindent</p><p>Uređuje uvlačenje odabranih redaka ili trenutačnog retka prema postavkama uvlačenja dokumenta.</p>"

#: utils/katecmds.cpp:67
#, kde-format
msgid ""
"<p>comment</p><p>Inserts comment markers to make the selection or selected "
"lines or current line a comment according to the text format as defined by "
"the syntax highlight definition for the document.</p>"
msgstr "<p>comment</p><p>Umeće oznake komentara kako bi odabir, odabrani retci ili trenutačni redak postali komentar prema formatu teksta definiranom isticanjem sintakse dokumenta.</p>"

#: utils/katecmds.cpp:73
#, kde-format
msgid ""
"<p>uncomment</p><p>Removes comment markers from the selection or selected "
"lines or current line according to the text format as defined by the syntax "
"highlight definition for the document.</p>"
msgstr "<p>uncomment</p><p>Uklanja oznake komentara iz odabira, odabranih redaka ili trenutačnog retka prema formatu teksta definiranom isticanjem sintakse dokumenta.</p>"

#: utils/katecmds.cpp:79
#, kde-format
msgid ""
"<p>goto <b>line number</b></p><p>This command navigates to the specified "
"line number.</p>"
msgstr "<p>goto <b>broj retka</b></p><p>Ova naredba prelazi na navedeni broj retka.</p>"

#: utils/katecmds.cpp:84
#, kde-format
msgid ""
"<p>set-indent-pasted-text <b>enable</b></p><p>If enabled, indentation of "
"text pasted from the clipboard is adjusted using the current indenter.</"
"p><p>Possible true values: 1 on true<br/>possible false values: 0 off false</"
"p>"
msgstr "<p>set-indent-pasted-text <b>enable</b></p><p>Ako je omogućeno, uvlačenje teksta zalijepljenog iz međuspremnika prilagođava se trenutačnim postavkama uvlačenja.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:90
#, kde-format
msgid "Deletes the current line."
msgstr "Briše trenutačni redak."

#: utils/katecmds.cpp:94
#, kde-format
msgid ""
"<p>set-tab-width <b>width</b></p><p>Sets the tab width to the number "
"<b>width</b></p>"
msgstr "<p>set-tab-width <b>width</b></p><p>Postavlja širinu tabulatora na vrijednost <b>width</b>.</p>"

#: utils/katecmds.cpp:99
#, kde-format
msgid ""
"<p>set-replace-tab <b>enable</b></p><p>If enabled, tabs are replaced with "
"spaces as you type.</p><p>Possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr "<p>set-replace-tab <b>enable</b></p><p>Ako je omogućeno, tabulatori se tijekom tipkanja zamjenjuju razmacima.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:106
#, kde-format
msgid ""
"<p>set-show-tabs <b>enable</b></p><p>If enabled, TAB characters and trailing "
"whitespace will be visualized by a small dot.</p><p>Possible true values: 1 "
"on true<br/>possible false values: 0 off false</p>"
msgstr "<p>set-show-tabs <b>enable</b></p><p>Ako je omogućeno, znakovi TAB i završne bjeline prikazuju se malom točkom.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:113
#, kde-format
msgid ""
"<p>set-remove-trailing-spaces <b>mode</b></p><p>Removes the trailing spaces "
"in the document depending on the <b>mode</b>.</p><p>Possible values:"
"<ul><li><b>none</b>: never remove trailing spaces.</li><li><b>modified</b>: "
"remove trailing spaces only of modified lines.</li><li><b>all</b>: remove "
"trailing spaces in the entire document.</li></ul></p>"
msgstr "<p>set-remove-trailing-spaces <b>mode</b></p><p>Uklanja završne razmake iz dokumenta ovisno o načinu <b>mode</b>.</p><p>Moguće vrijednosti:<ul><li><b>none</b>: nikad ne uklanjaj završne razmake.</li><li><b>modified</b>: uklanjaj završne razmake samo u izmijenjenim redcima.</li><li><b>all</b>: uklanjaj završne razmake u cijelom dokumentu.</li></ul></p>"

#: utils/katecmds.cpp:124
#, kde-format
msgid ""
"<p>set-indent-width <b>width</b></p><p>Sets the indentation width to the "
"number <b>width</b>. Used only if you are indenting with spaces.</p>"
msgstr "<p>set-indent-width <b>width</b></p><p>Postavlja širinu uvlačenja na vrijednost <b>width</b>. Upotrebljava se samo pri uvlačenju razmacima.</p>"

#: utils/katecmds.cpp:129
#, kde-format
msgid ""
"<p>set-indent-mode <b>mode</b></p><p>The mode parameter is a value as seen "
"in the Tools - Indentation menu</p>"
msgstr "<p>set-indent-mode <b>mode</b></p><p>Parametar mode vrijednost je prikazana u izborniku Alati - Uvlačenje.</p>"

#: utils/katecmds.cpp:134
#, kde-format
msgid ""
"<p>set-auto-indent <b>enable</b></p><p>Enable or disable autoindentation.</"
"p><p>possible true values: 1 on true<br/>possible false values: 0 off false</"
"p>"
msgstr "<p>set-auto-indent <b>enable</b></p><p>Omogućuje ili onemogućuje automatsko uvlačenje.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:141
#, kde-format
msgid ""
"<p>set-line-numbers <b>enable</b></p><p>Sets the visibility of the line "
"numbers pane.</p><p> possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr "<p>set-line-numbers <b>enable</b></p><p>Postavlja vidljivost područja s brojevima redaka.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:148
#, kde-format
msgid ""
"<p>set-folding-markers <b>enable</b></p><p>Sets the visibility of the "
"folding markers pane.</p><p> possible true values: 1 on true<br/>possible "
"false values: 0 off false</p>"
msgstr "<p>set-folding-markers <b>enable</b></p><p>Postavlja vidljivost područja s oznakama sažimanja.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:155
#, kde-format
msgid ""
"<p>set-icon-border <b>enable</b></p><p>Sets the visibility of the icon "
"border.</p><p> possible true values: 1 on true<br/>possible false values: 0 "
"off false</p>"
msgstr "<p>set-icon-border <b>enable</b></p><p>Postavlja vidljivost obruba ikona.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:162
#, kde-format
msgid ""
"<p>set-word-wrap <b>enable</b></p><p>Enables dynamic word wrap according to "
"<b>enable</b></p><p> possible true values: 1 on true<br/>possible false "
"values: 0 off false</p>"
msgstr "<p>set-word-wrap <b>enable</b></p><p>Omogućuje dinamičko prelamanje riječi prema vrijednosti <b>enable</b>.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:169
#, kde-format
msgid ""
"<p>set-word-wrap-column <b>width</b></p><p>Sets the line width for hard "
"wrapping to <b>width</b>. This is used if you are having your text wrapped "
"automatically.</p>"
msgstr "<p>set-word-wrap-column <b>width</b></p><p>Postavlja širinu retka za tvrdo prelamanje na vrijednost <b>width</b>. Upotrebljava se kada je uključeno automatsko prelamanje teksta.</p>"

#: utils/katecmds.cpp:174
#, kde-format
msgid ""
"<p>set-replace-tabs-save <b>enable</b></p><p>When enabled, tabs will be "
"replaced with whitespace whenever the document is saved.</p><p> possible "
"true values: 1 on true<br/>possible false values: 0 off false</p>"
msgstr "<p>set-replace-tabs-save <b>enable</b></p><p>Ako je omogućeno, tabulatori će se pri svakom spremanju dokumenta zamijeniti bjelinama.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:181
#, kde-format
msgid ""
"<p>set-highlight <b>highlight</b></p><p>Sets the syntax highlighting system "
"for the document. The argument must be a valid highlight name, as seen in "
"the Tools → Highlighting menu. This command provides an autocompletion list "
"for its argument.</p>"
msgstr "<p>set-highlight <b>highlight</b></p><p>Postavlja isticanje sintakse dokumenta. Argument mora biti valjan naziv isticanja iz izbornika Alati → Isticanje. Ova naredba nudi popis za automatsko dovršavanje argumenta.</p>"

#: utils/katecmds.cpp:187
#, kde-format
msgid "<p>set-mode <b>mode</b></p><p>Sets the mode as seen in Tools - Mode</p>"
msgstr "<p>set-mode <b>mode</b></p><p>Postavlja način rada prikazan u izborniku Alati - Način rada.</p>"

#: utils/katecmds.cpp:192
#, kde-format
msgid ""
"<p>set-show-indent <b>enable</b></p><p>If enabled, indentation will be "
"visualized by a vertical dotted line.</p><p> possible true values: 1 on "
"true<br/>possible false values: 0 off false</p>"
msgstr "<p>set-show-indent <b>enable</b></p><p>Ako je omogućeno, uvlačenje će se prikazivati okomitom točkastom crtom.</p><p>Moguće vrijednosti za true: 1 on true<br/>moguće vrijednosti za false: 0 off false</p>"

#: utils/katecmds.cpp:198
#, kde-format
msgid "<p>Open the Print dialog to print the current document.</p>"
msgstr "<p>Otvori dijaloški okvir Ispis za ispis trenutačnog dokumenta.</p>"

#: utils/katecmds.cpp:313 utils/katecmds.cpp:340
#, kde-format
msgid "Missing argument. Usage: %1 <value>"
msgstr "Nedostaje parametar. Uporaba: %1 <vrijednost>"

