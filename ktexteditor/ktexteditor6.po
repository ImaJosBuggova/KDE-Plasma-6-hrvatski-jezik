#: view/kateview.cpp:711
#, kde-format
msgid "&Editor Color Theme"
msgstr "Tema boja &uređivača"

#: view/kateview.cpp:717
#, kde-format
msgid "&Indentation"
msgstr "&Uvlačenje"

#: view/kateview.cpp:726
#, kde-format
msgid "Select the entire text of the current document."
msgstr "Označava cijeli tekst trenutnog dokumenta."

#: view/kateview.cpp:729
#, kde-format
msgid ""
"If you have selected something within the current document, this will no "
"longer be selected."
msgstr "Ako ste odabrali nešto iz trenutnog dokumenta, ovo više neće biti odabrano."

#: view/kateview.cpp:733
#, kde-format
msgid "Enlarge Font"
msgstr "Povećaj Pismo"

#: view/kateview.cpp:735
#, kde-format
msgid "This increases the display font size."
msgstr "Povećavanje veličine fonta."

#: view/kateview.cpp:742
#, kde-format
msgid "Shrink Font"
msgstr "Smanji pismo"

#: view/kateview.cpp:744
#, kde-format
msgid "This decreases the display font size."
msgstr "Smanjivanje veličine fonta."

#: view/kateview.cpp:751
#, kde-format
msgid "Reset Font Size"
msgstr "Vrati zadanu veličinu fonta"

#: view/kateview.cpp:753
#, kde-format
msgid "This resets the display font size."
msgstr "Vraća zadanu veličinu fonta prikaza."

#: view/kateview.cpp:756
#, kde-format
msgid "Bl&ock Selection Mode"
msgstr "Uključi/isključi režim bl&okovskog označavanja"

#: view/kateview.cpp:759
#, kde-format
msgid ""
"This command allows switching between the normal (line based) selection mode "
"and the block selection mode."
msgstr "Ova komanda omogućuje prebacivanje između normalnog (baziranog na linijama)načina odabira i odabira blokova teksta."

#: view/kateview.cpp:763
#, kde-format
msgid "Switch to Next Input Mode"
msgstr "Prijeđi na sljedeći način unosa"

#: view/kateview.cpp:765
#, kde-format
msgid "Switch to the next input mode."
msgstr "Prelazi na sljedeći način unosa."

#: view/kateview.cpp:768
#, kde-format
msgid "Overwr&ite Mode"
msgstr "Rež&im prepisivanja"

#: view/kateview.cpp:771
#, kde-format
msgid ""
"Choose whether you want the text you type to be inserted or to overwrite "
"existing text."
msgstr "Odaberite želite li da tekst koji tipkate bude umetnut ili da se prepisuje postojeći tekst. "

#: view/kateview.cpp:775
#, kde-format
msgid "Show Whitespace"
msgstr "Prikaži bjeline"

#: view/kateview.cpp:778
#, kde-format
msgid ""
"If this option is checked, whitespaces in this document will be visible.<br /"
"><br />This is only a view option, meaning the document will not be changed."
msgstr "Ako je ova opcija odabrana, bjeline u ovom dokumentu bit će vidljive.<br /><br />Ovo je samo opcija prikaza; dokument se neće mijenjati."

#: view/kateview.cpp:782
#, kde-format
msgid "&Dynamic Word Wrap"
msgstr "Dinamičko omatanje riječi"

#: view/kateview.cpp:786
#, kde-format
msgid ""
"If this option is checked, the text lines will be wrapped at the view border "
"on the screen.<br /><br />This is only a view option, meaning the document "
"will not be changed."
msgstr "Ako je ova opcija odabrana, tekstualni će se retci prelamati uz rub prikaza na zaslonu.<br /><br />Ovo je samo opcija prikaza; dokument se neće mijenjati."

#: view/kateview.cpp:790
#, kde-format
msgid "Dynamic Word Wrap Indicators"
msgstr "Dinamički indikatori omatanja riječi"

#: view/kateview.cpp:792
#, kde-format
msgid "Choose when the Dynamic Word Wrap Indicators should be displayed"
msgstr "Odaberite kad se dinamički indikatori omatanja riječi trebaju pokazati"

#: view/kateview.cpp:794
#, kde-format
msgid "&Off"
msgstr "&Isključi"

#: view/kateview.cpp:794
#, kde-format
msgid "Follow &Line Numbers"
msgstr "&Prati brojeve redaka"

#: view/kateview.cpp:794
#, kde-format
msgid "&Always On"
msgstr "&Uvijek uključen"

#: view/kateview.cpp:798
#, kde-format
msgid "Static Word Wrap"
msgstr "Statičko prijelom"

#: view/kateview.cpp:800
#, kde-format
msgid ""
"If this option is checked, the text lines will be wrapped at the column "
"defined in the editing properties."
msgstr "Ako je ova opcija odabrana, tekstualni će se retci prelamati na stupcu zadanom u svojstvima uređivanja."

#: view/kateview.cpp:807
#, kde-format
msgid "Show Static &Word Wrap Marker"
msgstr "Prikazuj marker &statičkog prijeloma "

#: view/kateview.cpp:810
#, kde-format
msgid ""
"Show/hide the Word Wrap Marker, a vertical line drawn at the word wrap "
"column as defined in the editing properties"
msgstr "Pokaži/sakrij marker za omatanje riječi, vertikalna redak nacrtan na stupcu omatanja riječi kako je definirano u svojstivma uređivanja "

#: view/kateview.cpp:814
#, kde-format
msgid "Show Folding &Markers"
msgstr "Pokaži oznake preklapanja"

#: view/kateview.cpp:816
#, kde-format
msgid ""
"You can choose if the codefolding marks should be shown, if codefolding is "
"possible."
msgstr "Možete odabrati jesu li oznake preklapanja pokazane, ako je preklapanje moguće."

#: view/kateview.cpp:819
#, kde-format
msgid "Show &Icon Border"
msgstr "Pokaži okvir &ikona"

#: view/kateview.cpp:821
#, kde-format
msgid ""
"Show/hide the icon border.<br /><br />The icon border shows bookmark "
"symbols, for instance."
msgstr "Prikaži/sakrij rub ikone.<br /> <br /> Rub ikone primjerice prikazuje simbole oznaka (bookmarks)."

#: view/kateview.cpp:824
#, kde-format
msgid "Show &Line Numbers"
msgstr "Prikaži brojeve &redaka"

#: view/kateview.cpp:826
#, kde-format
msgid "Show/hide the line numbers on the left hand side of the view."
msgstr "Pokaži/sakrij brojeve linija na lijevoj strani pogleda."

#: view/kateview.cpp:829
#, kde-format
msgid "Show Scroll&bar Marks"
msgstr "Prikaži oznake klizača"

#: view/kateview.cpp:831
#, kde-format
msgid ""
"Show/hide the marks on the vertical scrollbar.<br /><br />The marks show "
"bookmarks, for instance."
msgstr "Prikaži/sakrij oznake na okomitom klizaču.<br /> <br /> Te oznake npr. prikazuju korisničke oznake (bookmarks)."

#: view/kateview.cpp:834
#, kde-format
msgid "Show Scrollbar Mini-Map"
msgstr "Prikaži minimapu klizne trake"

#: view/kateview.cpp:836
#, kde-format
msgid ""
"Show/hide the mini-map on the vertical scrollbar.<br /><br />The mini-map "
"shows an overview of the whole document."
msgstr "Prikazuje/sakriva minimapu na okomitoj kliznoj traci.<br /><br />Minimapa prikazuje pregled cijelog dokumenta."

