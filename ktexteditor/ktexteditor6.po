#: vimode/appcommands.cpp:79
#, kde-format
msgid "Document written to disk"
msgstr "Dokument je zapisan na disk"

#: vimode/appcommands.cpp:212
#, kde-format
msgid ""
"<p><b>w/wa &mdash; write document(s) to disk</b></p><p>Usage: <tt><b>w[a]</"
"b></tt></p><p>Writes the current document(s) to disk. It can be called in "
"two ways:<br /> <tt>w</tt> &mdash; writes the current document to disk<br /> "
"<tt>wa</tt> &mdash; writes all documents to disk.</p><p>If no file name is "
"associated with the document, a file dialog will be shown.</p>"
msgstr "<p><b>w/wa &mdash; zapiši dokumente na disk</b></p><p>Upotreba: <tt><b>w[a]</b></tt></p><p>Zapisuje trenutačne dokumente na disk. Može se pozvati na dva načina:<br /> <tt>w</tt> &mdash; zapisuje trenutačni dokument na disk<br /> <tt>wa</tt> &mdash; zapisuje sve dokumente na disk.</p><p>Ako dokument nema pridružen naziv datoteke, prikazat će se dijaloški okvir za odabir datoteke.</p>"

#: vimode/appcommands.cpp:223
#, kde-format
msgid ""
"<p><b>q/qa/wq/wqa &mdash; [write and] quit</b></p><p>Usage: <tt><b>[w]q[a]</"
"b></tt></p><p>Quits the application. If <tt>w</tt> is prepended, it also "
"writes the document(s) to disk. This command can be called in several ways:"
"<br /> <tt>q</tt> &mdash; closes the current view.<br /> <tt>qa</tt> &mdash; "
"closes all views, effectively quitting the application.<br /> <tt>wq</tt> "
"&mdash; writes the current document to disk and closes its view.<br /> "
"<tt>wqa</tt> &mdash; writes all documents to disk and quits.</p><p>In all "
"cases, if the view being closed is the last view, the application quits. If "
"no file name is associated with the document and it should be written to "
"disk, a file dialog will be shown.</p>"
msgstr "<p><b>q/qa/wq/wqa &mdash; [zapiši i] izađi</b></p><p>Upotreba: <tt><b>[w]q[a]</b></tt></p><p>Zatvara aplikaciju. Ako se ispred naredbe nalazi <tt>w</tt>, dokumenti se također zapisuju na disk. Naredba se može pozvati na nekoliko načina:<br /> <tt>q</tt> &mdash; zatvara trenutačni prikaz.<br /> <tt>qa</tt> &mdash; zatvara sve prikaze i izlazi iz aplikacije.<br /> <tt>wq</tt> &mdash; zapisuje trenutačni dokument na disk i zatvara njegov prikaz.<br /> <tt>wqa</tt> &mdash; zapisuje sve dokumente na disk i izlazi iz aplikacije.</p><p>U svakom slučaju aplikacija se zatvara ako je prikaz koji se zatvara posljednji. Ako dokument nema pridružen naziv datoteke, a treba ga zapisati na disk, prikazat će se dijaloški okvir za odabir datoteke.</p>"

#: vimode/appcommands.cpp:238
#, kde-format
msgid ""
"<p><b>x/xa &mdash; write and quit</b></p><p>Usage: <tt><b>x[a]</b></tt></"
"p><p>Saves document(s) and quits (e<b>x</b>its). This command can be called "
"in two ways:<br /> <tt>x</tt> &mdash; closes the current view.<br /> <tt>xa</"
"tt> &mdash; closes all views, effectively quitting the application.</p><p>In "
"all cases, if the view being closed is the last view, the application quits. "
"If no file name is associated with the document and it should be written to "
"disk, a file dialog will be shown.</p><p>Unlike the 'w' commands, this "
"command only writes the document if it is modified.</p>"
msgstr "<p><b>x/xa &mdash; zapiši i izađi</b></p><p>Upotreba: <tt><b>x[a]</b></tt></p><p>Sprema dokumente i izlazi (e<b>x</b>its). Naredba se može pozvati na dva načina:<br /> <tt>x</tt> &mdash; zatvara trenutačni prikaz.<br /> <tt>xa</tt> &mdash; zatvara sve prikaze i izlazi iz aplikacije.</p><p>U svakom slučaju aplikacija se zatvara ako je prikaz koji se zatvara posljednji. Ako dokument nema pridružen naziv datoteke, a treba ga zapisati na disk, prikazat će se dijaloški okvir za odabir datoteke.</p><p>Za razliku od naredbi 'w', ova naredba zapisuje dokument samo ako je izmijenjen.</p>"

#: vimode/appcommands.cpp:252
#, kde-format
msgid ""
"<p><b>sp,split&mdash; Split horizontally the current view into two</b></"
"p><p>Usage: <tt><b>sp[lit]</b></tt></p><p>The result is two views on the "
"same document.</p>"
msgstr "<p><b>sp,split&mdash; podijeli trenutačni prikaz vodoravno na dva dijela</b></p><p>Upotreba: <tt><b>sp[lit]</b></tt></p><p>Rezultat su dva prikaza istog dokumenta.</p>"

#: vimode/appcommands.cpp:258
#, kde-format
msgid ""
"<p><b>vs,vsplit&mdash; Split vertically the current view into two</b></"
"p><p>Usage: <tt><b>vs[plit]</b></tt></p><p>The result is two views on the "
"same document.</p>"
msgstr "<p><b>vs,vsplit&mdash; podijeli trenutačni prikaz okomito na dva dijela</b></p><p>Upotreba: <tt><b>vs[plit]</b></tt></p><p>Rezultat su dva prikaza istog dokumenta.</p>"

#: vimode/appcommands.cpp:264
#, kde-format
msgid ""
"<p><b>clo[se]&mdash; Close the current view</b></p><p>Usage: <tt><b>clo[se]</"
"b></tt></p><p>After executing it, the current view will be closed.</p>"
msgstr "<p><b>clo[se]&mdash; zatvori trenutačni prikaz</b></p><p>Upotreba: <tt><b>clo[se]</b></tt></p><p>Izvršavanjem se zatvara trenutačni prikaz.</p>"

#: vimode/appcommands.cpp:270
#, kde-format
msgid ""
"<p><b>[v]new &mdash; split view and create new document</b></p><p>Usage: "
"<tt><b>[v]new</b></tt></p><p>Splits the current view and opens a new "
"document in the new view. This command can be called in two ways:<br /> "
"<tt>new</tt> &mdash; splits the view horizontally and opens a new document."
"<br /> <tt>vnew</tt> &mdash; splits the view vertically and opens a new "
"document.<br /></p>"
msgstr "<p><b>[v]new &mdash; podijeli prikaz i stvori novi dokument</b></p><p>Upotreba: <tt><b>[v]new</b></tt></p><p>Dijeli trenutačni prikaz i otvara novi dokument u novom prikazu. Naredba se može pozvati na dva načina:<br /> <tt>new</tt> &mdash; dijeli prikaz vodoravno i otvara novi dokument.<br /> <tt>vnew</tt> &mdash; dijeli prikaz okomito i otvara novi dokument.<br /></p>"

#: vimode/appcommands.cpp:280
#, kde-format
msgid ""
"<p><b>e[dit] &mdash; reload current document</b></p><p>Usage: <tt><b>e[dit]</"
"b></tt></p><p>Starts <b>e</b>diting the current document again. This is "
"useful to re-edit the current file, when it was modified on disk.</p>"
msgstr "<p><b>e[dit] &mdash; ponovno učitaj trenutačni dokument</b></p><p>Upotreba: <tt><b>e[dit]</b></tt></p><p>Ponovno započinje uređivanje trenutačnog dokumenta. Korisno je za ponovno uređivanje datoteke koja je izmijenjena na disku.</p>"

#: vimode/appcommands.cpp:528
#, kde-format
msgid ""
"<p><b>b,buffer &mdash; Edit document N from the document list</b></"
"p><p>Usage: <tt><b>b[uffer] [N]</b></tt></p>"
msgstr "<p><b>b,buffer &mdash; uredi dokument N s popisa dokumenata</b></p><p>Upotreba: <tt><b>b[uffer] [N]</b></tt></p>"

#: vimode/appcommands.cpp:533
#, kde-format
msgid ""
"<p><b>bp,bprev &mdash; previous buffer</b></p><p>Usage: <tt><b>bp[revious] "
"[N]</b></tt></p><p>Goes to <b>[N]</b>th previous document (\"<b>b</b>uffer"
"\") in document list. </p><p> <b>[N]</b> defaults to one. </p><p>Wraps "
"around the start of the document list.</p>"
msgstr "<p><b>bp,bprev &mdash; prethodni međuspremnik</b></p><p>Upotreba: <tt><b>bp[revious] [N]</b></tt></p><p>Prelazi na <b>[N]</b>-ti prethodni dokument („<b>b</b>uffer”) na popisu dokumenata.</p><p>Zadana vrijednost za <b>[N]</b> je jedan.</p><p>Nastavlja od kraja nakon početka popisa dokumenata.</p>"

#: vimode/appcommands.cpp:541
#, kde-format
msgid ""
"<p><b>bn,bnext &mdash; switch to next document</b></p><p>Usage: "
"<tt><b>bn[ext] [N]</b></tt></p><p>Goes to <b>[N]</b>th next document "
"(\"<b>b</b>uffer\") in document list.<b>[N]</b> defaults to one. </"
"p><p>Wraps around the end of the document list.</p>"
msgstr "<p><b>bn,bnext &mdash; prijeđi na sljedeći dokument</b></p><p>Upotreba: <tt><b>bn[ext] [N]</b></tt></p><p>Prelazi na <b>[N]</b>-ti sljedeći dokument („<b>b</b>uffer”) na popisu dokumenata. Zadana vrijednost za <b>[N]</b> je jedan.</p><p>Nastavlja od početka nakon kraja popisa dokumenata.</p>"

#: vimode/appcommands.cpp:549
#, kde-format
msgid ""
"<p><b>bf,bfirst &mdash; first document</b></p><p>Usage: <tt><b>bf[irst]</b></"
"tt></p><p>Goes to the <b>f</b>irst document (\"<b>b</b>uffer\") in document "
"list.</p>"
msgstr "<p><b>bf,bfirst &mdash; prvi dokument</b></p><p>Upotreba: <tt><b>bf[irst]</b></tt></p><p>Prelazi na prvi dokument („<b>b</b>uffer”) na popisu dokumenata.</p>"

#: vimode/appcommands.cpp:555
#, kde-format
msgid ""
"<p><b>bl,blast &mdash; last document</b></p><p>Usage: <tt><b>bl[ast]</b></"
"tt></p><p>Goes to the <b>l</b>ast document (\"<b>b</b>uffer\") in document "
"list.</p>"
msgstr "<p><b>bl,blast &mdash; posljednji dokument</b></p><p>Upotreba: <tt><b>bl[ast]</b></tt></p><p>Prelazi na posljednji dokument („<b>b</b>uffer”) na popisu dokumenata.</p>"

#: vimode/appcommands.cpp:561
#, kde-format
msgid "<p><b>ls</b></p><p>list current buffers<p>"
msgstr "<p><b>ls</b></p><p>prikaži trenutačne međuspremnike<p>"

