#: perldoc.cpp:72
#, kde-format
msgid ""
"<html><head><title>No page requested</title><body>No page was requested.  "
"You can search for:<ul><li>functions using perldoc:/functions/foo</li>\n"
"\n"
"<li>faq entries using perldoc:/faq/search_terms</li><li>All other perldoc "
"documents using the name of the document, like<ul><li><a href='perldoc:/"
"perlreftut'>perldoc:/perlreftut</a></li><li>or <a href='perldoc:/Net::"
"HTTP'>perldoc:/Net::HTTP</a></li></ul></li></ul>\n"
"\n"
"</body></html>\n"
msgstr ""
"<html><head><title>Nije zatražena nijedna stranica</title><body>Nije zatražena "
"nijedna stranica. Možete pretraživati:<ul><li>funkcije pomoću "
"perldoc:/functions/foo</li>\n"
"\n"
"<li>često postavljana pitanja pomoću perldoc:/faq/pojmovi_pretraživanja</li>"
"<li>sve ostale dokumente perldoc prema nazivu dokumenta, na primjer:"
"<ul><li><a href='perldoc:/perlreftut'>perldoc:/perlreftut</a></li><li>ili "
"<a href='perldoc:/Net::HTTP'>perldoc:/Net::HTTP</a></li></ul></li></ul>\n"
"\n"
"</body></html>\n"

#: perldoc.cpp:91
#, kde-format
