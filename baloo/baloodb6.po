#, kde-format
msgid "integer"
msgstr "cijeli broj"

#: main.cpp:43
#, kde-format
msgid ""
"List only inaccessible entries.\n"
"Only applies to \"%1\""
msgstr ""
"Prikaži samo nedostupne unose.\n"
"Primjenjuje se samo na naredbu „%1”."

#: main.cpp:47
#, kde-format
msgid "Act only on item on mounted devices"
msgstr "Djeluj samo na stavkama na priključenim uređajima"

#: main.cpp:51
#, kde-format
msgid ""
"Print results of a cleaning operation, but do not change anything.\n"
"Only applies to \"%1\" command"
msgstr ""
"Ispiši rezultate čišćenja, ali ništa ne mijenjaj.\n"
"Primjenjuje se samo na naredbu „%1”."

