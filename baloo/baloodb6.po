#: main.cpp:33
#, kde-format
msgid ""
"Filter by device id.\n"
"0 (default) does not filter and everything is printed.\n"
"Positive numbers are including filters printing only the mentioned device "
"id.\n"
"Negative numbers are excluding filters printing everything but the mentioned "
"device id.\n"
"May be given multiple times."
msgstr ""
"Filtriraj prema ID-u uređaja.\n"
"0 (zadano) ne filtrira, pa se ispisuje sve.\n"
"Pozitivni brojevi uključuju filtar koji ispisuje samo navedeni ID uređaja.\n"
"Negativni brojevi isključuju filtar koji ispisuje sve osim navedenog ID-a "
"uređaja.\n"
"Može se navesti više puta."

