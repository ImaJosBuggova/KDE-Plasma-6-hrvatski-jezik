#. (itstool) path: component/name
#: org.kde.kompare.appdata.xml:9
msgid "Kompare"
msgstr "Kompare"

#. (itstool) path: component/summary
#: org.kde.kompare.appdata.xml:10
msgid "Diff/Patch Frontend"
msgstr "Sučelje za razlike i zakrpe"

#. (itstool) path: description/p
#: org.kde.kompare.appdata.xml:12
msgid "Kompare is a GUI front-end program that enables differences between source files to be viewed and merged. It can be used to compare differences on files or the contents of folders, and it supports a variety of diff formats and provide many options to customize the information level displayed."
msgstr "Kompare je grafički program koji omogućuje pregled i spajanje razlika među izvornim datotekama. Može se upotrebljavati za usporedbu datoteka ili sadržaja mapa, podržava razne formate za prikaz razlika i nudi brojne mogućnosti prilagodbe razine prikazanih informacija."

#. (itstool) path: description/p
#: org.kde.kompare.appdata.xml:15
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kompare.appdata.xml:17
msgid "Comparing differences on files or the contents of folders recursively."
msgstr "Rekurzivna usporedba datoteka ili sadržaja mapa."

#. (itstool) path: ul/li
#: org.kde.kompare.appdata.xml:18
msgid "Supports a variety of diff formats and provides many options to customize the information level displayed."
msgstr "Podrška za razne formate prikaza razlika i brojne mogućnosti prilagodbe razine prikazanih informacija."

#. (itstool) path: ul/li
#: org.kde.kompare.appdata.xml:19
msgid "Creating and applying patches."
msgstr "Stvaranje i primjena zakrpa."
