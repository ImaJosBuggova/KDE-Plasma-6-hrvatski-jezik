#: kio_sftp.cpp:316
#, kde-format
msgid "Incorrect or invalid passphrase"
msgstr "Netočna ili nevažeća lozinka"

#: kio_sftp.cpp:365
#, kde-format
msgid "Could not allocate callbacks"
msgstr "Nije moguće dodijeliti povratne pozive (callbacks)"

#: kio_sftp.cpp:378
#, kde-format
msgid "Could not set log verbosity."
msgstr "Nije moguće postaviti opširnost zapisivanja."

#: kio_sftp.cpp:383
#, kde-format
msgid "Could not set log userdata."
msgstr "Nije moguće postaviti korisničke podatke dnevnika."

#: kio_sftp.cpp:388
#, kde-format
msgid "Could not set log callback."
msgstr "Nije moguće postaviti povratni poziv dnevnika."

#: kio_sftp.cpp:424 kio_sftp.cpp:426 kio_sftp.cpp:979
#, kde-format
msgid "SFTP Login"
msgstr "SFTP prijava"

#: kio_sftp.cpp:441
#, kde-format
msgid "Use the username input field to answer this question."
msgstr "Upotrijebite polje za unos korisničkog imena za odgovor na ovo pitanje."

#: kio_sftp.cpp:456
#, kde-format
msgid "Please enter your password."
msgstr "Unesite svoju lozinku."

#: kio_sftp.cpp:461 kio_sftp.cpp:982
#, kde-format
msgid "Site:"
msgstr "Web-mjesto:"

#: kio_sftp.cpp:524
#, kde-format
msgctxt "error message. %1 is a path, %2 is a numeric error code"
msgid "Could not read link: %1 [%2]"
msgstr "Nije moguće čitati poveznicu: %1 [%2]"

#: kio_sftp.cpp:655
#, kde-format
msgid "Could not create a new SSH session."
msgstr "Nije moguće stvoriti novu SSH sesiju."

#: kio_sftp.cpp:666 kio_sftp.cpp:670
#, kde-format
msgid "Could not set a timeout."
msgstr "Nije moguće postaviti vremensko ograničenje."

#: kio_sftp.cpp:677
#, kde-format
msgid "Could not disable Nagle's Algorithm."
msgstr "Nije moguće onemogućiti Nagleov algoritam."

#: kio_sftp.cpp:683 kio_sftp.cpp:688
#, kde-format
msgid "Could not set compression."
msgstr "Nije moguće postaviti sažimanje."

#: kio_sftp.cpp:694
#, kde-format
msgid "Could not set host."
msgstr "Nije moguće postaviti domaćina."

#: kio_sftp.cpp:700
#, kde-format
msgid "Could not set port."
msgstr "Nije moguće postaviti priključak."

#: kio_sftp.cpp:708
#, kde-format
msgid "Could not set username."
msgstr "Nije moguće postaviti korisničko ime."

#: kio_sftp.cpp:715
#, kde-format
msgid "Could not parse the config file."
msgstr "Nije moguće raščlaniti konfiguracijsku datoteku."

#: kio_sftp.cpp:730
#, kde-kuit-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "Otvaranje SFTP veze s domaćinom %1:%2"

#: kio_sftp.cpp:770
#, kde-format
msgid "Could not get server public key type name"
msgstr "Nije moguće dohvatiti naziv vrste javnog ključa poslužitelja"

#: kio_sftp.cpp:782
#, kde-format
msgid "Could not create hash from server public key"
msgstr "Nije moguće stvoriti heš iz javnog ključa poslužitelja"

#: kio_sftp.cpp:791
#, kde-format
msgid "Could not create fingerprint for server public key"
msgstr "Nije moguće stvoriti otisak prsta za javni ključ poslužitelja"

#: kio_sftp.cpp:850
#, kde-format
msgid ""
"An %1 host key for this server was not found, but another type of key "
"exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%2"
msgstr ""
"Ključ domaćina %1 za ovaj poslužitelj nije pronađen, ali postoji druga vrsta ključa.\n"
"Napadač je možda promijenio zadani ključ poslužitelja kako bi zavarao vaš klijent da pomisli kako ključ ne postoji.\n"
"Obratite se svom sistemskom administratoru.\n"
"%2"

#: kio_sftp.cpp:867
#, kde-format
msgctxt "@title:window"
msgid "Host Identity Change"
msgstr "Promjena identiteta domaćina"

#: kio_sftp.cpp:869
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The host key for the server <emphasis>%1</emphasis> has changed.</"
"para><para>This could either mean that DNS spoofing is happening or the IP "
"address for the host and its host key have changed at the same time.</"
"para><para>The %2 key fingerprint sent by the remote host is:<bcode>%3</"
"bcode>Are you sure you want to continue connecting?</para>"
msgstr ""
"<para>Ključ domaćina za poslužitelj <emphasis>%1</emphasis> se promijenio.</"
"para><para>To bi moglo značiti da se događa DNS lažiranje ili da su se IP adresa "
"domaćina i njegov ključ promijenili u isto vrijeme.</"
"para><para>Otisak prsta ključa %2 koji je poslao udaljeni domaćin jest:<bcode>%3</"
"bcode>Jeste li sigurni da želite nastaviti s povezivanjem?</para>"

#: kio_sftp.cpp:879
#, kde-format
msgctxt "@title:window"
msgid "Host Verification Failure"
msgstr "Neuspjela provjera valjanosti domaćina"

#: kio_sftp.cpp:881
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>The authenticity of host <emphasis>%1</emphasis> cannot be established."
"</para><para>The %2 key fingerprint is:<bcode>%3</bcode>Are you sure you "
"want to continue connecting?</para>"
msgstr ""
"<para>Autentičnost domaćina <emphasis>%1</emphasis> ne može se utvrditi."
"</para><para>Otisak prsta ključa %2 jest:<bcode>%3</bcode>Jeste li sigurni da "
"želite nastaviti s povezivanjem?</para>"

#: kio_sftp.cpp:890
#, kde-format
msgctxt "@action:button"
msgid "Connect Anyway"
msgstr "Svejedno se poveži"

#: kio_sftp.cpp:913 kio_sftp.cpp:932 kio_sftp.cpp:953 kio_sftp.cpp:971
#: kio_sftp.cpp:1023 kio_sftp.cpp:1033
#, kde-format
msgid "Authentication failed."
msgstr "Autentifikacija nije uspjela."

#: kio_sftp.cpp:920
#, kde-format
msgid ""
"Authentication failed. The server didn't send any authentication methods"
msgstr ""
"Autentifikacija nije uspjela. Poslužitelj nije poslao nijednu metodu autentifikacije"

#: kio_sftp.cpp:980
#, kde-format
msgid "Please enter your username and password."
msgstr "Unesite svoje korisničko ime i lozinku."

#: kio_sftp.cpp:991
#, kde-format
msgid "Incorrect username or password"
msgstr "Netočno korisničko ime ili lozinka"

#: kio_sftp.cpp:1040
#, kde-format
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"Nije moguće zatražiti SFTP podsustav. Provjerite je li SFTP omogućen na "
"poslužitelju."

#: kio_sftp.cpp:1045
#, kde-format
msgid "Could not initialize the SFTP session."
msgstr "Nije moguće inicijalizirati SFTP sesiju."

#: kio_sftp.cpp:1049
#, kde-format
msgid "Successfully connected to %1"
msgstr "Uspješno povezano s %1"

#: kio_sftp.cpp:1106
#, kde-format
msgid "Invalid sftp context"
msgstr "Nevažeći sftp kontekst"

#: kio_sftp.cpp:1655
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"Nije moguće promijeniti dozvole za\n"
"%1"