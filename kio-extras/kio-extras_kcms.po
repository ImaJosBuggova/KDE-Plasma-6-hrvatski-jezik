#: trash/kcmtrash.cpp:207
#, kde-format
msgid ""
"<para>KDE's wastebin is configured to use the <b>Finder</b>'s Trash.<br></"
"para>"
msgstr ""
"<para>KDE-ov koš za smeće podešen je za korištenje koša za smeće u aplikaciji "
"<b>Finder</b>.<br></para>"

#: trash/kcmtrash.cpp:209
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Emptying KDE's wastebin will remove only KDE's trash items, "
"while<br>emptying the Trash through the Finder will delete everything.</"
"para><para>KDE's trash items will show up in a folder called KDE.trash, in "
"the Trash can.</para>"
msgstr ""
"<para>Pražnjenje KDE-ovog koša za smeće uklonit će samo KDE-ove stavke u "
"smeću, dok<br>će pražnjenje koša za smeće putem Findera izbrisati sve.</"
"para><para>KDE-ove stavke u smeću prikazat će se u mapi naziva KDE.trash, u "
"košu za smeće.</para>"

#: trash/kcmtrash.cpp:250
#, kde-format
msgid "Delete files older than"
msgstr "Izbriši datoteke starije od"

#: trash/kcmtrash.cpp:253
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <emphasis strong='true'>automatic deletion</"
"emphasis> of files that are older than the value specified. Leave this "
"disabled to <emphasis strong='true'>not</emphasis> automatically delete any "
"items after a certain timespan</para>"
msgstr ""
"<para>Označite ovaj okvir kako biste omogućili <emphasis "
"strong='true'>automatsko brisanje</emphasis> datoteka koje su starije od "
"navedene vrijednosti. Ostavite ovo onemogućenim kako <emphasis "
"strong='true'>ne</emphasis> biste automatski brisali stavke nakon određenog "
"vremenskog razdoblja</para>"

#: trash/kcmtrash.cpp:260
#, kde-format
msgctxt "@label:spinbox"
msgid "%v day"
msgid_plural "%v days"
msgstr[0] "%v dan"
msgstr[1] "%v dana"
msgstr[2] "%v dana"

#: trash/kcmtrash.cpp:262
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""
"<para>Postavite broj dana koliko datoteke mogu ostati u košu za smeće. Sve "
"datoteke starije od toga bit će automatski izbrisane.</para>"

#: trash/kcmtrash.cpp:266
#, kde-format
msgid "Cleanup:"
msgstr "Čišćenje:"

#: trash/kcmtrash.cpp:269
#, kde-format
msgid "Limit to"
msgstr "Ograniči na"

#: trash/kcmtrash.cpp:271
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""
"<para>Označite ovaj okvir kako biste ograničili koš za smeće na maksimalnu "
"količinu prostora na disku koju navedete u nastavku. U suprotnom, bit će "
"neograničeno.</para>"

#: trash/kcmtrash.cpp:274
#, kde-format
msgid "Size:"
msgstr "Veličina:"

#: trash/kcmtrash.cpp:280
#, kde-format
msgctxt "@label:spinbox Percent value"
msgid "%v%"
msgstr "%v%"

#: trash/kcmtrash.cpp:281
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr ""
"<para>Ovo je maksimalni postotak prostora na disku koji će se koristiti za "
"koš za smeće.</para>"

#: trash/kcmtrash.cpp:286
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""
"<para>Ovo je izračunata količina prostora na disku koja će biti dopuštena za "
"koš za smeće, kao maksimum.</para>"

#: trash/kcmtrash.cpp:290
#, kde-format
msgid "Show a warning"
msgstr "Prikaži upozorenje"

#: trash/kcmtrash.cpp:291
#, kde-format
msgid "Delete oldest files from trash"
msgstr "Izbriši najstarije datoteke iz koša za smeće"

#: trash/kcmtrash.cpp:292
#, kde-format
msgid "Delete biggest files from trash"
msgstr "Izbriši najveće datoteke iz koša za smeće"

#: trash/kcmtrash.cpp:294
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""
"<para>Kada se dosegne ograničenje veličine, najprije će se dati prednost "
"brisanju vrste datoteka koju navedete. Ako je postavljeno da vas upozori, "
"učinit će to umjesto automatskog brisanja datoteka.</para>"

#: trash/kcmtrash.cpp:296
#, kde-format
msgid "Full trash:"
msgstr "Pun koš za smeće:"

