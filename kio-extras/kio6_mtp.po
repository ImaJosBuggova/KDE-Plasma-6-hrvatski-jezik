#: kio_mtp.cpp:240
#, kde-format
msgctxt "Message shown when attempting to access an MTP device that is not fully accessible yet"
msgid "Could not access device. Make sure it is unlocked, and tap \"Allow\" on the popup on its screen. If that does not work, make sure MTP is enabled in its USB connection settings."
msgstr "Nije moguće pristupiti uređaju. Provjerite je li otključan i dodirnite „Dopusti” u skočnoj poruci na njegovu zaslonu. Ako to ne pomogne, provjerite je li MTP omogućen u postavkama USB veze."

#: kio_mtp.cpp:544
#, kde-format
msgid "Cannot copy/move files on the device itself"
msgstr "Nije moguće kopirati ni premještati datoteke na samom uređaju"