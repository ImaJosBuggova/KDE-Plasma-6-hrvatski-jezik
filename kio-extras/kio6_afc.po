#: afcutils.cpp:105
#, kde-format
msgid "The device is locked. Please enter the passcode on the device and try again."
msgstr "Uređaj je zaključan. Unesite šifru na uređaju i pokušajte ponovno."

#: afcutils.cpp:112
#, kde-format
msgid "You have denied this computer access to the device."
msgstr "Ovom računalu niste dopustili pristup uređaju."

#: afcutils.cpp:119
#, kde-format
msgid "You need to allow this computer to access the device. Please accept the prompt on the device and try again."
msgstr "Morate dopustiti ovom računalu pristup uređaju. Prihvatite upit na uređaju i pokušajte ponovno."

#: afcutils.cpp:127
#, kde-format
msgid "Cannot access the device. Make sure it is unlocked and allows this computer to access it."
msgstr "Nije moguće pristupiti uređaju. Provjerite je li otključan i dopušta li ovom računalu pristup."

#: afcutils.cpp:134
#, kde-format
msgid "Unhandled lockdownd code '%1'"
msgstr "Neobrađena lockdownd šifra '%1'"

#: afcutils.cpp:147
#, kde-format
msgid "Unhandled sbservices code '%1'"
msgstr "Neobrađena sbservices šifra '%1'"

