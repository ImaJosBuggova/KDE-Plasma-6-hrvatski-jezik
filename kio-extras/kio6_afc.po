msgid "Apps"
msgstr "Aplikacije"

#: kio_afc.cpp:617
#, kde-format
msgid "Cannot read without opening file first"
msgstr "Nije moguće čitati bez prethodnog otvaranja datoteke"

#: kio_afc.cpp:637
#, kde-format
msgid "Cannot seek without opening file first"
msgstr "Nije moguće tražiti u datoteci bez prethodnog otvaranja"

#: kio_afc.cpp:665
#, kde-format
msgid "Cannot write without opening file first"
msgstr "Nije moguće pisati bez prethodnog otvaranja datoteke"

#: kio_afc.cpp:817
#, kde-format
msgid "Cannot rename between devices."
msgstr "Nije moguće preimenovati između uređaja."