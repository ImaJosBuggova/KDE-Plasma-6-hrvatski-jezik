#: kio_man.cpp:517
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No man page matching <resource>%1</resource> could be found.<nl/><nl/>Check "
"that you have not mistyped the name of the page, and note that man page "
"names are case sensitive.<nl/><nl/>If the name is correct, then you may need "
"to extend the search path for man pages, either using the <envar>MANPATH</"
"envar> environment variable or a configuration file in the <filename>/etc</"
"filename> directory."
msgstr ""
"Nije pronađena stranica priručnika koja odgovara <resource>%1</resource>.<nl/><nl/>"
"Provjerite jeste li točno utipkali naziv stranice i imajte na umu da su nazivi stranica "
"priručnika osjetljivi na velika i mala slova.<nl/><nl/>Ako je naziv točan, možda ćete "
"morati proširiti putanju pretraživanja za stranice priručnika, bilo pomoću varijable okruženja "
"<envar>MANPATH</envar> ili konfiguracijske datoteke u direktoriju <filename>/etc</filename>."

#: kio_man.cpp:632
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The specified man page references another page <filename>%1</filename>,<nl/"
">but the referenced page <filename>%2</filename> could not be found."
msgstr ""
"Navedena stranica priručnika upućuje na drugu stranicu <filename>%1</filename>,<nl/>"
"ali ta navedena stranica <filename>%2</filename> nije pronađena."

#: kio_man.cpp:649
#, kde-kuit-format
msgctxt "@info"
msgid "The man page <filename>%1</filename> could not be read."
msgstr "Stranicu priručnika <filename>%1</filename> nije moguće pročitati."

#: kio_man.cpp:658
#, kde-kuit-format
msgctxt "@info"
msgid "The man page <filename>%1</filename> could not be converted."
msgstr "Stranicu priručnika <filename>%1</filename> nije moguće pretvoriti."

#: kio_man.cpp:713
#, kde-format
msgid "Manual Page Viewer Error"
msgstr "Pogreška preglednika stranica priručnika"

#: kio_man.cpp:747
#, kde-format
msgid "Multiple Manual Pages"
msgstr "Više stranica priručnika"

#: kio_man.cpp:748
#, kde-format
msgid "There is more than one matching man page:"
msgstr "Postoji više odgovarajućih stranica priručnika:"

#: kio_man.cpp:749
#, kde-format
msgid ""
"Note: if you read a man page in your language, be aware it can contain some "
"mistakes or be obsolete. In case of doubt, you should have a look at the "
"English version."
msgstr ""
"Napomena: ako čitate stranicu priručnika na svom jeziku, imajte na umu da može sadržavati "
"određene pogreške ili biti zastarjela. U slučaju sumnje, pogledajte verziju "
"na engleskom jeziku."

#: kio_man.cpp:757
#, kde-format
msgid "Possible Alternative Manual Pages"
msgstr "Moguće zamjenske stranice priručnika"

#: kio_man.cpp:758
#, kde-format
msgid "There were possible close matches:"
msgstr "Postoje moguća bliska podudaranja:"

#: kio_man.cpp:760
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No man page matching <resource>%1</resource> could be found, but there were "
"close or case insensitive matches as above."
msgstr ""
"Nije pronađena stranica priručnika koja odgovara <resource>%1</resource>, ali postoje "
"bliska podudaranja ili podudaranja bez obzira na velika i mala slova (prikazana iznad)."

