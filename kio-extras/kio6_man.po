#: kio_man.cpp:1444
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Could not find the <command>%1</command> program on your system. Please "
"install it if necessary, and ensure that it can be found using the "
"environment variable <envar>PATH</envar>."
msgstr ""
"Program <command>%1</command> nije pronađen na vašem sustavu. Ako je potrebno, "
"instalirajte ga i provjerite se može li se pronaći pomoću varijable okruženja "
"<envar>PATH</envar>."