#. (itstool) path: component/name
#: org.kde.filelight.appdata.xml:10
msgid "Filelight"
msgstr "Filelight"

#. (itstool) path: component/summary
#: org.kde.filelight.appdata.xml:11
msgid "Show disk usage and delete unused files"
msgstr "Prikažite korištenje diska i izbrišite nekorištene datoteke"

#. (itstool) path: description/p
#: org.kde.filelight.appdata.xml:13
msgid "Filelight is an application to visualize the disk usage on your computer by showing folders using an easy-to-understand view of concentric rings. Filelight makes it simple to free up space!"
msgstr "Filelight prikazuje korištenje diska na vašem računalu prikazom mapa u lako razumljivom obliku koncentričnih prstenova. Uz Filelight jednostavno ćete osloboditi prostor!"

#. (itstool) path: description/p
#: org.kde.filelight.appdata.xml:16
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:18
msgid "Scan local, remote, or removable disks"
msgstr "Skeniranje lokalnih, udaljenih ili izmjenjivih diskova"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:19
msgid "View detailed information about files and folders"
msgstr "Prikaz detaljnih informacija o datotekama i mapama"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:20
msgid "Delete files or folders that are taking up too much space"
msgstr "Brisanje datoteka ili mapa koje zauzimaju previše prostora"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:21
msgid "Integration into the Dolphin, Konqueror, and Krusader file managers"
msgstr "Integracija s upraviteljima datoteka Dolphin, Konqueror i Krusader"

#. (itstool) path: ul/li
#: org.kde.filelight.appdata.xml:22
msgid "Configurable color schemes"
msgstr "Prilagodljive sheme boja"
