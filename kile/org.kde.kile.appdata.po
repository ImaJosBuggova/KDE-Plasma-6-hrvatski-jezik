#. (itstool) path: component/name
#: org.kde.kile.appdata.xml:9
msgid "Kile"
msgstr ""
"Kile"

#. (itstool) path: component/summary
#: org.kde.kile.appdata.xml:10
msgid "TeX/LaTeX Editor"
msgstr ""
"TeX/LaTeX Editor"

#. (itstool) path: description/p
#: org.kde.kile.appdata.xml:12
msgid "Kile is a user-friendly TeX/LaTeX editor by KDE. Kile gives you the ability to use all the functionality of LaTeX in a graphical interface and has interactive preview mechanisms to readily see the results of editing."
msgstr ""
"Kile je KDE-ov TeX/LaTeX uređivač prilagođen korisniku. Kile vam daje mogućnost korištenja svih funkcionalnosti LaTeX-a u grafičkom sučelju i ima mehanizme interaktivnog pregleda kako biste lako vidjeli rezultate uređivanja."

#. (itstool) path: description/p
#: org.kde.kile.appdata.xml:15
msgid "Features:"
msgstr ""
"Značajke:"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:17
msgid "Compile, convert and view your document with one click"
msgstr ""
"Sastavite, pretvorite i pregledajte svoj dokument jednim klikom"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:18
msgid "Auto-completion of (La)TeX commands"
msgstr ""
"Automatsko dovršavanje (La)TeX-a naredbe"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:19
msgid "Templates and wizards make starting new documents very little work"
msgstr ""
"Predlošci i čarobnjaci čine pokretanje novih dokumenata vrlo malim poslom"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:20
msgid "Easy insertion of many standard tags and symbols and the option to define (an arbitrary number of) user defined tags"
msgstr ""
"Lako umetanje mnogih standardnih oznaka i simbola i opcija za definiranje (proizvoljnog broja) korisnički definiranih oznaka"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:21
msgid "Inverse and forward search: click in the DVI viewer and jump to the corresponding LaTeX line in the editor, or jump from the editor to the corresponding page in the viewer"
msgstr ""
"Inverzno i naprijed pretraživanje: kliknite u DVI pregledniku i skočite na odgovarajući LaTeX redak u uređivaču ili skočite iz uređivača na odgovarajuću stranicu u pregledniku"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:23
msgid "Finding chapter or sections is very easy, Kile constructs a list of all the chapter etc. in your document. You can use the list to jump to the corresponding section"
msgstr ""
"Pronalaženje poglavlja ili odjeljaka je vrlo jednostavno, Kile konstruira popis svih poglavlja itd. u vašem dokumentu. Možete koristiti popis za skok na odgovarajući odjeljak"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:25
msgid "Collect documents that belong together into a project"
msgstr ""
"Prikupite dokumente koji pripadaju zajedno u projekt"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:26
msgid "Easy insertion of citations and references when using projects"
msgstr ""
"Lako umetanje citata i referenci pri korištenju projekata"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:27
msgid "Flexible and smart build system to compile your LaTeX documents"
msgstr ""
"Fleksibilan i pametan sustav izrade za sastavljanje vaših LaTeX dokumenata"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:28
msgid "QuickPreview: preview a selected part of your document"
msgstr ""
"QuickPreview: pregledajte odabrani dio vašeg dokument"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:29
msgid "Easy access to various help sources"
msgstr ""
"Jednostavan pristup raznim izvorima pomoći"

#. (itstool) path: ul/li
#: org.kde.kile.appdata.xml:30
msgid "Advanced editing commands"
msgstr ""
"Napredne naredbe za uređivanje"

#. (itstool) path: screenshot/caption
#: org.kde.kile.appdata.xml:35
msgid "Document editing in Kile"
msgstr ""
"Uređivanje dokumenta u Kileu"
