#. (itstool) path: component/name
#: org.kde.kcachegrind.appdata.xml:9
msgid "KCachegrind"
msgstr "KCachegrind"

#. (itstool) path: component/summary
#: org.kde.kcachegrind.appdata.xml:10
msgid "Profiler Frontend"
msgstr "Sučelje profilera"

#. (itstool) path: description/p
#: org.kde.kcachegrind.appdata.xml:12
msgid "KCachegrind is a profile data visualization tool, used to determine the most time consuming parts in the execution of a program."
msgstr "KCachegrind je alat za vizualizaciju podataka profila koji služi za određivanje dijelova programa koji najviše vremena troše tijekom izvođenja."

#. (itstool) path: description/p
#: org.kde.kcachegrind.appdata.xml:15
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:17
msgid "KCachegrind visualizes profiles (i.e. runtime characteristics) of applications in various ways, including call graph visualisations and source/disassembler annotation."
msgstr "KCachegrind na različite načine vizualizira profile (odnosno karakteristike izvođenja) aplikacija, uključujući grafove poziva te anotacije izvornog koda i rastavljača."

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:19
msgid "It can load profiles generated by the cache simulation/call tracer Calltree, a Valgrind tool. Thus, profiling does not need any preparation, can cope with shared libraries and plugin architectures, and does not influence the measuring itself."
msgstr "Može učitati profile koje generira Calltree, Valgrindov alat za simulaciju predmemorije i praćenje poziva. Stoga za profiliranje nije potrebna priprema, podržane su dijeljene biblioteke i arhitekture s priključcima, a samo mjerenje nije pod utjecajem profiliranja."

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:21
msgid "Converter scripts for OProfile, Perl, and PHP."
msgstr "Skripte za pretvorbu za OProfile, Perl i PHP."

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:22
msgid "Switching between multiple visualization layouts."
msgstr "Prebacivanje između više rasporeda vizualizacije."

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:23
msgid "Call graph can be exported as image (PNG)."
msgstr "Graf poziva može se izvesti kao slika (PNG)."

#. (itstool) path: ul/li
#: org.kde.kcachegrind.appdata.xml:24
msgid "Simultaneous display of 2 event types in Call and Annotation View"
msgstr "Istodobni prikaz dviju vrsta događaja u prikazu poziva i anotacija"

#. (itstool) path: screenshot/caption
#: org.kde.kcachegrind.appdata.xml:29
msgid "Profiling data analysis with KCachegrind"
msgstr "Analiza podataka o profiliranju u programu KCachegrind"
