#. (itstool) path: component/name
#: org.kde.korganizer.appdata.xml:9
msgid "KOrganizer"
msgstr "KOrganizer"

#. (itstool) path: component/summary
#: org.kde.korganizer.appdata.xml:10
msgid "KOrganizer is a calendar and scheduling application"
msgstr "KOrganizer je aplikacija za kalendar i raspoređivanje"

#. (itstool) path: description/p
#: org.kde.korganizer.appdata.xml:12
msgid "KOrganizer is the calendar and scheduling component of Kontact. It provides management of events and tasks, alarm notification, web export, network transparent handling of data, group scheduling, import and export of calendar files and more. It is able to work together with a wide variety of calendaring services, including NextCloud, Kolab, Google Calendar and others. KOrganizer is fully customizable to your needs and is an integral part of the Kontact suite, which aims to be a complete solution for organizing your personal data. KOrganizer supports the two dominant standards for storing and exchanging calendar data, vCalendar and iCalendar."
msgstr "KOrganizer je Kontactova komponenta za kalendar i raspoređivanje. Omogućuje upravljanje događajima i zadacima, obavijesti o alarmima, izvoz na web, transparentnu mrežnu obradu podataka, grupno raspoređivanje te uvoz i izvoz kalendarskih datoteka i još mnogo toga. Radi s raznim kalendarskim uslugama, uključujući Nextcloud, Kolab, Google kalendar i druge. KOrganizer se može u potpunosti prilagoditi vašim potrebama i sastavni je dio paketa Kontact, koji nastoji biti cjelovito rješenje za organizaciju osobnih podataka. KOrganizer podržava dva vodeća standarda za pohranu i razmjenu kalendarskih podataka: vCalendar i iCalendar."

