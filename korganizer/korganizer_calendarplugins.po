#: datenums/configdialog.cpp:28
#, kde-format
msgctxt "@title:window"
msgid "Configure Day Numbers"
msgstr "Konfiguriranje brojeva dana"

#: datenums/configdialog.cpp:43
#, kde-format
msgctxt "@title:group"
msgid "Show Date Number"
msgstr "Prikaz broja dana"

#: datenums/configdialog.cpp:48
#, kde-format
msgctxt "@option:radio"
msgid "Show day number"
msgstr "Prikaži redni broj dana"

#: datenums/configdialog.cpp:49
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the year's day number"
msgstr "Prikaži redni broj dana u godini"

#: datenums/configdialog.cpp:50
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select this option to show the day number of the current year."
msgstr "Odaberite ovu mogućnost za prikaz rednog broja dana u tekućoj godini."

#: datenums/configdialog.cpp:53
#, kde-format
msgctxt "@option:radio"
msgid "Show days to end of year"
msgstr "Prikaži broj dana do kraja godine"

#: datenums/configdialog.cpp:54
#, kde-format
msgctxt "@info:tooltip"
msgid "Show the number of days remaining in the year"
msgstr "Prikaži koliko je dana preostalo do kraja godine"

#: datenums/configdialog.cpp:55
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show the number of days remaining in the current year."
msgstr "Odaberite ovu mogućnost za prikaz broja dana preostalih do kraja tekuće godine."

#: datenums/configdialog.cpp:58
#, kde-format
msgctxt "@option:radio"
msgid "Show both"
msgstr "Prikaži oboje"

#: datenums/configdialog.cpp:59
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Show both the year's day number and the number of days remaining in the year"
msgstr "Prikaži redni broj dana u godini i broj preostalih dana"

#: datenums/configdialog.cpp:61
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select this option to show both the year's day number and the number of days "
"remaining in the current year. The format is dayOfYear / daysTillEndOfYear"
msgstr "Odaberite ovu mogućnost za prikaz rednog broja dana u godini i broja dana preostalih do kraja tekuće godine. Format je danUGodini / daniDoKrajaGodine."

