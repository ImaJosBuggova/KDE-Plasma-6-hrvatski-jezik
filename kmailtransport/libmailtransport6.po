msgstr "Bez naziva"

#. i18n: ectx: label, entry (id), group (Transport $(transportId))
#: mailtransport.kcfg:12
#, kde-format
msgid "Unique identifier"
msgstr "Jedinstveni identifikator"

#. i18n: ectx: label, entry (name), group (Transport $(transportId))
#: mailtransport.kcfg:16
#, kde-format
msgid "User-visible transport name"
msgstr "Naziv prijenosa vidljiv korisniku"

#. i18n: ectx: whatsthis, entry (name), group (Transport $(transportId))
#: mailtransport.kcfg:17
#, kde-format
msgid "The name that will be used when referring to this server."
msgstr "Naziv koji će se koristiti za označavanje ovog poslužitelja."

#. i18n: ectx: label, entry (host), group (Transport $(transportId))
#: mailtransport.kcfg:30
#, kde-format
msgid "Host name of the server"
msgstr "Naziv poslužitelja"

#. i18n: ectx: whatsthis, entry (host), group (Transport $(transportId))
#: mailtransport.kcfg:31
#, kde-format
msgid "The domain name or numerical address of the SMTP server."
msgstr "Naziv domene ili numerička adresa SMTP poslužitelja."

#. i18n: ectx: label, entry (port), group (Transport $(transportId))
#: mailtransport.kcfg:34
#, kde-format
msgid "Port number of the server"
msgstr "Broj priključka poslužitelja"

#. i18n: ectx: whatsthis, entry (port), group (Transport $(transportId))
#: mailtransport.kcfg:35
#, kde-format
msgid ""
"The port number that the SMTP server is listening on. The default port is "
"465."
msgstr "Broj priključka na kojem SMTP poslužitelj osluškuje. Zadani priključak je 465."

#. i18n: ectx: label, entry (userName), group (Transport $(transportId))
#: mailtransport.kcfg:39
#, kde-format
msgid "User name needed for login"
msgstr "Korisničko ime potrebno za prijavu"

#. i18n: ectx: whatsthis, entry (userName), group (Transport $(transportId))
#: mailtransport.kcfg:40
#, kde-format
msgid "The user name to send to the server for authorization."
msgstr "Korisničko ime koje se šalje poslužitelju za autorizaciju."

#. i18n: ectx: label, entry (precommand), group (Transport $(transportId))
#: mailtransport.kcfg:43
#, kde-format
msgid "Command to execute before sending a mail"
msgstr "Naredba koju treba izvršiti prije slanja pošte"

#. i18n: ectx: whatsthis, entry (precommand), group (Transport $(transportId))
#: mailtransport.kcfg:44
#, kde-format
msgid ""
"A command to run locally, prior to sending email. This can be used to set up "
"SSH tunnels, for example. Leave it empty if no command should be run."
msgstr "Naredba koja se lokalno izvršava prije slanja e-pošte. Može se, primjerice, upotrijebiti za postavljanje SSH tunela. Ostavite je praznom ako ne želite pokretati naredbu."

#. i18n: ectx: label, entry (options), group (Transport $(transportId))
#: mailtransport.kcfg:47
#, kde-format
msgid "Options added to mailtransport method"
msgstr "Mogućnosti dodane metodi prijenosa pošte"

#. i18n: ectx: label, entry (requiresAuthentication), group (Transport $(transportId))
#: mailtransport.kcfg:50
#, kde-format
msgid "Server requires authentication"
msgstr "Poslužitelj zahtijeva autentikaciju"

#. i18n: ectx: whatsthis, entry (requiresAuthentication), group (Transport $(transportId))
#: mailtransport.kcfg:51
#, kde-format
msgid ""
"Check this option if your SMTP server requires authentication before "
"accepting mail. This is known as 'Authenticated SMTP' or simply ASMTP."
msgstr "Označite ovu mogućnost ako SMTP poslužitelj zahtijeva autentikaciju prije prihvaćanja pošte. To je poznato kao „Authenticated SMTP” ili skraćeno ASMTP."

#. i18n: ectx: label, entry (storePassword), group (Transport $(transportId))
#: mailtransport.kcfg:55
#, kde-format
msgid "Store password"
msgstr "Spremi lozinku"

#. i18n: ectx: whatsthis, entry (storePassword), group (Transport $(transportId))
#: mailtransport.kcfg:58
#, kde-format
msgid ""
"Check this option to have your password stored.\n"
"If KWallet is available the password will be stored there, which is "
"considered safe.\n"
"However, if KWallet is not available, the password will be stored in the "
"configuration file. The password is stored in an obfuscated format, but "
"should not be considered secure from decryption efforts if access to the "
"configuration file is obtained."
msgstr "Označite ovu mogućnost da biste spremili lozinku.\nAko je KWallet dostupan, lozinka će se ondje spremiti na siguran način.\nAko KWallet nije dostupan, lozinka će se spremiti u konfiguracijsku datoteku. Lozinka se sprema u prikrivenom obliku, ali se ne smatra sigurnom od dešifriranja ako netko dobije pristup konfiguracijskoj datoteci."

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:62
#, kde-format
msgid "Encryption method used for communication"
msgstr "Način šifriranja komunikacije"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:65
#, kde-format
msgid "No encryption"
msgstr "Bez šifriranja"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:68
#, kde-format
msgid "SSL/TLS encryption"
msgstr "Šifriranje SSL/TLS-om"

#. i18n: ectx: label, entry (encryption), group (Transport $(transportId))
#: mailtransport.kcfg:71
#, kde-format
msgid "STARTTLS encryption"
msgstr "Šifriranje STARTTLS-om"

#. i18n: ectx: label, entry (authenticationType), group (Transport $(transportId))
#: mailtransport.kcfg:77
#, kde-format
msgid "Authentication method"
msgstr "Način autentikacije"

#. i18n: ectx: label, entry (specifyHostname), group (Transport $(transportId))
#. i18n: ectx: label, entry (localHostname), group (Transport $(transportId))
#. i18n: ectx: label, entry (specifySenderOverwriteAddress), group (Transport $(transportId))
#. i18n: ectx: label, entry (senderOverwriteAddress), group (Transport $(transportId))
