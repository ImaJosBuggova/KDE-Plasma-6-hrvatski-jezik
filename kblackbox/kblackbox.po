msgstr "Pomakni udesno"

#: kbbmainwindow.cpp:167
#, kde-format
msgctxt "@action"
msgid "Switch Ball or Shoot Laser"
msgstr "Promijeni oznaku kuglice ili ispali laser"

#: kbbmainwindow.cpp:173
#, kde-format
msgctxt "@action"
