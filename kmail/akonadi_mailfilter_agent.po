#: filterlogdialog.cpp:47
#, kde-format
msgctxt "@action:button"
msgid "Share…"
msgstr "Podijeli…"

#: filterlogdialog.cpp:49
#, kde-format
msgctxt "@title:window"
msgid "Filter Log Viewer"
msgstr "Preglednik zapisnika filtra"

#: filterlogdialog.cpp:71
#, kde-format
msgctxt "@option:check"
msgid "&Log filter activities"
msgstr "&Bilježi aktivnosti filtra"

#: filterlogdialog.cpp:76
#, kde-format
msgid ""
"You can turn logging of filter activities on and off here. Of course, log "
"data is collected and shown only when logging is turned on. "
msgstr "Ovdje možete uključiti ili isključiti bilježenje aktivnosti filtra. Podaci se prikupljaju i prikazuju samo kada je bilježenje uključeno. "

#: filterlogdialog.cpp:97
#, kde-format
msgid "Logging Details"
msgstr "Pojedinosti zapisivanja"

#: filterlogdialog.cpp:104
#, kde-format
msgctxt "@option:check"
msgid "Log pattern description"
msgstr "Zabilježi opis uzorka"

#: filterlogdialog.cpp:109
#, kde-format
msgctxt "@option:check"
msgid "Log filter &rule evaluation"
msgstr "Zabilježi procjenu &pravila filtra"

#: filterlogdialog.cpp:114
#, kde-format
msgid ""
"You can control the feedback in the log concerning the evaluation of the "
"filter rules of applied filters: having this option checked will give "
"detailed feedback for each single filter rule; alternatively, only feedback "
"about the result of the evaluation of all rules of a single filter will be "
"given."
msgstr "Možete odrediti količinu povratnih informacija o procjeni pravila primijenjenih filtara koje se bilježe: ako uključite ovu mogućnost, dobit ćete detaljne povratne informacije za svako pravilo filtra; u suprotnom će se bilježiti samo rezultat procjene svih pravila pojedinog filtra."

#: filterlogdialog.cpp:121
#, kde-format
msgctxt "@option:check"
msgid "Log filter pattern evaluation"
msgstr "Zabilježi procjenu uzorka filtra"

#: filterlogdialog.cpp:126
#, kde-format
msgctxt "@option:check"
msgid "Log filter actions"
msgstr "Zabilježi radnje filtra"

#: filterlogdialog.cpp:136
#, kde-format
msgctxt "@label:textbox"
msgid "Log size limit:"
msgstr "Ograničenje veličine zapisnika:"

#: filterlogdialog.cpp:144
#, kde-format
msgid " KB"
msgstr " KB"

#: filterlogdialog.cpp:145
#, kde-format
msgctxt "@label:spinbox Set the size of the logfile to unlimited."
msgid "unlimited"
msgstr "neograničeno"

#: filterlogdialog.cpp:148
#, kde-format
msgid ""
"Collecting log data uses memory to temporarily store the log data; here you "
"can limit the maximum amount of memory to be used: if the size of the "
"collected log data exceeds this limit then the oldest data will be discarded "
"until the limit is no longer exceeded. "
msgstr "Za privremenu pohranu podataka zapisnika koristi se memorija. Ovdje možete ograničiti najveću količinu memorije: ako veličina prikupljenih podataka premaši ograničenje, najstariji će se podaci odbacivati dok se veličina ne smanji ispod ograničenja. "

#: filterlogdialog.cpp:326
#, kde-format
msgid ""
"Could not write the file %1:\n"
"\"%2\" is the detailed error description."
msgstr "Nije moguće zapisati datoteku %1:\nDetaljan opis pogreške: „%2”."

#: filterlogdialog.cpp:330
#, kde-format
msgctxt "@title:window"
msgid "KMail Error"
msgstr "Pogreška KMaila"

#: filtermanager.cpp:97
#, kde-format
msgid "Filtering message %1 of %2"
msgstr "Filtriranje poruke %1 od %2"

#: filtermanager.cpp:182
#, kde-format
msgid "Error applying mail filter move"
msgstr "Pogreška pri premještanju poruke pomoću filtra pošte"

#: filtermanager.cpp:190
#, kde-format
msgid "Error applying mail filter delete"
msgstr "Pogreška pri brisanju poruke pomoću filtra pošte"

#: filtermanager.cpp:198
#, kde-format
msgid "Error applying mail filter modifications"
msgstr "Pogreška pri izmjenama koje je zatražio filtar pošte"

#: filtermanager.cpp:215
#, kde-format
msgid "<b>Evaluating filter rules:</b> "
msgstr "<b>Procjena pravila filtra:</b> "

#: filtermanager.cpp:222
#, kde-format
msgid "<b>Filter rules have matched.</b>"
msgstr "<b>Pravila filtra odgovaraju poruci.</b>"

#: filtermanager.cpp:250
#, kde-format
msgid "<b>Begin filtering on message \"%1\" from \"%2\" at \"%3\" :</b>"
msgstr "<b>Početak filtriranja poruke „%1” od „%2” u „%3”:</b>"

#: filtermanager.cpp:583 mailfilteragent.cpp:222
#, kde-format
msgid "Filtering messages"
msgstr "Filtriranje poruka"

#: mailfilteragent.cpp:92
#, kde-format
msgid "Starting"
msgstr "Pokretanje"

#: mailfilteragent.cpp:114
#, kde-format
msgctxt "Notification when the filter log was enabled"
msgid "Mail Filter Log Enabled"
msgstr "Zapisnik filtra pošte omogućen"

#: mailfilteragent.cpp:116
#, kde-format
msgid "Show Log"
msgstr "Prikaži zapisnik"

#: mailfilteragent.cpp:183
#, kde-format
msgid "Ready"
msgstr "Spremno"

#: mailfilteragent.cpp:270
#, kde-format
msgid "Filtering in %1"
msgstr "Filtriranje u %1"

#: mailfilteragent.cpp:393
#, kde-format
msgid "Finished filtering, %1 message processed"
msgid_plural "Finished filtering, %1 messages processed"
msgstr[0] "Filtriranje dovršeno, obrađena je %1 poruka."
msgstr[1] "Filtriranje dovršeno, obrađene su %1 poruke."
msgstr[2] "Filtriranje dovršeno, obrađeno je %1 poruka."
