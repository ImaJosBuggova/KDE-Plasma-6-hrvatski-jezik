#. i18n: ectx: property (whatsThis), widget (QComboBox, kcfg_LoopOnGotoUnread)
#: ui/miscpagemaintab.ui:127
#, kde-format
msgctxt "what's this help"
msgid ""
"<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"https://www.w3.org/TR/"
"REC-html40/strict.dtd\">\n"
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css"
"\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-"
"weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">When jumping to the next "
"unread message, it may occur that no more unread messages are below the "
"current message.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Do not loop:</span> The search will stop at the last message "
"in the current folder.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Loop in current folder:</span> The search will continue at the "
"top of the message list, but not go to another folder.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Loop in all folders:</span> The search will continue at the "
"top of the message list. If no unread messages are found it will then "
"continue to the next folder.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\">Similarly, when searching "
"for the previous unread message, the search will start from the bottom of "
"the message list and continue to the previous folder depending on which "
"option is selected.</p>\n"
"<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-"
"right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-"
"weight:600;\">Loop in all marked folders: </span>This is the same as \"Loop "
"in all folders\" except that only folders are taken into account which have "
"been marked with the folder property \"Act on new/unread mail in this folder"
"\".</p></body></html>"
msgstr "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"https://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:10pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Pri prelasku na sljedeću nepročitanu poruku može se dogoditi da ispod trenutačne više nema nepročitanih poruka.</p>\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Ne ponavljaj:</span> Pretraživanje će se zaustaviti na posljednjoj poruci trenutačne mape.</p>\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Ponavljaj u trenutačnoj mapi:</span> Pretraživanje će se nastaviti od vrha popisa poruka, ali neće prijeći u drugu mapu.</p>\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Ponavljaj u svim mapama:</span> Pretraživanje će se nastaviti od vrha popisa poruka. Ako nema nepročitanih poruka, nastavit će se u sljedećoj mapi.</p>\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Slično tome, pri traženju prethodne nepročitane poruke pretraživanje će početi od dna popisa poruka, a zatim će se, ovisno o odabranoj opciji, nastaviti u prethodnoj mapi.</p>\n<p style=\" margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600;\">Ponavljaj u svim označenim mapama: </span>To je isto što i „Ponavljaj u svim mapama”, osim što se uzimaju u obzir samo mape označene svojstvom „Postupaj s novom/nepročitanom poštom u ovoj mapi”.</p></body></html>"

