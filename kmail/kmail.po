#: identity/identitydialog.cpp:616
#, kde-format
msgid ""
"<qt><h3>Reply-To addresses</h3><p>This sets the <tt>Reply-to:</tt> header to "
"contain a different email address to the normal <tt>From:</tt> address.</"
"p><p>This can be useful when you have a group of people working together in "
"similar roles. For example, you might want any emails sent to have your "
"email in the <tt>From:</tt> field, but any responses to go to a group "
"address.</p><p>If in doubt, leave this field blank.</p></qt>"
msgstr "<qt><h3>Adrese za odgovor</h3><p>Ovom se postavkom u zaglavlje <tt>Reply-to:</tt> unosi adresa e-pošte različita od uobičajene adrese <tt>From:</tt>.</p><p>To može biti korisno kada skupina osoba surađuje u sličnim ulogama. Primjerice, možete postaviti svoju adresu u polje <tt>From:</tt>, a odgovore usmjeriti na grupnu adresu.</p><p>Ako niste sigurni, ostavite polje praznim.</p></qt>"

#: identity/identitydialog.cpp:634
#, kde-format
msgctxt "@label:textbox"
msgid "&CC addresses:"
msgstr "Adrese &kopije:"

#: identity/identitydialog.cpp:640
#, kde-format
msgid ""
"<qt><h3>CC (Carbon Copy) addresses</h3><p>The addresses that you enter here "
"will be added to each outgoing mail that is sent with this identity.</"
"p><p>This is commonly used to send a copy of each sent message to another "
"account of yours.</p><p>To specify more than one address, use commas to "
"separate the list of CC recipients.</p><p>If in doubt, leave this field "
"blank.</p></qt>"
msgstr "<qt><h3>Adrese kopije (CC)</h3><p>Ovdje unesene adrese dodavat će se svakoj odlaznoj poruci poslanoj ovim identitetom.</p><p>Ta se mogućnost obično koristi za slanje kopije svake poruke na drugi vlastiti račun.</p><p>Više adresa kopije odvojite zarezima.</p><p>Ako niste sigurni, ostavite polje praznim.</p></qt>"

#: identity/identitydialog.cpp:656
#, kde-format
msgctxt "@label:textbox"
msgid "&BCC addresses:"
msgstr "Adrese &skrivene kopije:"

#: identity/identitydialog.cpp:660
#, kde-format
msgid ""
"<qt><h3>BCC (Blind Carbon Copy) addresses</h3><p>The addresses that you "
"enter here will be added to each outgoing mail that is sent with this "
"identity. They will not be visible to other recipients.</p><p>This is "
"commonly used to send a copy of each sent message to another account of "
"yours.</p><p>To specify more than one address, use commas to separate the "
"list of BCC recipients.</p><p>If in doubt, leave this field blank.</p></qt>"
msgstr "<qt><h3>Adrese skrivene kopije (BCC)</h3><p>Ovdje unesene adrese dodavat će se svakoj odlaznoj poruci poslanoj ovim identitetom. Ostali ih primatelji neće vidjeti.</p><p>Ta se mogućnost obično koristi za slanje kopije svake poruke na drugi vlastiti račun.</p><p>Više adresa skrivene kopije odvojite zarezima.</p><p>Ako niste sigurni, ostavite polje praznim.</p></qt>"

