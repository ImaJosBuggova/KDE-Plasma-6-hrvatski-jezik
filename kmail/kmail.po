#: identity/identitydialog.cpp:363
#, kde-format
msgctxt "@title:tab General identity settings."
msgid "General"
msgstr "Općenito"

#: identity/identitydialog.cpp:370
#, kde-format
msgctxt "@label:textbox"
msgid "&Your name:"
msgstr "&Vaše ime:"

#: identity/identitydialog.cpp:375
#, kde-format
msgid ""
"<qt><h3>Your name</h3><p>This field should contain your name as you would "
"like it to appear in the email header that is sent out;</p><p>if you leave "
"this blank your real name will not appear, only the email address.</p></qt>"
msgstr "<qt><h3>Vaše ime</h3><p>U ovo polje unesite ime koje želite prikazati u zaglavlju poslane poruke e-pošte.</p><p>Ako polje ostavite praznim, neće se prikazati vaše ime, već samo adresa e-pošte.</p></qt>"

#: identity/identitydialog.cpp:386
#, kde-format
msgctxt "@label:textbox"
msgid "Organi&zation:"
msgstr "&Organizacija:"

#: identity/identitydialog.cpp:391
#, kde-format
msgid ""
"<qt><h3>Organization</h3><p>This field should have the name of your "
"organization if you would like it to be shown in the email header that is "
"sent out.</p><p>It is safe (and normal) to leave this blank.</p></qt>"
msgstr "<qt><h3>Organizacija</h3><p>U ovo polje unesite naziv organizacije ako ga želite prikazati u zaglavlju poslane poruke e-pošte.</p><p>Slobodno ga možete ostaviti praznim, što je i uobičajeno.</p></qt>"

#: identity/identitydialog.cpp:403
#, kde-format
msgctxt "@label:textbox"
msgid "&Email address:"
msgstr "Adresa &e-pošte:"

#: identity/identitydialog.cpp:408
#, kde-format
msgid ""
"<qt><h3>Email address</h3><p>This field should have your full email address."
"</p><p>This address is the primary one, used for all outgoing mail. If you "
"have more than one address, either create a new identity, or add additional "
"alias addresses in the field below.</p><p>If you leave this blank, or get it "
"wrong, people will have trouble replying to you.</p></qt>"
msgstr "<qt><h3>Adresa e-pošte</h3><p>U ovo polje unesite svoju punu adresu e-pošte.</p><p>Ta je adresa primarna i koristi se za svu odlaznu poštu. Ako imate više adresa, izradite novi identitet ili u polje u nastavku dodajte pseudonime.</p><p>Ako polje ostavite praznim ili unesete pogrešnu adresu, drugi će vam teško moći odgovoriti.</p></qt>"

#: identity/identitydialog.cpp:427
#, kde-format
msgctxt "@label:textbox"
msgid "Email a&liases:"
msgstr "&Pseudonimi adrese e-pošte:"

#: identity/identitydialog.cpp:432
#, kde-format
msgid ""
"<qt><h3>Email aliases</h3><p>This field contains alias addresses that should "
"also be considered as belonging to this identity (as opposed to representing "
"a different identity).</p><p>Example:</p><table><tr><th>Primary address:</"
"th><td>first.last@example.org</td></tr><tr><th>Aliases:</"
"th><td>first@example.org<br>last@example.org</td></tr></table><p>Type one "
"alias address per line.</p></qt>"
msgstr "<qt><h3>Pseudonimi adrese e-pošte</h3><p>Ovo polje sadrži dodatne adrese koje pripadaju ovom identitetu, a ne predstavljaju zaseban identitet.</p><p>Primjer:</p><table><tr><th>Primarna adresa:</th><td>first.last@example.org</td></tr><tr><th>Pseudonimi:</th><td>first@example.org<br>last@example.org</td></tr></table><p>Unesite po jednu pseudonimnu adresu u svaki redak.</p></qt>"

#: identity/identitydialog.cpp:449
#, kde-format
msgid "Cryptography"
msgstr "Kriptografija"

#: identity/identitydialog.cpp:455
#, kde-format
msgid ""
"<qt><p>The OpenPGP key you choose here will be used to digitally sign "
"messages. You can also use GnuPG keys.</p><p>You can leave this blank, but "
"KMail will not be able to digitally sign emails using OpenPGP; normal mail "
"functions will not be affected.</p><p>You can find out more about keys at "
"<a>https://www.gnupg.org</a></p></qt>"
msgstr "<qt><p>Ovdje odabrani OpenPGP ključ koristit će se za digitalno potpisivanje poruka. Možete koristiti i GnuPG ključeve.</p><p>Polje možete ostaviti praznim, no KMail tada neće moći digitalno potpisivati poruke e-pošte pomoću OpenPGP-a. Uobičajene funkcije pošte neće biti pogođene.</p><p>Više o ključevima možete saznati na stranici <a>https://www.gnupg.org</a></p></qt>"

#: identity/identitydialog.cpp:461
#, kde-format
msgctxt "@label:textbox"
msgid "OpenPGP signing key:"
msgstr "OpenPGP ključ za potpisivanje:"

#: identity/identitydialog.cpp:467
#, kde-format
msgctxt "@option:check"
msgid "Use same key for encryption and signing"
msgstr "Koristi isti ključ za šifriranje i potpisivanje"

#: identity/identitydialog.cpp:477
#, kde-format
msgid "OpenPGP key:"
msgstr "OpenPGP ključ:"

#: identity/identitydialog.cpp:484
#, kde-format
msgid "OpenPGP signing key:"
msgstr "OpenPGP ključ za potpisivanje:"

#: identity/identitydialog.cpp:501
#, kde-format
msgid ""
"<qt><p>The OpenPGP key you choose here will be used to encrypt messages to "
"yourself and for the \"Attach My Public Key\" feature in the composer. You "
"can also use GnuPG keys.</p><p>You can leave this blank, but KMail will not "
"be able to encrypt copies of outgoing messages to you using OpenPGP; normal "
"mail functions will not be affected.</p><p>You can find out more about keys "
"at <a>https://www.gnupg.org</a></p></qt>"
msgstr "<qt><p>Ovdje odabrani OpenPGP ključ koristit će se za šifriranje poruka upućenih vama i za značajku „Priloži moj javni ključ” u sastavljaču. Možete koristiti i GnuPG ključeve.</p><p>Polje možete ostaviti praznim, no KMail tada neće moći šifrirati kopije odlaznih poruka upućene vama pomoću OpenPGP-a. Uobičajene funkcije pošte neće biti pogođene.</p><p>Više o ključevima možete saznati na stranici <a>https://www.gnupg.org</a></p></qt>"

#: identity/identitydialog.cpp:508
#, kde-format
msgctxt "@label:textbox"
msgid "OpenPGP encryption key:"
msgstr "OpenPGP ključ za šifriranje:"

#: identity/identitydialog.cpp:518
#, kde-format
msgid ""
"<qt><p>The S/MIME (X.509) certificate you choose here will be used to "
"digitally sign messages.</p><p>You can leave this blank, but KMail will not "
"be able to digitally sign emails using S/MIME; normal mail functions will "
"not be affected.</p></qt>"
msgstr "<qt><p>Ovdje odabrani certifikat S/MIME (X.509) koristit će se za digitalno potpisivanje poruka.</p><p>Polje možete ostaviti praznim, no KMail tada neće moći digitalno potpisivati poruke e-pošte pomoću S/MIME-a. Uobičajene funkcije pošte neće biti pogođene.</p></qt>"

#: identity/identitydialog.cpp:523
#, kde-format
msgctxt "@label:textbox"
msgid "S/MIME signing certificate:"
msgstr "Certifikat za potpisivanje S/MIME-om:"

#: identity/identitydialog.cpp:537
#, kde-format
msgid ""
"<qt><p>The S/MIME certificate you choose here will be used to encrypt "
"messages to yourself and for the \"Attach My Certificate\" feature in the "
"composer.</p><p>You can leave this blank, but KMail will not be able to "
"encrypt copies of outgoing messages to you using S/MIME; normal mail "
"functions will not be affected.</p></qt>"
msgstr "<qt><p>Ovdje odabrani certifikat S/MIME koristit će se za šifriranje poruka upućenih vama i za značajku „Priloži moj certifikat” u sastavljaču.</p><p>Polje možete ostaviti praznim, no KMail tada neće moći šifrirati kopije odlaznih poruka upućene vama pomoću S/MIME-a. Uobičajene funkcije pošte neće biti pogođene.</p></qt>"

