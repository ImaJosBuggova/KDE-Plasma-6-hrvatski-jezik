#. (itstool) path: component/name
#: org.kde.kgoldrunner.appdata.xml:9
msgid "KGoldrunner"
msgstr "KGoldrunner"

#. (itstool) path: component/summary
#: org.kde.kgoldrunner.appdata.xml:10
msgid "Hunt Gold, Dodge Enemies and Solve Puzzles"
msgstr "Pronađite zlato, izbjegnite neprijatelje i riješite zagonetke"

#. (itstool) path: description/p
#: org.kde.kgoldrunner.appdata.xml:12
msgid "KGoldrunner is an action game where the hero runs through a maze, climbs stairs, dig holes and dodges enemies in order to collect all the gold nuggets and escape to the next level. Your enemies are also after the gold. Worse still, they are after you!."
msgstr "KGoldrunner je akcijska igra u kojoj junak prolazi labirintom, penje se stubama, kopa rupe i izbjegava neprijatelje kako bi prikupio sve zlatne grumene i prešao na sljedeću razinu. I neprijatelji traže zlato. Još gore, traže i vas!"

#. (itstool) path: description/p
#: org.kde.kgoldrunner.appdata.xml:17
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
