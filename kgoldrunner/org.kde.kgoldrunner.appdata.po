msgid "Very very difficult levels"
msgstr "Vrlo, vrlo teške razine"

#. (itstool) path: ul/li
#: org.kde.kgoldrunner.appdata.xml:25
msgid "Keyboard or mouse control"
msgstr "Upravljanje tipkovnicom ili mišem"

#. (itstool) path: ul/li
