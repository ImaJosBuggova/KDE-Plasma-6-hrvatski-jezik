#: src/org.kde.kgoldrunner.desktop:2
msgctxt "Name"
msgid "KGoldrunner"
msgstr "KGoldrunner"

#: src/org.kde.kgoldrunner.desktop:72
msgctxt "GenericName"
msgid "Hunt Gold, Dodge Enemies and Solve Puzzles"
msgstr "Pronađite zlato, izbjegnite neprijatelje i riješite zagonetke"

#: src/org.kde.kgoldrunner.desktop:126
msgctxt "Comment"
msgid "A game of action and puzzle-solving"
msgstr "Akcijska igra sa zagonetkama"

#: themes/black-on-white.desktop:2
msgctxt "Name"
msgid "Black on White"
msgstr "Crno na bijelom"

#: themes/black-on-white.desktop:61
msgctxt "Description"
msgid "A monochrome, black on white theme for KGoldrunner"
msgstr "Jednobojna crno-bijela tema za KGoldrunner"

#: themes/default.desktop:2
msgctxt "Name"
msgid "KGoldRunner Default"
msgstr "Zadana tema za KGoldrunner"

#: themes/default.desktop:59
msgctxt "Description"
msgid "A light and clean theme for KDE4"
msgstr "Svijetla i jednostavna tema za KDE 4"

#: themes/egypt.desktop:2
msgctxt "Name"
msgid "The Treasure of Egypt"
msgstr "Blago Egipta"

#: themes/egypt.desktop:58
msgctxt "Description"
msgid "Help Matt Goldrunner escape the traps of ancient Egypt."
msgstr "Pomozite Mattu Goldrunneru da izbjegne zamke drevnog Egipta."

#: themes/kgr_geek.desktop:2
msgctxt "Name"
msgid "Geek City"
msgstr "Grad računalnih entuzijasta"

#: themes/kgr_geek.desktop:56
msgctxt "Description"
msgid "The hero is trapped inside a computer."
msgstr "Junak je zarobljen u računalu."

#: themes/nostalgia-blues.desktop:2
msgctxt "Name"
msgid "Nostalgia Blues"
msgstr "Plava nostalgija"

#: themes/nostalgia-blues.desktop:55
msgctxt "Description"
msgid ""
"A theme for KGoldrunner that brings back that 8-bit look... now in blue!"
msgstr "Tema za KGoldrunner koja vraća 8-bitni izgled... sada u plavoj boji!"

#: themes/nostalgia.desktop:2
msgctxt "Name"
msgid "Nostalgia"
msgstr "Nostalgija"

#: themes/nostalgia.desktop:58
msgctxt "Description"
msgid "A scalable theme for KGoldrunner that brings back that 8-bit look..."
msgstr "Prilagodljiva tema za KGoldrunner koja vraća 8-bitni izgled..."
