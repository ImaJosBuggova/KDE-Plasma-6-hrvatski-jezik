#. (itstool) path: component/name
#: org.kde.kclock.appdata.xml:12
msgid "Clock"
msgstr "Sat"

#. (itstool) path: component/summary
#: org.kde.kclock.appdata.xml:13
msgid "Keep time and set alarms"
msgstr "Pratite vrijeme i postavljajte alarme"

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:18
msgid "A universal clock application for desktop and mobile. Clock includes a stopwatch and a world clock, and allows you to set multiple alarms and timers."
msgstr "Univerzalna aplikacija sata za računala i mobilne uređaje. Sat uključuje štopericu i svjetski sat te omogućuje postavljanje više alarma i mjerača vremena."

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:19
msgid "It contains alarm, timer, stopwatch and timezone functionalities. Alarms and timers are able to wake the device from suspend on Plasma."
msgstr "Sadrži funkcije alarma, mjerača vremena, štoperice i vremenskih zona. U Plasmi alarmi i mjerači vremena mogu probuditi uređaj iz stanja suspenzije."

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:32
msgid "Mobile view"
msgstr "Mobilni prikaz"

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:36
msgid "Desktop view"
msgstr "Prikaz na računalu"

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:40
msgid "Timers page"
msgstr "Stranica mjerača vremena"

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:44
msgid "Timer page"
msgstr "Stranica mjerača vremena"

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:48
msgid "Stopwatch page"
msgstr "Stranica štoperice"

#. (itstool) path: screenshot/caption
#: org.kde.kclock.appdata.xml:52
msgid "Alarms page"
msgstr "Stranica alarma"

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:117
msgid "New features and bugfixes in this release:"
msgstr "Nove značajke i ispravci grešaka u ovom izdanju:"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:119
msgid "Fixed timer add one minute button."
msgstr "Ispravljen je gumb za dodavanje jedne minute mjeraču vremena."

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:120
msgid "Switched to tab bar based sidebar (similar to bottom navigation bar)."
msgstr "Bočna traka zamijenjena je trakom kartica (slično donjoj navigacijskoj traci)."

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:137
msgid "Support for background daemon when using flatpak"
msgstr "Dodana je podrška za pozadinski servis pri korištenju Flatpaka"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:138
msgid "Fix excessive log generation on non-Plasma system"
msgstr "Ispravljeno je prekomjerno stvaranje zapisa na sustavima koji ne koriste Plasmu"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:146
msgid "Fix \"Clock daemon not found\" popup message"
msgstr "Ispravljena je skočna poruka „Pozadinski servis sata nije pronađen”"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:147
msgid "Various bugfixes and user interface improvements"
msgstr "Razni ispravci grešaka i poboljšanja korisničkog sučelja"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:148
msgid "Add a sound picker component for listing alarm sounds"
msgstr "Dodana je komponenta za odabir zvuka alarma"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:149
msgid "Start snooze only after button is pressed"
msgstr "Odgoda počinje tek nakon pritiska gumba"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:150
msgid "Fix alarms not working on PinePhone"
msgstr "Ispravljeni su problemi s alarmima na uređaju PinePhone"

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:156 org.kde.kclock.appdata.xml:173
msgid "Changes:"
msgstr "Promjene:"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:158
msgid "Kirigami's bottom navigation bar component is now used for mobile"
msgstr "Na mobilnim uređajima sada se koristi Kirigamijeva donja navigacijska traka"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:159
msgid "A Plasma style sidebar is now used on desktop"
msgstr "Na računalima se sada koristi bočna traka u stilu Plasme"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:160
msgid "The system tray item now only shows when alarms are pending"
msgstr "Ikona u programskoj traci sada se prikazuje samo kada postoje aktivni alarmi"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:161
msgid "The daemon automatically stops if no alarms and timers are pending"
msgstr "Pozadinski servis automatski se zaustavlja kada nema aktivnih alarma ni mjerača vremena"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:162
msgid "Action bars are now used on the timer and alarms forms page"
msgstr "Na obrascima mjerača vremena i alarma sada se koriste trake s radnjama"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:163
msgid "The settings button has been moved to the top actions bar"
msgstr "Gumb postavki premješten je na gornju traku radnji"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:175
msgid "Watch DBus for PowerDevil, so wake from suspend always works if PowerDevil is found"
msgstr "Nadzire se D-Bus za PowerDevil pa buđenje iz suspenzije uvijek radi ako je PowerDevil dostupan"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:176
msgid "Use consistent dialog style on the settings page"
msgstr "Na stranici postavki koristi se dosljedan stil dijaloga"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:177
msgid "After editing an alarm, the alarm now automatically is activated"
msgstr "Alarm se sada automatski aktivira nakon uređivanja"

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:184
msgid "New features and bugfixes:"
msgstr "Nove značajke i ispravci grešaka:"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:186
msgid "Added the ability to set timer presets"
msgstr "Dodana je mogućnost postavljanja predložaka mjerača vremena"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:187
msgid "Added ability to increase timer duration by 1m as timer is running"
msgstr "Dodana je mogućnost produljenja trajanja pokrenutog mjerača vremena za jednu minutu"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:188
msgid "Fixed multiple alarm sounds and notifications being played for one alarm"
msgstr "Ispravljeno je višestruko reproduciranje zvukova i prikazivanje obavijesti za jedan alarm"

#. (itstool) path: ul/li
#: org.kde.kclock.appdata.xml:189
msgid "Fixed errors that prevented the application from working in a Flatpak"
msgstr "Ispravljene su greške koje su onemogućavale rad aplikacije u Flatpaku"
