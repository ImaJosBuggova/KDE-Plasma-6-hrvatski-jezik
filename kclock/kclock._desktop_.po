msgid "Find timers and start/stop them"
msgstr "Pronađite mjerače vremena i pokrenite ih ili zaustavite"

#: kclock-runner.desktop:89
msgctxt "X-Plasma-Runner-Syntax-Descriptions"
msgid ""
"Finds timers whose name match :q:,Lists all timers and allows to start/stop "
"them.,Lists all alarms and allows to enable/disable them."
msgstr "Pronalazi mjerače vremena čiji naziv odgovara :q:,Prikazuje sve mjerače vremena i omogućuje njihovo pokretanje ili zaustavljanje.,Prikazuje sve alarme i omogućuje njihovo uključivanje ili isključivanje."

