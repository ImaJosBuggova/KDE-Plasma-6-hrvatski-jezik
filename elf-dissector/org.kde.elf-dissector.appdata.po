#. (itstool) path: component/name
#: org.kde.elf-dissector.appdata.xml:6
msgid "ELF Dissector"
msgstr "ELF Dissector"

#. (itstool) path: component/summary
#: org.kde.elf-dissector.appdata.xml:11
msgid "Static analysis tool for ELF files"
msgstr "Alat za statičku analizu ELF datoteka"

#. (itstool) path: description/p
#: org.kde.elf-dissector.appdata.xml:13
msgid "ELF Dissector is useful if you need to do one or more of the following tasks:"
msgstr "ELF Dissector koristan je ako trebate obaviti jedan ili više sljedećih zadataka:"

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:15
msgid "Inspecting forward and backward dependencies, on library and symbol level."
msgstr "Pregledavanje izravnih i obratnih ovisnosti na razini biblioteka i simbola."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:16
msgid "Identifying load-time performance bottlenecks such as expensive static constructors or excessive relocations."
msgstr "Otkrivanje uskih grla u performansama pri učitavanju, kao što su skupi statički konstruktori ili prekomjerne relokacije."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:17
msgid "Size profiling of ELF files."
msgstr "Profiliranje veličine ELF datoteka."

#. (itstool) path: description/p
#: org.kde.elf-dissector.appdata.xml:19
msgid "Main features:"
msgstr "Glavne značajke:"

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:21
msgid "ELF structure browser."
msgstr "Preglednik strukture ELF-a."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:22
msgid "Tree map visualization of the size of the various parts of an ELF file."
msgstr "Vizualizacija veličine različitih dijelova ELF datoteke u obliku kartograma."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:23
msgid "Relocation heatmap."
msgstr "Toplinska karta relokacija."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:24
msgid "Built-in disassembler for x86 and AArch64."
msgstr "Ugrađeni rastavljač za x86 i AArch64."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:25
msgid "Browser for data type memory layouts extracted from DWARF debug information."
msgstr "Preglednik rasporeda vrsta podataka u memoriji izdvojenih iz informacija za otklanjanje pogrešaka DWARF."

#. (itstool) path: ul/li
#: org.kde.elf-dissector.appdata.xml:26
msgid "Forward and backward dependency viewer."
msgstr "Preglednik izravnih i obratnih ovisnosti."

#. (itstool) path: screenshot/caption
