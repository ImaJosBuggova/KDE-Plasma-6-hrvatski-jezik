#: kamera.cpp:71
#, kde-format
msgid "Unable to initialize the gPhoto2 libraries."
msgstr "Inicijalizacija biblioteka gPhoto2 nije uspjela."

#: kamera.cpp:108
#, kde-format
msgid "Add"
msgstr "Dodaj"

#: kamera.cpp:110
#, kde-format
msgid "Click this button to add a new camera."
msgstr "Kliknite ovaj gumb da biste dodali novi fotoaparat."

#: kamera.cpp:116
#, kde-format
msgid "Test"
msgstr "Testiraj"

#: kamera.cpp:118
#, kde-format
msgid "Click this button to test the connection to the selected camera."
msgstr "Kliknite ovaj gumb da biste testirali vezu s odabranim fotoaparatom."

#: kamera.cpp:123
#, kde-format
msgid "Remove"
msgstr "Ukloni"

#: kamera.cpp:125
#, kde-format
msgid "Click this button to remove the selected camera from the list."
msgstr "Kliknite ovaj gumb da biste uklonili odabrani fotoaparat s popisa."

#: kamera.cpp:130
#, kde-format
msgid "Configure..."
msgstr "Konfiguriraj..."

#: kamera.cpp:133
#, kde-format
msgid ""
"Click this button to change the configuration of the selected camera."
"<br><br>The availability of this feature and the contents of the "
"Configuration dialog depend on the camera model."
msgstr "Kliknite ovaj gumb da biste promijenili konfiguraciju odabranog fotoaparata.<br><br>Dostupnost ove značajke i sadržaj dijaloškog prozora za konfiguraciju ovise o modelu fotoaparata."

#: kamera.cpp:139
#, kde-format
msgid "Information"
msgstr "Informacije"

#: kamera.cpp:142
#, kde-format
msgid ""
"Click this button to view a summary of the current status of the selected "
"camera.<br><br>The availability of this feature and the contents of the "
"Information dialog depend on the camera model."
msgstr "Kliknite ovaj gumb da biste pregledali sažetak trenutačnog stanja odabranog fotoaparata.<br><br>Dostupnost ove značajke i sadržaj dijaloškog prozora s informacijama ovise o modelu fotoaparata."

#: kamera.cpp:149
#, kde-format
msgid "Cancel"
msgstr "Odustani"

#: kamera.cpp:151
#, kde-format
msgid "Click this button to cancel the current camera operation."
msgstr "Kliknite ovaj gumb da biste otkazali trenutačnu radnju s fotoaparatom."

#: kamera.cpp:355
#, kde-format
msgid "Camera test was successful."
msgstr "Test fotoaparata uspješno je završen."

#: kameraconfigdialog.cpp:226
#, kde-format
msgid "Button (not supported by KControl)"
msgstr "Gumb (KControl ne podržava)"

#: kameraconfigdialog.cpp:233
#, kde-format
msgid "Date (not supported by KControl)"
msgstr "Datum (KControl ne podržava)"

#: kameradevice.cpp:82
#, kde-format
msgid "Could not allocate memory for the abilities list."
msgstr "Nije moguće dodijeliti memoriju za popis mogućnosti."

#: kameradevice.cpp:86
#, kde-format
msgid "Could not load ability list."
msgstr "Nije moguće učitati popis mogućnosti."

#: kameradevice.cpp:92 kameradevice.cpp:542 kameradevice.cpp:560
#, kde-format
msgid ""
"Description of abilities for camera %1 is not available. Configuration "
"options may be incorrect."
msgstr "Opis mogućnosti fotoaparata %1 nije dostupan. Mogućnosti konfiguracije možda nisu ispravne."

#: kameradevice.cpp:117
#, kde-format
msgid "Could not access driver. Check your gPhoto2 installation."
msgstr "Nije moguće pristupiti upravljačkom programu. Provjerite instalaciju gPhoto2."

#: kameradevice.cpp:136
#, kde-format
msgid ""
"Unable to initialize camera. Check your port settings and camera "
"connectivity and try again."
msgstr "Nije moguće inicijalizirati fotoaparat. Provjerite postavke priključka i vezu s fotoaparatom pa pokušajte ponovno."

#: kameradevice.cpp:175
#, kde-format
msgid "No camera summary information is available.\n"
msgstr "Nema dostupnih sažetih informacija o fotoaparatu.\n"

#: kameradevice.cpp:190 kameradevice.cpp:200
#, kde-format
msgid "Camera configuration failed."
msgstr "Konfiguracija fotoaparata nije uspjela."

#: kameradevice.cpp:242 kameradevice.cpp:368
#, kde-format
msgid "Serial"
msgstr "Serijski"

#: kameradevice.cpp:244 kameradevice.cpp:374
#, kde-format
msgid "USB"
msgstr "USB"

#: kameradevice.cpp:245
#, kde-format
msgid "Unknown port"
msgstr "Nepoznat priključak"

#: kameradevice.cpp:310
#, kde-format
msgid "Select Camera Device"
msgstr "Odabir uređaja fotoaparata"

#: kameradevice.cpp:328
#, kde-format
msgctxt "@title:column"
msgid "Supported Cameras"
msgstr "Podržani fotoaparati"

#: kameradevice.cpp:338
#, kde-format
msgid "Filter by name…"
msgstr "Filtriraj po nazivu…"

#: kameradevice.cpp:362 kameradevice.cpp:389
#, kde-format
msgid "Port"
msgstr "Priključak"

#: kameradevice.cpp:371
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's serial ports (known as COM ports in Microsoft Windows.)"
msgstr "Ako je ova mogućnost odabrana, fotoaparat mora biti priključen na jedan od serijskih priključaka računala (u sustavu Microsoft Windows poznatih kao COM priključci)."

#: kameradevice.cpp:377
#, kde-format
msgid ""
"If this option is checked, the camera has to be connected to one of the "
"computer's USB ports, or to a USB hub."
msgstr "Ako je ova mogućnost odabrana, fotoaparat mora biti priključen na jedan od USB priključaka računala ili na USB koncentrator."

#: kameradevice.cpp:380
#, kde-format
msgid "Port Settings"
msgstr "Postavke priključka"

#: kameradevice.cpp:398
#, kde-format
msgid "No port type selected."
msgstr "Nije odabrana vrsta priključka."

#: kameradevice.cpp:405
#, kde-format
msgid "Port:"
msgstr "Priključak:"

#: kameradevice.cpp:409
#, kde-format
msgid "Specify here the serial port to which you connect the camera."
msgstr "Ovdje navedite serijski priključak na koji je priključen fotoaparat."

#: kameradevice.cpp:416
#, kde-format
msgid "No further configuration is required for USB cameras."
msgstr "Za USB fotoaparate nije potrebno dodatno konfiguriranje."
