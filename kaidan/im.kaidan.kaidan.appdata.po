#. (itstool) path: component/name
#: im.kaidan.kaidan.appdata.xml:4
msgid "Kaidan"
msgstr "Kaidan"

#. (itstool) path: component/summary
#: im.kaidan.kaidan.appdata.xml:5
msgid "Modern chat app for every device"
msgstr "Suvremena aplikacija za čavrljanje na svim uređajima"

#. (itstool) path: description/p
#: im.kaidan.kaidan.appdata.xml:9
msgid "Kaidan is a user-friendly and modern chat app for every device. It uses the open communication protocol XMPP (Jabber). Unlike other chat apps, you are not dependent on one specific service provider."
msgstr "Kaidan je jednostavna i suvremena aplikacija za čavrljanje na svim uređajima. Koristi otvoreni komunikacijski protokol XMPP (Jabber). Za razliku od drugih aplikacija za čavrljanje, ne ovisite o jednom davatelju usluga."

#. (itstool) path: description/p
#: im.kaidan.kaidan.appdata.xml:10
msgid "Kaidan does not have all basic features yet and has still some stability issues. But we do our best to improve it!"
msgstr "Kaidan još nema sve osnovne značajke i ima ponekih problema sa stabilnošću, no činimo sve što možemo kako bismo ga poboljšali!"

