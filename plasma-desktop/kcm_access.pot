msgctxt "@info:tooltip"
msgid ""
"Modifier keys like Ctrl, Shift, Alt, and the Meta/Super/Windows key act as "
"though they “stick in place” and no longer need to be held down when typing "
"a keyboard shortcut."
msgstr ""
"Modifikatorske tipke poput Ctrl, Shift, Alt te Meta/Super/Windows tipke "
"ponašaju se kao da „ostaju zakačene” pa ih više ne morate držati pritisnutima "
"pri unosu tipkovničkih prečaca."

#: ui/ModifierKeys.qml:39
#, kde-format
msgctxt "@option:check"
msgid "Lock sticky keys"
msgstr "Zaključaj ljepljive tipke"

#: ui/ModifierKeys.qml:52
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Pressing a modifier key twice will keep it in active state until pressed "
"again."
msgstr ""
"Dvostruki pritisak na modifikatorsku tipku držat će je u aktivnom stanju "
"sve dok je ponovno ne pritisnete."

#: ui/ModifierKeys.qml:60
#, kde-format
msgctxt "@option:check"
msgid "Disable when two keys are held down"
msgstr "Onemogući kada su pritisnute dvije tipke"

#: ui/ModifierKeys.qml:75
#, kde-format
msgctxt "@option:check"
msgid "Ring system bell when modifier keys are used"
msgstr "Oglasi sistemsko zvono pri upotrebi modifikatorskih tipki"

#: ui/ModifierKeys.qml:91
#, kde-format
msgctxt "@option:check Feedback options:"
msgid "Feedback:"
msgstr "Povratna informacija:"

#: ui/ModifierKeys.qml:94
#, kde-format
msgctxt "@option:check"
msgid "Ring system bell when locking keys are used"
msgstr "Oglasi sistemsko zvono pri upotrebi zaključavajućih tipki"

#: ui/ModifierKeys.qml:106
#, kde-format
msgctxt "@info:tooltip"
msgid "The locking keys are Caps Lock, Num Lock, and Scroll Lock."
msgstr "Zaključavajuće tipke su Caps Lock, Num Lock i Scroll Lock."

#: ui/ModifierKeys.qml:112
#, kde-format
msgctxt "@option:check"
msgid "Show notification when modifier or locking keys are used"
msgstr "Prikaži obavijest pri upotrebi modifikatorskih ili zaključavajućih tipki"

