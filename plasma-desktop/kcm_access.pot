#: ui/MouseNavigation.qml:17
#, kde-format
msgctxt "@option:check"
msgid "Use number pad to move pointer:"
msgstr "Upotrijebi numeričku tipkovnicu za pomicanje pokazivača:"

#: ui/MouseNavigation.qml:19
#, kde-format
msgctxt "@option:check Enable mouse navigation"
msgid "Enable"
msgstr "Omogući"

#: ui/MouseNavigation.qml:31
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid ""
"The numpad key <shortcut>5</shortcut> functions as a mouse click, toggled by "
"<shortcut>/</shortcut> for middle click, <shortcut>*</shortcut> for right "
"click and <shortcut>NumLock</shortcut> for left click. The keys <shortcut>2</"
"shortcut>, <shortcut>4</shortcut>, <shortcut>6</shortcut>, and <shortcut>8</"
"shortcut> allow for cardinal movement (down, left, right, and up). The keys "
"<shortcut>1</shortcut>, <shortcut>3</shortcut>, <shortcut>7</shortcut>, and "
"<shortcut>9</shortcut> allow for diagonal movement."
msgstr ""
"Tipka <shortcut>5</shortcut> na numeričkoj tipkovnici djeluje kao klik miša, "
"preklapana s <shortcut>/</shortcut> za srednji klik, <shortcut>*</shortcut> za "
"desni klik i <shortcut>NumLock</shortcut> za lijevi klik. Tipke <shortcut>2</"
"shortcut>, <shortcut>4</shortcut>, <shortcut>6</shortcut> i <shortcut>8</"
"shortcut> omogućuju kretanje u smjerovima (dolje, lijevo, desno i gore). "
"Tipke <shortcut>1</shortcut>, <shortcut>3</shortcut>, <shortcut>7</shortcut> "
"i <shortcut>9</shortcut> omogućuju dijagonalno kretanje."

