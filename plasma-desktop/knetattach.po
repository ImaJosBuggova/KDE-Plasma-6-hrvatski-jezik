msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Vaša imena"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "Vaše adrese e-pošte"

#: knetattach.cpp:78
#, kde-format
msgid "Enter a name for this <i>WebFolder</i> as well as a server address, port and folder path to use and press the <b>Save & Connect</b> button."
msgstr "Unesite naziv za ovu <i>WebFolder</i> vezu, kao i adresu poslužitelja, priključak i putanju mape, pa pritisnite gumb <b>Spremi i poveži</b>."

#: knetattach.cpp:81
#, kde-format
msgid "Enter a name for this <i>Secure shell connection</i> as well as a server address, port and folder path to use and press the <b>Save & Connect</b> button."
msgstr "Unesite naziv za ovu <i>vezu sigurnom ljuskom</i>, kao i adresu poslužitelja, priključak i putanju mape, pa pritisnite gumb <b>Spremi i poveži</b>."

#: knetattach.cpp:85
#, kde-format
msgid "Enter a name for this <i>File Transfer Protocol connection</i> as well as a server address and folder path to use and press the <b>Save & Connect</b> button."
msgstr "Unesite naziv za ovu <i>FTP vezu</i>, kao i adresu poslužitelja i putanju mape, pa pritisnite gumb <b>Spremi i poveži</b>."

#: knetattach.cpp:89
#, kde-format
msgid "Enter a name for this <i>Microsoft Windows network drive</i> as well as a server address and folder path to use and press the <b>Save & Connect</b> button."
msgstr "Unesite naziv za ovaj <i>mrežni pogon Microsoft Windows</i>, kao i adresu poslužitelja i putanju mape, pa pritisnite gumb <b>Spremi i poveži</b>."

#: knetattach.cpp:205
#, kde-format
msgid "Unable to connect to server.  Please check your settings and try again."
msgstr "Nije se moguće povezati s poslužiteljem. Provjerite postavke i pokušajte ponovno."

