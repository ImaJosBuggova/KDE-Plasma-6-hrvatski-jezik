#. i18n: ectx: label, entry (confirmLogout), group (General)
#: smserversettings.kcfg:9
#, kde-format
msgid "Confirm logout"
msgstr "Potvrdi odjavu"

#. i18n: ectx: label, entry (shutdownType), group (General)
#: smserversettings.kcfg:13
#, kde-format
msgid "Default leave option"
msgstr "Zadana opcija napuštanja"

#. i18n: ectx: label, entry (loginMode), group (General)
#: smserversettings.kcfg:22
#, kde-format
msgid "On login"
msgstr "Pri prijavi"

#. i18n: ectx: label, entry (excludeApps), group (General)
#: smserversettings.kcfg:26
#, kde-format
msgid "Applications to be excluded from session"
msgstr "Aplikacije koje treba izuzeti iz sesije"

#: ui/main.qml:30
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Failed to request restart to firmware setup: %1"
msgstr "Nije moguće zatražiti ponovno pokretanje u postavke firmvera: %1"

#: ui/main.qml:31
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Next time the computer is restarted, it will enter UEFI firmware settings."
msgstr "Pri sljedećem ponovnom pokretanju računalo će otvoriti postavke UEFI firmvera."

#: ui/main.qml:32
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "Next time the computer is restarted, it will enter the firmware setup screen."
msgstr "Pri sljedećem ponovnom pokretanju računalo će otvoriti zaslon za postavljanje firmvera."

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Restart Now"
msgstr "Ponovno pokreni sada"

#: ui/main.qml:46
#, kde-format
msgctxt "@title:group"
msgid "General"
msgstr "Općenito"

#: ui/main.qml:51
#, kde-format
msgctxt "@label beginning of the logical sentence 'Ask for confirmation on shutdown, restart, and logout.'"
msgid "Ask for confirmation:"
msgstr "Zatraži potvrdu:"

#: ui/main.qml:52
#, kde-format
msgctxt "@option:check end of the logical sentence 'Ask for confirmation on shutdown, restart, and logout.'"
msgid "On shutdown, restart, and logout"
msgstr "Pri isključivanju, ponovnom pokretanju i odjavi"

#: ui/main.qml:63
#, kde-format
msgctxt "@title:group"
msgid "Session Restore"
msgstr "Vraćanje sesije"

#: ui/main.qml:71
#, kde-format
msgctxt "@title:group prefix for radiobuttons"
msgid "On login, launch apps that were open:"
msgstr "Pri prijavi pokreni otvorene aplikacije:"

#: ui/main.qml:72
#, kde-format
msgctxt "@option:radio Automatic style of session restoration"
msgid "On last logout"
msgstr "Pri posljednjoj odjavi"

#: ui/main.qml:85
#, kde-format
msgctxt "@option:radio Manual style of session restoration"
msgid "When session was manually saved"
msgstr "Kada je sesija ručno spremljena"

#: ui/main.qml:94
#, kde-kuit-format
msgctxt "@info"
msgid "A <interface>Save Session</interface> button will appear in the <interface>Application Launcher</interface> menu. When you click it, Plasma will remember the apps that are open and restore them on the next login. Click it again to replace the set of remembered apps."
msgstr "Gumb <interface>Spremi sesiju</interface> pojavit će se u izborniku <interface>Pokretača aplikacija</interface>. Kada ga kliknete, Plasma će zapamtiti otvorene aplikacije i vratiti ih pri sljedećoj prijavi. Ponovno ga kliknite da biste zamijenili skup zapamćenih aplikacija."

#: ui/main.qml:99
#, kde-format
msgctxt "@option:radio Here 'session' refers to the technical concept of session restoration, whereby the windows that were open on logout are re-opened on the next login"
msgid "Start with an empty session"
msgstr "Započni s praznom sesijom"

#: ui/main.qml:113
#, kde-format
msgctxt "@label:textbox"
msgid "Ignored applications:"
msgstr "Zanemarene aplikacije:"

#: ui/main.qml:132
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid "Write apps' desktop file identifier or, on X11, executable names here (separated by commas or colons, for example 'xterm:org.kde.konsole.desktop' or 'xterm,org.kde.konsole.desktop') to prevent them from autostarting along with other session-restored apps."
msgstr "Ovdje upišite identifikator desktop datoteke aplikacije ili, na X11, nazive izvršnih datoteka (odvojene zarezima ili dvotočkama, na primjer 'xterm:org.kde.konsole.desktop' ili 'xterm,org.kde.konsole.desktop') kako biste spriječili njihovo automatsko pokretanje s ostalim aplikacijama vraćenima u sesiju."

#: ui/main.qml:138
#, kde-format
msgctxt "@title:group"
msgid "Firmware"
msgstr "Firmver"

#: ui/main.qml:144
#, kde-format
msgctxt "@label:check part of a sentence: After next restart enter UEFI/Firmware setup screen"
msgid "After next restart:"
msgstr "Nakon sljedećeg ponovnog pokretanja:"

#: ui/main.qml:145
#, kde-format
msgctxt "@option:check"
msgid "Enter UEFI firmware settings"
msgstr "Otvori postavke UEFI firmvera"

#: ui/main.qml:146
#, kde-format
msgctxt "@option:check"
msgid "Enter firmware setup screen"
msgstr "Otvori zaslon za postavljanje firmvera"