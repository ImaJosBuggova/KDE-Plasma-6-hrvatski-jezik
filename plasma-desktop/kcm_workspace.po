#: ui/main.qml:25
#, kde-format
msgctxt "@info:status inlinemessage"
msgid "The system must be restarted before changes to the middle-click paste setting can take effect."
msgstr "Da bi promjene postavke lijepljenja klikom srednje tipke stupile na snagu, potrebno je ponovno pokrenuti sustav."

#: ui/main.qml:31
#, kde-format
msgctxt "@action:button"
msgid "Restart"
msgstr "Ponovno pokreni"

#: ui/main.qml:46
#, kde-format
msgctxt "@title:group"
msgid "Plasma"
msgstr "Plasma"

#: ui/main.qml:49
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show panel and widget tooltips'"
msgid "Allow Plasma to show:"
msgstr "Dopusti Plasmi prikaz:"

#: ui/main.qml:52
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show panel and widget tooltips'"
msgid "Panel and widget tooltips"
msgstr "Opisa ploča i widgeta"

#: ui/main.qml:63
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid "Allows all Plasma panel and desktop widgets to show descriptive tooltips when hovered with the pointer. This setting has no effect on the small tooltips displayed when hovering over individual buttons and other user interface elements."
msgstr "Omogućuje svim pločama i widgetima radne površine Plasma prikaz opisnih oblačića kada se pokazivač zadrži iznad njih. Ova postavka ne utječe na male oblačiće koji se prikazuju pri prelasku pokazivača preko pojedinih gumba i drugih elemenata sučelja."

#: ui/main.qml:70
#, kde-format
msgctxt "Part of the sentence 'Allow Plasma to show OSD popups for status changes'"
msgid "OSD popups for status changes"
msgstr "OSD obavijesti o promjenama stanja"

#: ui/main.qml:81
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid "Allows all Plasma widgets to show on-screen display (OSD) popups for changes like volume and brightness level, or audio device switching."
msgstr "Omogućuje svim Plasma widgetima prikaz zaslonskih obavijesti (OSD) o promjenama poput glasnoće, razine svjetline ili promjene zvučnog uređaja."

#: ui/main.qml:88
#, kde-format
msgctxt "@title:group"
msgid "Scrolling"
msgstr "Pomicanje"

#: ui/main.qml:92
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Clicking in scrollbar track:"
msgstr "Klik na stazu klizača:"

#: ui/main.qml:93
#, kde-format
msgctxt "@radio part of a complete sentence: 'Clicking in scrollbar track scrolls to the clicked location'"
msgid "Scrolls to the clicked location"
msgstr "Pomakni se na mjesto klika"

#: ui/main.qml:111
#, kde-format
msgctxt "@radio part of a complete sentence: 'Clicking in scrollbar track scrolls one page up or down'"
msgid "Scrolls one page up or down"
msgstr "Pomakni se za jednu stranicu gore ili dolje"

#: ui/main.qml:112
#, kde-format
msgctxt "@info:usagetip"
msgid "Middle-click to scroll to clicked location"
msgstr "Kliknite srednjom tipkom za pomicanje na odabrano mjesto"

#: ui/main.qml:129
#, kde-format
msgctxt "@option:check"
msgid "Prefer smooth scrolling"
msgstr "Preferiraj glatko pomicanje"

#: ui/main.qml:140
#, kde-format
msgctxt "@info:tooltip"
msgid "This setting enables or disables animated transitions when scrolling with a mouse wheel or the keyboard. Some applications may not honor this setting because they either do not support smooth scrolling, or have their own setting for enabling and disabling it."
msgstr "Ova postavka uključuje ili isključuje animirane prijelaze pri pomicanju kotačićem miša ili tipkovnicom. Neke aplikacije možda neće primijeniti ovu postavku jer ne podržavaju glatko pomicanje ili imaju vlastitu postavku za njegovo uključivanje i isključivanje."

#: ui/main.qml:146
#, kde-format
msgctxt "@title:group"
msgid "Clicking"
msgstr "Klik"

#: ui/main.qml:149
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders [opens them/selects them]'"
msgid "Clicking files or folders:"
msgstr "Klik na datoteke ili mape:"

#: ui/main.qml:153
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders selects them'"
msgid "Selects them"
msgstr "Odabire ih"

#: ui/main.qml:154
#, kde-format
msgctxt "@info:usagetip"
msgid "Open by double-clicking instead"
msgstr "Umjesto toga otvori dvostrukim klikom"

#: ui/main.qml:171
#, kde-format
msgctxt "part of a sentence: 'Clicking files or folders opens them'"
msgid "Opens them"
msgstr "Otvara ih"

#: ui/main.qml:172
#, kde-format
msgctxt "@info:usagetip"
msgid "Select by clicking on item's selection marker"
msgstr "Odaberi klikom na oznaku za odabir stavke"

#: ui/main.qml:190
#, kde-format
msgctxt "@label for checkbox, part of a complete sentence: 'Middle-click pastes selected text'"
msgid "Middle-click:"
msgstr "Klik srednjom tipkom:"

#: ui/main.qml:194
#, kde-format
msgctxt "@option:check part of a complete sentence: 'Middle click pastes selected text'"
msgid "Pastes selected text"
msgstr "Zalijepi odabrani tekst"

#: ui/main.qml:212
#, kde-format
msgctxt "@label:spinbox"
msgid "Double-click interval:"
msgstr "Razmak dvostrukog klika:"

#: ui/main.qml:232
#, kde-format
msgctxt "short for millisecond(s)"
msgid "%1 ms"
msgid_plural "%1 ms"
msgstr[0] "%1 ms"
msgstr[1] "%1 ms"
msgstr[2] "%1 ms"

#: ui/main.qml:236
#, kde-format
msgctxt "short for millisecond(s)"
msgid "ms"
msgstr "ms"

#: ui/main.qml:251
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid "Two clicks within this duration are considered a double-click. Some applications may not honor this setting."
msgstr "Dva klika unutar ovog vremenskog razmaka smatraju se dvostrukim klikom. Neke aplikacije možda neće primijeniti ovu postavku."

#: ui/main.qml:262
#, kde-format
msgctxt "Test double-click speed"
msgid "Double-click the folder to test. If it does not change its appearance, increase double-click interval."
msgstr "Dvostruko kliknite mapu za testiranje. Ako se njezin izgled ne promijeni, povećajte razmak dvostrukog klika."

#: ui/main.qml:306
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Drag and Drop"
msgstr "Povlačenje i ispuštanje"

#: ui/main.qml:309
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "When dragging files or folders:"
msgstr "Pri povlačenju datoteka ili mapa:"

#: ui/main.qml:313
#, kde-format
msgctxt "@option:radio When dragging..."
msgid "Always ask what to do"
msgstr "Uvijek pitaj što učiniti"

#: ui/main.qml:314
#, kde-kuit-format
msgctxt "@info"
msgid "Hold <shortcut>Shift</shortcut> to move, <shortcut>Ctrl</shortcut> to copy, and <shortcut>Shift+Ctrl</shortcut> to create a symlink. Otherwise show a dialog."
msgstr "Držite <shortcut>Shift</shortcut> za premještanje, <shortcut>Ctrl</shortcut> za kopiranje i <shortcut>Shift+Ctrl</shortcut> za stvaranje simboličke poveznice. U suprotnom prikaži dijalog."

#: ui/main.qml:332
#, kde-format
msgctxt "@option:radio When dragging…"
msgid "Move if on the same device"
msgstr "Premjesti ako je na istom uređaju"

#: ui/main.qml:333
#, kde-kuit-format
msgctxt "@info"
msgid "Hold <shortcut>Shift</shortcut> when dropping to show other options."
msgstr "Držite <shortcut>Shift</shortcut> pri ispuštanju za prikaz drugih opcija."

#: ui/main.qml:348
#, kde-format
msgctxt "@title:group"
msgid "Touch"
msgstr "Dodir"

#: ui/main.qml:351
#, kde-format
msgctxt "@title:group prefix radiobutton group"
msgid "Enable Tablet Mode:"
msgstr "Omogući način rada za tablet:"

#: ui/main.qml:354
#, kde-format
msgctxt "As in: 'Tablet Mode is automatically enabled as needed'"
msgid "Automatically enable as needed"
msgstr "Automatski omogući prema potrebi"

#: ui/main.qml:354
#, kde-format
msgctxt "As in: 'Tablet Mode is never enabled'"
msgid "Never enabled"
msgstr "Nikad omogućen"

#: ui/main.qml:373
#, kde-format
msgctxt "@info:whatsthis contextualhelpbutton tooltip"
msgid "Tablet Mode will be automatically enabled whenever the system detects a touchscreen but no mouse or touchpad. For example: when a transformable laptop's keyboard is flipped around or detached."
msgstr "Način rada za tablet automatski će se uključiti kada sustav prepozna zaslon osjetljiv na dodir, ali ne i miš ili dodirnu pločicu. Primjerice, kada se tipkovnica konvertibilnog prijenosnog računala preklopi ili odvoji."

#: ui/main.qml:379
#, kde-format
msgctxt "As in: 'Tablet Mode is always enabled'"
msgid "Always enabled"
msgstr "Uvijek omogućen"

#: ui/main.qml:401
#, kde-format
msgctxt "As in: 'Tablet Mode is never enabled'"
msgid "Disabled"
msgstr "Onemogućen"

#: ui/main.qml:402
#, kde-format
msgctxt "@info:usagetip"
msgid "In Tablet Mode, the virtual keyboard will appear when needed."
msgstr "U načinu rada za tablet virtualna će se tipkovnica pojaviti prema potrebi."

#. i18n: ectx: label, entry (singleClick), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:9
#, kde-format
msgid "Single click to open files"
msgstr "Jedan klik za otvaranje datoteka"

#. i18n: ectx: label, entry (dndBehavior), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:13
#, kde-format
msgid "For local files on the same device, whether dragging and dropping will perform a move operation instead of showing the options menu"
msgstr "Određuje hoće li se lokalne datoteke na istom uređaju povlačenjem premjestiti umjesto prikaza izbornika s opcijama"

#. i18n: ectx: label, entry (smoothScroll), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:21
#, kde-format
msgid "Smooth scrolling"
msgstr "Glatko pomicanje"

#. i18n: ectx: label, entry (scrollbarLeftClickNavigatesByPage), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:25
#, kde-format
msgid "Left-click in scrollbar track moves scrollbar by one page"
msgstr "Klik lijevom tipkom na stazu klizača pomiče klizač za jednu stranicu"

#. i18n: ectx: label, entry (doubleClickInterval), group (KDE)
#: workspaceoptions_kdeglobalssettings.kcfg:29
#, kde-format
msgid "Double click interval"
msgstr "Razmak dvostrukog klika"

#. i18n: ectx: label, entry (tabletMode), group (Input)
#: workspaceoptions_kwinsettings.kcfg:9
#, kde-format
msgid "Automatically switch to touch-optimized mode"
msgstr "Automatski prijeđi na način prilagođen dodiru"

#. i18n: ectx: label, entry (primarySelection), group (Wayland)
#: workspaceoptions_kwinsettings.kcfg:15
#, kde-format
msgid "Enable middle click selection pasting"
msgstr "Omogući lijepljenje odabira klikom srednje tipke"

#. i18n: ectx: label, entry (delay), group (PlasmaToolTips)
#: workspaceoptions_plasmasettings.kcfg:9
#, kde-format
msgid "Display large panel and widget tooltips"
msgstr "Prikazuj velike opise ploča i widgeta"

#. i18n: ectx: tooltip, entry (delay), group (PlasmaToolTips)
#: workspaceoptions_plasmasettings.kcfg:10
#, kde-format
msgid "Allow Plasma widgets to display large panel and widget tooltips on hover"
msgstr "Dopusti Plasma widgetima prikaz velikih opisa ploča i widgeta pri prelasku pokazivačem"

#. i18n: ectx: label, entry (osdEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:16
#, kde-format
msgid "Display small popups for status changes"
msgstr "Prikazuj male obavijesti o promjenama stanja"

#. i18n: ectx: tooltip, entry (osdEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:17
#, kde-format
msgid "Allow Plasma widgets to display small popups for status changes such as brightness or volume"
msgstr "Dopusti Plasma widgetima prikaz malih obavijesti o promjenama stanja, poput svjetline ili glasnoće"

#. i18n: ectx: label, entry (osdKbdLayoutChangedEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:21
#, kde-format
msgid "OSD on layout change"
msgstr "OSD pri promjeni rasporeda"

#. i18n: ectx: tooltip, entry (osdKbdLayoutChangedEnabled), group (OSD)
#: workspaceoptions_plasmasettings.kcfg:22
#, kde-format
msgid "Show a popup on layout changes"
msgstr "Prikaži obavijest pri promjeni rasporeda"