#: kcm.cpp:57
#, kde-format
msgid "Not able to select appropriate backend"
msgstr "Nije moguće odabrati odgovarajući pozadinski sustav"

#: kcm.cpp:103
#, kde-format
msgid "Error while loading values. See logs for more information. Please restart this configuration module."
msgstr "Pogreška pri učitavanju vrijednosti. Za više informacija pogledajte zapisnike. Ponovno pokrenite ovaj modul postavki."

#: kcm.cpp:106
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Nije pronađen nijedan pokazivački uređaj. Povežite ga sada."

#: kcm.cpp:115
#, kde-format
msgid "Not able to save all changes. See logs for more information. Please restart this configuration module and try again."
msgstr "Nije moguće spremiti sve promjene. Za više informacija pogledajte zapisnike. Ponovno pokrenite ovaj modul postavki i pokušajte ponovno."

#: kcm.cpp:134
#, kde-format
msgid "Error while loading default values. Failed to set some options to their default values."
msgstr "Pogreška pri učitavanju zadanih vrijednosti. Neke opcije nije bilo moguće postaviti na zadane vrijednosti."

#: kcm.cpp:149
#, kde-format
msgid "Error while adding newly connected device. Please reconnect it and restart this configuration module."
msgstr "Pogreška pri dodavanju novopovezanog uređaja. Ponovno ga povežite i pokrenite ovaj modul postavki."

#: kcm.cpp:162
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "Pokazivački uređaj je odspojen. Njegov dijalog postavki je zatvoren."

#: kcm.cpp:164
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "Pokazivački uređaj je odspojen. Nisu pronađeni drugi uređaji."

#: kwinwaylandbackend.cpp:45
#, kde-format
msgid "Critical error on reading fundamental device infos for touchpad %1."
msgstr "Kritična pogreška pri čitanju osnovnih podataka dodirne pločice %1."

#: ui/main.qml:69
#, kde-format
msgctxt "@info:status placeholdermessage text"
msgid "No touchpad found"
msgstr "Nije pronađena dodirna pločica"

#: ui/main.qml:70
#, kde-format
msgctxt "@info:usagetip placeholdermessage explanation"
msgid "Connect an external touchpad"
msgstr "Povežite vanjsku dodirnu pločicu"

#: ui/main.qml:87
#, kde-format
msgctxt "@label:listbox device selection"
msgid "Device:"
msgstr "Uređaj:"

#: ui/main.qml:110
#, kde-format
msgctxt "@title:group prefix for checkbox group"
msgid "General:"
msgstr "Općenito:"

#: ui/main.qml:111
#, kde-format
msgctxt "@option:check"
msgid "Enable device"
msgstr "Omogući uređaj"

#: ui/main.qml:126
#, kde-format
msgctxt "@option:check"
msgid "Disable while mouse is connected"
msgstr "Onemogući dok je miš povezan"

#: ui/main.qml:146
#, kde-format
msgctxt "option:check"
msgid "Disable while typing"
msgstr "Onemogući tijekom tipkanja"

#: ui/main.qml:147
#, kde-format
msgctxt "@label 'this' refers to the 'disable touchpad while typing' feature"
msgid "This can interfere with video games."
msgstr "To može ometati videoigre."

#: ui/main.qml:169
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Lijeva i desna tipka:"

#: ui/main.qml:170
#, kde-format
msgctxt "@option:check"
msgid "Swap (left-handed mode)"
msgstr "Zamijeni (način za ljevake)"

#: ui/main.qml:185
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Istodobno pritisnite obje tipke za klik srednjom tipkom"

#: ui/main.qml:197
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid "Activating this setting increases click latency by 50ms. The extra delay is needed to correctly detect simultaneous left and right button presses."
msgstr "Uključivanje ove postavke povećava latenciju klika za 50 ms. Dodatna je odgoda potrebna za ispravno prepoznavanje istodobnog pritiska lijeve i desne tipke."

#: ui/main.qml:207
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Brzina pokazivača:"

#: ui/main.qml:287
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Omogući ubrzanje pokazivača"

#: ui/main.qml:299
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid "When enabled, pointer travel distance increases with faster movement speed."
msgstr "Kada je omogućeno, prijeđena udaljenost pokazivača povećava se s brzinom njegova kretanja."

#: ui/main.qml:310
#, kde-format
msgctxt "@label:slider"
msgid "Scrolling speed:"
msgstr "Brzina pomicanja:"

#: ui/main.qml:392
#, kde-format
msgctxt "@item:inrange Slower Scroll"
msgid "Slower"
msgstr "Sporije"

#: ui/main.qml:399
#, kde-format
msgctxt "@item:inrange Faster Scroll Speed"
msgid "Faster"
msgstr "Brže"

#: ui/main.qml:406
#, kde-format
msgctxt "@title group begins the sentence 'Scroll by moving two fingers anywhere/moving one finger on edge'"
msgid "Scroll by:"
msgstr "Pomiči sadržaj:"

#: ui/main.qml:409
#, kde-format
msgctxt "@option:radio completes the sentence 'Scroll by moving two fingers anywhere'"
msgid "Moving two fingers anywhere"
msgstr "Pomicanjem dvaju prstiju bilo gdje"

#: ui/main.qml:427
#, kde-format
msgctxt "@option:radio completes the sentence 'Scroll by moving one finger on edge'"
msgid "Moving one finger on edge"
msgstr "Pomicanjem jednog prsta uz rub"

#: ui/main.qml:436
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction (Natural scrolling)"
msgstr "Obrni smjer pomicanja (prirodno pomicanje)"

#: ui/main.qml:453
#, kde-format
msgctxt "@option:check"
msgid "Disable horizontal scrolling"
msgstr "Onemogući vodoravno pomicanje"

#: ui/main.qml:471
#, kde-format
msgctxt "@title:group for radiobutton group, begins the sentence 'right-click by pressing bottom-right corner/pressing with two fingers'"
msgid "Right-click by:"
msgstr "Desni klik ostvari:"

#: ui/main.qml:475
#, kde-format
msgctxt "@option:radio Completes the sentence 'right-click by pressing bottom-right corner'"
msgid "Pressing bottom-right corner"
msgstr "Pritiskom donjeg desnog kuta"

#: ui/main.qml:480
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing both bottom corners."
msgstr "Klik srednjom tipkom ostvarite pritiskom na oba donja kuta."

#: ui/main.qml:481
#, kde-format
msgctxt "@info:usagetip shown below radio button"
msgid "Middle-click by pressing bottom center."
msgstr "Klik srednjom tipkom ostvarite pritiskom na donju sredinu."

#: ui/main.qml:503
#, kde-format
msgctxt "@option:radio Completes the sentence 'right-click by pressing with two fingers'"
msgid "Pressing anywhere with two fingers"
msgstr "Pritiskom dvama prstima bilo gdje"

#: ui/main.qml:504
#, kde-format
msgctxt "@info shown below radio button"
msgid "Middle-click by pressing anywhere with three fingers."
msgstr "Klik srednjom tipkom ostvarite pritiskom trima prstima bilo gdje."

#: ui/main.qml:516
#, kde-format
msgctxt "@label for radiobutton group, begins the sentence 'middle-click by pressing bottom-middle edge/by pressing anywhere with three fingers'"
msgid "Middle-click by:"
msgstr "Klik srednjom tipkom ostvari:"

#: ui/main.qml:519
#, kde-format
msgctxt "@option:radio completes the sentence 'middle-click by pressing bottom-middle edge'"
msgid "Pressing bottom-middle edge"
msgstr "Pritiskom donjeg srednjeg ruba"

#: ui/main.qml:539
#, kde-format
msgctxt "@option:radio completes the sentence 'middle-click by pressing bottom-left and bottom-right corners'"
msgid "Pressing bottom-left and bottom-right corners"
msgstr "Pritiskom donjeg lijevog i donjeg desnog kuta"

#: ui/main.qml:551
#, kde-format
msgctxt "@option:check completes the sentence 'middle-click by pressing anywhere with three fingers'"
msgid "Pressing anywhere with three fingers"
msgstr "Pritiskom trima prstima bilo gdje"

#: ui/main.qml:564
#, kde-format
msgctxt "@label for checkbox, tap-to-click"
msgid "Tapping:"
msgstr "Dodir:"

#: ui/main.qml:565
#, kde-format
msgctxt "@option:check"
msgid "Tap to click"
msgstr "Dodirni za klik"

#: ui/main.qml:580
#, kde-format
msgctxt "@option:check"
msgid "Allow dragging after tapping"
msgstr "Dopusti povlačenje nakon dodira"

#: ui/main.qml:592
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid "Tap, then tap and immediately slide finger over the touchpad to drag. Lift finger to drop."
msgstr "Dodirnite, zatim ponovno dodirnite i odmah povucite prst preko dodirne pločice. Podignite prst da biste otpustili stavku."

#: ui/main.qml:599
#, kde-format
msgctxt "@option:check"
msgid "Allow briefly lifting finger during tap-and-drag"
msgstr "Dopusti kratko podizanje prsta tijekom dodira i povlačenja"

#: ui/main.qml:612
#, kde-format
msgctxt "@title:group"
msgid "Two-finger tap:"
msgstr "Dodir dvama prstima:"

#: ui/main.qml:618
#, kde-format
msgctxt "@option:radio"
msgid "Right-click (three-finger tap to middle-click)"
msgstr "Desni klik (dodir trima prstima za klik srednjom tipkom)"

#: ui/main.qml:619
#, kde-format
msgctxt "@option:radio"
msgid "Right-click"
msgstr "Desni klik"

#: ui/main.qml:640
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click (three-finger tap to right-click)"
msgstr "Klik srednjom tipkom (dodir trima prstima za desni klik)"

#: ui/main.qml:641
#, kde-format
msgctxt "@option:radio"
msgid "Middle-click"
msgstr "Klik srednjom tipkom"