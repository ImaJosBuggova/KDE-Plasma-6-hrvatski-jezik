#: ui/main.qml:53
#, kde-format
msgctxt "@label:textbox"
msgid "Desktop folder:"
msgstr "Mapa Radna površina:"

#: ui/main.qml:59
#, kde-format
msgctxt "@info:tooltip and accessible description"
msgid "This folder contains all the files you see on your desktop."
msgstr "Ova mapa sadrži sve datoteke koje vidite na radnoj površini."

#: ui/main.qml:67
#, kde-format
msgctxt "@label:textbox"
msgid "Documents folder:"
msgstr "Mapa Dokumenti:"

