#: inputbackend.cpp:49
#, kde-format
msgid "Critical error on reading fundamental device infos of %1."
msgstr "Kritična pogreška pri čitanju osnovnih podataka uređaja %1."

#: kcm.cpp:112
#, kde-format
msgid "Error while loading values. See logs for more information. Please restart this configuration module."
msgstr "Pogreška pri učitavanju vrijednosti. Za više informacija pogledajte zapisnike. Ponovno pokrenite ovaj modul postavki."

#: kcm.cpp:115
#, kde-format
msgid "No pointer device found. Connect now."
msgstr "Nije pronađen nijedan pokazivački uređaj. Povežite ga sada."

#: kcm.cpp:124
#, kde-format
msgid "Not able to save all changes. See logs for more information. Please restart this configuration module and try again."
msgstr "Nije moguće spremiti sve promjene. Za više informacija pogledajte zapisnike. Ponovno pokrenite ovaj modul postavki i pokušajte ponovno."

#: kcm.cpp:142
#, kde-format
msgid "Error while loading default values. Failed to set some options to their default values."
msgstr "Pogreška pri učitavanju zadanih vrijednosti. Neke opcije nije bilo moguće postaviti na zadane vrijednosti."

#: kcm.cpp:157
#, kde-format
msgid "Error while adding newly connected device. Please reconnect it and restart this configuration module."
msgstr "Pogreška pri dodavanju novopovezanog uređaja. Ponovno ga povežite i pokrenite ovaj modul postavki."

#: kcm.cpp:170
#, kde-format
msgid "Pointer device disconnected. Closed its setting dialog."
msgstr "Pokazivački uređaj je odspojen. Njegov dijalog postavki je zatvoren."

#: kcm.cpp:172
#, kde-format
msgid "Pointer device disconnected. No other devices found."
msgstr "Pokazivački uređaj je odspojen. Nisu pronađeni drugi uređaji."

#: ui/bindings.qml:27
#, kde-format
msgctxt "@title"
msgid "Extra Mouse Buttons"
msgstr "Dodatne tipke miša"

#: ui/bindings.qml:77
#, kde-format
msgctxt "@label for assigning an action to a numbered button"
msgid "Extra Button %1:"
msgstr "Dodatna tipka %1:"

#: ui/bindings.qml:106
#, kde-format
msgctxt "@action:button"
msgid "Press the mouse button for which you want to add a key binding"
msgstr "Pritisnite tipku miša kojoj želite dodijeliti kombinaciju tipki"

#: ui/bindings.qml:108
#, kde-format
msgctxt "@action:button, %1 is the translation of 'Extra Button %1' from above"
msgid "Enter the new key combination for %1"
msgstr "Unesite novu kombinaciju tipki za %1"

#: ui/bindings.qml:112
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "Odustani"

#: ui/bindings.qml:130
#, kde-format
msgctxt "@action:button"
msgid "Press a mouse button"
msgstr "Pritisnite tipku miša"

#: ui/bindings.qml:131
#, kde-format
msgctxt "@action:button, Bind a mousebutton to keyboard key(s)"
msgid "Add Binding…"
msgstr "Dodaj povezivanje…"

#: ui/main.qml:37
#, kde-format
msgctxt "@action:button"
msgid "Configure Extra Buttons…"
msgstr "Konfiguriraj dodatne tipke…"

#: ui/main.qml:64
#, kde-format
msgctxt "@title:listbox select device"
msgid "Device:"
msgstr "Uređaj:"

#: ui/main.qml:86
#, kde-format
msgctxt "@title:group"
msgid "General:"
msgstr "Općenito:"

#: ui/main.qml:87
#, kde-format
msgctxt "@option:check enable this mouse device"
msgid "Enable device"
msgstr "Omogući uređaj"

#: ui/main.qml:102
#, kde-format
msgctxt "@title:group"
msgid "Left and right buttons:"
msgstr "Lijeva i desna tipka:"

#: ui/main.qml:103
#, kde-format
msgctxt "@option:check Left and right buttons"
msgid "Swap (left-handed mode)"
msgstr "Zamijeni (način za ljevake)"

#: ui/main.qml:118
#, kde-format
msgctxt "@option:check 'both' refers to the left and right buttons'"
msgid "Press both simultaneously to middle-click"
msgstr "Istodobno pritisni obje tipke za klik srednjom tipkom"

#: ui/main.qml:130
#, kde-format
msgctxt "@info:tooltip from ContextualHelpButton"
msgid "Activating this setting increases click latency by 50ms. The extra delay is needed to correctly detect simultaneous left and right button presses."
msgstr "Uključivanje ove postavke povećava latenciju klika za 50 ms. Dodatna je odgoda potrebna za ispravno prepoznavanje istodobnog pritiska lijeve i desne tipke."

#: ui/main.qml:142
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Pointer speed:"
msgstr "Brzina pokazivača:"

#: ui/main.qml:223
#, kde-format
msgctxt "@option:check"
msgid "Enable pointer acceleration"
msgstr "Omogući ubrzanje pokazivača"

#: ui/main.qml:235
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid "When enabled, pointer travel distance increases with faster movement speed."
msgstr "Kada je omogućeno, prijeđena udaljenost pokazivača povećava se s brzinom njegova kretanja."

#: ui/main.qml:264
#, kde-format
msgctxt "@label:slider and @label:spinbox"
msgid "Scrolling speed:"
msgstr "Brzina pomicanja:"

#: ui/main.qml:328
#, kde-format
msgctxt "Slower Scroll"
msgid "Slower"
msgstr "Sporije"

#: ui/main.qml:337
#, kde-format
msgctxt "Faster Scroll Speed"
msgid "Faster"
msgstr "Brže"

#: ui/main.qml:347
#, kde-format
msgctxt "@title:group"
msgid "Scrolling:"
msgstr "Pomicanje:"

#: ui/main.qml:348
#, kde-format
msgctxt "@option:check"
msgid "Invert scroll direction"
msgstr "Obrni smjer pomicanja"

#: ui/main.qml:363
#, kde-format
msgctxt "@option:check"
msgid "Scroll when moving the pointer"
msgstr "Pomiči sadržaj pri kretanju pokazivača"

#: ui/main.qml:383
#, kde-format
msgctxt "@option:radio"
msgid "while pressing the middle button"
msgstr "dok je pritisnuta srednja tipka"

#: ui/main.qml:396
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid "This will interfere with applications that use middle-button drag, such as some image editors, document viewers, or video games. It may be used on any device, but is intended primarily as a substitute for scroll wheels on devices that do not have any."
msgstr "To će ometati aplikacije koje koriste povlačenje srednjom tipkom, poput nekih uređivača slika, preglednika dokumenata ili videoigara. Može se koristiti na bilo kojem uređaju, ali je prvenstveno namijenjeno kao zamjena za kotačić za pomicanje na uređajima koji ga nemaju."

#: ui/main.qml:406
#, kde-format
msgctxt "@option:radio"
msgid "after clicking the middle button"
msgstr "nakon pritiska srednje tipke"

#: ui/main.qml:419
#, kde-format
msgctxt "@info:whatsthis ContextualHelpButton tooltip"
msgid "This will interfere with middle-clicks in general; middle-click twice when you want the application to receive a single middle-click. This includes middle-click dragging."
msgstr "To će općenito ometati klikove srednjom tipkom. Kada želite da aplikacija primi jedan takav klik, dvaput kliknite srednjom tipkom. To uključuje i povlačenje srednjom tipkom."