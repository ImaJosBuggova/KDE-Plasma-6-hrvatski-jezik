msgstr "Omogući"

#: ui/StylusTab.qml:241
#, kde-kuit-format
msgctxt "@info"
msgid "Tells the device to accommodate left-handed users. Effects will vary by device, but often it reverses the pad buttonsʼ functionality so the tablet can be used upside-down."
msgstr "Prilagođava uređaj ljevacima. Učinak ovisi o uređaju, no često se obrću funkcije tipki podloge kako bi se tablet mogao koristiti naopako."

#: ui/StylusTab.qml:247
#, kde-format
msgctxt "'Mode' is the mode the stylus is in, pen (absolute) or mouse (relative)"
msgid "Mode:"
msgstr "Način rada:"

#: ui/StylusTab.qml:251
#, kde-format
msgctxt "@option:radio Pen mode, where the point on the screen is always where you touch the stylus"
msgid "Pen"
msgstr "Olovka"

#: ui/StylusTab.qml:256
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid "The cursor follows where you touch the pen on the surface"
msgstr "Pokazivač prati mjesto na površini koje dodirnete olovkom"

#: ui/StylusTab.qml:265
#, kde-format
msgctxt "@option:radio Mouse mode, or like using the tablet like a giant touchpad"
msgid "Mouse"
msgstr "Miš"

#: ui/StylusTab.qml:270
#, kde-format
msgctxt "@info:whatsthis Accessible description"
msgid "Moving the pen on the surface moves the cursor relative to where it was, like a mouse"
msgstr "Pomicanjem olovke po površini pomiče se pokazivač u odnosu na njegov prethodni položaj, kao kod miša"

#: ui/StylusTab.qml:276
#, kde-format
msgid "Sync with mouse cursor"
msgstr "Sinkroniziraj s pokazivačem miša"

