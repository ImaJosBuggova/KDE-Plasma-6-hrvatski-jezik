#, kde-format
msgctxt "@info"
msgid "%1: (%2 px, %3 px)"
msgstr "%1: (%2 px, %3 px)"

#: ui/Calibration.qml:107
#, kde-format
msgctxt "@info"
msgid "Applied center correction (%1 px, %2 px). Retap the targets to redo the correction."
msgstr "Primijenjena je korekcija središta (%1 px, %2 px). Ponovno dodirnite ciljne točke da biste ponovili korekciju."

#: ui/Calibration.qml:173
#, kde-kuit-format
msgctxt "@info"
msgid "Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis strong='true'>Will revert to default calibration in %1 second unless further action is taken.</emphasis>"
msgid_plural "Tap the targets again to confirm the new calibration.<nl/><nl/><emphasis strong='true'>Will revert to default calibration in %1 seconds unless further action is taken.</emphasis>"
msgstr[0] "Ponovno dodirnite ciljne točke da biste potvrdili novu kalibraciju.<nl/><nl/><emphasis strong='true'>Vraćanje na zadanu kalibraciju za %1 sekundu ako ne poduzmete dodatnu radnju.</emphasis>"
msgstr[1] "Ponovno dodirnite ciljne točke da biste potvrdili novu kalibraciju.<nl/><nl/><emphasis strong='true'>Vraćanje na zadanu kalibraciju za %1 sekunde ako ne poduzmete dodatnu radnju.</emphasis>"
msgstr[2] "Ponovno dodirnite ciljne točke da biste potvrdili novu kalibraciju.<nl/><nl/><emphasis strong='true'>Vraćanje na zadanu kalibraciju za %1 sekundi ako ne poduzmete dodatnu radnju.</emphasis>"

#: ui/Calibration.qml:177
#, kde-format
msgctxt "@info"
msgid "Calibration is completed and saved.\n\nTap the center target once to fine-tune alignment. You can retap the other targets to verify the result."
msgstr "Kalibracija je dovršena i spremljena.\n\nJednom dodirnite središnju ciljnu točku za fino podešavanje poravnanja. Ponovno dodirnite ostale ciljne točke da biste provjerili rezultat."

#: ui/Calibration.qml:180
#, kde-format
msgctxt "@info"
msgid "Tap the center of each target."
msgstr "Dodirnite središte svake ciljne točke."

#: ui/Calibration.qml:201
#, kde-format
msgctxt "@info"
msgid "Offset Correction:\n%1"
msgstr "Korekcija pomaka:\n%1"

