#: ui/StylusTab.qml:456
#, kde-format
msgctxt "@info"
msgid "Pressure above or below the threshold will be clamped, and this becomes the new effective range."
msgstr "Pritisak iznad ili ispod praga bit će ograničen, čime se postavlja novi učinkoviti raspon."

#: ui/StylusTab.qml:461
#, kde-format
msgctxt "@info"
msgid "You have manually calibrated this tablet. If it's no longer working correctly, try resetting this first."
msgstr "Ručno ste kalibrirali ovaj tablet. Ako više ne radi ispravno, najprije pokušajte poništiti kalibraciju."

