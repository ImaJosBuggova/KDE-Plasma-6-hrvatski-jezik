#: app/Konfigurator/kgpanel.cpp:781
#, kde-format
msgid "Spacebar moves down"
msgstr "Razmaknica pomiče prema dolje"

#: app/Konfigurator/kgpanel.cpp:783
#, kde-format
msgid ""
"If checked, pressing the spacebar will select the current item and move "
"down.\n"
"Otherwise, current item is selected, but remains the current item."
msgstr ""
"Ako je označeno, pritiskom razmaknice odabire se trenutačna stavka i pomiče "
"se prema dolje.\n"
