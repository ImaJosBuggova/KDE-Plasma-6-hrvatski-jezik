msgid "Ignore Date"
msgstr "Zanemari datum"

#: app/Synchronizer/synchronizergui.cpp:264
#, kde-format
msgid ""
"<p>Ignore date information during the compare process.</p><p><b>Note</b>: "
"useful if the files are located on network filesystems or in archives.</p>"
msgstr "<p>Zanemari podatke o datumu tijekom usporedbe.</p><p><b>Napomena</b>: korisno ako se datoteke nalaze na mrežnim datotečnim sustavima ili u arhivama.</p>"

#: app/Synchronizer/synchronizergui.cpp:266
#, kde-format
msgid "Asymmetric"
msgstr "Asimetrično"

#: app/Synchronizer/synchronizergui.cpp:270
#, kde-format
msgid ""
"<p><b>Asymmetric mode</b></p><p>The left side is the destination, the right "
"is the source folder. Files existing only in the left folder will be "
"deleted, the other differing ones will be copied from right to left.</"
"p><p><b>Note</b>: useful when updating a folder from a file server.</p>"
msgstr "<p><b>Asimetrični način</b></p><p>Lijeva strana je odredište, a desna izvorna mapa. Datoteke koje postoje samo u lijevoj mapi bit će izbrisane, a ostale različite datoteke kopirat će se zdesna nalijevo.</p><p><b>Napomena</b>: korisno pri ažuriranju mape s poslužitelja datoteka.</p>"

#: app/Synchronizer/synchronizergui.cpp:272
#, kde-format
msgid "Ignore Case"
msgstr "Zanemari velika i mala slova"

#: app/Synchronizer/synchronizergui.cpp:275
#, kde-format
msgid ""
"<p>Case insensitive filename compare.</p><p><b>Note</b>: useful when "
"synchronizing Windows filesystems.</p>"
msgstr "<p>Uspoređuj nazive datoteka bez razlikovanja velikih i malih slova.</p><p><b>Napomena</b>: korisno pri sinkronizaciji datotečnih sustava Windows.</p>"

