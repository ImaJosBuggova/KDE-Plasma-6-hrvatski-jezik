#: ui/DeviceView.qml:105 ui/DeviceView.qml:125
#, kde-format
msgid "Failed to enroll device <b>%1</b>: %2"
msgstr "Neuspjela registracija uređaja <b>%1</b>: %2"

#: ui/DeviceView.qml:112
#, kde-format
msgid "Trust this Device"
msgstr "Smatraj ovaj uređaj pouzdanim"

#: ui/DeviceView.qml:133
#, kde-format
msgid "Revoke Trust"
msgstr "Opozovi pouzdanost"

#: ui/DeviceView.qml:145
#, kde-format
msgid "Error changing device trust: <b>%1</b>: %2"
msgstr "Greška pri promjeni pouzdanosti uređaja: <b>%1</b>: %2"

#: ui/DeviceView.qml:161
#, kde-format
msgid ""
"Hint: trusted device will be automatically authorized the next time it is "
"connected to the computer."
msgstr ""
"Savjet: pouzdani uređaj automatski će se autorizirati sljedeći put kada se "
"spoji na računalo."

#: ui/DeviceView.qml:162
#, kde-format
msgid ""
"Hint: an untrusted device needs to be manually authorized each time it is "
"connected to the computer."
msgstr ""
"Savjet: nepouzdani uređaj potrebno je ručno autorizirati svaki put kada se "
"spoji na računalo."

#: ui/main.qml:31
#, kde-format
msgctxt "@option:check Enable Thunderbolt subsystem"
msgid "Enable"
msgstr "Omogući"

#: ui/main.qml:32
#, kde-format
msgctxt "@option:check"
msgid "Enable Thunderbolt subsystem"
msgstr "Omogući Thunderbolt podsustav"

#: ui/main.qml:63
#, kde-format
msgid "Thunderbolt support has been disabled in BIOS"
msgstr "Podrška za Thunderbolt je onemogućena u BIOS-u"

#: ui/main.qml:64
#, kde-format
msgid "Follow your system manufacturer's guide to enable Thunderbolt support"
msgstr ""
"Slijedite upute proizvođača vašeg sustava kako biste omogućili podršku za "
"Thunderbolt"

#: ui/main.qml:70
#, kde-format
msgid "No Thunderbolt devices connected"
msgstr "Nema spojenih Thunderbolt uređaja"

#: ui/main.qml:71
#, kde-format
msgid "Plug in a Thunderbolt device"
msgstr "Priključite Thunderbolt uređaj"

#: ui/main.qml:85
#, kde-format
msgid "Thunderbolt subsystem is disabled or unavailable"
msgstr "Thunderbolt podsustav je onemogućen ili nedostupan"

#: ui/main.qml:86
#, kde-format
msgid ""
"If the device supports Thunderbolt, try plugging in a Thunderbolt device"
msgstr ""
"Ako uređaj podržava Thunderbolt, pokušajte priključiti Thunderbolt uređaj"

