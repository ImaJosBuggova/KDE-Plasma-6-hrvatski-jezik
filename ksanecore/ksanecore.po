#: interface.cpp:314
#, kde-format
msgid "Scanning stopped by user."
msgstr "Korisnik je zaustavio skeniranje."

#: options/batchdelayoption.cpp:31
#, kde-format
msgid "Batch mode time delay"
msgstr "Vremenski odmak u skupnom načinu rada"

#: options/batchdelayoption.cpp:36
#, kde-format
msgid "Specify the time delay between each scan when batch mode is enabled."
msgstr "Odredite vremenski odmak između skeniranja kada je omogućen skupni način rada."

#: options/batchmodeoption.cpp:31
#, kde-format
msgid "Batch mode with time delay"
msgstr "Skupni način rada s vremenskim odmakom"

#: options/batchmodeoption.cpp:36
#, kde-format
msgid ""
"Enables batch mode scanning. Continues scanning after a delay until canceled."
msgstr "Omogućuje skupno skeniranje. Skeniranje se nastavlja nakon odmaka sve dok ga ne otkažete."

#: options/invertoption.cpp:58
#, kde-format
msgid "Invert colors"
msgstr "Invertiraj boje"

#: options/invertoption.cpp:63
#, kde-format
msgid "Invert the colors of the scanned image."
msgstr "Invertiraj boje skenirane slike."

#: options/pagesizeoption.cpp:184
#, kde-format
msgid "Scan area size"
msgstr "Veličina područja skeniranja"

#: options/pagesizeoption.cpp:189
#, kde-format
msgid "Select a predefined page size for the scanning area."
msgstr "Odaberite unaprijed definiranu veličinu stranice za područje skeniranja."

#: options/pagesizeoption.cpp:329
#, kde-format
msgctxt "Page size landscape"
msgid "Landscape %1"
msgstr "Položeno %1"
