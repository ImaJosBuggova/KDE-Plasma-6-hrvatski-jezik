#: wakedlg.cpp:40
#, kde-format
msgctxt "@title:window"
msgid "Wake From Suspend"
msgstr "Buđenje iz stanja suspenzije"

#: wakedlg.cpp:146
#, kde-format
msgctxt "@info"
msgid "Cannot schedule wakeup time for a date-only alarm"
msgstr "Sljedeći planirani datum i vrijeme alarma"

#: wakedlg.cpp:150
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para>This wakeup will cancel any existing wakeup which has been set by "
"KAlarm or any other application, because your computer can only schedule a "
"single wakeup time.</para><para><note>Wake From Suspend is not supported at "
"all on some computers, especially older ones, and some computers only "
"support setting a wakeup time up to 24 hours ahead. You may wish to set up a "
"test alarm to check your system's capability.</note></para>"
msgstr "<para>Ovo će buđenje otkazati postojeća buđenja koja su postavili KAlarm ili druge aplikacije jer računalo može zakazati samo jedno vrijeme buđenja.</para><para><note>Neka računala, osobito starija, uopće ne podržavaju buđenje iz suspenzije, a neka ga mogu zakazati najviše 24 sata unaprijed. Postavite probni alarm da biste provjerili mogućnosti sustava.</note></para>"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: wakedlg.ui:21
#, kde-format
msgid "Wake From Suspend Alarm"
msgstr "Alarm za buđenje iz stanja suspenzije"

#. i18n: ectx: property (toolTip), widget (QPushButton, showWakeButton)
#: wakedlg.ui:42
#, kde-format
msgid "Show current wake-from-suspend alarm"
msgstr "Prikaži trenutačni alarm za buđenje iz stanja suspenzije"

#. i18n: ectx: property (whatsThis), widget (QPushButton, showWakeButton)
#: wakedlg.ui:45
#, kde-format
msgid ""
"Highlight the current wake-from-suspend alarm in the alarm list. This button "
"is disabled if no wake-from-suspend alarm is configured."
msgstr "Označi trenutačni alarm za buđenje iz suspenzije na popisu. Gumb je onemogućen ako takav alarm nije postavljen."

#. i18n: ectx: property (text), widget (QPushButton, showWakeButton)
#: wakedlg.ui:48
#, kde-format
msgid "Show current alarm"
msgstr "Pokaži vrijeme do &oglašavanja"

#. i18n: ectx: property (toolTip), widget (QPushButton, useWakeButton)
#: wakedlg.ui:55
#, kde-format
msgid "Set highlighted alarm as the wake-from-suspend alarm"
msgstr "Postavi označeni alarm za buđenje iz suspenzije"

#. i18n: ectx: property (whatsThis), widget (QPushButton, useWakeButton)
#: wakedlg.ui:58
#, kde-format
msgid ""
"Set the alarm highlighted in the alarm list to wake-from-suspend. This "
"replaces any existing wake-from-suspend alarm."
msgstr "Postavi označeni alarm za buđenje iz suspenzije. Time se zamjenjuje postojeći alarm za buđenje."

#. i18n: ectx: property (text), widget (QPushButton, useWakeButton)
#: wakedlg.ui:61
#, kde-format
msgid "Use highlighted alarm"
msgstr "Ukloni trenutno označenu stavku iz liste izuzetaka"

#. i18n: ectx: property (toolTip), widget (QPushButton, cancelWakeButton)
#: wakedlg.ui:74
#, kde-format
msgid "Cancel the current wake-from-suspend"
msgstr "Otkaži trenutačno buđenje iz suspenzije"

#. i18n: ectx: property (whatsThis), widget (QPushButton, cancelWakeButton)
#: wakedlg.ui:77
#, kde-format
msgid ""
"Cancel the currently configured wake-from-suspend. Note that this does not "
"cancel the alarm itself, which will still trigger in the normal way. This "
"button is disabled if no wake-from-suspend alarm is configured."
msgstr "Otkaži postavljeno buđenje iz suspenzije. Sam alarm neće se otkazati i aktivirat će se uobičajeno. Gumb je onemogućen ako alarm za buđenje nije postavljen."

#. i18n: ectx: property (text), widget (QPushButton, cancelWakeButton)
#: wakedlg.ui:80
#, kde-format
msgid "Cancel wake from suspend"
msgstr "Otkaži buđenje iz stanja suspenzije"

#. i18n: ectx: property (whatsThis), widget (QSpinBox, advanceWakeTime)
#: wakedlg.ui:113
#, kde-format
msgid ""
"Enter how many minutes before the alarm trigger time to wake the system from "
"suspend. This can be used to ensure that the system is fully restored by the "
"time the alarm triggers."
msgstr "Unesite koliko minuta prije alarma treba probuditi sustav iz stanja suspenzije kako bi bio potpuno pokrenut pri aktiviranju alarma."

#. i18n: ectx: property (text), widget (QLabel, label)
#: wakedlg.ui:123
#, kde-format
msgid "Number of minutes before alarm to wake from suspend"
msgstr "Broj minuta prije alarma za buđenje iz stanja suspenzije"
