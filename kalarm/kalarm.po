#: prefdlg.cpp:1202
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>%1<list><item><interface>%2</interface>: The email is sent "
"automatically. This option will only work if your system is configured to "
"use <application>sendmail</application> or a sendmail compatible mail "
"transport agent.</item></list></para>"
msgstr "<para>%1<list><item><interface>%2</interface>: E-poruka se šalje automatski. Ova opcija radi samo ako je sustav konfiguriran za upotrebu programa <application>sendmail</application> ili kompatibilnog agenta za prijenos pošte.</item></list></para>"

