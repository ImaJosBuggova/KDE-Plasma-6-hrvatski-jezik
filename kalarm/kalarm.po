#: specialactions.cpp:160 specialactions.cpp:195
#, kde-format
msgctxt "@label:textbox"
msgid "Command:"
msgstr "&Naredba"

#: specialactions.cpp:167
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Enter a shell command to execute before the alarm is displayed.</"
"para><para>Note that it is executed only when the alarm proper is displayed, "
"not when a reminder or deferred alarm is displayed.</para><para><note>KAlarm "
"will wait for the command to complete before displaying the alarm.</note></"
"para>"
msgstr "<para>Unesite naredbu ljuske koju treba izvršiti prije prikaza alarma.</para><para>Izvršava se samo prije samog alarma, a ne prije podsjetnika ili odgođenog alarma.</para><para><note>KAlarm će pričekati dovršetak naredbe.</note></para>"

#: specialactions.cpp:173
#, kde-format
msgctxt "@option:check"
msgid "Execute for deferred alarms"
msgstr "Izvrši za odgođene alarme"

#: specialactions.cpp:174
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>If unchecked, the command is only executed before the alarm proper is "
"displayed.</para><para>If checked, the pre-alarm command is also executed "
"before a deferred alarm is displayed.</para>"
msgstr "<para>Ako nije označeno, naredba se izvršava samo prije samog alarma.</para><para>Ako je označeno, naredba prije alarma izvršava se i prije odgođenog alarma.</para>"

#: specialactions.cpp:178
#, kde-format
msgctxt "@option:check"
msgid "Cancel alarm on error"
msgstr "Otkaži alarm pri pogrešci"

#: specialactions.cpp:179
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Cancel the alarm if the pre-alarm command fails, i.e. do not display the "
"alarm or execute any post-alarm action command."
msgstr "Otkaži alarm ako naredba prije alarma ne uspije; nemoj prikazati alarm ni izvršiti naredbu nakon alarma."

#: specialactions.cpp:183
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Do not show error status or error message if the pre-alarm command fails."
msgstr "Uobičajena vrijednost za pravilo ponavljanja u dijalogu za uređivanje alarma."

#: specialactions.cpp:187
#, kde-format
msgctxt "@title:group"
msgid "Post-Alarm Action"
msgstr "Postavke e-pošte alarma"

#: specialactions.cpp:201
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Enter a shell command to execute after the alarm window is closed.</"
"para><para>Note that it is not executed after closing a reminder window. If "
"you defer the alarm, it is not executed until the alarm is finally "
"acknowledged or closed.</para>"
msgstr "<para>Unesite naredbu ljuske za izvršavanje nakon zatvaranja prozora alarma.</para><para>Ne izvršava se nakon zatvaranja podsjetnika. Ako odgodite alarm, izvršit će se nakon njegove konačne potvrde ili zatvaranja.</para>"

