msgid "Audio backend"
msgstr "Pozadinski sustav zvuka"

#. i18n: ectx: whatsthis, entry (Base_AudioBackend), group (General)
#: data/kalarmconfig.kcfg:84
#, kde-format
msgctxt "@info:whatsthis"
msgid "Which audio backend to prefer."
msgstr "Koji pozadinski sustav zvuka ima prednost."

#. i18n: ectx: label, entry (Base_AudioBackend), group (General)
#: data/kalarmconfig.kcfg:86
