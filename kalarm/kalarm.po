#. i18n: ectx: label, entry (Base_TimeZone), group (General)
#: data/kalarmconfig.kcfg:92
#, kde-format
msgctxt "@label"
msgid "Time zone"
msgstr "Vrijeme do"

#. i18n: ectx: whatsthis, entry (Base_TimeZone), group (General)
#: data/kalarmconfig.kcfg:93
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Select the time zone which KAlarm should use as its default for displaying "
"and entering dates and times."
msgstr "Odaberite vremensku zonu koju će KAlarm zadano upotrebljavati za prikaz i unos datuma i vremena."

#. i18n: ectx: label, entry (Base_HolidayRegion), group (General)
#: data/kalarmconfig.kcfg:97
#, kde-format
msgctxt "@label"
msgid "Holiday region"
msgstr "Regija blagdana"

#. i18n: ectx: whatsthis, entry (Base_HolidayRegion), group (General)
#: data/kalarmconfig.kcfg:98
#, kde-format
msgctxt "@info:whatsthis"
msgid "Select the holiday region to use."
msgstr "Unesite vrijeme za koje želite da zakažete alarm."

#. i18n: ectx: label, entry (DefaultFgColour), group (General)
#: data/kalarmconfig.kcfg:102
#, kde-format
msgctxt "@label"
msgid "Foreground color"
msgstr "&Boja:"

#. i18n: ectx: whatsthis, entry (DefaultFgColour), group (General)
#: data/kalarmconfig.kcfg:103
#, kde-format
msgctxt "@info:whatsthis"
msgid "Default foreground color for alarm message windows."
msgstr "Odaberite boju pozadine za alarmnu poruku."

#. i18n: ectx: label, entry (DefaultBgColour), group (General)
#: data/kalarmconfig.kcfg:107
#, kde-format
msgctxt "@label"
msgid "Background color"
msgstr "&Boja pozadine:"

#. i18n: ectx: whatsthis, entry (DefaultBgColour), group (General)
#: data/kalarmconfig.kcfg:108
#, kde-format
msgctxt "@info:whatsthis"
msgid "Default background color for alarm message windows."
msgstr "Odaberite boju pozadine za alarmnu poruku."

#. i18n: ectx: label, entry (UseAlarmName), group (General)
#: data/kalarmconfig.kcfg:112
#, kde-format
msgctxt "@label"
msgid "Enable alarm names"
msgstr "Alarmna poruka"

#. i18n: ectx: whatsthis, entry (UseAlarmName), group (General)
#: data/kalarmconfig.kcfg:113
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Choose whether to be able to give alarms a name. This is a convenience to "
"help you to identify alarms."
msgstr "Odaberite želite li imenovati alarme kako biste ih lakše prepoznali."

#. i18n: ectx: label, entry (MessageFont), group (General)
#: data/kalarmconfig.kcfg:118
#, kde-format
msgctxt "@label"
msgid "Message font"
msgstr "Poruka"

#. i18n: ectx: whatsthis, entry (MessageFont), group (General)
#: data/kalarmconfig.kcfg:119
#, kde-format
msgctxt "@info:whatsthis"
msgid "Default font for displaying alarm messages."
msgstr "Odaberite boju pozadine za alarmnu poruku."

#. i18n: ectx: label, entry (ShowInSystemTray), group (General)
#: data/kalarmconfig.kcfg:124
#, kde-format
msgctxt "@label"
msgid "Show in system tray"
msgstr "Pokaži u sis&temskoj kaseti"

#. i18n: ectx: whatsthis, entry (ShowInSystemTray), group (General)
#: data/kalarmconfig.kcfg:125
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>Check to show KAlarm's icon in the system tray. Showing it in the system "
"tray provides easy access and a status indication.</p>"
msgstr "<p>Označite za prikaz ikone KAlarma u programskoj traci radi brzog pristupa i prikaza statusa.</p>"

#. i18n: ectx: label, entry (Base_AutoHideSystemTray), group (General)
#: data/kalarmconfig.kcfg:130
#, kde-format
msgctxt "@label"
msgid "Auto-hide in system tray if no alarms due within period"
msgstr "Automatski sakrij u programskoj traci ako u tom razdoblju nema zakazanih alarma"

#. i18n: ectx: whatsthis, entry (Base_AutoHideSystemTray), group (General)
#: data/kalarmconfig.kcfg:131
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>Enter -1 to auto-hide KAlarm's icon in the system tray when there are no "
"active alarms.</p><p>To auto-hide the system tray icon when there are no "
"alarms due within a set period of time, enter the time period in minutes.</"
"p><p>Enter 0 to always show the system tray icon.</p>"
msgstr "<p>Unesite -1 da biste automatski sakrili ikonu KAlarma u programskoj traci kada nema aktivnih alarma.</p><p>Da biste automatski sakrili ikonu kada u zadanom razdoblju nema alarma, unesite trajanje u minutama.</p><p>Unesite 0 da biste uvijek prikazivali ikonu programske trake.</p>"

#. i18n: ectx: label, entry (NoAutoHideSystemTrayDesktops), group (General)
#: data/kalarmconfig.kcfg:136
#, kde-format
msgctxt "@label"
msgid "Desktops without auto-hide in system tray"
msgstr "Radne površine bez automatskog skrivanja u programskoj traci"

#. i18n: ectx: whatsthis, entry (NoAutoHideSystemTrayDesktops), group (General)
#: data/kalarmconfig.kcfg:137
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Desktops for which the auto-hide in system tray option is not available."
msgstr "Radne površine na kojima automatsko skrivanje u programskoj traci nije dostupno."

#. i18n: ectx: label, entry (Base_AutoStart), group (General)
#: data/kalarmconfig.kcfg:141
#, kde-format
msgctxt "@label"
msgid "Start at login"
msgstr "Automatsko pokretanje po &prijavljivanju"

#. i18n: ectx: whatsthis, entry (Base_AutoStart), group (General)
#: data/kalarmconfig.kcfg:142
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>Automatically start KAlarm whenever you start KDE.</p><p>This option "
"should always be set true if RunMode=Auto, else false.</p>"
msgstr "<p>Automatski pokreni KAlarm pri pokretanju KDE-a.</p><p>Ova mogućnost mora biti uključena ako je RunMode=Auto, a inače isključena.</p>"

#. i18n: ectx: label, entry (Base_RunMode), group (General)
#: data/kalarmconfig.kcfg:146
#, kde-format
msgctxt "@label"
msgid "Run mode"
msgstr "Način rada rada"

#. i18n: ectx: whatsthis, entry (Base_RunMode), group (General)
#: data/kalarmconfig.kcfg:147
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Whether to run KAlarm automatically on login, manually only, or not at all."
msgstr "Treba li KAlarm pokretati automatski pri prijavi, samo ručno ili ga uopće ne pokretati."

#. i18n: ectx: label, entry (Base_RunMode), group (General)
#: data/kalarmconfig.kcfg:149
#, kde-format
msgctxt "@option"
msgid "Run automatically"
msgstr "Pokreni automatski"

#. i18n: ectx: label, entry (Base_RunMode), group (General)
#: data/kalarmconfig.kcfg:150
#, kde-format
msgctxt "@option"
msgid "Run manually only"
msgstr "Pokreći samo ručno"

#. i18n: ectx: label, entry (Base_RunMode), group (General)
#: data/kalarmconfig.kcfg:151
#, kde-format
msgctxt "@option"
msgid "Do not run"
msgstr "&Ne ponavljaj"

#. i18n: ectx: label, entry (DefaultDeferTime), group (General)
#: data/kalarmconfig.kcfg:156
#, kde-format
msgctxt "@label"
msgid "Default defer time interval"
msgstr "Odloži za vremenski &period:"

#. i18n: ectx: whatsthis, entry (DefaultDeferTime), group (General)
#: data/kalarmconfig.kcfg:157
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Enter the default time interval (in minutes) to defer alarms, used by the "
"Defer Alarm dialog."
msgstr "Unesite zadani vremenski interval (u minutama) za odgodu alarma, koji se koristi u dijalogu za odgodu alarma."

#. i18n: ectx: label, entry (AskResource), group (General)
#: data/kalarmconfig.kcfg:161
#, kde-format
msgctxt "@label"
msgid "Prompt for which calendar to store in"
msgstr "Pitaj u koji kalendar spremiti"

#. i18n: ectx: whatsthis, entry (AskResource), group (General)
#: data/kalarmconfig.kcfg:162
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>When saving a new alarm or alarm template, prompt for which calendar to "
"store it in, if there is more than one active calendar.</p><p>Note that "
"archived alarms are always stored in the default archived alarm calendar.</p>"
msgstr "<p>Pri spremanju novog alarma ili predloška pitaj u koji kalendar ga spremiti ako postoji više aktivnih kalendara.</p><p>Arhivirani se alarmi uvijek spremaju u zadani kalendar arhiviranih alarma.</p>"

#. i18n: ectx: label, entry (Base_MessageButtonDelay), group (General)
#: data/kalarmconfig.kcfg:166
#, kde-format
msgctxt "@label"
msgid "Delay before message window buttons are enabled"
msgstr "Odgoda prije aktiviranja gumba u prozoru poruke"

#. i18n: ectx: whatsthis, entry (Base_MessageButtonDelay), group (General)
#: data/kalarmconfig.kcfg:171
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>Specify the positioning of alarm message windows, and the delay in "
"seconds after a window shows until its buttons are enabled.\n"
"        <ul><li>0 to position message windows as far from the cursor as "
"possible with no enable delay.</li>\n"
"        <li>> 0 to position in center of screen and specify delay before "
"enabling buttons.</li>\n"
"        <li>-1 for no special positioning and no enable delay.</li></ul></"
"p>\n"
"      "
msgstr "<p>Odredite položaj prozora alarmnih poruka i odgodu aktiviranja gumba u sekundama.\n        <ul><li>0 za smještanje prozora što dalje od pokazivača, bez odgode aktiviranja.</li>\n        <li>> 0 za smještanje na sredinu zaslona i zadavanje odgode aktiviranja gumba.</li>\n        <li>-1 za uobičajen položaj i bez odgode.</li></ul></p>\n      "

#. i18n: ectx: label, entry (TooltipAlarmCount), group (General)
#: data/kalarmconfig.kcfg:177
#, kde-format
msgctxt "@label"
msgid "Number of alarms to show in system tray tooltip"
msgstr "Broj alarma za prikaz u oblačiću programske trake"

#. i18n: ectx: whatsthis, entry (TooltipAlarmCount), group (General)
#: data/kalarmconfig.kcfg:182
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>How many alarms due in the next 24 hours to show in the system tray "
"tooltip:\n"
"        <ul><li>0 to display none</li>\n"
"        <li>-1 to display all</li>\n"
"        <li>>0 to set a limit.</li></ul></p>\n"
"      "
msgstr "Uključite ovo da bi alarmi bili sačuvani poslije isticanja ili brisanja (osim ako se alarm nijednom nije oglasio)."

#. i18n: ectx: label, entry (ShowTooltipAlarmTime), group (General)
#: data/kalarmconfig.kcfg:188
#, kde-format
msgctxt "@label"
msgid "Show alarm times in system tray tooltip"
msgstr "Prikaži vremena alarma u oblačiću programske trake"

#. i18n: ectx: whatsthis, entry (ShowTooltipAlarmTime), group (General)
#: data/kalarmconfig.kcfg:189 prefdlg.cpp:2013
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Specify whether to show in the system tray tooltip, the time at which each "
"alarm is due."
msgstr "Navedite da li će u oblačiću sustavske kasete biti prikazano vrijeme za koje je alarm zakazan."

#. i18n: ectx: label, entry (ShowTooltipTimeToAlarm), group (General)
#: data/kalarmconfig.kcfg:194
#, kde-format
msgctxt "@label"
msgid "Show time to alarms in system tray tooltip"
msgstr "Automatski pokreni &sličicu u sistemskoj traci po prijavljivanju"

#. i18n: ectx: whatsthis, entry (ShowTooltipTimeToAlarm), group (General)
#: data/kalarmconfig.kcfg:195 prefdlg.cpp:2019
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Specify whether to show in the system tray tooltip, how long until each "
"alarm is due."
msgstr "Navedite da li će u oblačiću sustavske kasete biti prikazano preostalo vrijeme do oglašavanja alarma."

#. i18n: ectx: label, entry (TooltipTimeToPrefix), group (General)
#: data/kalarmconfig.kcfg:200
#, kde-format
msgctxt "@label"
msgid "Time-to-alarm prefix in system tray tooltip"
msgstr "Prefiks vremena do alarma u oblačiću programske trake"

#. i18n: ectx: whatsthis, entry (TooltipTimeToPrefix), group (General)
#: data/kalarmconfig.kcfg:201 prefdlg.cpp:2030
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Enter the text to be displayed in front of the time until the alarm, in the "
"system tray tooltip."
msgstr "Unesite tekst koji će biti prikazan ispred preostalog vremena do oglašavanja alarma u oblačiću sustavske kasete"

#. i18n: ectx: label, entry (Base_EmailClient), group (General)
#: data/kalarmconfig.kcfg:206
#, kde-format
msgctxt "@label"
msgid "Email client"
msgstr "E-poštanski klijent:"

#. i18n: ectx: whatsthis, entry (Base_EmailClient), group (General)
#: data/kalarmconfig.kcfg:207
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<p>How to send email when an email alarm is triggered.<ul><li>KMail: The "
"email is sent automatically via KMail.</li><li>Sendmail: The email is sent "
"automatically. This option will only work if your system is configured to "
"use sendmail or a sendmail compatible mail transport agent.</li></ul></p>"
msgstr "Odaberite kako će e-poruka biti poslana kada se oglasi e-poštanski alarm.\nKMail: E-poruka biti će dodata u KMail-ovo odlazno sanduče ako je KMail pokrenut. U suprotnom, otvoriće se KMail-ov sastavljač koji vam omogućuva da pošaljete poruku.\nSendmail: E-poruka će biti poslana automatski. Ova opcija će raditi samo ako je vaš sustav postavljen treba koristiti „sendmail“ ili njemu kompatibilan transportni agent."

#. i18n: ectx: label, entry (Base_EmailClient), group (General)
#: data/kalarmconfig.kcfg:209
#, kde-format
msgctxt "@option"
msgid "Sendmail"
msgstr "Sendmail"

#. i18n: ectx: label, entry (Base_EmailClient), group (General)
#: data/kalarmconfig.kcfg:210
#, kde-format
msgctxt "@option"
msgid "KMail"
msgstr "&KMail"

#. i18n: ectx: label, entry (Base_EmailCopyToKMail), group (General)
#: data/kalarmconfig.kcfg:215
#, kde-format
msgctxt "@label"
msgid "Whether to copy sent emails into KMail's Sent folder."
msgstr "Treba li kopirati poslane poruke e-pošte u mapu Poslano u KMailu."

#. i18n: ectx: whatsthis, entry (Base_EmailCopyToKMail), group (General)
#: data/kalarmconfig.kcfg:216
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Whether after sending an email to store a copy in KMail's sent-mail folder. "
"Only applies when sendmail is selected as the email client."
msgstr "Treba li kopiju poslane poruke spremiti u mapu Poslana pošta u KMailu. Primjenjuje se samo kada je sendmail odabran kao klijent e-pošte."

#. i18n: ectx: label, entry (Base_EmailFrom), group (General)
#: data/kalarmconfig.kcfg:220
#, kde-format
msgctxt "@label"
msgid "'From' email address"
msgstr "Vaša adresa e-pošte"

#. i18n: ectx: whatsthis, entry (Base_EmailFrom), group (General)
#: data/kalarmconfig.kcfg:221
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Your email address, used to identify you as the sender when sending email "
"alarms. Enter \"@SystemSettings\" to use the default email address set in "
"KMail, \"@KMail\" to allow choice of KMail identities, or enter the actual "
"email address otherwise."
msgstr "Vaša e-adresa, koja se koristi za slepo kopiranje e-poštanskih alarma vama. Ako želite da se slepe kopije šalju na vaš korisnički račun na računalou na kome se izvršava KAlarm, možete prosto unijeti vaše korisničko ime."

#. i18n: ectx: label, entry (Base_EmailBccAddress), group (General)
#: data/kalarmconfig.kcfg:225
#, kde-format
msgctxt "@label"
msgid "'Bcc' email address"
msgstr "Vaša adresa e-pošte"

#. i18n: ectx: whatsthis, entry (Base_EmailBccAddress), group (General)
#: data/kalarmconfig.kcfg:226
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Your email address, used for blind copying email alarms to yourself. If you "
"want blind copies to be sent to your account on the computer which KAlarm "
"runs on, you can simply enter your user login name. Enter \"@SystemSettings"
"\" to use the default email address set in KMail, or enter the actual email "
"address otherwise."
msgstr "Vaša e-adresa, koja se koristi za slepo kopiranje e-poštanskih alarma vama. Ako želite da se slepe kopije šalju na vaš korisnički račun na računalou na kome se izvršava KAlarm, možete prosto unijeti vaše korisničko ime."

#. i18n: ectx: label, entry (Base_CmdXTermCommand), group (General)
#: data/kalarmconfig.kcfg:230
#, kde-format
msgctxt "@label"
msgid "Terminal for command alarms"
msgstr "&Naredba"

#. i18n: ectx: whatsthis, entry (Base_CmdXTermCommand), group (General)
#: data/kalarmconfig.kcfg:231
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Command line to execute command alarms in a terminal window, including "
"special codes described in the KAlarm handbook."
msgstr "Naredbeni redak za izvršavanje naredbenih alarma u terminalu, uključujući posebne kodove opisane u priručniku za KAlarm."

#. i18n: ectx: label, entry (Base_StartOfDay), group (General)
#: data/kalarmconfig.kcfg:234
#, kde-format
msgctxt "@label"
msgid "Start of day for date-only alarms"
msgstr "&Početak dana za alarme samo sa datumom:"

#. i18n: ectx: whatsthis, entry (Base_StartOfDay), group (General)
#: data/kalarmconfig.kcfg:235
#, kde-format
msgctxt "@info:whatsthis"
msgid "The earliest time of day at which a date-only alarm will be triggered."
msgstr "Najranije doba dana u koje će se oglasiti alarm samo sa datumom (tj. onaj alarm kod koga je navedeno „bilo kada“)."

#. i18n: ectx: label, entry (Base_WorkDayStart), group (General)
#: data/kalarmconfig.kcfg:240
#, kde-format
msgctxt "@label"
msgid "Start time of working day"
msgstr "Početak radnog dana"

#. i18n: ectx: whatsthis, entry (Base_WorkDayStart), group (General)
#: data/kalarmconfig.kcfg:241
#, kde-format
msgctxt "@info:whatsthis"
msgid "The start time of the working day."
msgstr "Unesite ime ili URL tekstualnog datotekaa ili datotekaa slike koji treba prikazati."

#. i18n: ectx: label, entry (Base_WorkDayEnd), group (General)
#: data/kalarmconfig.kcfg:246
#, kde-format
msgctxt "@label"
msgid "End time of working day"
msgstr "Završetak radnog dana"

#. i18n: ectx: whatsthis, entry (Base_WorkDayEnd), group (General)
#: data/kalarmconfig.kcfg:247
#, kde-format
msgctxt "@info:whatsthis"
msgid "The end time of the working day."
msgstr "Unesite ime ili URL tekstualnog datotekaa ili datotekaa slike koji treba prikazati."

#. i18n: ectx: label, entry (Base_WorkDays), group (General)
#: data/kalarmconfig.kcfg:252
#, kde-format
msgctxt "@label"
msgid "Working days"
msgstr "Radni dani"

#. i18n: ectx: whatsthis, entry (Base_WorkDays), group (General)
#: data/kalarmconfig.kcfg:253
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"OR'ed bits indicating which days of the week are work days, 1 = Monday ... "
"64 = Sunday."
msgstr "Bitovi povezani logičkim ILI označavaju radne dane: 1 = ponedjeljak ... 64 = nedjelja."

#. i18n: ectx: label, entry (DisabledColour), group (General)
#: data/kalarmconfig.kcfg:258
#, kde-format
msgctxt "@label"
msgid "Disabled alarm color"
msgstr "Boja i&steklog alarma:"

#. i18n: ectx: whatsthis, entry (DisabledColour), group (General)
#: data/kalarmconfig.kcfg:259 prefdlg.cpp:2052
#, kde-format
msgctxt "@info:whatsthis"
msgid "Choose the text color in the alarm list for disabled alarms."
msgstr "Odaberite boju teksta u listi alarma za istekle alarme."

#. i18n: ectx: label, entry (ArchivedColour), group (General)
#: data/kalarmconfig.kcfg:264
#, kde-format
msgctxt "@label"
msgid "Archived alarm color"
msgstr "Boja i&steklog alarma:"

#. i18n: ectx: whatsthis, entry (ArchivedColour), group (General)
#: data/kalarmconfig.kcfg:265 prefdlg.cpp:2065
#, kde-format
