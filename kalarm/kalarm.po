#, kde-format
msgctxt "@info"
msgid "This uses the same time zone as the start time."
msgstr "Upotrebljava istu vremensku zonu kao vrijeme početka."

#: recurrenceedit.cpp:243
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid "<para>Enter the last date to repeat the alarm.</para><para>%1</para>"
msgstr "<para>Unesite posljednji datum ponavljanja alarma.</para><para>%1</para>"

#: recurrenceedit.cpp:249
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Enter the last time to repeat the alarm.</para><para>%1</para><para>"
"%2</para>"
msgstr "<para>Unesite posljednje vrijeme ponavljanja alarma.</para><para>%1</para><para>%2</para>"

