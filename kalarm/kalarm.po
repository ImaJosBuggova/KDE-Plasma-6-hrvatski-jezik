#: recurrenceedit.cpp:98
#, kde-format
msgctxt "@info:whatsthis"
msgid "Do not repeat the alarm"
msgstr "Alarm se ne ponavlja"

#: recurrenceedit.cpp:105
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Trigger the alarm at the specified date/time and at every login until "
"then.</para><para>Note that it will also be triggered any time "
"<application>KAlarm</application> is restarted.</para>"
msgstr "Alarm će se oglasiti navedenog datuma/vremena i po svakom prijavljivanju do tog trenutka.\nTakođe, alarm će se oglasiti i po svakom ponovnom pokretanju alarmnog demona."

#: recurrenceedit.cpp:112
#, kde-format
msgctxt "@info:whatsthis"
msgid "Repeat the alarm at hourly/minutely intervals"
msgstr "Alarm se ponavlja u intervalu navedenih časova/minuta"

#: recurrenceedit.cpp:118
#, kde-format
msgctxt "@info:whatsthis"
msgid "Repeat the alarm at daily intervals"
msgstr "Alarm se ponavlja jednom dnevno"

#: recurrenceedit.cpp:124
#, kde-format
msgctxt "@info:whatsthis"
msgid "Repeat the alarm at weekly intervals"
msgstr "Alarm se ponavlja jednom sedmično"

#: recurrenceedit.cpp:130
#, kde-format
msgctxt "@info:whatsthis"
msgid "Repeat the alarm at monthly intervals"
msgstr "Alarm se ponavlja jednom mesečno"

#: recurrenceedit.cpp:136
#, kde-format
msgctxt "@info:whatsthis"
