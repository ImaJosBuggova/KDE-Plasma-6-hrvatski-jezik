#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:50
msgid "Fix crash when alarm excludes holidays."
msgstr "Ispravljen je pad programa kada alarm isključuje blagdane."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:51
msgid "Fix skipped alarms not triggering unless KAlarm is restarted."
msgstr "Ispravljeno je aktiviranje preskočenih alarma tek nakon ponovnog pokretanja KAlarma."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:62
msgid "Provide facility to skip the next few recurrences/sub-repetitions of an alarm."
msgstr "Dodana je mogućnost preskakanja nekoliko sljedećih ponavljanja/podponavljanja alarma."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:63
msgid "Provide Edit Alarm dialog option to override notification inhibition or display over X11 full screen applications."
msgstr "U dijalog Uredi alarm dodana je mogućnost zaobilaženja blokiranja obavijesti ili prikaza iznad X11 aplikacija preko cijelog zaslona."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:64
msgid "Only show options for Late cancel/Reminder in Edit Alarm dialog when they are enabled."
msgstr "Mogućnosti za kasno otkazivanje/podsjetnik u dijalogu Uredi alarm prikazuju se samo kada su omogućene."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:65
msgid "Fix date-only sub-repetition time calculations."
msgstr "Ispravljen je izračun vremena podponavljanja alarma zadanih samo datumom."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:66
msgid "Improve layout of late-cancel and other widgets at bottom of Edit Alarm dialog."
msgstr "Poboljšan je raspored kontrola za kasno otkazivanje i drugih kontrola pri dnu dijaloga Uredi alarm."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:74
msgid "Fix sound files being played at the wrong volume when using VLC."
msgstr "Ispravljeno je reproduciranje zvučnih datoteka pogrešnom glasnoćom pri upotrebi VLC-a."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:82
msgid "Fix hang evaluating recurring date-only alarms when start-of-day time is non-zero."
msgstr "Ispravljeno je zamrzavanje pri obradi ponavljajućih alarma zadanih samo datumom ako vrijeme početka dana nije nula."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:83
msgid "Fix hang evaluating next recurrence time for time zones with daylight savings time."
msgstr "Ispravljeno je zamrzavanje pri izračunu vremena sljedećeg ponavljanja u vremenskim zonama s ljetnim računanjem vremena."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:91
msgid "Prevent multiple Defer Alarm dialogs for the same event."
msgstr "Spriječeno je prikazivanje više dijaloga Odgodi alarm za isti događaj."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:92
msgid "If Defer is disabled for a notification alarm, don't show two Edit buttons."
msgstr "Ako je odgoda onemogućena za alarm obavijesti, ne prikazuju se dva gumba Uredi."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:100
msgid "If a recurrence is suppressed by work time/holidays/exception, suppress its sub-repetitions."
msgstr "Ako je ponavljanje potisnuto zbog radnog vremena, blagdana ili iznimke, potiskuju se i njegova podponavljanja."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:101
msgid "Improvements and bug fixes to recurrence/work time/holidays calculations."
msgstr "Poboljšanja i ispravci pogrešaka u izračunima ponavljanja, radnog vremena i blagdana."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:102
msgid "Fix formatting of user messages which showed HTML tags."
msgstr "Ispravljeno je oblikovanje korisničkih poruka u kojima su se prikazivale HTML oznake."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:103
msgid "Distinguish between daily and minutely sub-repetitions in alarm calendar."
msgstr "U kalendaru alarma razlikuju se dnevna podponavljanja od podponavljanja u minutnim razmacima."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:104
msgid "Only mark calendars as 'KeepFormat' if the user declines to update them."
msgstr "Kalendari se označuju kao „KeepFormat” samo ako korisnik odbije njihovo ažuriranje."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:113
msgid "If an alarm is late-cancelled, don't remove the event if a sub-repetition is still due."
msgstr "Ako se alarm kasno otkaže, događaj se ne uklanja ako još predstoji podponavljanje."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:114
msgid "Fix infinite loop when alarms trigger, if they are read-only or if the calendar is non-writable."
msgstr "Ispravljena je beskonačna petlja pri aktiviranju alarma ako su oni samo za čitanje ili kalendar nije moguće zapisivati."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:115
msgid "In edit dialog, don't display high accuracy warning if start time is before now."
msgstr "U dijalogu za uređivanje ne prikazuje se upozorenje o visokoj preciznosti ako je vrijeme početka u prošlosti."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:124
msgid "Remove excess spacing in Preferences dialog."
msgstr "Uklonjen je suvišan razmak u dijalogu Postavke."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:132
msgid "Prevent message windows taking keyboard focus when they pop up."
msgstr "Spriječeno je preuzimanje fokusa tipkovnice pri prikazu prozora poruke."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:142
msgid "Implement audio backends as plugins to allow user selection."
msgstr "Pozadinski sustavi za zvuk implementirani su kao dodaci kako bi ih korisnik mogao odabrati."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:143
msgid "Clean up time spin box appearance in some styles, e.g. Oxygen."
msgstr "Poboljšan je izgled okretnih polja za vrijeme u nekim stilovima, primjerice Oxygen."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:151
msgid "Fix KAlarm exiting before executing session restoration."
msgstr "Ispravljeno je zatvaranje KAlarma prije izvršavanja obnove sesije."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:159
msgid "Fix system tray showing blank KAlarm icon under XFCE."
msgstr "Ispravljeno je prikazivanje prazne ikone KAlarma u programskoj traci u okruženju XFCE."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:167
msgid "Show normal decorated alarm windows over full screen applications on X11."
msgstr "Na X11 se prozori alarma s uobičajenim ukrasima prikazuju iznad aplikacija preko cijelog zaslona."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:168
