#. (itstool) path: component/name
#: org.kde.kalarm.appdata.xml:6
msgid "KAlarm"
msgstr "KAlarm"

#. (itstool) path: component/summary
#: org.kde.kalarm.appdata.xml:7
msgid "Personal Alarm Scheduler"
msgstr "Planer osobnih alarma"

#. (itstool) path: description/p
#: org.kde.kalarm.appdata.xml:13
msgid "KAlarm is a personal alarm message, command and email scheduler application by KDE"
msgstr "KAlarm je KDE-ova aplikacija za planiranje osobnih alarmnih poruka, naredbi i e-pošte."

#. (itstool) path: description/p
#: org.kde.kalarm.appdata.xml:14
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:16
msgid "Display alarms using your own text message, the text generated by a command, or a text or image file."
msgstr "Prikazujte alarme vlastitom tekstualnom porukom, tekstom koji generira naredba ili tekstnom ili slikovnom datotekom."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:17
msgid "Audible alarm using a sound file"
msgstr "Zvučni alarm uz upotrebu zvučne datoteke"

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:18
msgid "Recurring alarm on an hours/minutes, daily, weekly, monthly or annual basis, or set it to trigger every time you log in."
msgstr "Ponavljajući alarm u razmacima od sati ili minuta, dnevno, tjedno, mjesečno ili godišnje, ili alarm koji se aktivira pri svakoj prijavi."

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:19
msgid "Display alarms color and font customization"
msgstr "Prilagodba boje i fonta prikaza alarma"

#. (itstool) path: ul/li
#: org.kde.kalarm.appdata.xml:20
msgid "Support for multiple alarm calendars, which for example enables you to share alarms between a laptop and desktop computer."
msgstr "Podrška za više kalendara alarma, što, primjerice, omogućuje dijeljenje alarma između prijenosnog i stolnog računala."

#. (itstool) path: screenshot/caption
#: org.kde.kalarm.appdata.xml:35
msgid "KAlarm configuration window with a testing message alarm"
msgstr "Prozor konfiguracije KAlarma s probnim alarmom tekstualne poruke"

