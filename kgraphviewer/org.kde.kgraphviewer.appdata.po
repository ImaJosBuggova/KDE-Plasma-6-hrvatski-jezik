#. (itstool) path: component/name
#: org.kde.kgraphviewer.appdata.xml:9
msgid "KGraphViewer"
msgstr "KGraphViewer"

#. (itstool) path: component/summary
#: org.kde.kgraphviewer.appdata.xml:10
msgid "A Graphviz DOT graph viewer"
msgstr "Preglednik grafova u formatu Graphviz DOT"

#. (itstool) path: description/p
#: org.kde.kgraphviewer.appdata.xml:12
msgid "KGraphViewer is a Graphviz DOT graph file viewer, aimed to replace the other outdated Graphviz tools. Graphs are commonly used in scientific domains and particularly in computer science."
msgstr "KGraphViewer je preglednik grafova u datotekama Graphviz DOT, namijenjen zamjeni drugih zastarjelih alata Graphviz. Grafovi se često upotrebljavaju u znanstvenim područjima, osobito u računarstvu."

#. (itstool) path: description/p
#: org.kde.kgraphviewer.appdata.xml:16
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:18
msgid "Zooming"
msgstr "Zumiranje"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:19
msgid "Threaded loading of several graphs in tabs"
msgstr "Učitavanje više grafova u karticama u zasebnim dretvama"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:20
msgid "Saving of the recent files list"
msgstr "Spremanje popisa nedavnih datoteka"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:21
msgid "Manual reload of files"
msgstr "Ručno ponovno učitavanje datoteka"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:22
msgid "Display of a bird-eye view of the graph"
msgstr "Prikaz pregleda grafa iz ptičje perspektive"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:23
msgid "Moving of the graph by dragging"
msgstr "Pomicanje grafa povlačenjem"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:24
msgid "Full featured printing"
msgstr "Potpuno opremljen ispis"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:25
msgid "Perfect drawing of all graphviz example graphs"
msgstr "Ispravan prikaz svih oglednih grafova Graphviza"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:26
msgid "Automatically choose dot for directed graphs and neato for undirected"
msgstr "Automatski odabir alata dot za usmjerene, a neato za neusmjerene grafove"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:27
msgid "Possibility to use an arbitrary layout algorithm as soon as it produces xdot format"
msgstr "Mogućnost upotrebe proizvoljnog algoritma rasporeda ako stvara format xdot"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:28
msgid "Automatic reloading with user confirmation of (externally) modified files (configurable)"
msgstr "Automatsko ponovno učitavanje datoteka izmijenjenih izvana, uz potvrdu korisnika (može se podesiti)"

#. (itstool) path: ul/li
#: org.kde.kgraphviewer.appdata.xml:29
msgid "Open new instances as new tabs in the old one (configurable)"
msgstr "Otvaranje novih instanci kao kartica u postojećoj instanci (može se podesiti)"
