#: widgets/administratorsettingsdialog/troubleshoot/troubleshootsettingswidget.cpp:45
#, kde-format
msgid ""
"This setting prevents the Rocket.Chat instances from sending events to the "
"other instances, it may cause syncing problems and misbehavior!"
msgstr "Ova postavka sprječava instance Rocket.Chat-a da šalju događaje drugim instancama, što može uzrokovati probleme sa sinkronizacijom i neispravan rad!"

#: widgets/administratorsettingsdialog/troubleshoot/troubleshootsettingswidget.cpp:50
#, kde-format
msgid ""
"This setting stops the processing of livechat visitor sessions causing the "
"statistics to stop working correctly!"
msgstr "Ova postavka zaustavlja obradu sesija posjetitelja Livechata, zbog čega statistika neće ispravno raditi!"

#: widgets/administratorsettingsdialog/troubleshoot/troubleshootsettingswidget.cpp:55
#, kde-format
msgid ""
"This setting stops the processing all statistics making the info page "
"outdated until someone clicks on the refresh button and may cause other "
"missing information around the system!"
msgstr "Ova postavka zaustavlja obradu sve statistike, zbog čega će stranica s informacijama biti zastarjela dok netko ne klikne gumb za osvježavanje; može uzrokovati i nedostatak drugih informacija u sustavu!"

#: widgets/administratorsettingsdialog/troubleshoot/troubleshootsettingswidget.cpp:61
#, kde-format
msgid ""
"This setting stops the processing of all export requests from users, so they "
"will not receive the link to download their data!"
msgstr "Ova postavka zaustavlja obradu svih zahtjeva za izvoz korisnika pa oni neće dobiti poveznicu za preuzimanje svojih podataka!"

#: widgets/administratorsettingsdialog/troubleshoot/troubleshootsettingswidget.cpp:66
#, kde-format
msgid ""
"This setting stops the sync of this server with Rocket.Chat's cloud and may "
"cause issues with marketplace and enterprise licenses!"
msgstr "Ova postavka zaustavlja sinkronizaciju ovog poslužitelja s oblakom Rocket.Chat-a, što može uzrokovati probleme s tržnicom i licencama Enterprise!"

