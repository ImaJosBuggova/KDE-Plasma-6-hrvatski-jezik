#. (itstool) path: component/name
#: org.kde.calligra.karbon.metainfo.xml:11
msgid "Karbon"
msgstr "Karbon"

#. (itstool) path: component/summary
#: org.kde.calligra.karbon.metainfo.xml:12
msgid "Scalable Graphics"
msgstr "Vektorska grafika"

#. (itstool) path: description/p
#: org.kde.calligra.karbon.metainfo.xml:14
msgid "Karbon is a vector drawing application with a user interface that is easy to use, highly customizable and extensible. That makes Karbon a great application for users starting to explore the world of vector graphics as well as for artists wanting to create breathtaking vector art."
msgstr "Karbon je aplikacija za vektorsko crtanje s jednostavnim, vrlo prilagodljivim i proširivim korisničkim sučeljem. Zato je Karbon izvrstan i za korisnike koji tek otkrivaju svijet vektorske grafike i za umjetnike koji žele stvarati zadivljujuća vektorska djela."

#. (itstool) path: description/p
#: org.kde.calligra.karbon.metainfo.xml:19
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:21
msgid "Loading support for ODG, SVG, WPG, WMF, EPS/PS"
msgstr "Podrška za učitavanje ODG-a, SVG-a, WPG-a, WMF-a i EPS/PS-a"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:24
msgid "Writing support for ODG, SVG, PNG, PDF, WMF"
msgstr "Podrška za zapisivanje ODG-a, SVG-a, PNG-a, PDF-a i WMF-a"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:27
msgid "Customizable user interface with freely placeable toolbars and dockers"
msgstr "Prilagodljivo korisničko sučelje s alatnim trakama i priključnim prozorima koji se mogu slobodno postavljati"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:30
msgid "Layer docker for easy handling of complex documents including preview thumbnails, support for grouping shapes via drag and drop, controlling visibility of shapes or locking"
msgstr "Priključni prozor slojeva za jednostavno rukovanje složenim dokumentima, uključujući minijature pretpregleda, grupiranje oblika povlačenjem i ispuštanjem, upravljanje vidljivošću oblika i njihovo zaključavanje"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:34
msgid "Advanced path editing tool with great on-canvas editing capabilities"
msgstr "Napredni alat za uređivanje staza s izvrsnim mogućnostima uređivanja na platnu"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:37
msgid "Various drawing tools for creating path shapes including a draw path tool, a pencil tool as well as a calligraphy drawing tool"
msgstr "Razni alati za crtanje oblika staza, uključujući alat za crtanje staza, olovku i alat za kaligrafsko crtanje"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:40
msgid "Gradient and pattern tools for easy on-canvas editing of gradient and pattern styles"
msgstr "Alati za gradijente i uzorke koji omogućuju jednostavno uređivanje stilova gradijenata i uzoraka na platnu"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:43
msgid "Top notch snapping facilities for guided drawing and editing (e.g. snapping to grid, guide lines, path nodes, bounding boxes, orthogonal positions, intersections of path shapes or extensions of lines and paths)"
msgstr "Vrhunske mogućnosti privlačenja za vođeno crtanje i uređivanje (npr. privlačenje na mrežu, vodilice, čvorove staza, granične okvire, ortogonalne položaje, sjecišta oblika staza ili produžetke linija i staza)"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:47
msgid "Includes many predefined shapes including basic shapes like stars, circle/ellipse, rectangle, image"
msgstr "Uključuje brojne unaprijed definirane oblike, uključujući osnovne poput zvijezda, kružnica/elipsa, pravokutnika i slika"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:50
msgid "Artistic text shape with support for following path outlines (i.e. text on path)"
msgstr "Umjetnički tekstualni oblik s podrškom za praćenje obrisa staze (odnosno tekst na stazi)"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:53
msgid "Complex path operations and effects like boolean set operations, path flattening, rounding and refining as well as whirl/pinch effects"
msgstr "Složene operacije i efekti staza, poput Booleovih operacija skupova, izravnavanja staza, zaobljivanja i pročišćavanja te efekata vrtloga i uštinuća"

#. (itstool) path: ul/li
#: org.kde.calligra.karbon.metainfo.xml:56
msgid "Extensible by writing plugins for new tools, shapes and dockers"
msgstr "Proširiv pisanjem dodataka za nove alate, oblike i priključne prozore"

#. (itstool) path: screenshot/caption
#: org.kde.calligra.karbon.metainfo.xml:74
msgid "Main window of Karbon"
msgstr "Glavni prozor Karbona"

#. (itstool) path: description/p
#: org.kde.calligra.karbon.metainfo.xml:108
msgid "This release add flatpak support to the Calligra Office suite."
msgstr "Ovo izdanje dodaje podršku za Flatpak uredskom paketu Calligra."

#. (itstool) path: description/p
#: org.kde.calligra.karbon.metainfo.xml:114
msgid "The most significant changes are that Calligra has been fully transitioned to Qt6 and KF6, along with a major overhaul of its user interface."
msgstr "Najznačajnije su promjene potpuni prijelaz Calligre na Qt 6 i KF 6 te temeljita obnova korisničkog sučelja."

#. (itstool) path: description/p
#: org.kde.calligra.karbon.metainfo.xml:115
msgid "Karbon didn’t received much change outside of the one affecting the whole platform."
msgstr "Osim promjena koje su zahvatile cijelu platformu, Karbon se nije mnogo promijenio."
