#. (itstool) path: component/name
#: org.kde.calligra.words.metainfo.xml:6
msgid "Calligra Words"
msgstr "Calligra Words"

#. (itstool) path: component/summary
#: org.kde.calligra.words.metainfo.xml:7
msgid "Word Processor"
msgstr "Program za obradu teksta"

#. (itstool) path: description/p
#: org.kde.calligra.words.metainfo.xml:9
msgid "Words is an intuitive word processor and desktop publisher application. With it, you can create informative and attractive documents with pleasure and ease."
msgstr "Words je intuitivna aplikacija za obradu teksta i stolno izdavaštvo. S njom možete jednostavno i ugodno stvarati informativne i privlačne dokumente."

#. (itstool) path: description/p
#: org.kde.calligra.words.metainfo.xml:13
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.calligra.words.metainfo.xml:15
msgid "Frame-based editing"
msgstr "Uređivanje temeljeno na okvirima"

#. (itstool) path: ul/li
#: org.kde.calligra.words.metainfo.xml:16
msgid "Allows embedding of Documents"
msgstr "Omogućuje ugrađivanje dokumenata"

#. (itstool) path: ul/li
#: org.kde.calligra.words.metainfo.xml:17
msgid "Customization of user interface"
msgstr "Prilagodba korisničkog sučelja"

#. (itstool) path: ul/li
#: org.kde.calligra.words.metainfo.xml:18
msgid "Includes all features expected from a modern word processor"
msgstr "Sadrži sve značajke koje se očekuju od suvremenog programa za obradu teksta"

#. (itstool) path: ul/li
#: org.kde.calligra.words.metainfo.xml:19
msgid "ODT (Open Document Text) support"
msgstr "Podrška za ODT (Open Document Text)"

#. (itstool) path: screenshot/caption
#: org.kde.calligra.words.metainfo.xml:28
msgid "Calligra Words main window"
msgstr "Glavni prozor Calligre Words"

#. (itstool) path: description/p
#: org.kde.calligra.words.metainfo.xml:71
msgid "This release add flatpak support to the Calligra Office suite."
msgstr "Ovo izdanje dodaje podršku za Flatpak uredskom paketu Calligra."

#. (itstool) path: description/p
#: org.kde.calligra.words.metainfo.xml:77
msgid "The most significant changes are that Calligra has been fully transitioned to Qt6 and KF6, along with a major overhaul of its user interface."
msgstr "Najznačajnije su promjene potpuni prijelaz Calligre na Qt 6 i KF 6 te temeljita obnova korisničkog sučelja."

#. (itstool) path: description/p
#: org.kde.calligra.words.metainfo.xml:78
msgid "Word now features the new sidebar design, and the main view uses a shadow to define the document borders. The Style Manager and Page Layout dialog were also updated with a new design."
msgstr "Words sada ima novi dizajn bočne trake, a glavni prikaz koristi sjenu za označavanje rubova dokumenta. Upravitelj stilova i dijalog za izgled stranice također su dobili novi dizajn."
