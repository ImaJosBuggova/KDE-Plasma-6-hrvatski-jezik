msgid "A test application for the AtCore framework to control 3D printers"
msgstr "Testna aplikacija za upravljanje 3D pisačima pomoću okvira AtCore"

#. (itstool) path: description/p
#: org.kde.atcore.appdata.xml:11
msgid "AtCore is the API that controls the 3DPrinter and its basic functionalities. AtCore comes with a test client called atcore-gui to manage your printer."
msgstr "AtCore je API za upravljanje 3D pisačem i njegovim osnovnim funkcijama. AtCore uključuje testni klijent atcore-gui za upravljanje pisačem."

#. (itstool) path: description/p
#: org.kde.atcore.appdata.xml:14
msgid "This is an AtCore test application to showcase the framework."
msgstr "Ova testna aplikacija prikazuje mogućnosti okvira AtCore."