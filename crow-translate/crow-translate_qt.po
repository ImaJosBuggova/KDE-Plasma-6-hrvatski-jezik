msgstr "Ne ispisuj tekst pri upotrebi opcije --%1 ili --%2."

#: src/cli.cpp:185
msgctxt "Cli|"
msgid "Print only translations."
msgstr "Ispiši samo prijevode."

#: src/cli.cpp:186
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "Ispiši izlaz u obliku JSON-a."

#: src/cli.cpp:192
msgctxt "Cli|"
msgid ""
"Which frontend to run ('gui' or 'cli'). Defaults to 'cli' whenever any "
"argument is given."
msgstr "Koje sučelje pokrenuti („gui” ili „cli”). Ako je zadan bilo koji argument, zadano je „cli”."

