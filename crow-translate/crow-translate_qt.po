#: src/cli.cpp:142
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "Prikaži sve jezične kodove."

#: src/cli.cpp:144
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr "Odredi izvorni jezik (mehanizam će ga prema zadanim postavkama pokušati sam prepoznati)."

#: src/cli.cpp:148
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr "Odredi jezik(e) prijevoda, odvojene znakom „+” (prema zadanim postavkama upotrebljava se jezik sustava)."

#: src/cli.cpp:153
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'deepl', "
"'libretranslate', 'mymemory' or 'reverso'), Google is used by default."
msgstr "Odredi prevoditeljski mehanizam („google”, „yandex”, „bing”, „deepl”, „libretranslate”, „mymemory” ili „reverso”); prema zadanim postavkama upotrebljava se Google."

#: src/cli.cpp:157
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr "Odredi URL instance Mozhija. Prema zadanim postavkama upotrebljava se URL instance iz postavki aplikacije."

#: src/cli.cpp:161
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy', 'mozhi' or 'localai'). Provider from "
"app settings will be used by default."
msgstr "Odredi pružatelja prijevoda („copy”, „mozhi” ili „localai”). Prema zadanim postavkama upotrebljava se pružatelj iz postavki aplikacije."

#: src/cli.cpp:169
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt' or 'piper'). Provider from app "
"settings will be used by default."
msgstr "Odredi pružatelja TTS-a („none”, „mozhi”, „qt” ili „piper”). Prema zadanim postavkama upotrebljava se pružatelj iz postavki aplikacije."

#: src/cli.cpp:171
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi' or 'qt'). Provider from app settings "
"will be used by default."
msgstr "Odredi pružatelja TTS-a („none”, „mozhi” ili „qt”). Prema zadanim postavkama upotrebljava se pružatelj iz postavki aplikacije."

#: src/cli.cpp:173
msgctxt "Cli|"
msgid "Specify TTS provider ('none'). This build has text-to-speech disabled."
msgstr "Odredi pružatelja TTS-a („none”). U ovoj je međuverziji pretvaranje teksta u govor onemogućeno."

#: src/cli.cpp:176
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "Izgovori prijevod."

#: src/cli.cpp:177
msgctxt "Cli|"
msgid "Speak the source."
msgstr "Izgovori izvorni tekst."

#: src/cli.cpp:178
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr "Učitaj izvorni tekst iz datoteka. Argumenti će se tumačiti kao putanje datoteka."

#: src/cli.cpp:179
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "Dodaj podatke sa standardnog ulaza izvornom tekstu."

#: src/cli.cpp:181
msgctxt "Cli|"
msgid "Read source text from an image using the configured OCR engine."
msgstr "Prepoznaj izvorni tekst na slici pomoću konfiguriranog OCR mehanizma."

#: src/cli.cpp:182
msgctxt "Cli|"
msgid "path"
msgstr "putanja"

#: src/cli.cpp:184
#, qt-format
msgctxt "Cli|"
