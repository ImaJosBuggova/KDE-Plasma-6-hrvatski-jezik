#: s3backend.cpp:46
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Invalid S3 URI, bucket name is missing from the host.<nl/>A valid S3 URI "
"must be written in the form: <link>s3://bucket/key</link>"
msgstr "Neispravan URI S3; u nazivu glavnog računala nedostaje naziv spremnika.<nl/>Ispravan URI S3 mora biti u obliku: <link>s3://bucket/key</link>"

#: s3backend.cpp:201 s3backend.cpp:210
#, kde-kuit-format
msgctxt "@info"
msgid "Could not find S3 buckets, please check your AWS configuration."
msgstr "Nije moguće pronaći spremnike S3. Provjerite konfiguraciju AWS-a."

#: s3backend.cpp:686
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot copy between different S3 profiles. Copy the file locally first."
msgstr "Nije moguće kopirati između različitih profila S3. Najprije kopirajte datoteku lokalno."

#: s3backend.cpp:738
#, kde-kuit-format
msgctxt "@info"
msgid "Could not copy <link>%1</link> to <link>%2</link>"
msgstr "Nije moguće kopirati <link>%1</link> u <link>%2</link>"

#: s3backend.cpp:811
#, kde-kuit-format
msgctxt "@info"
msgid "Cannot rename between different S3 profiles."
msgstr "Nije moguće preimenovati između različitih profila S3."

#: s3backend.cpp:937
#, kde-format
msgctxt "@info"
msgid ""
"Some source files could not be deleted after renaming. The renamed folder "
"may still contain leftover files."
msgstr "Neke izvorne datoteke nije bilo moguće izbrisati nakon preimenovanja. U preimenovanoj mapi možda su ostale datoteke."

#: s3backend.cpp:1001 s3backend.cpp:1063
#, kde-format
msgctxt "@info"
msgid ""
"Could not retrieve the complete file listing. Some files may not be shown."
msgstr "Nije moguće dohvatiti potpuni popis datoteka. Neke datoteke možda neće biti prikazane."

#: s3backend.cpp:1160
#, kde-format
msgctxt "@item"
msgid "and %1 more object"
msgid_plural "and %1 more objects"
msgstr[0] "i još %1 objekt"
msgstr[1] "i još %1 objekta"
msgstr[2] "i još %1 objekata"

#: s3backend.cpp:1164
#, kde-kuit-format
msgctxt "@info"
msgid "Failed to delete %1 of %2 objects. Affected keys: %3"
msgstr "Brisanje %1 od %2 objekata nije uspjelo. Obuhvaćeni ključevi: %3"
