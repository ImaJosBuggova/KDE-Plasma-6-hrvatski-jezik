#. (itstool) path: component/name
#: org.kde.kio_s3.metainfo.xml:14
msgid "KIO S3"
msgstr "KIO S3"

#. (itstool) path: component/summary
#: org.kde.kio_s3.metainfo.xml:15
msgid "Amazon S3 integration with KDE Plasma and KDE applications"
msgstr "Integracija Amazona S3 s KDE Plasmaom i KDE-ovim aplikacijama"

#. (itstool) path: description/p
#: org.kde.kio_s3.metainfo.xml:17
msgid "KIO S3 enables KIO-aware applications (such as Dolphin, Kate or Gwenview) to access and edit Amazon S3 buckets and objects."
msgstr "KIO S3 aplikacijama s podrškom za KIO (poput Dolphina, Katea ili Gwenviewa) omogućuje pristup spremnicima i objektima Amazona S3 te njihovo uređivanje."

#. (itstool) path: screenshot/caption
#: org.kde.kio_s3.metainfo.xml:25
msgid "Dolphin showing a picture uploaded on an Amazon S3 bucket."
msgstr "Dolphin prikazuje sliku prenesenu u spremnik Amazona S3."

#. (itstool) path: description/p
#: org.kde.kio_s3.metainfo.xml:32
msgid "The release improves the handling of large files. Improving the chunking behavior for multipart uploads and streaming downloaded files instead of buffering them in memory."
msgstr "Ovo izdanje poboljšava rukovanje velikim datotekama. Poboljšano je dijeljenje datoteka pri višedijelnom prijenosu i uveden je izravan prijenos preuzetih datoteka umjesto njihova pohranjivanja u međuspremnik."

#. (itstool) path: description/p
#: org.kde.kio_s3.metainfo.xml:40
msgid "Small bug fix release to fix renaming S3 profiles and implement mkdir operations in a more standard way."
msgstr "Manje izdanje s ispravcima pogrešaka pri preimenovanju profila S3 i standardnijom implementacijom operacija stvaranja mapa."

#. (itstool) path: description/p
#: org.kde.kio_s3.metainfo.xml:47
msgid "Initial release of kio-s3, which provides access to S3 in Dolphin and other KDE Apps."
msgstr "Prvo izdanje kio-s3, koje omogućuje pristup S3-u u Dolphinu i drugim KDE-ovim aplikacijama."
