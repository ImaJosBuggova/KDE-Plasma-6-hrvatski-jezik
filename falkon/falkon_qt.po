msgstr "Spremi korisničko ime i lozinku za ovo web-mjesto"

#: lib/network/networkmanager.cpp:147
#, qt-format
msgctxt "NetworkManager|"
msgid ""
"A username and password are being requested by %1. The site says: \"%2\""
msgstr "%1 traži korisničko ime i lozinku. Web-mjesto poručuje: „%2”"

