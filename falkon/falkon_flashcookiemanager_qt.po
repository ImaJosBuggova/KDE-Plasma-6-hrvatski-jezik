#: fcm_dialog.ui:316
msgctxt "FCM_Dialog|"
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Flash cookie "
"whitelist</span></p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Popis dopuštenih Flash kolačića</span></p></body></html>"


#: fcm_dialog.ui:348 fcm_dialog.ui:416
msgctxt "FCM_Dialog|"
msgid "Remove"
msgstr "Ukloni"


#: fcm_dialog.ui:355 fcm_dialog.ui:423
msgctxt "FCM_Dialog|"
msgid "Add"
msgstr "Dodaj"


#: fcm_dialog.ui:364
msgctxt "FCM_Dialog|"
msgid ""
"Flash cookies from these origins will not be deleted automatically. (Also "
"detection of them will not be notified to user.)"
msgstr "Flash kolačići s ovih podrijetla neće se automatski brisati. (Korisnik neće biti obaviješten ni o njihovom otkrivanju.)"


#: fcm_dialog.ui:374
msgctxt "FCM_Dialog|"
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Flash cookie "
"blacklist</span></p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Popis blokiranih Flash kolačića</span></p></body></html>"


#: fcm_dialog.ui:381
msgctxt "FCM_Dialog|"
msgid ""
"Flash cookies from these origins will be deleted without any notification."
msgstr "Flash kolačići s ovih podrijetla bit će izbrisani bez obavijesti."


#: fcm_dialog.ui:442
msgctxt "FCM_Dialog|"
msgid "Settings"
msgstr "Postavke"


#: fcm_dialog.ui:453
msgctxt "FCM_Dialog|"
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Flash Cookie "
"Settings</span></p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Postavke Flash kolačića</span></p></body></html>"


#: fcm_dialog.ui:475
msgctxt "FCM_Dialog|"
msgid ""
"Auto mode: The flash data directory will be checked regularly. and flash "
"cookies in blacklist will be deleted automatically."
msgstr "Automatski način rada: mapa s Flash podacima redovito će se provjeravati, a Flash kolačići s popisa blokiranih automatski će se brisati."


#: fcm_dialog.ui:510
msgctxt "FCM_Dialog|"
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Note:</span> This "
"settings are just applied to flash cookies, to manage HTTP cookies use <span "
"style=\" font-weight:600;\">Cookies Manager</span>. </p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Napomena:</span> Ove se postavke odnose samo na Flash kolačiće. Za upravljanje HTTP kolačićima upotrijebite <span style=\" font-weight:600;\">Upravitelj kolačićima</span>. </p></body></html>"


#: fcm_dialog.ui:538
msgctxt "FCM_Dialog|"
msgid ""
"Notification: User will be notified for every new flash cookie that is not "
"in blacklist and whitelist."
msgstr "Obavijesti: korisnik će biti obaviješten o svakom novom Flash kolačiću koji nije na popisu blokiranih ni na popisu dopuštenih."


#: fcm_dialog.ui:565
msgctxt "FCM_Dialog|"
msgid "Delete all flash cookies on exit/start. (except those are in whitelist)"
msgstr "Izbriši sve Flash kolačiće pri izlasku/pokretanju (osim onih s popisa dopuštenih)."


