msgstr "Ovu pogrešku uzrokuje neispravno postavljanje dijeljenja putem Sambe u vašoj distribuciji. Možete je sami ispraviti tako da ručno stvorite tu mapu, a zatim zatvorite i ponovno otvorite ovaj prozor."

#: samba/filepropertiesplugin/groupmanager.cpp:72
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"This folder can't be shared because your user account isn't a member of the "
