msgstr "Omogući praćenje &nadimaka"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, kcfg_OpenWatchedNicksAtStartup)
#: src/config/watchednicknames_configui.ui:37
#, kde-format
msgid ""
"<qt>When checked, the <b>Watched Nicks</b> window will be automatically "
"opened when starting Konversation.</qt>"
msgstr "<qt>Ako je ova mogućnost označena, prozor <b>Praćeni nadimci</b> automatski će se otvoriti pri pokretanju Konversationa.</qt>"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_OpenWatchedNicksAtStartup)
