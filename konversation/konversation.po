#: data/scripts/cmd:28
msgid "You need to specify a command."
msgstr "Morate navesti naredbu."

#: data/scripts/cmd:41
msgid ""
"The command executed successfully, but did not return any output or only "
"whitespace."
msgstr "Naredba je uspješno izvršena, ali nije vratila nikakav izlaz ili je vratila samo praznine."

#: data/scripts/media:103
msgid "The media script requires Python %1 or higher."
msgstr "Skripta za medije zahtijeva Python %1 ili noviji."

#: data/scripts/media:133
msgid "An error occurred while trying to list the running media players."
msgstr "Došlo je do pogreške pri dohvaćanju popisa pokrenutih reproduktora medija."

#: data/scripts/media:177
msgid "No running audio players found."
msgstr "Nije pronađen nijedan pokrenuti audioreproduktor."

#: data/scripts/media:179
msgid "No running video players found."
msgstr "Nije pronađen nijedan pokrenuti videoreproduktor."

#: data/scripts/media:181
msgid "\"%1\" is not running."
msgstr "„%1” nije pokrenut."

#: data/scripts/media:183
msgid "No running media players found."
msgstr "Nije pronađen nijedan pokrenuti reproduktor medija."

#: data/scripts/media:197
msgid "Nothing is playing in %1."
msgstr "U aplikaciji %1 ništa se ne reproducira."

#: data/scripts/media:201
msgctxt "1 = Comma-separated list of audio players."
msgid "None of the running audio players (%1) are playing anything."
msgstr "Nijedan od pokrenutih audioreproduktora (%1) ništa ne reproducira."

#: data/scripts/media:206
msgctxt "1 = Comma-separated list of video players."
msgid "None of the running video players (%1) are playing anything."
msgstr "Nijedan od pokrenutih videoreproduktora (%1) ništa ne reproducira."

#: data/scripts/media:211
msgctxt "1 = Comma-separated list of media players."
msgid "None of the running media players (%1) are playing anything."
msgstr "Nijedan od pokrenutih reproduktora medija (%1) ništa ne reproducira."

#: data/scripts/media:219
msgid "An error occurred while trying to retrieve media metadata from %1."
msgstr "Došlo je do pogreške pri dohvaćanju metapodataka medija iz aplikacije %1."

#: data/scripts/media:257
msgctxt "REGEX_FIXUP is the name of a config key in a config file."
msgid ""
"There is a problem with the regular expression specified in REGEX_FIXUP."
msgstr "Postoji problem s regularnim izrazom navedenim u REGEX_FIXUP."

#: data/scripts/media:266
msgid "%1 did not report the metadata needed to output a message."
msgstr "%1 nije dostavio metapodatke potrebne za ispis poruke."

#: data/scripts/media:282
msgid "There is a problem in the output format configuration."
msgstr "Postoji problem u postavkama izlaznog formata."

#: data/scripts/media:302
msgid "media v%1 for Konversation."
msgstr "media v%1 za Konversation."

#: data/scripts/media:303
msgid "Usage:"
msgstr "Upotreba:"

#: data/scripts/media:304
msgid "\"/media\" - report what the first player found is playing."
msgstr "„/media” – prikaži što reproducira prvi pronađeni reproduktor."

#: data/scripts/media:305
msgid ""
"\"/media [ 'audio' | 'video' ]\" - report what is playing in a known audio "
"or video player."
msgstr "„/media [ 'audio' | 'video' ]” – prikaži što se reproducira u poznatom audioreproduktoru ili videoreproduktoru."

#: data/scripts/media:306
msgid ""
"\"/media { Player }\" - report what is playing in the specified player if it "
"is found."
msgstr "„/media { Player }” – prikaži što se reproducira u navedenom reproduktoru ako je pronađen."

