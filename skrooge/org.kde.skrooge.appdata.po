msgid "Skrooge"
msgstr "Skrooge"

#. (itstool) path: component/summary
#: org.kde.skrooge.appdata.xml:14
msgid "Single-entry bookkeeping for home use"
msgstr "Jednostavno knjigovodstvo za kućnu upotrebu"

#. (itstool) path: description/p
#: org.kde.skrooge.appdata.xml:16
msgid "Skrooge is a personal finance manager powered by KDE that aims to be simple and intuitive. Skrooge allows you to keep track of your expenses and income, categorize them, and build reports of them."
msgstr "Skrooge je KDE-ov upravitelj osobnih financija koji je osmišljen da bude jednostavan i intuitivan. Omogućuje praćenje troškova i prihoda, njihovo kategoriziranje i izradu izvješća."

