msgstr "Možete uštedjeti novac na računu s povoljnijom kamatnom stopom. Primjer: '%1' (%2%)"

#: plugins/skrooge/skrooge_operation/skgoperationplugin.cpp:1479
#, kde-format
msgctxt "Advice on making the best (short)"
msgid "Many transactions do not have mode"
msgstr "Mnoge transakcije nemaju način"

#: plugins/skrooge/skrooge_operation/skgoperationplugin.cpp:1481
#, kde-format
msgctxt "Advice on making the best (long)"
msgid ""
"Do not forget to set a mode for each transaction. This will allow you to "
"generate better reports."
msgstr "Ne zaboravite postaviti način za svaku transakciju. Tako ćete moći izraditi kvalitetnija izvješća."

#: plugins/skrooge/skrooge_operation/skgoperationplugin.cpp:1508
