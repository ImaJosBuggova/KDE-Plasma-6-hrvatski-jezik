#: org.kde.pix.appdata.xml:7
msgid "Pix"
msgstr "Galerija slika"

#. (itstool) path: component/summary
#: org.kde.pix.appdata.xml:8
msgid "Image Gallery"
msgstr "Pix je galerija i preglednik slika. Pix može otvoriti slike u drugim aplikacijama, primjerice u uređivaču slika, dodavati oznake datotekama i napomene slikama, zakretati ih i dijeliti."

#. (itstool) path: description/p
#: org.kde.pix.appdata.xml:14
msgid "Pix is an image gallery and image viewer. Pix can be used to open images with other applications like an image editor, add tags to the files, add annotations to pictures, rotate and share them."
msgstr "Glazbeni reproduktor Pix"

#. (itstool) path: screenshot/caption
