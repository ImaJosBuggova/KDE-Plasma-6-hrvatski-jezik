#. (itstool) path: component/summary
#: org.kde.kshisen.appdata.xml:10
msgid "Shisen-Sho Mahjongg-like Tile Game"
msgstr "Igra pločicama nalik na Mahjongg Shisen-Sho"

#. (itstool) path: description/p
#: org.kde.kshisen.appdata.xml:12
msgid "KShisen is a solitaire-like game played using the standard set of Mahjong tiles. Unlike Mahjong however, KShisen has only one layer of scrambled tiles."
msgstr "KShisen je igra nalik pasijansu koja se igra standardnim skupom pločica Mahjonga. Za razliku od Mahjonga, KShisen ima samo jedan sloj izmiješanih pločica."

