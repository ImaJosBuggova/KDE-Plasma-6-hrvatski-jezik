#: src/kcfg/settings.kcfg:66
#, kde-format
msgid ""
"This text will be used as pattern validator for the address email field of "
"OpenPGP certificates and S/MIME certification requests."
msgstr "ovaj tekst will be used as pattern validator za  address e-pošta field od OpenPGP certifikati i S/MIME certifikacija requests."

#. i18n: ectx: label, entry (email), group (CertificateCreationWizard)
#: src/kcfg/settings.kcfg:70
