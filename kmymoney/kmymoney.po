#: kmymoney/wizards/newaccountwizard/kloanpayoutpage.ui:59
#, kde-format
msgid ""
"Check this if you are refinancing a loan that already exists in KMyMoney"
msgstr "Označite ovo ako refinancirate zajam koji već postoji u KMyMoney"

#. i18n: ectx: property (text), widget (QCheckBox, m_refinanceLoan)
#: kmymoney/wizards/newaccountwizard/kloanpayoutpage.ui:62
#, kde-format
