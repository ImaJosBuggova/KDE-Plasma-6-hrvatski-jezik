#: kmymoney/plugins/xml/xmlstorage.cpp:113
#, kde-format
msgid ""
"GPG does not seem to be installed on your system. Please make sure that GPG "
"can be found using the standard search path. This time, encryption is "
"disabled."
msgstr "GPG nije instaliran na vašem sustavu. Provjerite može li se GPG pronaći korištenjem standardne staze pretraživanja. Ovaj put je enkripcija onemogućena."

