#: kmymoney/wizards/newloanwizard/paymenteditwizardpage.ui:103
#: kmymoney/wizards/newloanwizard/paymentwizardpage.ui:56
#, kde-format
msgid "Principal and interest"
msgstr "Glavnica i kamate"

