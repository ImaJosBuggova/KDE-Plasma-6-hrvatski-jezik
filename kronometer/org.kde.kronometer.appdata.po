#. (itstool) path: component/name
#: org.kde.kronometer.appdata.xml:11
msgid "Kronometer"
msgstr "Kronometer"

#. (itstool) path: component/summary
#: org.kde.kronometer.appdata.xml:12
msgid "Chronometer"
msgstr "Kronometar"

#. (itstool) path: description/p
#: org.kde.kronometer.appdata.xml:14
msgid "Kronometer is a stopwatch application. It features the basic stopwatch actions (pause/resume/reset/laps), as well as the ability to save the times and resume them later. Kronometer is part of the KDE Extragear collection, within the Utils sub-module."
msgstr "Kronometer je aplikacija za štopericu. Nudi osnovne radnje štoperice (pauziranje/nastavak/ponovno postavljanje/krugovi), kao i mogućnost spremanja vremena i kasnijeg nastavka. Kronometer je dio zbirke KDE Extragear, unutar podmodula Utils."

#. (itstool) path: description/p
#: org.kde.kronometer.appdata.xml:17
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:19
msgid "Start/pause/resume the stopwatch widget"
msgstr "Pokretanje, pauziranje i nastavak štoperice"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:20
msgid "Laps recording: you can capture the stopwatch time when you want"
msgstr "Bilježenje krugova: zabilježite vrijeme štoperice kad god želite"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:21
msgid "Lap times sorting: you can easily find the shortest lap time or the longest one"
msgstr "Razvrstavanje vremena krugova: jednostavno pronađite najkraće ili najdulje vrijeme kruga"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:22
msgid "Reset the stopwatch widget and the lap times"
msgstr "Ponovno postavljanje štoperice i vremena krugova"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:23
msgid "Time format settings: you can choose the stopwatch granularity"
msgstr "Postavke oblika vremena: odaberite preciznost štoperice"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:24
msgid "Times saving and resuming: you can save the stopwatch status and resume it later"
msgstr "Spremanje i nastavak mjerenja: spremite stanje štoperice i nastavite kasnije"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:25
msgid "Font customization: you can choose the fonts for each of the stopwatch digits"
msgstr "Prilagodba fonta: odaberite font za svaku znamenku štoperice"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:26
msgid "Color customization: you can choose the color for the stopwatch digits and the stopwatch background"
msgstr "Prilagodba boja: odaberite boju znamenaka i pozadine štoperice"

#. (itstool) path: ul/li
#: org.kde.kronometer.appdata.xml:27
msgid "Lap times export: you can export the lap times to a file using the JSON or CSV format"
msgstr "Izvoz vremena krugova: izvezite vremena krugova u datoteku u obliku JSON ili CSV"
