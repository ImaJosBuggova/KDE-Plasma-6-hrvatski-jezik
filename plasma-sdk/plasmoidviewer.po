#: main.cpp:44
#, kde-format
msgid "Run Plasma widgets in their own window"
msgstr "Pokreni Plasma widgete u vlastitom prozoru"

#: main.cpp:47
#, kde-format
msgid "The name of the containment plugin"
msgstr "Naziv dodatka spremnika"

#: main.cpp:51
#, kde-format
msgid "The name of the applet plugin"
msgstr "Naziv dodatka apleta"

#: main.cpp:53
#, kde-format
msgid ""
"The formfactor to use (horizontal, vertical, mediacenter, planar or "
"application)"
msgstr "Oblik uređaja za upotrebu (vodoravno, okomito, multimedijski centar, ravno ili aplikacija)"

#: main.cpp:58
#, kde-format
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, topedge, bottomedge, leftedge, rightedge)"
msgstr "Ograničenje položaja pri pokretanju spremnika (plutajući, radna površina, cijeli zaslon, gornji rub, donji rub, lijevi rub, desni rub)"

#: main.cpp:63
#, kde-format
msgid "Set the x position of the plasmoidviewer on the Plasma desktop"
msgstr "Postavi x-položaj preglednika Plasma widgeta na radnoj površini Plasme"

#: main.cpp:66
#, kde-format
msgid "Set the y position of the plasmoidviewer on the Plasma desktop"
msgstr "Postavi y-položaj preglednika Plasma widgeta na radnoj površini Plasme"

#: main.cpp:69
#, kde-format
msgid "Set the window size of the plasmoidview"
msgstr "Postavi veličinu prozora preglednika Plasma widgeta"

#: main.cpp:72
#, kde-format
msgid "The size in kB to set the pixmap cache to"
msgstr "Veličina predmemorije rasterskih slika u kB"

#: main.cpp:75
#, kde-format
msgid "The name of the theme which the shell will use"
msgstr "Naziv teme koju će ljuska upotrebljavati"

#: main.cpp:78
#, kde-format
msgid "Data that should be passed to the applet as 'externalData' event"
msgstr "Podaci koji će se apletu proslijediti kao događaj „externalData”"

#: view.cpp:118
#, no-c-format, kde-format
msgid "Applet %1 does not exist."
msgstr "Aplet %1 ne postoji."

#: view.cpp:135
#, no-c-format, kde-format
msgid "Containment %1 does not exist."
msgstr "Spremnik %1 ne postoji."

