#: kdeconnect-cli.cpp:74
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id, to ease "
"scripting"
msgstr ""
"Naredba --list-devices ili --list-available ispisuje samo ID-ove uređaja radi "
"lakšeg pisanja skripti"

#: kdeconnect-cli.cpp:76
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices name, to ease "
"scripting"
msgstr ""
"Naredba --list-devices ili --list-available ispisuje samo nazive uređaja radi "
"lakšeg pisanja skripti"

#: kdeconnect-cli.cpp:78
#, kde-format
