#: kdeconnect-cli.cpp:37
#, kde-format
msgid ""
"No device specified: Use -d <Device ID> or -n <Device Name> to specify a "
"device. \n"
"Device ID's and names may be found using \"kdeconnect-cli -l\" \n"
"View complete help with --help option"
msgstr ""
"Nije naveden nijedan uređaj: upotrijebite -d <ID uređaja> ili -n <naziv "
"uređaja> za odabir uređaja.\n"
"ID-ovi i nazivi uređaja mogu se pronaći pomoću naredbe „kdeconnect-cli -l”\n"
"Cijelu pomoć pogledajte pomoću opcije --help"

