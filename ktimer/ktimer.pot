#: prefwidget.ui:51
#, kde-format
msgid "Command"
msgstr "Naredba"

#. i18n: ectx: property (toolTip), widget (QPushButton, m_add)
#: prefwidget.ui:59
#, kde-format
msgid "Add a new task"
msgstr "Dodaj novi zadatak"

#. i18n: ectx: property (whatsThis), widget (QPushButton, m_add)
#: prefwidget.ui:62
#, kde-format
msgid "Add a new task to the list."
msgstr "Dodaj novi zadatak na popis."

#. i18n: ectx: property (text), widget (QPushButton, m_add)
#: prefwidget.ui:65
#, kde-format
msgid "&New"
msgstr "&Novi"

#. i18n: ectx: property (toolTip), widget (QPushButton, m_remove)
#: prefwidget.ui:72
#, kde-format
msgid "Remove a task"
msgstr "Ukloni zadatak"

#. i18n: ectx: property (whatsThis), widget (QPushButton, m_remove)
#: prefwidget.ui:75
#, kde-format
msgid "Remove a task from the list."
msgstr "Ukloni zadatak s popisa."

#. i18n: ectx: property (text), widget (QPushButton, m_remove)
#: prefwidget.ui:78
#, kde-format
msgid "&Remove"
msgstr "&Ukloni"

#. i18n: ectx: property (toolTip), widget (QSlider, m_slider)
#: prefwidget.ui:116
#, kde-format
msgid "Speed up or slow down your countdown"
msgstr "Ubrzajte ili usporite odbrojavanje"

#. i18n: ectx: property (whatsThis), widget (QSlider, m_slider)
#: prefwidget.ui:119
#, kde-format
msgid "You can use this slider to adjust the time."
msgstr "Ovim klizačem možete podesiti vrijeme."

#. i18n: ectx: property (toolTip), widget (QLCDNumber, m_counter)
#: prefwidget.ui:129
#, kde-format
msgid "Time in seconds until command is executed"
msgstr "Vrijeme u sekundama do izvršavanja naredbe"

#. i18n: ectx: property (whatsThis), widget (QLCDNumber, m_counter)
#: prefwidget.ui:132
#, kde-format
msgid "This number is how many seconds are left for the selected countdown."
msgstr "Ovaj broj pokazuje koliko je sekundi preostalo do kraja odabranog odbrojavanja."

#. i18n: ectx: property (toolTip), widget (QToolButton, m_pause)
#: prefwidget.ui:142
#, kde-format
msgid "Pause a countdown"
