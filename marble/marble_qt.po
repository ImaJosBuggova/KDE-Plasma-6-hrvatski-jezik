#: src/lib/marble/MarbleNavigationSettingsWidget.ui:17
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Dragging and Animation"
msgstr "Povlačenje i animacija"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:37
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Drag location:"
msgstr "&Povucite lokaciju:"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:50
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">While dragging the "
"mouse there are two standard behaviours when dealing with a virtual "
"globe:</p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">The location below "
"mouse pointer will follow the cursor exactly: As a result e.g. the north "
"pole will not stay at the top which can lead to confusion. By default Marble "
"makes sure that north is always up which results in a dragging behaviour "
"where the location below the mouse pointer slightly \"detaches\" from the "
"cursor. </p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Dok povlačite mišem postoje dva standardna ponašanja kada radite s virtualnim globusom:</p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Lokacija ispod pokazivača miša točno će pratiti pokazivač: Kao rezultat, npr. sjeverni pol neće ostati na vrhu što može dovesti do zabune. Prema zadanim postavkama Marble osigurava da je sjever uvijek gore što rezultira ponašanjem povlačenja gdje se lokacija ispod pokazivača miša lagano \"odvaja\" od pokazivača. </p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:58
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Keep Planet Axis Vertically"
msgstr "Držite os planeta okomito"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:63
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Follow Mouse Pointer"
msgstr "Slijedite pokazivač miša"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:73
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Use kinetic spinning when dragging the map"
msgstr "Koristite kinetičko okretanje kada povlačite kartu"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:76
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Inertial globe rotation"
msgstr "&Inercijalna rotacija globusa"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:83
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">When searching for "
"a location Marble can either move instantly to the new location or it can "
"show a travel animation from the previous place to the new "
"place.</p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Kada tražite lokaciju Marble može se odmah pomaknuti na novu lokaciju ili može prikazati animaciju putovanja s prethodnog mjesta na novo mjesto.</p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:89
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Animate voyage to the target"
msgstr "&Animirajte putovanje do cilja"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:96
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Use right mouse button to rotate the camera around"
msgstr "Koristite desnu tipku miša za okretanje kamere"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:99
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&Mouse view rotation"
msgstr "&Rotacija pogleda mišem"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:142
msgctxt "MarbleNavigationSettingsWidget|"
msgid "&On startup:"
msgstr "&Pri pokretanju:"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:152
msgctxt "MarbleNavigationSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">By default Marble "
"will display the home location immediately after the application has "
"started. As an alternative it can also show the last position that was "
"active when the user left the application. </p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Prema zadanim postavkama Marble će prikazati početnu lokaciju odmah nakon pokretanja aplikacije. Kao alternativa također može prikazati posljednju poziciju koja je bila aktivna kada je korisnik napustio aplikaciju. </p></body></html>"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:159
msgctxt "MarbleNavigationSettingsWidget|"
msgid "Show Home Location"
msgstr "Prikaži početnu lokaciju"

#: src/lib/marble/MarbleNavigationSettingsWidget.ui:164
