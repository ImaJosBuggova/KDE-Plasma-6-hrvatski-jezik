#: src/lib/marble/MarbleViewSettingsWidget.ui:126
msgctxt "MarbleViewSettingsWidget|"
msgid "Map &Quality"
msgstr "&Kvaliteta karte"

#: src/lib/marble/MarbleViewSettingsWidget.ui:144
msgctxt "MarbleViewSettingsWidget|"
msgid "&Still image:"
msgstr "&Slika:"

#: src/lib/marble/MarbleViewSettingsWidget.ui:154
msgctxt "MarbleViewSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Specifies the map "
"quality that gets displayed while there is no user input. Usually this "
"allows for high map quality as speed is no concern.</p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Određuje kvalitetu karte koja se prikazuje dok nema korisničkog unosa. To obično omogućuje visoku kvalitetu karte jer brzina nije briga.</p></body></html>"

#: src/lib/marble/MarbleViewSettingsWidget.ui:164
#: src/lib/marble/MarbleViewSettingsWidget.ui:219
msgctxt "MarbleViewSettingsWidget|"
msgid "Outline Quality"
msgstr "Kvaliteta obrisa"

