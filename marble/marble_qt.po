msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\"><p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Ovdje možete odabrati želite li da se prikazuju vremenski uvjeti (na primjer, oblaci ili vedro nebo.) Marble će prikazati stanje samo ako su ove informacije dostupne.</p></body></html>\n"

