#. file data/maps/moon/clementine/clementine.dgml:5
msgctxt "DGML|"
msgid "Moon"
msgstr "Mjesec"

#. file data/maps/moon/clementine/clementine.dgml:15
msgctxt "DGML|"
msgid ""
"<p>The moon.</p><p>The map is based on data from the Clementine Moon mission "
"(UVVIS Basemap Mosaic). Credits: NASA/SDIO, Courtesy <a "
"href=\"http://astrogeology.usgs.gov\">USGS Astrogeology Research "
"Program</a></p>"
msgstr ""
"<p>Mjesec.</p><p>Karta se temelji na podacima misije Clementine na Mjesec "
"(UVVIS Basemap Mosaic). Zasluge: NASA/SDIO, ljubaznošću <a "
"href=\"http://astrogeology.usgs.gov\">istraživačkog programa USGS "
"Astrogeology</a></p>"

