msgid "Print Quality"
msgstr "Kvaliteta ispisa"

#: src/lib/marble/MarbleViewSettingsWidget.ui:198
msgctxt "MarbleViewSettingsWidget|"
msgid "During &animations:"
msgstr "Tijekom &animacija:"

#: src/lib/marble/MarbleViewSettingsWidget.ui:208
msgctxt "MarbleViewSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Specifies the map "
"quality that gets displayed during map animations (e.g. while dragging the "
"globe). </p>\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Especially on slow "
"machines it is advisable to set this option to \"low quality\" as this will "
"give better speed.</p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Određuje kvalitetu karte koja se prikazuje tijekom animacija karte (npr. dok povlačite globus). </p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Posebno na sporim strojevima preporučljivo je postaviti ovu opciju na \"niska kvaliteta\" jer će to dati bolju brzinu.</p></body></html>"

#: src/lib/marble/MarbleViewSettingsWidget.ui:266
msgctxt "MarbleViewSettingsWidget|"
msgid "&Text Labels"
msgstr "&Tekstualne oznake"

#: src/lib/marble/MarbleViewSettingsWidget.ui:286
msgctxt "MarbleViewSettingsWidget|"
msgid "&Place names:"
msgstr "&Imena mjesta:"

#: src/lib/marble/MarbleViewSettingsWidget.ui:299
msgctxt "MarbleViewSettingsWidget|"
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /><style "
"type=\"text/css\">\n"
"p, li { white-space: pre-wrap; }\n"
"</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; "
"font-weight:400; font-style:normal;\">\n"
"<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; "
"margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Places often have "
"different names in different languages. The label on the map can show the "
"name in the user's language. Alternatively it can display the name in the "
"official language and glyphs of that place. </p></body></html>"
msgstr "<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'Sans Serif'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">Mjesta često imaju različita imena na različitim jezicima. Oznaka na karti može prikazati ime na jeziku korisnika. Alternativno, može prikazati ime na službenom jeziku i glifove tog mjesta. </p></body></html>"

