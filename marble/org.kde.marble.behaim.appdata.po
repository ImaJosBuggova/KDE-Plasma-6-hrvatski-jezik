#. (itstool) path: component/name
#: org.kde.marble.behaim.appdata.xml:10
msgid "Behaim Globe"
msgstr "Behaimov globus"

#. (itstool) path: component/summary
#: org.kde.marble.behaim.appdata.xml:11
msgid "Martin Behaim's Erdapfel"
msgstr "Martin Behaimov Erdapfel"

#. (itstool) path: description/p
#: org.kde.marble.behaim.appdata.xml:13
msgid "The oldest existent globe of the Earth. Martin Behaim and collaborators created the globe around 1492 at the time of Columbus' first sea travel to the west."
msgstr "Najstariji sačuvani zemaljski globus. Martin Behaim i suradnici izradili su ga oko 1492., u vrijeme Kolumbova prvog putovanja morem prema zapadu."

#. (itstool) path: screenshot/caption
#: org.kde.marble.behaim.appdata.xml:75
msgid "Digital imagery taken directly from the original Behaim globe."
msgstr "Digitalna snimka izravno s izvornog Behaimova globusa."

#. (itstool) path: screenshot/caption
#: org.kde.marble.behaim.appdata.xml:79
msgid "A (rough) facsimile created by Friedrich Wilhelm Ghillany in 1853."
msgstr "Približna reprodukcija koju je izradio Friedrich Wilhelm Ghillany 1853."

#. (itstool) path: screenshot/caption
#: org.kde.marble.behaim.appdata.xml:83
msgid "A (rough) facsimile created by Ernest George Ravenstein in 1908."
msgstr "Približna reprodukcija koju je izradio Ernest George Ravenstein 1908."
