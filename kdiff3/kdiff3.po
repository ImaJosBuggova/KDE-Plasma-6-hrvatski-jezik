#: pdiff.cpp:645
#, kde-format
msgid ""
"Some input characters could not be converted to valid unicode.\n"
"You might be using the wrong codec. (e.g. UTF-8 for non UTF-8 files).\n"
"Do not save the result if unsure. Continue at your own risk.\n"
"Affected input files are in %1."
msgstr "Neke ulazne znakove nije bilo moguće pretvoriti u valjani Unicode.\nMožda koristite pogrešan kodek (npr. UTF-8 za datoteke koje nisu u UTF-8 kodiranju).\nAko niste sigurni, nemojte spremiti rezultat. Nastavite na vlastitu odgovornost.\nPogođene ulazne datoteke nalaze se u %1."

