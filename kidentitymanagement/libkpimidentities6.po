#, kde-format
msgid "Text File (*.txt)"
msgstr "Tekstna datoteka (*.txt)"

#: widgets/signatureconfigurator.cpp:220
#, kde-format
msgid "Use this requester to specify a text file that contains your signature. It will be read every time you create a new mail or append a new signature."
msgstr "Ovim dijaloškim okvirom odaberite tekstnu datoteku koja sadrži vaš potpis. Pročitat će se pri svakom stvaranju nove poruke ili dodavanju novog potpisa."

#: widgets/signatureconfigurator.cpp:223
#, kde-format
msgctxt "@label:textbox"
msgid "S&pecify file:"
msgstr "&Odaberite datoteku:"

#: widgets/signatureconfigurator.cpp:230
#, kde-format
msgctxt "@action:button"
msgid "Edit &File"
msgstr "Uredi &datoteku"

#: widgets/signatureconfigurator.cpp:231
#, kde-format
msgid "Opens the specified file in a text editor."
msgstr "Otvara odabranu datoteku u uređivaču teksta."

#: widgets/signatureconfigurator.cpp:251
#, kde-format
msgid "You can add an arbitrary command here, either with or without path depending on whether or not the command is in your Path. For every new mail, KMail will execute the command and use what it outputs (to standard output) as a signature. Usual commands for use with this mechanism are \"fortune\" or \"ksig -random\". (Be careful, script needs a shebang line)."
msgstr "Ovdje možete unijeti proizvoljnu naredbu, s putanjom ili bez nje, ovisno o tome nalazi li se naredba u varijabli PATH. Za svaku novu poruku KMail će izvršiti naredbu i upotrijebiti njezin standardni izlaz kao potpis. Uobičajene naredbe za ovu namjenu su „fortune” i „ksig -random”. (Imajte na umu da skripta mora sadržavati redak shebang.)"

