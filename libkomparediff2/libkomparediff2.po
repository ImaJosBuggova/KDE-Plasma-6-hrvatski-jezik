#: modellist.cpp:183 modellist.cpp:209
#, kde-format
msgid ""
"<qt>No models or no differences, this file: <b>%1</b>, is not a valid diff "
"file.</qt>"
msgstr ""
"<qt>Nema modela ni razlika; ova datoteka: <b>%1</b>, nije valjana diff "
"datoteka.</qt>"

#: modellist.cpp:192
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the file <b>%2</b>.</"
"qt>"
msgstr ""
"<qt>Došlo je do problema pri primjeni razlike <b>%1</b> na datoteku "
"<b>%2</b>.</qt>"

#: modellist.cpp:220
#, kde-format
msgid ""
"<qt>There were problems applying the diff <b>%1</b> to the folder <b>%2</b>."
"</qt>"
msgstr ""
"<qt>Došlo je do problema pri primjeni razlike <b>%1</b> na mapu "
"<b>%2</b>.</qt>"

#: modellist.cpp:256 modellist.cpp:520
#, kde-format
msgid "Could not open a temporary file."
msgstr "Nije moguće otvoriti privremenu datoteku."

#: modellist.cpp:289 modellist.cpp:296
#, kde-format
msgid "<qt>Could not write to the temporary file <b>%1</b>, deleting it.</qt>"
msgstr "<qt>Nije moguće pisati u privremenu datoteku <b>%1</b>; briše se.</qt>"

#: modellist.cpp:324
#, kde-format
msgid ""
"<qt>Could not create destination directory <b>%1</b>.\n"
"The file has not been saved.</qt>"
msgstr ""
"<qt>Nije moguće stvoriti odredišni direktorij <b>%1</b>.\n"
"Datoteka nije spremljena.</qt>"

#: modellist.cpp:350
#, kde-format
msgid ""
"<qt>Could not upload the temporary file to the destination location <b>%1</"
"b>. The temporary file is still available under: <b>%2</b>. You can manually "
"copy it to the right place.</qt>"
msgstr ""
"<qt>Nije moguće prenijeti privremenu datoteku na odredišnu lokaciju "
"<b>%1</b>. Privremena datoteka i dalje je dostupna na lokaciji: <b>%2</b>. "
"Možete je ručno kopirati na odgovarajuće mjesto.</qt>"

#: modellist.cpp:429 modellist.cpp:465 modellist.cpp:486
#, kde-format
msgid "Could not parse diff output."
msgstr "Nije moguće raščlaniti izlaz razlike."

#: modellist.cpp:440
#, kde-format
msgid "The files are identical."
msgstr "Datoteke su jednake."

#: modellist.cpp:550
#, kde-format
msgid "Could not write to the temporary file."
msgstr "Nije moguće pisati u privremenu datoteku."

#: modellist.cpp:820
#, kde-format
msgid ""
"The diff is malformed. Some lines could not be parsed and will not be "
"displayed in the diff view."
msgstr ""
"Razlika je neispravno oblikovana. Neke retke nije bilo moguće raščlaniti pa "
"neće biti prikazani u prikazu razlika."
