#. (itstool) path: component/summary
#: org.kde.krfb.appdata.xml:7
msgid "Share your desktop to another computer via VNC"
msgstr "Dijelite radnu površinu s drugim računalom putem VNC-a"

#. (itstool) path: description/p
#: org.kde.krfb.appdata.xml:9
msgid "Krfb Desktop Sharing is a server application that allows you to share your current session with a user on another machine, who can use a VNC client to view or even control the desktop."
msgstr "Krfb je poslužiteljska aplikacija za dijeljenje trenutačne sesije s korisnikom na drugom računalu, koji pomoću VNC klijenta može pregledavati ili čak upravljati radnom površinom."

#. (itstool) path: screenshot/caption
