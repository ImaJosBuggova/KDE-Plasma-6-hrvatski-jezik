#. (itstool) path: component/name
#: org.kde.smb4k.appdata.xml:10
msgid "Smb4K"
msgstr "Smb4K"

#. (itstool) path: component/summary
#: org.kde.smb4k.appdata.xml:11
msgid "Discover and mount SAMBA and Windows shares over the network"
msgstr "Otkrivanje i montiranje Samba i Windows dijeljenih resursa putem mreže"

#. (itstool) path: description/p
#: org.kde.smb4k.appdata.xml:13
msgid "Smb4K is an advanced network neighborhood browser and Samba share mounting utility. It is based on the KDE Frameworks, QtKeychain, Samba's client library (libsmbclient) and, optionally, the KDSoap WS-Discovery client. It scans your network neighborhood for all available workgroups, servers and shares and can mount all desired shares to your local file system."
msgstr "Smb4K je napredni preglednik mrežnog susjedstva i alat za montiranje Samba dijeljenih resursa. Temelji se na KDE Frameworksima, QtKeychainu, Samba klijentskoj biblioteci (libsmbclient) i, po izboru, KDSoap klijentu za WS-Discovery. Pretražuje mrežno susjedstvo u potrazi za dostupnim radnim grupama, poslužiteljima i dijeljenim resursima te može montirati željene resurse u lokalni datotečni sustav."

#. (itstool) path: description/p
#: org.kde.smb4k.appdata.xml:16
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:20
msgid "Scanning for (active) workgroups, hosts, and shares using Samba's client library, DNS Service Discovery (DNS-SD) and, optionally, Web Services Dynamic Discovery (WS-Discovery)"
msgstr "Traženje (aktivnih) radnih grupa, računala i dijeljenih resursa pomoću Samba klijentske biblioteke, DNS Service Discoveryja (DNS-SD) i, po izboru, Web Services Dynamic Discoveryja (WS-Discovery)"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:21
msgid "Support of the CIFS and SMB3 file system under Linux as well as the SMBFS file system under BSD"
msgstr "Podrška za datotečne sustave CIFS i SMB3 u Linuxu te SMBFS u BSD-u"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:22
msgid "Mounting and unmounting of shares"
msgstr "Montiranje i odmontiranje dijeljenih resursa"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:23
msgid "Access to the files of a mounted share using a file manager or terminal"
msgstr "Pristup datotekama montiranog dijeljenog resursa putem upravitelja datoteka ili terminala"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:24
msgid "Auto-detection of external mounts and unmounts"
msgstr "Automatsko otkrivanje vanjskih montiranja i odmontiranja"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:25
msgid "Remounting of previously used shares on program start"
msgstr "Ponovno montiranje prethodno korištenih dijeljenih resursa pri pokretanju programa"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:26
msgid "Miscellaneous information about remote network items and mounted shares"
msgstr "Razne informacije o udaljenim mrežnim stavkama i montiranim dijeljenim resursima"

#. (itstool) path: ul/li
#: org.kde.smb4k.appdata.xml:27
