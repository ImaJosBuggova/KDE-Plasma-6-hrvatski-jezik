#: rulesets/classic.desktop:2 themes/classic.desktop:2
msgctxt "Name"
msgid "Classic"
msgstr "Klasično"

#: rulesets/classic.desktop:66
msgctxt "Description"
msgid ""
"<qt><p>The rules used in the original BSD command line version of "
"<tt>robots</tt>.</p><p>Nothing fancy, just the basic game elements: no "
"fastbots, no safe teleports, no pushing junkheaps, and a huge game grid.</"
"p><p>Due to its larger width, it is recommended that you use a theme with "
"narrower tiles to better fit your screen.</p></qt>"
msgstr ""
"<qt><p>Pravila izvorne BSD-ove verzije igre <tt>robots</tt> za naredbeni "
"redak.</p><p>Ništa posebno, samo osnovni elementi igre: nema brzih robota, "
"sigurnih teleportacija ni guranja gomila otpada, a igraća je mreža velika.</"
"p><p>Zbog veće širine preporučuje se tema s užim pločicama kako bi bolje "
"stala na zaslon.</p></qt>"

#: rulesets/daleks.desktop:2
msgctxt "Name"
msgid "Daleks"
msgstr "Daleksi"

#: rulesets/daleks.desktop:53
msgctxt "Description"
msgid ""
"<qt><p>An approximation of the rules used in Daleks, a robots-like game for "
"early Apple computers.</p><p>The hero is allotted one energy each round that "
"can be used to power the sonic screwdriver. All other special features are "
"disabled.</p></qt>"
msgstr ""
"<qt><p>Približna inačica pravila iz igre Daleks, igre nalik Robotsu za rana "
"Appleova računala.</p><p>Junak u svakom krugu dobiva jednu jedinicu energije "
"koju može iskoristiti za sonični odvijač. Sve su ostale posebne značajke "
"onemogućene.</p></qt>"

#: rulesets/default.desktop:2 src/org.kde.killbots.desktop:2
msgctxt "Name"
msgid "Killbots"
msgstr "Killbots"

#: rulesets/default.desktop:57
msgctxt "Description"
msgid ""
"<qt><p>The default Killbots game type.</p><p>Includes a medium size grid, "
"safe teleports, fast enemies and pushable junkheaps.</p></qt>"
msgstr ""
"<qt><p>Zadana vrsta igre Killbots.</p><p>Uključuje mrežu srednje veličine, "
"sigurne teleportacije, brze neprijatelje i gomile otpada koje je moguće "
"gurati.</p></qt>"

#: rulesets/easy.desktop:2
msgctxt "Name"
msgid "Easy"
msgstr "Lako"

#: rulesets/easy.desktop:58
msgctxt "Description"
msgid ""
"<qt><p>An easier version of the \"Killbots\" game type.</p><p>Includes a "
"bigger game grid prepopulated with junkheaps, a starting stash of energy and "
"an increasing energy cap.</p></qt>"
msgstr ""
"<qt><p>Jednostavnija inačica vrste igre „Killbots”.</p><p>Uključuje veću "
"igraću mrežu unaprijed ispunjenu gomilama otpada, početnu zalihu energije i "
"rastuće ograničenje energije.</p></qt>"

#: rulesets/energycrisis.desktop:2
msgctxt "Name"
msgid "Energy Crisis"
msgstr "Energetska kriza"

#: rulesets/energycrisis.desktop:54
msgctxt "Description"
msgid ""
"The player starts with 30 energy and cannot earn more. How many rounds can "
"you survive and how many points can you collect before your energy and luck "
"run out?"
msgstr ""
"Igrač počinje s 30 jedinica energije i ne može osvojiti više. Koliko krugova "
"možete preživjeti i koliko bodova skupiti prije nego što vam ponestane "
"energije i sreće?"

#: src/org.kde.killbots.desktop:55
msgctxt "GenericName"
msgid "Strategy Game with Robots"
msgstr "Strateška igra s robotima"

#: src/org.kde.killbots.desktop:96
msgctxt "Comment"
msgid "A KDE game of killer robots and teleportation."
msgstr "KDE-ova igra o robotima ubojicama i teleportaciji."

#: themes/classic.desktop:64
msgctxt "Description"
msgid "A theme for those who miss the console version"
msgstr "Tema za one kojima nedostaje konzolna inačica"

#: themes/mountainadventure.desktop:2
msgctxt "Name"
msgid "Mountain Adventure"
msgstr "Planinska pustolovina"

#: themes/mountainadventure.desktop:52
msgctxt "Description"
msgid "Indiana Gnomes battles ghosts and bats on a misty mountainside."
msgstr "Indiana Gnomes bori se protiv duhova i šišmiša na maglovitoj planinskoj padini."

#: themes/mummymadness.desktop:2
msgctxt "Name"
msgid "Mummy Madness"
msgstr "Ludilo s mumijama"

#: themes/mummymadness.desktop:51
msgctxt "Description"
msgid "Egyptian style theme with mad mummies."
msgstr "Tema u egipatskom stilu s ludim mumijama."

#: themes/robotkill.desktop:2
msgctxt "Name"
msgid "Robot Kill"
msgstr "Ubojiti roboti"

#: themes/robotkill.desktop:53
msgctxt "Description"
msgid "The default Killbots theme."
msgstr "Zadana tema igre Killbots."
