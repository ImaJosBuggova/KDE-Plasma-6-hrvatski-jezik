#. (itstool) path: component/name
#: org.kde.gwenview.appdata.xml:9
msgid "Gwenview"
msgstr "Gwenview"

#. (itstool) path: component/summary
#: org.kde.gwenview.appdata.xml:10
msgid "Image Viewer"
msgstr "Preglednik slika"

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:12
msgid "Gwenview is a fast and easy to use image viewer by KDE, ideal for browsing and displaying a collection of images."
msgstr "Gwenview je brz i jednostavan KDE-ov preglednik slika, idealan za pregledavanje i prikaz zbirke slika."

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:15
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:17
msgid "Simple image editing: rotate, crop, resize, mirror, flip, reduce red eye, and adjust brightness, contrast, or gamma"
msgstr "Jednostavno uređivanje slika: zakretanje, obrezivanje, promjena veličine, zrcaljenje, preokretanje, uklanjanje efekta crvenih očiju te prilagodba svjetline, kontrasta ili game"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:18
msgid "Annotate and mark up images with arrows, shapes, text boxes, image stamps, and more"
msgstr "Dodavanje napomena i oznaka na slike pomoću strelica, oblika, tekstnih okvira, slikovnih pečata i drugih elemenata"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:19
msgid "Basic file management actions such as copy, move, delete, and others"
msgstr "Osnovne radnje upravljanja datotekama kao što su kopiranje, premještanje i brisanje"

#. (itstool) path: screenshot/caption
#: org.kde.gwenview.appdata.xml:29
msgid "Main application window displaying an image and controls on the left"
msgstr "Glavni prozor aplikacije s prikazanom slikom i kontrolama na lijevoj strani"

#. (itstool) path: screenshot/caption
#: org.kde.gwenview.appdata.xml:33
msgid "Use Gwenview to manage your image collection"
msgstr "Upotrijebite Gwenview za upravljanje zbirkom slika"
