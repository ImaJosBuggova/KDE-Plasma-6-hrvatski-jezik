#. (itstool) path: component/name
#: org.kde.kget.appdata.xml:9
msgid "KGet"
msgstr "KGet"

#. (itstool) path: component/summary
#: org.kde.kget.appdata.xml:10
msgid "Download manager"
msgstr "Upravitelj preuzimanjima"

#. (itstool) path: description/p
#: org.kde.kget.appdata.xml:12
msgid "KGet is a versatile and user-friendly download manager."
msgstr "KGet je svestran i jednostavan upravitelj preuzimanjima."

#. (itstool) path: description/p
#: org.kde.kget.appdata.xml:15
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:17
msgid "Downloading files from FTP and HTTP(S) sources."
msgstr "Preuzimanje datoteka s izvora FTP i HTTP(S)."

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:18
msgid "Pausing and resuming of downloading files, as well as the ability to restart a download."
msgstr "Pauziranje i nastavak preuzimanja datoteka te mogućnost ponovnog pokretanja preuzimanja."

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:19
msgid "Tells lots of information about current and pending downloads."
msgstr "Prikazuje mnogo informacija o trenutačnim preuzimanjima i onima na čekanju."

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:20
msgid "Embedding into system tray."
msgstr "Integracija u programsku traku sustava."

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:21
msgid "Integration with the Konqueror web browser."
msgstr "Integracija s web-preglednikom Konqueror."

#. (itstool) path: ul/li
#: org.kde.kget.appdata.xml:22
msgid "Metalink support which contain multiple URLs for downloads, along with checksums and other information."
msgstr "Podrška za Metalink s više URL-ova za preuzimanje te kontrolnim zbrojevima i drugim informacijama."

#. (itstool) path: screenshot/caption
#: org.kde.kget.appdata.xml:31
msgid "Downloading files with KGet"
msgstr "Preuzimanje datoteka programom KGet"
