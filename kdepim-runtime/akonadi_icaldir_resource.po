msgstr "Putanja direktorija ili URL koji sadrži datoteke kalendara"

#: icaldirsettingswidget.cpp:46
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"Enter the path or URL to a directory whose contents should be represented by "
"this resource. The directory will be created if it does not exist."
msgstr "Unesite putanja ili URL za direktorij whose contents should biti represented putem ovo resurs. direktorij will biti created ako to ne postoji."

