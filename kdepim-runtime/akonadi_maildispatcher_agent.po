#: maildispatcheragent.cpp:79 maildispatcheragent.cpp:224
#, kde-format
msgid "Sending messages (1 item in queue)…"
msgid_plural "Sending messages (%1 items in queue)..."
msgstr[0] "Slanje poruka (%1 stavka u redu čekanja)…"
msgstr[1] "Slanje poruka (%1 stavke u redu čekanja)…"
msgstr[2] "Slanje poruka (%1 stavki u redu čekanja)…"

#: maildispatcheragent.cpp:89
#, kde-format
msgid "Sending canceled."
msgstr "Slanje otkazano."

#: maildispatcheragent.cpp:96
#, kde-format
msgid "Finished sending messages."
msgstr "Finished slanje poruke."

#: maildispatcheragent.cpp:102
#, kde-format
msgctxt "Notification title when email was sent"
msgid "E-Mail Successfully Sent"
msgstr "E-pošta je uspješno poslana"

#: maildispatcheragent.cpp:103
#, kde-format
msgctxt "Notification when the email was sent"
msgid "Your E-Mail has been sent successfully."
msgstr "Vaša je e-pošta uspješno poslana."

#: maildispatcheragent.cpp:109
#, kde-format
msgid "No items in queue."
msgstr "Nema stavki u redu čekanja."

#: maildispatcheragent.cpp:154
#, kde-format
msgid "Online, sending messages in queue."
msgstr "Na mreži, slanje poruka iz reda čekanja."

#: maildispatcheragent.cpp:158
#, kde-format
msgid "Offline, message sending suspended."
msgstr "Izvan mreže, poruka slanje suspended."

#: maildispatcheragent.cpp:184
#, kde-format
msgctxt "Message with given subject is being sent."
msgid "Sending: %1"
msgstr "Slanje: %1"

#: maildispatcheragent.cpp:249
#, kde-format
msgctxt "Notification title when email sending failed"
msgid "E-Mail Sending Failed"
msgstr "Slanje e-pošte nije uspjelo"

#: maildispatcheragent.cpp:282
#, kde-format
msgid "Ready to dispatch messages."
msgstr "Ready za dispatch poruke."

#. i18n: ectx: label, entry (Outbox), group (General)
#: maildispatcheragent.kcfg:10
#, kde-format
msgid "Outbox collection id"
msgstr "Izlazna pošta zbirka ID"

#. i18n: ectx: label, entry (SentMail), group (General)
#: maildispatcheragent.kcfg:14
#, kde-format
msgid "Sent Mail collection id"
msgstr "Poslano Pošta zbirka ID"

#: outboxqueue.cpp:263
#, kde-format
msgid "Could not access the outbox folder (%1)."
msgstr "Nije moguće pristupiti izlazna pošta mapa (%1)."

#: sendjob.cpp:47 sendjob.cpp:48
#, kde-format
msgid "Message sending aborted."
msgstr "Poruka slanje aborted."

#: sendjob.cpp:57
#, kde-format
msgid "Could not initiate message transport. Possibly invalid transport."
msgstr "Nije moguće pokrenuti poruka transport. Možda neispravan transport."

#: sendjob.cpp:63
#, kde-format
msgid "Could not send message. Invalid transport."
msgstr "Nije moguće poslati poruka. Neispravan transport."

#: sendjob.cpp:95
#, kde-format
msgid "Failed to get D-Bus interface of resource %1."
msgstr "Dohvaćanje nije uspjelo: D-Bus interface od resurs %1."

#: sendjob.cpp:108
#, kde-format
msgid "Invalid D-Bus reply from resource %1."
msgstr "Neispravan D-Bus reply od resurs %1."

#: sendjob.cpp:229
#, kde-format
msgid "Default sent-mail folder unavailable. Keeping message in outbox."
msgstr "Zadani sent-mail mapa unavailable. Keeping poruka u izlazna pošta."

#: sendjob.cpp:241
#, kde-format
msgid "Message transport aborted."
msgstr "Poruka transport aborted."

#: sendjob.cpp:241
#, kde-format
msgid "Failed to transport message."
msgstr "Nije uspjelo: transport poruka."

#: sendjob.cpp:245
#, kde-format
msgid ""
"Possible solution: review your send mail settings (authentication, port, "
"encryption type, etc.)"
msgstr "Possible solution: review vaš pošalji pošta postavke (autentifikacija, priključak, šifriranje vrsta, etc.)"

#: sendjob.cpp:288
#, kde-format
msgid "Failed to get D-Bus interface of mailfilteragent."
msgstr "Dohvaćanje nije uspjelo: D-Bus interface od mailfilteragent."

#: sendjob.cpp:295
#, kde-format
msgid "Invalid D-Bus reply from mailfilteragent"
msgstr "Neispravan D-Bus reply od mailfilteragent"

#: sendjob.cpp:337
#, kde-format
msgid "Sending succeeded, but failed to remove the message from the outbox."
msgstr "Slanje succeeded, but Uklanjanje nije uspjelo: poruka od izlazna pošta."

#: sendjob.cpp:340
#, kde-format
msgid ""
"Sending succeeded, but failed to move the message to the sent-mail folder."
msgstr "Slanje succeeded, but Premještanje nije uspjelo: poruka za sent-mail mapa."

#: sendjob.cpp:376
#, kde-format
msgid "Failed to store result in item."
msgstr "Nije uspjelo: store rezultat u stavka."

#: storeresultjob.cpp:59
#, kde-format
msgid "Failed to fetch item."
msgstr "Dohvaćanje nije uspjelo: stavka."