#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr "Pogreška opening %1; either ovo je ne valjan maildir mapa, ili vi učini ne ima sufficient pristup dopuštenja."

