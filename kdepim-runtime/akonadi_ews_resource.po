#: ewsconfigdialog.ui:179
#, kde-format
msgid "Password:"
msgstr "Lozinka:"

#. i18n: ectx: property (whatsThis), widget (KPasswordLineEdit, passwordEdit)
#: ewsconfigdialog.ui:186
#, kde-format
msgid ""
"<html><head/><body><p>The password used to login to the Exchange server.</"
"p><p><span style=\" font-weight:600;\">Note:</span> This can be left empty "
"when using Kerberos authentication.</p></body></html>"
msgstr "<html><head/><body><p> lozinka used za prijava za Exchange poslužitelj.</p><p><span style=\" font-weight:600;\">Note:</span> Ovo can biti left prazan kada koristeći Kerberos autentifikacija.</p></body></html>"

#. i18n: ectx: property (whatsThis), widget (QLineEdit, kcfg_Username)
#: ewsconfigdialog.ui:193
#, kde-format
msgid ""
"<html><head/><body><p>The username used to login to the Exchange server.</"
"p><p><span style=\" font-weight:600;\">Note:</span> This can be left empty "
"when using Kerberos authentication.</p></body></html>"
msgstr "<html><head/><body><p> korisničko ime used za prijava za Exchange poslužitelj.</p><p><span style=\" font-weight:600;\">Note:</span> Ovo can biti left prazan kada koristeći Kerberos autentifikacija.</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, kerberosNoteLabel)
#: ewsconfigdialog.ui:203
#, kde-format
msgid ""
"<html><head/><body><p><span style=\" font-weight:600;\">Note:</span> "
"Username and password are not needed (can be empty) when Kerberos is "
"properly configured on your system.</p></body></html>"
msgstr "<html><head/><body><p><span style=\" font-weight:600;\">Note:</span> Korisničko ime i lozinka su ne needed (can biti prazan) kada Kerberos je properly konfiguriran na vaš system.</p></body></html>"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, authOAuth2RadioButton)
#: ewsconfigdialog.ui:222
#, kde-format
msgid ""
"<html><head/><body><p>Enables more modern and stronger authentication based "
"on OAuth2.</p><p>This type of authentication will open an organization-"
"supplied webpage, where the user will be able to enter authentication "
"information, which may also include multifactor authentication in form of "
"one-time-passwords generated by tokens.</p><p>This method is mostly used for "
"hosted Office 365 instances.</p></body></html>"
msgstr "<html><head/><body><p>Enables more modern i stronger autentifikacija based na OAuth2.</p><p>Ovo vrsta od autentifikacija will otvori organization-supplied webpage, where korisnik will biti able za unesite autentifikacija podaci, which may also include multifactor autentifikacija u form od one-time-passwords generated putem tokens.</p><p>Ovo method je mostly used za hosted Office 365 instances.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, authOAuth2RadioButton)
#: ewsconfigdialog.ui:225
#, kde-format
msgid "OAuth&2 (Office 365)"
msgstr "OAuth&2 (Office 365)"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, authInTuneRadioButton)
#: ewsconfigdialog.ui:232
#, kde-format
msgid ""
"<html><head/><body><p>Enables authentication using Microsoft InTune MDM "
"software. This is required in many corporate environments, which mandate "
"strong authentication using device credentials and thereby require the "
"system to be joined to the organization and managed using InTune.</p></"
"body></html>"
msgstr "<html><head/><body><p>Enables autentifikacija koristeći Microsoft InTune MDM software. Ovo je obavezan u mnogo corporate environments, which mandate strong autentifikacija koristeći device vjerodajnice i thereby require system za biti joined za organization i managed koristeći InTune.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, authInTuneRadioButton)
#: ewsconfigdialog.ui:235
#, kde-format
msgid "&Microsoft InTune"
msgstr "&Microsoft InTune"

