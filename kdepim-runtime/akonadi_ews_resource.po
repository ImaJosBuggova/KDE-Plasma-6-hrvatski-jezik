msgid ""
"<html><head/><body><p>Periodically asks for new item change events.</p></"
"body></html>"
msgstr "<html><head/><body><p>Povremeno asks za novi stavka promjena događaji.</p></body></html>"

#. i18n: ectx: property (text), widget (QRadioButton, pollRadioButton)
#: ewsconfigdialog.ui:426
#, kde-format
msgid "Po&ll for new messages"
msgstr "Po&ll za novi poruke"

