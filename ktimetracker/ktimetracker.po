#: base/timetrackerwidget.cpp:138
#, kde-format
msgctxt "@action:inmenu"
msgid "Start &New Session"
msgstr "Pokreni &novu sesiju"

#: base/timetrackerwidget.cpp:139
#, kde-format
msgctxt "@info:tooltip"
msgid "Starts a new session"
msgstr "Pokreće novu sesiju"

#: base/timetrackerwidget.cpp:141
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This will reset the session time to 0 for all tasks, to start a new session, "
"without affecting the totals."
msgstr "Ovim će se vrijeme sesije za sve zadatke vratiti na 0 kako bi započela nova sesija, bez utjecaja na ukupna vremena."
"Vrijeme sesije za sve zadatke postavit će se na 0 kako bi započela "
"nova sesija, bez utjecaja na ukupna vremena."

#: base/timetrackerwidget.cpp:149
#, kde-format
msgctxt "@action:inmenu"
msgid "Edit History..."
msgstr "Uredi povijest..."

#: base/timetrackerwidget.cpp:150
#, kde-format
msgctxt "@info:tooltip"
msgid "Edits history of all tasks of the current document"
msgstr "Uređuje povijest svih zadataka trenutačnog dokumenta"

#: base/timetrackerwidget.cpp:152
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"A window will be opened where you can change start and stop times of tasks "
"or add a comment to them."
msgstr "Otvorit će se prozor u kojem možete promijeniti vremena početka i završetka zadataka ili im dodati komentar."
"Otvorit će se prozor u kojem možete promijeniti vremena početka i završetka "
"zadataka ili im dodati komentar."

#: base/timetrackerwidget.cpp:162
#, kde-format
msgctxt "@action:inmenu"
msgid "&Reset All Times"
msgstr "&Poništi sva vremena"

#: base/timetrackerwidget.cpp:163
#, kde-format
msgctxt "@info:tooltip"
msgid "Resets all times"
msgstr "Poništava sva vremena"

#: base/timetrackerwidget.cpp:165
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This will reset the session and total time to 0 for all tasks, to restart "
"from scratch."
msgstr "Ovim će se vrijeme sesije i ukupno vrijeme za sve zadatke vratiti na 0 kako bi sve počelo ispočetka."
"Ovim će se vrijeme sesije i ukupno vrijeme svih zadataka postaviti na 0, "
"kako biste krenuli ispočetka."

#: base/timetrackerwidget.cpp:172
#, kde-format
msgctxt "@action:inmenu"
msgid "&Start"
msgstr "&Pokreni"

#: base/timetrackerwidget.cpp:173
#, kde-format
msgctxt "@info:tooltip"
msgid "Starts timing for selected task"
msgstr "Pokreće mjerenje vremena odabranog zadatka"

#: base/timetrackerwidget.cpp:175
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This will start timing for the selected task.\n"
"It is even possible to time several tasks simultaneously.\n"
"\n"
"You may also start timing of tasks by double clicking the left mouse button "
"on a given task. This will, however, stop timing of other tasks."
msgstr "Mjerenje vremena zadatka možete započeti i dvostrukim klikom lijeve tipke miša na zadatak. Time će se, međutim, zaustaviti mjerenje vremena ostalih zadataka."
"Pokrenut će se mjerenje vremena odabranog zadatka.\n"
"Moguće je istodobno mjeriti vrijeme za više zadataka.\n"
"\n"
"Mjerenje možete pokrenuti i dvostrukim klikom lijeve tipke miša na zadatak. "
"Time će se, međutim, zaustaviti mjerenje vremena ostalih zadataka."

