#: org.kde.ktimetracker.appdata.xml:28 org.kde.ktimetracker.appdata.xml:37
msgid "KTimeTracker"
msgstr "KTimeTracker"

#. (itstool) path: component/summary
#: org.kde.ktimetracker.appdata.xml:29
msgid "Personal Time Tracker"
msgstr "Osobno praćenje vremena"

#. (itstool) path: description/p
#: org.kde.ktimetracker.appdata.xml:31
msgid "KTimeTracker helps you track your personal time spent on various tasks and projects."
msgstr "KTimeTracker pomaže vam pratiti vrijeme koje osobno provodite na raznim zadacima i projektima."

#. (itstool) path: description/p
#: org.kde.ktimetracker.appdata.xml:32
msgid "It is useful for tracking billable hours and can report the hours logged by task and day."
msgstr "Koristan je za praćenje naplativih sati te može izvijestiti o satima evidentiranima po zadatku i danu."

#. (itstool) path: description/p
#: org.kde.ktimetracker.appdata.xml:33
msgid "With KTimeTracker, you can organize a broken-down project as subtasks with unlimited nesting. The standard keyboard and mouse shortcuts are simple and make the tool really comfortable and intuitive to use."
msgstr "KTimeTrackerom možete organizirati razrađeni projekt u podzadatke s neograničenim ugniježđivanjem. Standardni tipkovni i mišji prečaci jednostavni su i čine alat vrlo praktičnim i intuitivnim za korištenje."
