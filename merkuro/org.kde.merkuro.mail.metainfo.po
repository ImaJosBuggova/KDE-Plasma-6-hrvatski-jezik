#. (itstool) path: component/name
#: org.kde.merkuro.mail.metainfo.xml:10
msgid "Merkuro Mail"
msgstr "Merkuro Pošta"

#. (itstool) path: component/summary
#: org.kde.merkuro.mail.metainfo.xml:11
msgid "Read and write emails"
msgstr "Čitajte i pišite poruke e-pošte"

#. (itstool) path: description/p
#: org.kde.merkuro.mail.metainfo.xml:18
msgid "Merkuro Mail is a free and open source email client. Merkuro Mail is part of the Merkuro groupware suite and is currently in beta. For now, it only allows you to read your emails."
msgstr "Merkuro Pošta je besplatan klijent e-pošte otvorenog koda. Merkuro Pošta dio je paketa uredskih aplikacija Merkuro i trenutačno je u beta-izdanju. Zasad omogućuje samo čitanje poruka e-pošte."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:38
msgid "Reply, reply to all, and forward messages from the message and folder views."
msgstr "Odgovarajte, odgovarajte svima i prosljeđujte poruke iz prikaza poruka i mapa."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:39
msgid "Schedule messages for later or queue them for manual sending, with options to send now or reschedule from Drafts and Outbox."
msgstr "Zakažite slanje poruka za kasnije ili ih stavite u red za ručno slanje, uz mogućnost slanja odmah ili promjene rasporeda u mapama Skice i Odlazno."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:40
msgid "Show scheduled send times and manual send status in the message list."
msgstr "Prikažite zakazano vrijeme slanja i stanje ručnog slanja na popisu poruka."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:41
msgid "Group messages into optional threads, showing combined senders and unread message counts, sorted by the latest message."
msgstr "Po želji grupirajte poruke u razgovore, s prikazom pošiljatelja i broja nepročitanih poruka, razvrstane prema najnovijoj poruci."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:42
msgid "Permanently delete messages from Trash."
msgstr "Trajno izbrišite poruke iz Smeća."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:43
msgid "Update a folder alone or together with its subfolders, and restart an account from the folder menu."
msgstr "Ažurirajte mapu zasebno ili zajedno s njezinim podmapama te ponovno pokrenite račun iz izbornika mape."

#. (itstool) path: ul/li
#: org.kde.merkuro.mail.metainfo.xml:44
msgid "Show Merkuro Mail in the application launcher and improve message ordering, sidebar sizing, and stability."
msgstr "Prikažite Merkuro Poštu u pokretaču aplikacija te poboljšajte redoslijed poruka, veličinu bočne trake i stabilnost."

#. (itstool) path: screenshot/caption
#: org.kde.merkuro.mail.metainfo.xml:102
msgid "Mail View"
msgstr "Prikaz pošte"
