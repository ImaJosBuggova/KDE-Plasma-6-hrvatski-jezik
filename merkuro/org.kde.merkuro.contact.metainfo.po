#. (itstool) path: component/name
#: org.kde.merkuro.contact.metainfo.xml:10
msgid "Merkuro Contact"
msgstr "Merkuro Kontakti"

#. (itstool) path: component/summary
#: org.kde.merkuro.contact.metainfo.xml:11
msgid "Manage your contacts with speed and ease"
msgstr "Upravljajte kontaktima brzo i jednostavno"

#. (itstool) path: description/p
#: org.kde.merkuro.contact.metainfo.xml:18
msgid "Merkuro contact book application."
msgstr "Aplikacija za adresar Merkuro Kontakti."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:45
msgid "Import and export contacts as vCard files, and share individual contacts."
msgstr "Uvozite i izvozite kontakte kao vCard datoteke te dijelite pojedinačne kontakte."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:46
msgid "Move contacts between address books from the contact list or editor."
msgstr "Premještajte kontakte između adresara s popisa kontakata ili iz uređivača."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:47
msgid "Find contacts by name, nickname, organization, email address, or phone number, with improved sorting and display of contacts without names."
msgstr "Pronađite kontakte prema imenu, nadimku, organizaciji, adresi e-pošte ili telefonskom broju, uz poboljšano razvrstavanje i prikaz kontakata bez imena."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:48
msgid "See upcoming birthdays, including the age each contact will turn."
msgstr "Pogledajte nadolazeće rođendane, uključujući dob koju će svaki kontakt navršiti."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:49
msgid "View recent emails and events on a contact's page."
msgstr "Pogledajte nedavne poruke e-pošte i događaje na stranici kontakta."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:50
msgid "Add and edit postal addresses and notes."
msgstr "Dodajte i uredite poštanske adrese i bilješke."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:51
msgid "Improve contact avatars with LibreAvatar images."
msgstr "Poboljšajte avatare kontakata slikama LibreAvatara."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:52
msgid "Improve the contact list, sidebar, and address book menus."
msgstr "Poboljšajte popis kontakata, bočnu traku i izbornike adresara."

#. (itstool) path: ul/li
#: org.kde.merkuro.contact.metainfo.xml:53
msgid "Fix contact editor, deletion dialog, and collection handling issues, including crashes and memory leaks."
msgstr "Ispravite probleme s uređivačem kontakata, dijalogom za brisanje i rukovanjem zbirkama, uključujući rušenja i curenja memorije."

#. (itstool) path: screenshot/caption
#: org.kde.merkuro.contact.metainfo.xml:111
msgid "Contact list"
msgstr "Popis kontakata"

