#: org.kde.merkuro.metainfo.xml:9
msgid "Merkuro"
msgstr "Merkuro"

#. (itstool) path: component/summary
#: org.kde.merkuro.metainfo.xml:10
msgid "Manage your tasks, events and contacts with speed and ease"
msgstr "Upravljajte zadacima, događajima i kontaktima brzo i jednostavno"

#. (itstool) path: description/p
#: org.kde.merkuro.metainfo.xml:17
msgid "Merkuro is a calendar and contact application that allows you to manage your tasks, events and contacts. Merkuro supports both local calendars as well as a multitude of online calendars: Nextcloud, Google® Calendar, Outlook®, Caldav, and many more."
msgstr "Merkuro je aplikacija za kalendar i kontakte koja vam omogućuje upravljanje zadacima, događajima i kontaktima. Merkuro podržava lokalne kalendare, kao i brojne mrežne kalendare: Nextcloud, Google® Kalendar, Outlook®, Caldav i mnoge druge."

#. (itstool) path: description/p
#: org.kde.merkuro.metainfo.xml:18
msgid "Merkuro was built with the idea to be usable on desktop, on mobile and everything in between."
msgstr "Merkuro je osmišljen za korištenje na stolnim i mobilnim uređajima te svemu između."

