#. (itstool) path: component/name
#: org.kde.optiimage.metainfo.xml:8
msgid "OptiImage"
msgstr "OptiImage"

#. (itstool) path: component/summary
#: org.kde.optiimage.metainfo.xml:12
msgid "Image optimizer to reduce the size of images"
msgstr "Optimizator slika za smanjenje veličine slika"

#. (itstool) path: description/p
#: org.kde.optiimage.metainfo.xml:19
msgid "Optimize your images with OptiImage, a useful image compressor that supports PNG, JPEG, WebP and SVG file types."
msgstr "Optimizirajte slike alatom OptiImage, praktičnim kompresorom slika koji podržava vrste datoteka PNG, JPEG, WebP i SVG."

#. (itstool) path: description/p
#: org.kde.optiimage.metainfo.xml:21
msgid "It supports both lossless and lossy compression modes with an option whether to keep or not metadata of images. It additionally has a safe mode, where a new image is created instead of overwriting the old one."
msgstr "Podržava načine kompresije bez gubitaka i s gubicima te mogućnost zadržavanja ili uklanjanja metapodataka slika. Uz to, ima siguran način rada u kojem se stvara nova slika umjesto prebrisavanja stare."

#. (itstool) path: description/p
#: org.kde.optiimage.metainfo.xml:24
msgid "It uses the following tools:"
msgstr "Koristi sljedeće alate:"

#. (itstool) path: ul/li
#: org.kde.optiimage.metainfo.xml:26
msgid "oxipng for PNG images"
msgstr "oxipng za slike PNG"

#. (itstool) path: ul/li
#: org.kde.optiimage.metainfo.xml:27
msgid "jpegoptim for JPEG images"
msgstr "jpegoptim za slike JPEG"

#. (itstool) path: ul/li
#: org.kde.optiimage.metainfo.xml:28
msgid "scour for SVG images"
msgstr "scour za slike SVG"

#. (itstool) path: ul/li
#: org.kde.optiimage.metainfo.xml:29
msgid "cwebp for WebP images"
msgstr "cwebp za slike WebP"

#. (itstool) path: screenshot/caption
#: org.kde.optiimage.metainfo.xml:46
msgid "OptiImage main view showing a list of images getting processed"
msgstr "Glavni prikaz OptiImagea s popisom slika koje se obrađuju"

#. (itstool) path: description/p
#: org.kde.optiimage.metainfo.xml:53
msgid "Initial release of OptiImage"
msgstr "Prvo izdanje OptiImagea"
