#. (itstool) path: component/name
#: org.kde.kgeotag.appdata.xml:11
msgid "KGeoTag"
msgstr "KGeoTag"

#. (itstool) path: component/summary
#: org.kde.kgeotag.appdata.xml:15
msgid "Photo geotagging program"
msgstr "Program za geooznačavanje fotografija."

#. (itstool) path: description/p
#: org.kde.kgeotag.appdata.xml:17
msgid "KGeoTag is a standalone geotagging program. Images can be associated with geographic coordinates by different means: On the one hand, a matching with GPX encoded geodata can be done, on the other hand, the coordinates can be set manually, either via drag and drop onto a map, via bookmarks or by manually supplying them. The coordinates can be stored in the images' Exif header and/or in XMP sidecar files."
msgstr "KGeoTag je samostalni program za geooznačavanje. Fotografijama se geografske koordinate mogu pridružiti na više načina: uparivanjem s geografskim podacima kodiranima u GPX datoteci ili ručnim postavljanjem koordinata, povlačenjem i ispuštanjem na kartu, putem oznaka mjesta ili njihovim ručnim unosom. Koordinate se mogu pohraniti u Exif zaglavlje fotografije i/ili u popratne XMP datoteke."

