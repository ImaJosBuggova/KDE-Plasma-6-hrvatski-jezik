#: scamdetection/scamdetectionwebengine.cpp:142
#: scamdetection/scamdetectionwebengine.cpp:240
#, kde-format
msgid ""
"This email contains a link which reads as '%1' in the text, but actually "
"points to '%2'. This is often the case in scam emails to mislead the "
"recipient"
msgstr ""
"Ova poruka e-pošte sadrži poveznicu koja je u tekstu prikazana kao „%1”, "
"ali zapravo vodi na „%2”. To se često događa u prijevarnim porukama e-pošte "
"kako bi se primatelj doveo u zabludu."

#: scamdetection/scamdetectionwebengine.cpp:156
#, kde-format
msgid ""
"This email contains a link which points to a numerical IP address (%1) "
"instead of a typical textual website address. This is often the case in scam "
"emails."
msgstr ""
"Ova poruka e-pošte sadrži poveznicu koja vodi na brojčanu IP adresu (%1), "
"umjesto na uobičajenu tekstualnu adresu web-mjesta. To se često događa u "
"prijevarnim porukama e-pošte."

#: scamdetection/scamdetectionwebengine.cpp:163
#, kde-format
msgid ""
"This email contains a link which points to a hexadecimal IP address (%1) "
"instead of a typical textual website address. This is often the case in scam "
"emails."
msgstr ""
"Ova poruka e-pošte sadrži poveznicu koja vodi na heksadekadsku IP adresu "
"(%1), umjesto na uobičajenu tekstualnu adresu web-mjesta. To se često događa "
"u prijevarnim porukama e-pošte."

#: scamdetection/scamdetectionwebengine.cpp:169
#, kde-format
msgid "This email contains a link (%1) which has a redirection"
msgstr "Ova poruka e-pošte sadrži poveznicu (%1) koja preusmjerava."

#: scamdetection/scamdetectionwebengine.cpp:174
#, kde-format
msgid ""
"This email contains a link (%1) which contains multiple http://. This is "
"often the case in scam emails."
msgstr ""
"Ova poruka e-pošte sadrži poveznicu (%1) s više pojavljivanja teksta "
"http://. To se često događa u prijevarnim porukama e-pošte."

#: scamdetection/scamdetectionwebengine.cpp:185
#, kde-format
msgid "This email contains a shorturl (%1). It can redirect to another server."
msgstr "Ova poruka e-pošte sadrži kratki URL (%1) koji može preusmjeriti na drugi poslužitelj."

#: scamdetection/scamdetectionwebengine.cpp:258
#, kde-format
msgid ""
"The text of this link contains invisible characters, which are not displayed "
"but make it look different from the address it really points to. This is "
"often the case in scam emails."
msgstr ""
"Tekst ove poveznice sadrži nevidljive znakove koji se ne prikazuju, ali zbog "
"kojih izgleda drukčije od adrese na koju zapravo vodi. To se često događa u "
"prijevarnim porukama e-pošte."

#: scamdetection/scamdetectionwebengine.cpp:264
#, kde-format
msgid "Message contains form element. This is often the case in scam emails."
msgstr "Poruka sadrži element obrasca. To se često događa u prijevarnim porukama e-pošte."

