#: src/messagepart.cpp:439
#, kde-format
msgctxt "display name for an unnamed attachment"
msgid "Unnamed"
msgstr "Bez naziva"

#: src/messagepart.cpp:706 src/messagepart.cpp:751 src/messagepart.cpp:990
#, kde-format
msgid "Wrong Crypto Plug-In."
msgstr "Neispravan kriptografski dodatak."

#: src/messagepart.cpp:817 src/messagepart.cpp:1205
#, kde-format
msgid "No appropriate crypto plug-in was found."
msgstr "Nije pronađen odgovarajući kriptografski dodatak."

#: src/messagepart.cpp:819
#, kde-format
msgctxt "%1 is either 'OpenPGP' or 'S/MIME'"
msgid "No %1 plug-in was found."
msgstr "Nije pronađen dodatak %1."

#: src/messagepart.cpp:822
#, kde-format
msgid "Crypto plug-in \"%1\" cannot verify signatures."
msgstr "Kriptografski dodatak „%1” ne može provjeriti potpise."

#: src/messagepart.cpp:825
#, kde-format
msgid ""
"The message is signed, but the validity of the signature cannot be verified."
"<br />Reason: %1"
msgstr "Poruka je potpisana, ali nije moguće provjeriti valjanost potpisa.<br />Razlog: %1"

#: src/messagepart.cpp:1207
#, kde-format
msgid "Crypto plug-in \"%1\" cannot decrypt messages."
msgstr "Kriptografski dodatak „%1” ne može dešifrirati poruke."

#: src/messagepart.cpp:1210
#, kde-format
msgid "Crypto plug-in \"%1\" could not decrypt the data."
msgstr "Kriptografski dodatak „%1” nije mogao dešifrirati podatke."

#: src/messagepart.cpp:1210
#, kde-format
msgid "Error: %1"
msgstr "Pogreška: %1"
