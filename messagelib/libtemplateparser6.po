#: templatesconfiguration.cpp:54
#, kde-format
msgid ""
"<p>Here you can create and manage templates to use when composing new "
"messages, replies or forwarded messages.</p><p>The message templates support "
"substitution commands, either simply type them or select them from the "
"<i>Insert command</i> menu.</p>"
msgstr "<p>Ovdje možete stvarati predloške i upravljati njima za sastavljanje novih poruka, odgovora ili proslijeđenih poruka.</p><p>Predlošci poruka podržavaju naredbe za zamjenu; jednostavno ih upišite ili odaberite iz izbornika <i>Umetni naredbu</i>.</p>"

#: templatesconfiguration.cpp:61
#, kde-format
msgid ""
"<p>Templates specified here are folder-specific. They override both global "
"templates and per-identity templates.</p>"
msgstr "<p>Ovdje navedeni predlošci odnose se na određenu mapu. Imaju prednost pred globalnim predlošcima i predlošcima pojedinog identiteta.</p>"

#: templatesconfiguration.cpp:66
#, kde-format
msgid ""
"<p>Templates specified here are identity-specific. They override global "
"templates, but can be overridden by per-folder templates if they are "
"specified.</p>"
msgstr "<p>Ovdje navedeni predlošci odnose se na određeni identitet. Imaju prednost pred globalnim predlošcima, ali predlošci pojedine mape imaju prednost pred njima ako su navedeni.</p>"

#: templatesconfiguration.cpp:71
#, kde-format
msgid ""
"<p>These are global (default) templates. They can be overridden by per-"
"identity templates or per-folder templates if they are specified.</p>"
msgstr "<p>Ovo su globalni (zadani) predlošci. Predlošci pojedinog identiteta ili mape imaju prednost pred njima ako su navedeni.</p>"

#: templatesconfiguration.cpp:103
#, kde-format
msgid "Do you want to reset current template or all templates to default?"
msgstr "Želite li vratiti trenutačni predložak ili sve predloške na zadane vrijednosti?"

#: templatesconfiguration.cpp:104
#, kde-format
msgctxt "@title:window"
msgid "Reset to default"
msgstr "Vrati na zadano"

#: templatesconfiguration.cpp:105
#, kde-format
msgctxt "@action:button"
msgid "Reset Current Template"
msgstr "Vrati trenutačni predložak"

#: templatesconfiguration.cpp:106
#, kde-format
msgctxt "@action:button"
msgid "Reset All Templates"
msgstr "Vrati sve predloške"

#: templatesconfiguration.cpp:363
#, kde-format
msgid ""
"Use of \"Reply using plain text\" and \"Reply using HTML text\" in pairs is "
"not correct. Use only one of the aforementioned commands with \" Reply as "
"Quoted Message command\" as per your need\n"
"(a)Reply using plain text for quotes to be strictly in plain text\n"
"(b)Reply using HTML text for quotes being in HTML format if present"
msgstr "Istodobna upotreba naredbi „Odgovori običnim tekstom” i „Odgovori HTML tekstom” nije ispravna. Upotrijebite samo jednu od navedenih naredbi zajedno s naredbom „Odgovori kao citirana poruka”, prema potrebi.\n(a) Odgovor običnim tekstom kako bi citati bili isključivo običan tekst\n(b) Odgovor HTML tekstom kako bi citati bili u HTML obliku, ako je dostupan"

