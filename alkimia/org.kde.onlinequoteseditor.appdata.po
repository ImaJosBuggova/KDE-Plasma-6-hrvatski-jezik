#. (itstool) path: component/name
#: org.kde.onlinequoteseditor.appdata.xml.cmake:6
msgid "Online Quotes Editor"
msgstr "Uređivač internetskih kotacija"

#. (itstool) path: component/summary
#: org.kde.onlinequoteseditor.appdata.xml.cmake:7
msgid "Editor for online price quotes used by finance applications"
msgstr "Uređivač internetskih cijena koji upotrebljavaju financijske aplikacije"

#. (itstool) path: description/p
#: org.kde.onlinequoteseditor.appdata.xml.cmake:9
msgid "Online Quotes Editor is a graphical user interface application for editing and checking online quotes. Available online quote sources can be added from the KDE store, created locally, edited and checked for correct execution."
msgstr "Uređivač internetskih kotacija grafička je aplikacija za uređivanje i provjeru internetskih kotacija. Dostupni izvori internetskih kotacija mogu se dodati iz trgovine KDE-a, izraditi lokalno, urediti i provjeriti radi ispravnog izvršavanja."

#. (itstool) path: description/p
#: org.kde.onlinequoteseditor.appdata.xml.cmake:10
msgid "The interface is divided into customizable sub-windows for profiles, profile details, assigned online quotes, quote attributes, debug, and browser, allowing for flexible interface setup."
msgstr "Sučelje je podijeljeno u prilagodljive podprozore za profile, pojedinosti profila, dodijeljene internetske kotacije, atribute kotacija, otklanjanje pogrešaka i preglednik, što omogućuje fleksibilno prilagođavanje sučelja."

#. (itstool) path: description/p
#: org.kde.onlinequoteseditor.appdata.xml.cmake:11
msgid "Multiple applications can be supported via profiles."
msgstr "Profili omogućuju podršku za više aplikacija."

#. (itstool) path: description/p
#: org.kde.onlinequoteseditor.appdata.xml.cmake:12
msgid "Financial applications that do not contain their own user interface for editing online quote sources can call the online quote editor for this purpose."
msgstr "Financijske aplikacije koje nemaju vlastito sučelje za uređivanje izvora internetskih kotacija mogu u tu svrhu pokrenuti uređivač internetskih kotacija."
