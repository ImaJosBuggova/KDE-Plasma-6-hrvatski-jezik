#, kde-format
msgctxt "@action:button"
msgid "Return to Network Connections"
msgstr "Vrati se na mrežne veze"

#: ShareNetworkQrCodePage.qml:33
#, kde-format
msgid "Scan this QR code with another device to connect to the \"%1\" network."
msgstr ""
"Skenirajte ovaj QR kod drugim uređajem kako biste se povezali na mrežu „%1”."

#: ShareNetworkQrCodePage.qml:108
#, kde-format
msgid "Wi-Fi password:"
msgstr "Wi-Fi lozinka:"

#: Toolbar.qml:124
#, kde-format
msgid "Enable mobile data"
msgstr "Omogući mobilne podatke"

#: Toolbar.qml:147
#, kde-kuit-format
msgctxt "@info"
msgid "Disable airplane mode<nl/><nl/>This will enable Wi-Fi and Bluetooth"
msgstr ""
"Onemogući zrakoplovni način rada<nl/><nl/>Ovo će omogućiti Wi-Fi i Bluetooth"

#: Toolbar.qml:148
#, kde-kuit-format
msgctxt "@info"
msgid "Enable airplane mode<nl/><nl/>This will disable Wi-Fi and Bluetooth"
msgstr ""
"Omogući zrakoplovni način rada<nl/><nl/>Ovo će onemogućiti Wi-Fi i Bluetooth"

#: Toolbar.qml:176
#, kde-format
msgid "Hotspot"
msgstr "Vruća točka (Hotspot)"

#: Toolbar.qml:193
#, kde-format
msgctxt "@info:tooltip"
msgid "Cannot create a hotspot because Wi-Fi is disabled."
msgstr "Nije moguće stvoriti vruću točku jer je Wi-Fi onemogućen."

#: Toolbar.qml:195
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Cannot create a hotspot because all wireless radios are in use. Disconnect "
"from the current Wi-Fi network or connect another wireless radio."
msgstr ""
"Nije moguće stvoriti vruću točku jer su svi bežični radijski moduli u uporabi. "
"Prekinite vezu s trenutnom Wi-Fi mrežom ili spojite drugi bežični modul."

#: Toolbar.qml:197
#, kde-format
msgctxt "@info:tooltip"
msgid "Disable Hotspot"
msgstr "Onemogući vruću točku"

#: Toolbar.qml:199
#, kde-format
msgctxt "@info:tooltip"
msgid "Create Hotspot"
msgstr "Stvori vruću točku"

#: Toolbar.qml:227
#, kde-format
msgctxt "@action:button"
msgid "Scan Wi-Fi QR Code"
msgstr "Skeniraj Wi-Fi QR kod"

#: Toolbar.qml:232
#, kde-format
msgctxt "@info:tooltip"
msgid "Scan QR Code to connect to a Wi-Fi network"
msgstr "Skenirajte QR kod za povezivanje na Wi-Fi mrežu"

#: Toolbar.qml:234
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"Install QRCA Barcode Scanner to scan for a QR Code that connects to a Wi-Fi "
"network"
msgstr ""
"Instalirajte QRCA skener barkodova za skeniranje QR koda koji vas povezuje "
"na Wi-Fi mrežu"

#: Toolbar.qml:253
#, kde-format
msgid "Configure network connections…"
msgstr "Konfiguriraj mrežne veze…"