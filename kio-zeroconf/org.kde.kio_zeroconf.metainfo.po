#. (itstool) path: component/summary
#: org.kde.kio_zeroconf.metainfo.xml:10
msgid "Browse local network services in Dolphin's Network page"
msgstr "Pregledavajte usluge lokalne mreže na Dolphinovoj stranici Mreža"

#. (itstool) path: description/p
#: org.kde.kio_zeroconf.metainfo.xml:12
msgid "Adds an entry to Dolphin's Network page to show local services such as printers which advertise themselves with DNSSD (called Avahi or Bonjour by other projects)."
msgstr "Dodaje stavku na Dolphinovu stranicu Mreža za prikaz lokalnih usluga, poput pisača, koje se oglašavaju putem DNSSD-a (u drugim projektima poznatog kao Avahi ili Bonjour)."
