#. (itstool) path: component/name
#: org.kde.pumoku.metainfo.xml:11
msgid "PuMoKu"
msgstr "PuMoKu"

#. (itstool) path: component/summary
#: org.kde.pumoku.metainfo.xml:12
msgid "A classic 9 × 9 sudoku game"
msgstr "Klasična igra sudoku 9 × 9"

#. (itstool) path: description/p
#: org.kde.pumoku.metainfo.xml:28
msgid "PuMoKu is a classic, 9 × 9 Sudoku solving game aimed for Plasma Mobile. It comes with flexible highlighting options and (touch) input methods, full undo stack and more."
msgstr "PuMoKu je klasična igra rješavanja sudokua 9 × 9 namijenjena za Plasma Mobile. Nudi prilagodljive mogućnosti isticanja, načine unosa (uključujući dodirni unos), potpunu povijest poništavanja i još mnogo toga."

#. (itstool) path: ul/li
#: org.kde.pumoku.metainfo.xml:30
msgid "Input methods: Cell first, Number first or Hybrid"
msgstr "Načini unosa: prvo ćelija, prvo broj ili hibridni"

#. (itstool) path: ul/li
#: org.kde.pumoku.metainfo.xml:31
msgid "Built in sudoku generator"
msgstr "Ugrađeni generator sudokua"

#. (itstool) path: ul/li
#: org.kde.pumoku.metainfo.xml:32
msgid "Automatic undo when the same action is repeated"
msgstr "Automatsko poništavanje pri ponavljanju iste radnje"

