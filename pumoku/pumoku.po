#, kde-format
msgctxt "@title:window"
msgid "Import Sudoku"
msgstr "Uvoz sudokua"

#: contents/ui/Import.qml:37
#, kde-format
msgctxt "Please use UTF character EN DASH (U+2013) for number range"
msgid ""
"Enter or paste a string of 81 characters. 1–9 for given cells, 0 or any "
"single non-numeric character except space will do for blanks cells. PuMoKu "
"will check that the Sudoku is solvable and calculate the level.\n"
"\n"
"Line breaks and spaces are silently removed, so that you can enter one or "
"more rows per-line with some optional whitespace."
msgstr ""
"Unesite ili zalijepite niz od 81 znaka. Brojevi 1–9 označavaju zadane ćelije, "
"a za prazne ćelije upotrijebite 0 ili bilo koji pojedinačni znak koji nije "
"broj, osim razmaka. PuMoKu će provjeriti može li se sudoku riješiti i "
"izračunati razinu.\n"
"\n"
"Prijelomi redaka i razmaci tiho se uklanjaju pa možete unijeti jedan ili "
"više redaka, uz neobavezne razmake."

