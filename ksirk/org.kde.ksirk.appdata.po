#. (itstool) path: component/name
#: org.kde.ksirk.appdata.xml:10
msgid "KsirK"
msgstr "KsirK"

#. (itstool) path: component/summary
#: org.kde.ksirk.appdata.xml:11
msgid "World Domination Strategy Game"
msgstr "Strateška igra osvajanja svijeta"

#. (itstool) path: description/p
#: org.kde.ksirk.appdata.xml:13
msgid "KsirK is a computerized version of the well known strategic board game Risk. The goal of the game is simply to conquer the world by attacking your neighbors with your armies."
msgstr "KsirK je računalna inačica poznate strateške društvene igre Risk. Cilj je jednostavno osvojiti svijet napadajući susjede svojim vojskama."


#. (itstool) path: description/p
#: org.kde.ksirk.appdata.xml:17
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.ksirk.appdata.xml:19
msgid "Support for 1-6 human or computer (AI) players"
msgstr "Podrška za 1 – 6 ljudskih igrača ili igrača kojima upravlja računalo (UI)"

#. (itstool) path: ul/li
#: org.kde.ksirk.appdata.xml:20
msgid "Multi-player gaming over a network"
msgstr "Mrežno igranje više igrača"

#. (itstool) path: ul/li
#: org.kde.ksirk.appdata.xml:21
msgid "You can easily create new skins with SVG graphics and the skin editor"
msgstr "Jednostavno možete stvarati nove teme uz SVG grafiku i uređivač tema."

#. (itstool) path: ul/li
#: org.kde.ksirk.appdata.xml:22
msgid "Hot New Stuff support. You can easily download and install new skins"
msgstr "Podrška za Hot New Stuff. Jednostavno možete preuzeti i instalirati nove teme."
