#: gui/org.kde.pimdataexporter.desktop:2
msgctxt "Name"
msgid "PIM Data Exporter"
msgstr "Izvoznik PIM podataka"

#: gui/org.kde.pimdataexporter.desktop:46
msgctxt "GenericName"
msgid "Saves and restores all data from PIM apps"
msgstr "Sprema i vraća sve podatke iz PIM aplikacija"

#: gui/org.kde.pimdataexporter.desktop:86
msgctxt "Comment"
msgid ""
"PIM Setting Exporter allows to save all data from PIM apps and restore them "
"in other systems."
msgstr "Izvoznik postavki PIM-a omogućuje spremanje svih podataka iz PIM aplikacija i njihovo vraćanje na drugim sustavima."
