"Malformed URL\n"
"%1"
msgstr ""
"Neispravan URL\n"
"%1"

#: core/mimetypefinderjob.cpp:224
#, kde-format
msgid "Unable to determine the type of file for %1"
msgstr "Nije moguće odrediti vrstu datoteke za %1"

