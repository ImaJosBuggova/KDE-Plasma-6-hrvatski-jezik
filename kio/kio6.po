#, kde-format
msgid "(Symbolic Link to %1)"
msgstr "(Simbolički link na %1)"

#: core/kfileitem.cpp:1537
#, kde-format
msgid "(%1, Link to %2)"
msgstr "(%1, link na %2)"

#: core/kfileitem.cpp:1540
#, kde-format
