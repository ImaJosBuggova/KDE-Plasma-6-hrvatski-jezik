#: qml/Help.qml:4
msgctxt "Help|"
msgid ""
"Simple color fill application. By selecting a color, the board gets flood "
"filled from top left. The goal is to make the board in one color in as few "
"fills as possible."
msgstr "Jednostavna igra popunjavanja bojom. Odabirom boje ploča se popunjava od gornjeg lijevog kuta. Cilj je obojiti cijelu ploču jednom bojom u što manje poteza."

#: qml/HighScoreView.qml:13
msgctxt "HighScoreView|"
msgid "Board size: "
msgstr "Veličina ploče: "

#: qml/HighScoreView.qml:17
msgctxt "HighScoreView|"
msgid "Fills: "
msgstr "Popunjavanja: "

