#: ui/main.qml:65
#, kde-format
msgid ""
"This will make the Plasma login screen reflect your customizations to the "
"following Plasma settings:"
msgstr ""
"Ovo će uskladiti prijavni zaslon Plasme s vašim prilagodbama sljedećih "
"Plasma postavki:"

#: ui/main.qml:66
#, kde-kuit-format
msgctxt "@info"
msgid ""
"<para><list><item>Language and locale settings</item><item>Keyboard layouts</"
"item><item>Screen arrangement, scale, and orientation settings</"
"item><item>NumLock preference</item><item>Font and font rendering settings</"
"item><item>Color scheme</item><item>Cursor theme and size</item><item>Plasma "
"theme</item></list></para>"
msgstr ""
"<para><list><item>Postavke jezika i lokalizacije</item><item>Rasporedi "
"tipkovnice</item><item>Postavke rasporeda, mjerila i usmjerenja zaslona</"
"item><item>Postavke NumLock tipke</item><item>Postavke fonta i prikaza fontova</"
"item><item>Shema boja</item><item>Tema i veličina pokazivača</item><item>Plasma "
"tema</item></list></para>"

#: ui/main.qml:67
#, kde-format
msgid ""
"Please note that theme and font files must be installed globally to be "
"reflected on the Plasma login screen."
msgstr ""
"Imajte na umu da datoteke tema i fontova moraju biti instalirane sustavski "
"(globalno) kako bi se prikazale na prijavnom zaslonu Plasme."

