#: org.kde.tokodon.desktop:4 src/tokodon.notifyrc:5
msgctxt "Name"
msgid "Tokodon"
msgstr "Tokodon"

#: org.kde.tokodon.desktop:44
msgctxt "GenericName"
msgid "Browse the Fediverse"
msgstr "Pregledavajte Fediverse"

#: org.kde.tokodon.desktop:78
msgctxt "Comment"
msgid "Client for the Mastodon"
msgstr "Klijent za Mastodon"

#: src/tokodon.notifyrc:46
msgctxt "Comment"
msgid "A client for Mastodon, the decentralized social media"
msgstr "Klijent za Mastodon, decentraliziranu društvenu mrežu"

#: src/tokodon.notifyrc:83
msgctxt "Name"
msgid "Favorite"
msgstr "Omiljeno"

#: src/tokodon.notifyrc:120
msgctxt "Comment"
msgid "Someone favorited your post"
msgstr "Netko je označio vašu objavu kao omiljenu"

#: src/tokodon.notifyrc:158
msgctxt "Name"
msgid "Boost"
msgstr "Prosljeđivanje"

#: src/tokodon.notifyrc:194
msgctxt "Comment"
msgid "Someone boosted your post"
msgstr "Netko je proslijedio vašu objavu"

#: src/tokodon.notifyrc:233 src/tokodon.notifyrc:369
msgctxt "Name"
msgid "Follow"
msgstr "Praćenje"

#: src/tokodon.notifyrc:271
msgctxt "Comment"
msgid "Someone followed you"
msgstr "Netko vas je počeo pratiti"

#: src/tokodon.notifyrc:309
msgctxt "Name"
msgid "Follow Request"
msgstr "Zahtjev za praćenje"

#: src/tokodon.notifyrc:343
msgctxt "Comment"
msgid "Someone requested to follow you"
msgstr "Netko vas je zatražio pratiti"

#: src/tokodon.notifyrc:407
msgctxt "Comment"
msgid "Someone mentioned you"
msgstr "Netko vas je spomenuo"

#: src/tokodon.notifyrc:446
msgctxt "Name"
msgid "Update"
msgstr "Ažuriranje"

#: src/tokodon.notifyrc:483
msgctxt "Comment"
msgid "Someone edited a post"
msgstr "Netko je uredio objavu"

#: src/tokodon.notifyrc:521
msgctxt "Name"
msgid "Poll"
msgstr "Anketa"

#: src/tokodon.notifyrc:555
msgctxt "Comment"
msgid "Someone's poll ended"
msgstr "Anketa nekog korisnika je završila"

#: src/tokodon.notifyrc:591
msgctxt "Name"
msgid "Status"
msgstr "Status"

#: src/tokodon.notifyrc:626
msgctxt "Comment"
msgid "Someone posted a new status"
msgstr "Netko je objavio novi status"

#: src/tokodon.notifyrc:663
msgctxt "Name"
msgid "Quote"
msgstr "Citiranje"

#: src/tokodon.notifyrc:690
msgctxt "Comment"
msgid "Someone quoted you"
msgstr "Netko vas je citirao"

#: src/tokodon.notifyrc:720
msgctxt "Name"
msgid "Annual Report"
msgstr "Godišnji izvještaj"

