#: core/smartattribute.cpp:101
#, kde-format
msgctxt "SMART attr name"
msgid "Read Error Rate"
msgstr "Učestalost pogrešaka pri čitanju"

#: core/smartattribute.cpp:101
#, kde-format
msgctxt "SMART attr description"
msgid "Rate of hardware read errors while reading data from the disk surface."
msgstr "Učestalost hardverskih pogrešaka pri čitanju podataka s površine diska."

#: core/smartattribute.cpp:102
#, kde-format
msgctxt "SMART attr name"
msgid "Throughput Performance"
msgstr "Propusnost"

#: core/smartattribute.cpp:102
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Overall (general) throughput performance of a hard disk drive. If the value "
"of this attribute is decreasing there is a high probability that there is a "
"problem with the disk."
msgstr ""
"Ukupna propusnost tvrdog diska. Ako se vrijednost ovog atributa smanjuje, "
"velika je vjerojatnost da postoji problem s diskom."

#: core/smartattribute.cpp:103
#, kde-format
msgctxt "SMART attr name"
msgid "Spin-Up Time"
msgstr "Vrijeme pokretanja"

#: core/smartattribute.cpp:103
#, kde-format
msgctxt "SMART attr description"
msgid "Average time of spindle spin up from zero RPM to fully operational."
msgstr "Prosječno vrijeme potrebno da se vreteno pokrene od nula okretaja u minuti do pune brzine."

#: core/smartattribute.cpp:104
#, kde-format
msgctxt "SMART attr name"
msgid "Start/Stop Count"
msgstr "Broj pokretanja/zaustavljanja"

#: core/smartattribute.cpp:104
#, kde-format
msgctxt "SMART attr description"
msgid "A tally of spindle start/stop cycles."
msgstr "Broj ciklusa pokretanja i zaustavljanja vretena."

#: core/smartattribute.cpp:105
#, kde-format
msgctxt "SMART attr name"
msgid "Reallocated Sectors Count"
msgstr "Broj preraspodijeljenih sektora"

#: core/smartattribute.cpp:105
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Count of reallocated sectors. When the hard drive finds a read/write/"
"verification error, it marks this sector as &quot;reallocated&quot; and "
"transfers data to a special reserved area (spare area)."
msgstr ""
"Broj preraspodijeljenih sektora. Kada tvrdi disk naiđe na pogrešku pri "
"čitanju, pisanju ili provjeri, označava taj sektor kao &quot;preraspodijeljen&quot; "
"i prenosi podatke u posebno rezervirano područje (zamjensko područje)."

#: core/smartattribute.cpp:106
#, kde-format
msgctxt "SMART attr name"
msgid "Read Channel Margin"
msgstr "Margina kanala za čitanje"

#: core/smartattribute.cpp:106
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Margin of a channel while reading data. The function of this attribute is "
"not specified."
msgstr "Margina kanala tijekom čitanja podataka. Funkcija ovog atributa nije navedena."

#: core/smartattribute.cpp:107
#, kde-format
msgctxt "SMART attr name"
msgid "Seek Error Rate"
msgstr "Učestalost pogrešaka traženja"

#: core/smartattribute.cpp:107
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Rate of seek errors of the magnetic heads. If there is a partial failure in "
"the mechanical positioning system, then seek errors will arise."
msgstr ""
"Učestalost pogrešaka pri traženju magnetskih glava. Djelomični kvar "
"mehaničkog sustava za pozicioniranje uzrokuje pogreške pri traženju."

#: core/smartattribute.cpp:108
#, kde-format
msgctxt "SMART attr name"
msgid "Seek Time Performance"
msgstr "Učinkovitost vremena traženja"

#: core/smartattribute.cpp:108
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Average performance of seek operations of the magnetic heads. If this "
"attribute is decreasing, it is a sign of problems in the mechanical "
"subsystem."
msgstr ""
"Prosječna učinkovitost postupaka traženja magnetskih glava. Smanjenje "
"vrijednosti ovog atributa znak je problema u mehaničkom podsustavu."

#: core/smartattribute.cpp:109
#, kde-format
msgctxt "SMART attr name"
msgid "Power-On Hours"
msgstr "Sati uključenosti"

#: core/smartattribute.cpp:109
#, kde-format
msgctxt "SMART attr description"
msgid "Count of hours in power-on state."
msgstr "Broj sati tijekom kojih je disk bio uključen."

#: core/smartattribute.cpp:110
#, kde-format
msgctxt "SMART attr name"
msgid "Spin Retry Count"
msgstr "Broj ponovnih pokušaja pokretanja"

#: core/smartattribute.cpp:110
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Count of retry of spin start attempts if the first attempt was unsuccessful. "
"An increase of this attribute value is a sign of problems in the hard disk "
"mechanical subsystem."
msgstr ""
"Broj ponovljenih pokušaja pokretanja vretena nakon neuspjeha prvog pokušaja. "
"Porast vrijednosti ovog atributa znak je problema u mehaničkom podsustavu "
"tvrdog diska."

#: core/smartattribute.cpp:111
#, kde-format
msgctxt "SMART attr name"
msgid "Recalibration Retries"
msgstr "Ponovni pokušaji kalibracije"

#: core/smartattribute.cpp:111
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Count of recalibrations requested if the first attempt was unsuccessful. An "
"increase of this attribute value is a sign of problems in the hard disk "
"mechanical subsystem."
msgstr ""
"Broj zatraženih ponovnih kalibracija nakon neuspjeha prvog pokušaja. Porast "
"vrijednosti ovog atributa znak je problema u mehaničkom podsustavu tvrdog diska."

#: core/smartattribute.cpp:112
#, kde-format
msgctxt "SMART attr name"
msgid "Power Cycle Count"
msgstr "Broj ciklusa uključivanja"

#: core/smartattribute.cpp:112
#, kde-format
msgctxt "SMART attr description"
msgid "Count of full hard disk power on/off cycles."
msgstr "Broj potpunih ciklusa uključivanja i isključivanja tvrdog diska."

#: core/smartattribute.cpp:113 core/smartattribute.cpp:145
#, kde-format
msgctxt "SMART attr name"
msgid "Soft Read Error Rate"
msgstr "Učestalost softverskih pogrešaka pri čitanju"

#: core/smartattribute.cpp:113
#, kde-format
msgctxt "SMART attr description"
msgid "Uncorrected read errors reported to the operating system."
msgstr "Neispravljene pogreške pri čitanju prijavljene operacijskom sustavu."

#: core/smartattribute.cpp:114
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Available Reserved Space"
msgstr "Dostupan rezervirani prostor SSD-a"

#: core/smartattribute.cpp:114
#, kde-format
msgctxt "SMART attr description"
msgid "Number of available reserved space as a percentage of reserved space."
msgstr "Količina dostupnog rezerviranog prostora izražena kao postotak ukupnog rezerviranog prostora."

#: core/smartattribute.cpp:115
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Program Fail Count"
msgstr "Broj neuspjelih upisa na SSD"

#: core/smartattribute.cpp:115 core/smartattribute.cpp:125
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Number of flash program operation failures since the drive was deployed."
msgstr "Broj neuspjelih operacija upisa u flash memoriju od početka korištenja pogona."

#: core/smartattribute.cpp:116 core/smartattribute.cpp:126
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Erase Fail Count"
msgstr "Broj neuspjelih brisanja na SSD-u"

#: core/smartattribute.cpp:116
#, kde-format
msgctxt "SMART attr description"
msgid "Number of flash erase operation failures since the drive was deployed."
msgstr "Broj neuspjelih operacija brisanja flash memorije od početka korištenja pogona."

#: core/smartattribute.cpp:117
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Wear Leveling Count"
msgstr "Broj ujednačavanja trošenja SSD-a"

#: core/smartattribute.cpp:117
#, kde-format
msgctxt "SMART attr description"
msgid "Counts the maximum worst erase count on any block."
msgstr "Broji najveći broj brisanja među svim blokovima."

#: core/smartattribute.cpp:118
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Unexpected power loss count"
msgstr "Broj neočekivanih gubitaka napajanja SSD-a"

#: core/smartattribute.cpp:118
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Number of shutdowns without STANDBY IMMEDIATE as the last command "
"(regardless of PLI activity using capacitor power). Normalized value is "
"always 100."
msgstr ""
"Broj isključivanja bez naredbe STANDBY IMMEDIATE kao posljednje naredbe "
"(neovisno o aktivnosti PLI-ja uz napajanje iz kondenzatora). Normalizirana "
"vrijednost uvijek je 100."

#: core/smartattribute.cpp:119
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Power Loss Protection Failure"
msgstr "Neuspjeh zaštite SSD-a od gubitka napajanja"

#: core/smartattribute.cpp:119
#, kde-format
msgctxt "SMART attr description"
msgid ""
"Last test result, saturated at its maximum value. Bytes 0-1: last test "
"result as microseconds to discharge cap in range [25, 5000000], lower "
"indicates specific error code. Bytes 2-3: minutes since last test. Bytes "
"4-5: lifetime number of tests. Normalized value is set to 1 on test failure "
"or 11 if the capacitor has been tested in an excessive temperature "
"condition, otherwise 100."
msgstr ""
"Rezultat posljednjeg testa, ograničen na najveću vrijednost. Bajtovi 0–1: "
"rezultat posljednjeg testa kao vrijeme pražnjenja kondenzatora u "
"mikrosekundama u rasponu [25, 5000000]; niža vrijednost označava određeni "
"kôd pogreške. Bajtovi 2–3: minute od posljednjeg testa. Bajtovi 4–5: ukupan "
"broj testova tijekom vijeka trajanja. Normalizirana vrijednost postavlja se "
"na 1 ako test ne uspije, na 11 ako je kondenzator testiran pri previsokoj "
"temperaturi, a inače na 100."

#: core/smartattribute.cpp:120
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Erase Fail Count (chip)"
msgstr "Broj neuspjelih brisanja SSD-a (čip)"

#: core/smartattribute.cpp:120
#, kde-format
msgctxt "SMART attr description"
msgid "Number of flash erase command failures."
msgstr "Broj neuspjelih naredbi za brisanje flash memorije."

#: core/smartattribute.cpp:121
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Wear Range Delta"
msgstr "Razlika istrošenosti SSD-a"

#: core/smartattribute.cpp:121
#, kde-format
msgctxt "SMART attr description"
msgid "Delta between most-worn and least-worn flash blocks."
msgstr "Razlika između najistrošenijih i najmanje istrošenih flash blokova."

#: core/smartattribute.cpp:122 core/smartattribute.cpp:123
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Used Reserved Block Count Total"
msgstr "Ukupan broj iskorištenih rezervnih blokova SSD-a"

#: core/smartattribute.cpp:122 core/smartattribute.cpp:123
#: core/smartattribute.cpp:126
#, kde-format
msgctxt "SMART attr description"
msgid "\"Pre-Fail\" Samsung attribute."
msgstr "Samsungov atribut „Pre-Fail”."

#: core/smartattribute.cpp:124
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Unused Reserved Block Count Total"
msgstr "Ukupan broj neiskorištenih rezervnih blokova SSD-a"

#: core/smartattribute.cpp:124
#, kde-format
msgctxt "SMART attr description"
msgid "\"Pre-Fail\" HP attribute."
msgstr "HP-ov atribut „Pre-Fail”."

#: core/smartattribute.cpp:125
#, kde-format
msgctxt "SMART attr name"
msgid "SSD Program Fail Count Total or Non-4K Aligned Access Count"
msgstr "Ukupan broj neuspjelih programiranja SSD-a ili neporavnatih pristupa koji nisu 4K"

#: core/smartattribute.cpp:127
#, kde-format
msgctxt "SMART attr name"
msgid "SATA Downshift Error Count"
msgstr "Broj pogrešaka snižavanja SATA brzine"

#: core/smartattribute.cpp:127
#, kde-format
msgctxt "SMART attr description"
msgid "Western Digital and Samsung attribute."
msgstr "Atribut Western Digitala i Samsunga."

#: core/smartattribute.cpp:128
#, kde-format
msgctxt "SMART attr name"
msgid "End-to-End Error"
