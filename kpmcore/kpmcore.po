#: core/operationstack.cpp:101
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just created: Undoing the operation to create the "
"partition."
msgstr ""
"Brisanje upravo stvorene particije: poništava se postupak stvaranja "
"particije."

#: core/operationstack.cpp:119
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Resizing a partition just created: Updating start and end in existing "
"operation."
msgstr ""
"Promjena veličine upravo stvorene particije: ažuriraju se početak i kraj "
"postojeće operacije."

#: core/operationstack.cpp:139
#, kde-kuit-format
msgctxt "@info:status"
msgid "Copying a new partition: Creating a new partition instead."
msgstr "Kopiranje nove particije: umjesto toga stvara se nova particija."

#: core/operationstack.cpp:156
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing label for a new partition: No new operation required."
msgstr "Promjena oznake nove particije: nije potrebna nova operacija."

#: core/operationstack.cpp:169
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing file system for a new partition: No new operation required."
msgstr "Promjena datotečnog sustava nove particije: nije potrebna nova operacija."

#: core/operationstack.cpp:188
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Checking file systems is automatically done when creating them: No new "
"operation required."
msgstr ""
"Provjera datotečnih sustava obavlja se automatski pri njihovu stvaranju: "
"nije potrebna nova operacija."

#: core/operationstack.cpp:235
#, kde-kuit-format
msgctxt "@info:status"
msgid "Deleting a partition just copied: Removing the copy."
msgstr "Brisanje upravo kopirane particije: uklanja se kopija."

#: core/operationstack.cpp:240
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just copied over an existing partition: Removing the "
"copy and deleting the existing partition."
msgstr ""
"Brisanje particije kopirane preko postojeće: uklanja se kopija i briše "
"postojeća particija."

#: core/operationstack.cpp:253
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Copying a partition that is itself a copy: Copying the original source "
"partition instead."
msgstr ""
"Kopiranje particije koja je i sama kopija: umjesto nje kopira se izvorna "
"particija."

#: core/operationstack.cpp:282
#, kde-kuit-format
msgctxt "@info:status"
msgid "Deleting a partition just restored: Removing the restore operation."
msgstr "Brisanje upravo vraćene particije: uklanja se operacija vraćanja."

#: core/operationstack.cpp:287
#, kde-kuit-format
msgctxt "@info:status"
msgid ""
"Deleting a partition just restored to an existing partition: Removing the "
"restore operation and deleting the existing partition."
msgstr ""
"Brisanje upravo vraćene particije u postojeću particiju: uklanja se "
"operacija vraćanja i briše postojeća particija."

#: core/operationstack.cpp:320
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing flags again for the same partition: Removing old operation."
msgstr "Ponovna promjena zastavica iste particije: uklanja se stara operacija."

#: core/operationstack.cpp:351
#, kde-kuit-format
msgctxt "@info:status"
msgid "Changing label again for the same partition: Removing old operation."
msgstr "Ponovna promjena oznake iste particije: uklanja se stara operacija."

#: core/operationstack.cpp:377
#, kde-kuit-format
msgctxt "@info:status"
msgid "Creating new partition table, discarding previous operation on device."
msgstr "Stvaranje nove particijske tablice uz odbacivanje prethodne operacije na uređaju."

#: core/operationstack.cpp:397
#, kde-kuit-format
msgctxt "@info:status"
msgid "Resizing Volume Group, nothing to do."
msgstr "Promjena veličine grupe jedinica: nema što učiniti."

