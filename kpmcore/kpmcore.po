#: fs/clustersize.cpp:107
#, kde-kuit-format
msgctxt "@info"
msgid "Choosing the cluster size is not supported for this file system."
msgstr "Odabir veličine klastera nije podržan za ovaj datotečni sustav."

#: fs/clustersize.cpp:111
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size must be given as an integer number of bytes."
msgstr "Veličina klastera mora biti zadana kao cijeli broj bajtova."

#: fs/clustersize.cpp:115
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size (%1 bytes) must be a positive number."
msgstr "Veličina klastera (%1 bajtova) mora biti pozitivan broj."

#: fs/clustersize.cpp:117
#, kde-kuit-format
msgctxt "@info"
msgid "The cluster size (%1 bytes) must be a power of two."
msgstr "Veličina klastera (%1 bajtova) mora biti potencija broja dva."

#: fs/clustersize.cpp:125
#, kde-kuit-format
msgctxt "@info"
msgid "The requested FAT sector size is not an integer power of two."
msgstr "Zatražena veličina sektora FAT-a nije cjelobrojna potencija broja dva."

#: fs/clustersize.cpp:128
#, kde-kuit-format
msgctxt "@info"
msgid "The requested FAT sector size (%1 bytes) must be between 512 and 32768."
msgstr "Zatražena veličina sektora FAT-a (%1 bajtova) mora biti između 512 i 32768."

#: fs/clustersize.cpp:134
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The requested FAT sectors-per-cluster value is not an integer power of two "
"from 1 to 128."
msgstr "Zatraženi broj sektora po klasteru za FAT nije cjelobrojna potencija broja dva između 1 i 128."

#: fs/clustersize.cpp:137 fs/clustersize.cpp:146
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) must be a whole multiple of the sector size (%2 "
"bytes)."
msgstr "Veličina klastera (%1 bajtova) mora biti višekratnik veličine sektora (%2 bajtova)."

#: fs/clustersize.cpp:141
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes maps to %2 sectors of %3 bytes per cluster, which "
"mkfs.fat cannot use (it must be a power of two from 1 to 128)."
msgstr "Veličina klastera od %1 bajtova odgovara %2 sektorima od %3 bajtova po klasteru, što mkfs.fat ne može koristiti (mora biti potencija broja dva između 1 i 128)."

#: fs/clustersize.cpp:143
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The requested cluster size (%1 bytes) and sectors-per-cluster value (%2) do "
"not agree."
msgstr "Zatražena veličina klastera (%1 bajtova) i vrijednost broja sektora po klasteru (%2) nisu usklađene."

#: fs/clustersize.cpp:152
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) is outside the range this file system supports "
"(%2 to %3 bytes)."
msgstr "Veličina klastera (%1 bajtova) izvan je raspona koji podržava ovaj datotečni sustav (%2 do %3 bajtova)."

#: fs/clustersize.cpp:155
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The cluster size (%1 bytes) is larger than the whole file system (%2 bytes)."
msgstr "Veličina klastera (%1 bajtova) veća je od cijelog datotečnog sustava (%2 bajtova)."

#: fs/clustersize.cpp:160
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes leaves fewer than the 4085 data clusters a FAT16 "
"file system needs. Choose a smaller cluster size."
msgstr "Veličina klastera od %1 bajtova ostavlja manje od 4085 podatkovnih klastera potrebnih datotečnom sustavu FAT16. Odaberite manju veličinu klastera."

#: fs/clustersize.cpp:162
#, kde-kuit-format
msgctxt "@info"
msgid ""
"A cluster size of %1 bytes leaves fewer than the 65525 data clusters a FAT32 "
"file system needs. Choose a smaller cluster size."
msgstr "Veličina klastera od %1 bajtova ostavlja manje od 65525 podatkovnih klastera potrebnih datotečnom sustavu FAT32. Odaberite manju veličinu klastera."

