#. (itstool) path: component/name
#: org.kde.bomber.appdata.xml:9
msgid "Bomber"
msgstr "Bomber"

#. (itstool) path: component/summary
#: org.kde.bomber.appdata.xml:10
msgid "Arcade Bombing Game"
msgstr "Arkadaška igra bombardiranja"

#. (itstool) path: description/p
#: org.kde.bomber.appdata.xml:12
msgid "Bomber is a single player arcade game. The player is invading various cities in a plane that is decreasing in height."
msgstr "Bomber je arkadna igra za jednog igrača. Igrač avionom koji se spušta napada razne gradove."

#. (itstool) path: description/p
#: org.kde.bomber.appdata.xml:15
msgid "The goal of the game is to destroy all the buildings and advance to the next level. Each level gets a bit harder by increasing the speed of the plane and the height of the buildings."
msgstr "Cilj je igre uništiti sve zgrade i prijeći na sljedeću razinu. Svaka je razina malo teža jer se povećavaju brzina aviona i visina zgrada."
