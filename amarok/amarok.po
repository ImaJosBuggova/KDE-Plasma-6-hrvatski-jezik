msgstr "Najveće dimenzije ugrađenog omota"

#. i18n: ectx: label, entry, group (Collection)
#: amarokconfig.kcfg:434
#, kde-format
msgid "List of folders in the Collection"
msgstr "Popis mapa u zbirci"

#. i18n: ectx: label, entry, group (Collection)
#: amarokconfig.kcfg:437
#, kde-format
