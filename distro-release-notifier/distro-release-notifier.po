#: src/notifier.cpp:22
#, kde-format
msgid "Upgrade available"
msgstr "Dostupna je nadogradnja"

#: src/notifier.cpp:23
#, kde-format
msgctxt "For example, 'KDE neon 24.04 is available.'"
msgid "%1 %2 is available."
msgstr "Dostupan je %1 %2."

#: src/notifier.cpp:25
#, kde-format
msgid ""
"\n"
"Your device will stop receiving updates and security fixes in 1 day — please "
"upgrade when possible."
msgid_plural ""
"\n"
"Your device will stop receiving updates and security fixes in %1 days — "
"please upgrade when possible."
msgstr[0] "\nVaš će uređaj prestati primati ažuriranja i sigurnosne ispravke za 1 dan — nadogradite ga čim bude moguće."
msgstr[1] "\nVaš će uređaj prestati primati ažuriranja i sigurnosne ispravke za %1 dana — nadogradite ga čim bude moguće."
msgstr[2] "\nVaš će uređaj prestati primati ažuriranja i sigurnosne ispravke za %1 dana — nadogradite ga čim bude moguće."

#: src/notifier.cpp:30
#, kde-format
msgid ""
"\n"
"Your device is no longer receiving updates or security fixes — please "
"upgrade now."
msgstr "\nVaš uređaj više ne prima ažuriranja ni sigurnosne ispravke — odmah ga nadogradite."

#: src/notifier.cpp:49
#, kde-format
msgctxt "@action:button"
msgid "Upgrade"
msgstr "Nadogradi"

#: src/screensaverinhibitor.cpp:24
#, kde-format
msgctxt "Screensaver inhibition reason"
msgid "Upgrading Operating System"
msgstr "Nadogradnja operacijskog sustava"

#: src/upgraderprocess.cpp:98
#, kde-format
msgctxt "@title/window upgrade failure dialog"
msgid "Upgrade Failed"
msgstr "Nadogradnja nije uspjela"

#: src/upgraderprocess.cpp:104
