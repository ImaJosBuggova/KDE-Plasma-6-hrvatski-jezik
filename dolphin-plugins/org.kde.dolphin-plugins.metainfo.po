#. (itstool) path: component/name
#: org.kde.dolphin-plugins.metainfo.xml:7
msgid "Dolphin Plugins"
msgstr "Dodaci za Dolphin"

#. (itstool) path: component/summary
#: org.kde.dolphin-plugins.metainfo.xml:8
msgid "Dolphin integration for revision control systems, Dropbox, and disk images"
msgstr "Integracija Dolphina sa sustavima za kontrolu verzija, uslugom Dropbox i slikama diskova"

#. (itstool) path: description/p
#: org.kde.dolphin-plugins.metainfo.xml:10
msgid "These plugins integrate Dolphin with the revision control systems Bazaar, Mercurial and Git. A Dropbox plugin gives action items to keep your files synced to the Dropbox service. A disk image integration plugin adds a mount or unmount action."
msgstr "Ovi dodaci povezuju Dolphin sa sustavima za kontrolu verzija Bazaar, Mercurial i Git. Dodatak za Dropbox dodaje radnje za sinkronizaciju datoteka s uslugom Dropbox. Dodatak za integraciju slika diskova dodaje radnju za prikvačivanje ili odspajanje slike."
