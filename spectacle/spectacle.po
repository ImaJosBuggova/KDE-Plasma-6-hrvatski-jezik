#: src/CommandLineOptions.h:22
#, kde-format
msgid "Capture the entire desktop (default)"
msgstr "Snimi cijelu radnu površinu (zadano)"

#: src/CommandLineOptions.h:26
#, kde-format
msgid ""
"When used with -f/--fullscreen, capture all screens scaled to the same size"
msgstr ""
"Kada se koristi uz -f/--fullscreen, snima sve zaslone skalirane na istu veličinu"

#: src/CommandLineOptions.h:30
#, kde-format
msgid "Capture the current monitor"
msgstr "Snimi trenutačni monitor"

#: src/CommandLineOptions.h:34
#, kde-format
msgid "Capture the active window"
msgstr "Snimi aktivni prozor"

#: src/CommandLineOptions.h:37
#, kde-format
msgid ""
"Capture the window currently under the cursor, including parents of pop-up "
"menus"
msgstr ""
"Snimi prozor koji je trenutno ispod pokazivača, uključujući roditeljske elemente "
"skočnih izbornika"

#: src/CommandLineOptions.h:40
#, kde-format
msgid "Capture a rectangular region of the screen"
msgstr "Snimi pravokutno područje zaslona"

#: src/CommandLineOptions.h:44
#, kde-format
msgid ""
"Record the screen using the given mode. Modes:\n"
"- r, region\n"
"- s, screen\n"
"- w, window"
msgstr ""
"Snimaj zaslon koristeći zadani način rada. Načini:\n"
"- r, region (područje)\n"
"- s, screen (zaslon)\n"
"- w, window (prozor)"

#: src/CommandLineOptions.h:52
#, kde-format
msgid "Launch Spectacle without taking a screenshot"
msgstr "Pokreni Spectacle bez snimanja zaslona"

#: src/CommandLineOptions.h:56
#, kde-format
msgid "Start in GUI mode (default)"
msgstr "Pokreni u grafičkom sučelju (zadano)"

#: src/CommandLineOptions.h:60
#, kde-format
msgid "Take a screenshot and exit without showing the GUI"
msgstr "Snimi zaslon i izađi bez prikazivanja grafičkog sučelja"

#: src/CommandLineOptions.h:64
#, kde-format
msgid "Start in DBus-Activation mode"
msgstr "Pokreni u načinu aktivacije putem DBus-a"

#: src/CommandLineOptions.h:68
#, kde-format
msgid ""
"In background mode, do not pop up a notification when the screenshot is taken"
msgstr ""
"U pozadinskom načinu rada nemoj prikazivati obavijest nakon snimanja zaslona"

#: src/CommandLineOptions.h:72
#, kde-format
msgid "In background mode, save image to specified file"
msgstr "U pozadinskom načinu rada spremi sliku u navedenu datoteku"

#: src/CommandLineOptions.h:77
#, kde-format
msgid "In background mode, delay before taking the shot (in milliseconds)"
msgstr ""
"U pozadinskom načinu rada odredi odgodu prije snimanja (u milisekundama)"

#: src/CommandLineOptions.h:82
#, kde-format
msgid ""
"In background mode, copy screenshot image to clipboard, unless -o is also "
"used."
msgstr ""
"U pozadinskom načinu rada kopiraj sliku u međuspremnik, osim ako se koristi i -o."

#: src/CommandLineOptions.h:86
#, kde-format
msgid "In background mode, copy screenshot file path to clipboard"
msgstr ""
"U pozadinskom načinu rada kopiraj putanju datoteke snimke zaslona u međuspremnik"

#: src/CommandLineOptions.h:90
#, kde-format
msgid "Wait for a click before taking screenshot. Invalidates delay"
msgstr "Pričekaj klik prije snimanja zaslona. Poništava odgodu"

#: src/CommandLineOptions.h:94
#, kde-format
msgid "Starts a new GUI instance of spectacle without registering to DBus"
msgstr "Pokreće novu instancu Spectaclea u sučelju bez registracije na DBus"

#: src/CommandLineOptions.h:98
#, kde-format
msgid "In background mode, include pointer in the screenshot"
msgstr "U pozadinskom načinu rada uključi pokazivač u snimku zaslona"

#: src/CommandLineOptions.h:102
#, kde-format
msgid "In background mode, exclude decorations in the screenshot"
msgstr "U pozadinskom načinu rada isključi dekoracije u snimci zaslona"

#: src/CommandLineOptions.h:104
#, kde-format
msgid "In background mode, exclude shadows in the screenshot"
msgstr "U pozadinskom načinu rada isključi sjene u snimci zaslona"

#: src/CommandLineOptions.h:107
#, kde-format
msgid "Open and edit existing screenshot file"
msgstr "Otvori i uredi postojeću datoteku snimke zaslona"

#: src/CommandLineOptions.h:110
#, kde-format
msgid "Accept region selection on click-and-release"
msgstr "Prihvati odabir područja pri kliku i puštanju tipke miša"

