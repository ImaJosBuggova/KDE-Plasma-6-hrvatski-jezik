#: ui/main.qml:41
#, kde-format
msgid "Animations"
msgstr "Animacije"

#: ui/main.qml:42
#, kde-format
msgid "If this is off, animations will be reduced as much as possible."
msgstr "Ako je isključeno, animacije će se smanjiti koliko god je moguće."

#: ui/main.qml:55
#, kde-format
msgid "Auto Hide Panels"
msgstr "Automatski sakrij ploče"

#: ui/main.qml:56
#, kde-format
msgid ""
"Auto-hide the status and navigation panels to allow applications to always "
"be in fullscreen."
msgstr "Automatski sakrij ploče stanja i navigacije kako bi aplikacije uvijek bile prikazane preko cijelog zaslona."

#: ui/main.qml:69
#, kde-format
msgid "Double Tap to Wakeup"
msgstr "Dvostruki dodir za buđenje"

#: ui/main.qml:70
#, kde-format
msgid "When the screen is off, double tap to wakeup the device."
msgstr "Dok je zaslon isključen, dvaput ga dodirnite da biste probudili uređaj."

#: ui/main.qml:83
#, kde-format
msgid "Confirm Close All"
msgstr "Potvrdi zatvaranje svih"

#: ui/main.qml:84
#, kde-format
msgid "Require confirmation before closing all apps in the task switcher."
msgstr "Zatraži potvrdu prije zatvaranja svih aplikacija u izmjenjivaču zadataka."

#: ui/main.qml:95
#, kde-format
