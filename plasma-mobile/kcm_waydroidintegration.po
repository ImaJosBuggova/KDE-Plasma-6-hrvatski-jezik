msgstr "Provjeri instalaciju"

#: ui/main.qml:51
#, kde-format
msgid ""
"Downloading Android and vendor images.\n"
"It can take a few minutes."
msgstr "Preuzimanje Androidovih i dobavljačkih slika.\nTo može potrajati nekoliko minuta."

#: ui/main.qml:66
#, kde-format
msgid ""
"Waydroid is resetting.\n"
"It can take a few seconds."
msgstr "Waydroid se vraća na početne postavke.\nTo može potrajati nekoliko sekundi."

#: ui/main.qml:75
#, kde-format
