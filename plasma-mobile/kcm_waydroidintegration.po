#: ui/WaydroidConfigurationForm.qml:57
#, kde-format
msgid "Certify my device for Google Play Protect"
msgstr "Certificiraj moj uređaj za Google Play Protect"

#: ui/WaydroidConfigurationForm.qml:62
#, kde-format
