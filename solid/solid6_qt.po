#: tools/solid-hardware/solid-hardware.cpp:218
#: tools/solid-hardware/solid-hardware.cpp:341
msgctxt "solid-hardware|"
msgid "Device udi"
msgstr "UDI uređaja"

#: tools/solid-hardware/solid-hardware.cpp:230
msgctxt "solid-hardware|"
msgid "Syntax:"
msgstr "Sintaksa:"

#: tools/solid-hardware/solid-hardware.cpp:233
msgctxt "solid-hardware|"
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Prikaži dostupni hardver u sustavu.\n"
"             # - Ako je navedena mogućnost 'nonportableinfo', prikazat će se\n"
"             # svojstva uređaja (nazivi svojstava ovise o pozadinskom sustavu),\n"
"             # - Ako je navedena mogućnost 'details', prikazat će se sučelja\n"
"             # uređaja i odgovarajuća svojstva na način neovisan o platformi,\n"
"             # - U suprotnom će se prikazati samo UDI-jevi uređaja.\n"

#: tools/solid-hardware/solid-hardware.cpp:245
msgctxt "solid-hardware|"
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Prikaži sva sučelja i svojstva uređaja koji odgovara vrijednosti\n"
"             # 'udi', na način neovisan o platformi.\n"

#: tools/solid-hardware/solid-hardware.cpp:251
msgctxt "solid-hardware|"
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # Prikaži sva svojstva uređaja koji odgovara vrijednosti 'udi'\n"
"             # (nazivi svojstava ovise o pozadinskom sustavu).\n"

#: tools/solid-hardware/solid-hardware.cpp:257
msgctxt "solid-hardware|"
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # Prikaži UDI-jeve uređaja koji odgovaraju uvjetu 'predicate'.\n"
"             # - Ako je naveden 'parentUdi', pretražuje se samo grana\n"
"             # odgovarajućeg uređaja,\n"
"             # - U suprotnom se pretražuju svi uređaji.\n"

#: tools/solid-hardware/solid-hardware.cpp:265
msgctxt "solid-hardware|"
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # Ako je moguće, montiraj uređaj koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:268
msgctxt "solid-hardware|"
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # Ako je moguće, demontiraj uređaj koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:271
msgctxt "solid-hardware|"
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # Ako je moguće, izbaci uređaj koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:274
msgctxt "solid-hardware|"
msgid "             # Listen to all add/remove events on supported hardware.\n"
msgstr "             # Prati sve događaje dodavanja i uklanjanja podržanog hardvera.\n"

#: tools/solid-hardware/solid-hardware.cpp:277
msgctxt "solid-hardware|"
msgid "             # Monitor devices for changes.\n"
msgstr "             # Prati promjene na uređajima.\n"

#: tools/solid-hardware/solid-hardware.cpp:280
msgctxt "solid-hardware|"
msgid ""
"             # Send \"CanCheck\" request to the device corresponding to "
"'udi'.\n"
msgstr "             # Pošalji zahtjev \"CanCheck\" uređaju koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:283
msgctxt "solid-hardware|"
msgid ""
"             # Send \"Check\" request to the device corresponding to 'udi'.\n"
msgstr "             # Pošalji zahtjev \"Check\" uređaju koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:286
msgctxt "solid-hardware|"
msgid ""
"             # Send \"CanRepair\" request to the device corresponding to "
"'udi'.\n"
msgstr "             # Pošalji zahtjev \"CanRepair\" uređaju koji odgovara vrijednosti 'udi'.\n"

#: tools/solid-hardware/solid-hardware.cpp:289
msgctxt "solid-hardware|"
msgid ""
"             # Send \"Repair\" request to the device corresponding to "
"'udi'.\n"
msgstr "             # Pošalji zahtjev \"Repair\" uređaju koji odgovara vrijednosti 'udi'.\n"

