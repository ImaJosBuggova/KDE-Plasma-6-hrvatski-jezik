#: suspenddialog.cpp:57
#, kde-format
msgctxt "@title:window"
msgid "Remind Later"
msgstr "Podsjeti kasnije"

#: suspenddialog.cpp:78
#, kde-format
msgctxt "@label:spinbox"
msgid "Suspend &duration:"
msgstr "Trajanje odgode:"

#: suspenddialog.cpp:85
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders by this amount of time"
msgstr "Odloži podsjetnike za odabrano vremensko razdoblje"

#: suspenddialog.cpp:87
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Each reminder for the selected incidences will be suspended by this number "
"of time units. You can choose the time units (typically minutes) in the "
"adjacent selector."
msgstr ""
"Svaki će se podsjetnik za odabrane događaje i zadatke odgoditi za ovaj "
"vremenski interval. Jedinice vremena (obično minute) možete odabrati u "
"susjednom izborniku."

#: suspenddialog.cpp:95
#, kde-format
msgctxt "@item:inlistbox suspend in terms of minutes"
msgid "minute(s)"
msgstr "minuta"

#: suspenddialog.cpp:96
#, kde-format
msgctxt "@item:inlistbox suspend in terms of hours"
msgid "hour(s)"
msgstr "sat"

#: suspenddialog.cpp:97
#, kde-format
msgctxt "@item:inlistbox suspend in terms of days"
msgid "day(s)"
msgstr "dan"

#: suspenddialog.cpp:98
#, kde-format
msgctxt "@item:inlistbox suspend in terms of weeks"
msgid "week(s)"
msgstr "tjedan"

#: suspenddialog.cpp:99
#, kde-format
msgctxt "@info:tooltip"
msgid "Suspend the reminders using this time unit"
msgstr "Odgodi podsjetnike ovom jedinicom vremena"

#: suspenddialog.cpp:101
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Each reminder for the selected incidences will be suspended using this time "
"unit. You can set the number of time units in the adjacent number entry "
"input."
msgstr ""
"Svaki će se podsjetnik za odabrane događaje i zadatke odgoditi ovom jedinicom "
"vremena. Broj jedinica vremena možete postaviti u susjednom polju za unos."

#: suspenddialog.cpp:114
#, kde-format
msgctxt "@action:button"
msgid "Remind Later"
msgstr "Podsjeti kasnije"

#: suspenddialog.cpp:115
#, kde-format
msgctxt "@info:tooltip"
msgid "Remind me again after the specified interval"
msgstr "Ponovno me podsjeti nakon navedenog intervala"

#: suspenddialog.cpp:116
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Press this button to be reminded again about this incidence after the "
"specified amount of time."
msgstr ""
"Pritisnite ovaj gumb da biste ponovno primili podsjetnik za ovaj događaj ili "
"zadatak nakon navedenog vremenskog razdoblja."

#: suspenddialog.cpp:120
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "Odustani"

#: suspenddialog.cpp:121
#, kde-format
msgctxt "@info:tooltip"
msgid "Cancel reminding later, show the notification again"
msgstr "Odustani od kasnijeg podsjećanja i ponovno prikaži obavijest"
