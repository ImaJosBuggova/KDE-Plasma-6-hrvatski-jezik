#. (itstool) path: component/name
#: org.kde.k3b.appdata.xml:5
msgid "K3b"
msgstr "K3b"

#. (itstool) path: component/summary
#: org.kde.k3b.appdata.xml:6
msgid "Disk Burning"
msgstr "Snimanje diska"

#. (itstool) path: description/p
#: org.kde.k3b.appdata.xml:8
msgid "K3b was created to be a feature-rich and easy to handle CD burning application. It consists of basically three parts:"
msgstr "K3b je stvoren da bude aplikacija za snimanje CD-a bogata značajkama i jednostavna za rukovanje. U osnovi se sastoji od tri dijela:"

#. (itstool) path: ul/li
#: org.kde.k3b.appdata.xml:13
msgid "The projects: Projects are created from the file menu and then filled with data to burn"
msgstr "Projekti: Projekti se stvaraju iz izbornika datoteka i zatim se popunjavaju podacima za snimanje"

#. (itstool) path: ul/li
#: org.kde.k3b.appdata.xml:17
msgid "The Tools: The tools menu offers different tools like CD copy or DVD formatting"
msgstr "Alati: Izbornik alata nudi različite alate poput kopiranja CD-a ili formatiranja DVD-a"

#. (itstool) path: ul/li
#: org.kde.k3b.appdata.xml:21
msgid "Context sensitive media actions: When clicking on the Icon representing a CD/DVD drive K3b will present its contents and allow some further action. This is for example the way to rip audio CDs"
msgstr "Medijske radnje osjetljive na kontekst: Klikom na ikonu koja predstavlja CD/DVD pogon K3b će prikazati njegov sadržaj i omogućiti neke daljnje radnje. Ovo je, na primjer, način kopiranja audio CD-a"
