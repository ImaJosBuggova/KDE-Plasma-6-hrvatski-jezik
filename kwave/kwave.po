msgid "Labels"
msgstr "Oznake"

#: libkwave/FileInfo.cpp:172
msgid "The list of labels/markers."
msgstr "Popis oznaka/markera."

#: libkwave/FileInfo.cpp:176
msgid "Length of the file in samples."
msgstr "Trajanje datoteke u uzorcima."

