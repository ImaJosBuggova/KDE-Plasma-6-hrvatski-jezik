#. (itstool) path: component/name
#: org.kde.kdenlive.appdata.xml:11
msgid "Kdenlive"
msgstr "Kdenlive"

#. (itstool) path: component/summary
#: org.kde.kdenlive.appdata.xml:12
msgid "Video editor"
msgstr "Uređivač videozapisa"

#. (itstool) path: description/p
#: org.kde.kdenlive.appdata.xml:14
msgid "Kdenlive is a video editing application with support for many audio and video formats. It offers advanced editing features, a variety of effects and transitions, color correction, audio post-production and subtitling tools. Additionally, it provides the flexibility to render into practically any format of your choice."
msgstr "Kdenlive je aplikacija za montažu videozapisa koja podržava mnoge audio i videoformate. Nudi napredne mogućnosti montaže, razne efekte i prijelaze, korekciju boja, naknadnu obradu zvuka i alate za titlovanje. Osim toga, omogućuje renderiranje u gotovo bilo koji željeni format."

#. (itstool) path: description/p
#: org.kde.kdenlive.appdata.xml:15
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:17
msgid "Nested Sequences"
msgstr "Ugniježđene sekvence"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:18
msgid "Configurable interface and shortcuts"
msgstr "Prilagodljivo sučelje i tipkovni prečaci"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:19
msgid "Scopes: Histogram, Vectorscope, RGB Parade, Waveform and Audio Meter"
msgstr "Mjerni prikazi: histogram, vektorskop, RGB prikaz po kanalima, valni oblik i mjerač zvuka"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:20
msgid "Proxy editing"
msgstr "Montaža pomoću proxy datoteka"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:21
msgid "Free online assets and templates"
msgstr "Besplatni mrežni resursi i predlošci"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:22
msgid "Motion tracking"
msgstr "Praćenje pokreta"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:23
msgid "AI powered tools"
msgstr "Alati pokretani umjetnom inteligencijom"

#. (itstool) path: description/p
#: org.kde.kdenlive.appdata.xml:32
msgid "Mostly a bugfix and usability release, here are some of the improvements"
msgstr "Ovo izdanje uglavnom donosi ispravke grešaka i poboljšanja upotrebljivosti; izdvajamo neka od njih:"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:34
msgid "Timeline: allow moving tracks up and down"
msgstr "Vremenska crta: omogućeno je premještanje staza gore i dolje"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:35
msgid "Timeline: auto add range markers at gaps"
msgstr "Vremenska crta: automatski se dodaju oznake raspona na prazninama"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:36
msgid "Timeline: add insert clip using its embeded timecode"
msgstr "Vremenska crta: dodana je mogućnost umetanja isječka prema njegovu ugrađenom vremenskom kodu"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:37
msgid "Timeline: add option to return playhead to start position on stop"
msgstr "Vremenska crta: dodana je mogućnost vraćanja pokazivača reprodukcije na početni položaj nakon zaustavljanja"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:38
msgid "Timeline: add option to duplicate clip"
msgstr "Vremenska crta: dodana je mogućnost dupliciranja isječka"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:39
msgid "Timeline: allow moving clip markers with the mouse"
msgstr "Vremenska crta: omogućeno je pomicanje oznaka isječka mišem"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:40
msgid "Timeline: add option to copy selection to new sequence (without modifying original)"
msgstr "Vremenska crta: dodana je mogućnost kopiranja odabira u novu sekvencu (bez izmjene izvornika)"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:41
msgid "Timeline: switch default transition to dissolve now that it correctly handles alpha"
msgstr "Vremenska crta: zadani je prijelaz promijenjen u pretapanje koje sada ispravno obrađuje kanal alfa"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:42
msgid "Audio mixer: shift click to listen to multiple selected tracks in solo mode"
msgstr "Mikser zvuka: klik uz pritisnut Shift omogućuje slušanje više odabranih staza u solo načinu"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:43
msgid "Effects: add avfilter.curves, allowing to adjust all channels in one effect"
msgstr "Efekti: dodan je avfilter.curves, koji omogućuje postavljanje svih kanala jednim efektom"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:44
msgid "Effects: improve gradientmap filter, allowing up to 32 stops in the gradient"
msgstr "Efekti: poboljšan je filtar gradientmap, koji sada podržava do 32 točke prijelaza gradijenta"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:45
msgid "Titler: add copy/paste of items"
msgstr "Uređivač naslova: dodano je kopiranje i lijepljenje objekata"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:46
msgid "Titler: add snapping to other objects"
msgstr "Uređivač naslova: dodano je poravnanje uz druge objekte"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:47
msgid "Titler: add rectangles with rounded corners"
msgstr "Uređivač naslova: dodani su pravokutnici zaobljenih kutova"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:48
msgid "Titler: when editing a timeline title, allow saving it as a new bin title to easily modify only this one"
msgstr "Uređivač naslova: pri uređivanju naslova na vremenskoj crti omogućeno je spremanje kao novog naslova u spremniku projekta, radi jednostavne izmjene samo tog naslova"

#. (itstool) path: description/p
#: org.kde.kdenlive.appdata.xml:124
msgid "This is the first bugfix release for the 24.02 version. Some of the most noteworthy fixes:"
msgstr "Ovo je prvo izdanje s ispravcima grešaka za verziju 24.02. Izdvajamo neke od najvažnijih ispravaka:"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:126
msgid "Fix distorted font in some parts of the UI"
msgstr "Ispravljen je izobličen font u nekim dijelovima sučelja"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:127
msgid "Fix crash editing gradients in titler"
msgstr "Ispravljen je pad pri uređivanju gradijenata u uređivaču naslova"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:128
msgid "Fix adding a mix to a grouped clip could move existing cut"
msgstr "Ispravljen je problem zbog kojeg je dodavanje miksa grupiranom isječku moglo pomaknuti postojeći rez"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:129
msgid "Fix moving and deleting a single item in a group"
msgstr "Ispravljeno je premještanje i brisanje pojedinačnog objekta u grupi"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:130
msgid "Fix crash in spacer tool with grouped subtitles"
msgstr "Ispravljen je pad alata za razmak pri radu s grupiranim podnaslovima"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:131
msgid "Fix multiple issues on sequence clips (incorrectly saving changes, subtitles not duplicated)"
msgstr "Ispravljeno je nekoliko problema s isječcima sekvenci (promjene se nisu ispravno spremale, a podnaslovi nisu duplicirani)"

#. (itstool) path: ul/li
#: org.kde.kdenlive.appdata.xml:132
msgid "Fix multiple issues with subtitles (multiple subtitles tracks not correctly saved or displayed)"
msgstr "Ispravljeno je nekoliko problema s podnaslovima (više staza podnaslova nije se ispravno spremalo ni prikazivalo)"

