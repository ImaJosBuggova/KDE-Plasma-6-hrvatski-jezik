#, kde-format
msgid "Dodge"
msgstr "Dodge"

#: data/transitions/frei0r/frei0r_dodge.xml:5
#, kde-format
msgid ""
"Perform an RGB[A] dodge operation between the pixel sources, using the "
"generalised algorithm: D = saturation of 255 or (A * 256) / (256 - B)"
msgstr "Izvršite operaciju izbjegavanja RGB[A] između izvora piksela, koristeći generalizirani algoritam: D = zasićenost od 255 ili (A * 256) / (256 - B)"

