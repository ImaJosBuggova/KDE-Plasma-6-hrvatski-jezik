#: src/titler/unicodedialog.cpp:154
#, kde-format
msgid ""
"<p><strong>&laquo;</strong> (u+00ab, <code>&amp;lfquo;</code> in HTML) and "
"<strong>&raquo;</strong> (u+00bb, <code>&amp;rfquo;</code> in HTML) are "
"called Guillemets or angle quotes. Usage in different countries: France "
"(with non-breaking Space 0x00a0), Switzerland, Germany, Finland and Sweden.</"
"p><p><strong>&lsaquo;</strong> and <strong>&rsaquo;</strong> (U+2039/203a, "
"<code>&amp;lsaquo;/&amp;rsaquo;</code>) are their single quote equivalents.</"
"p><p>See <a href=\"https://en.wikipedia.org/wiki/Guillemets\">Wikipedia:"
"Guillemets</a></p>"
msgstr "<p><strong>&laquo;</strong> (u+00ab, <code>&amp;lfquo;</code> u HTML-u) i <strong>&raquo;</strong> (u+00bb, <code>&amp;rfquo;</code> u HTML-u) nazivaju se Guillemets ili kutni navodnici. Upotreba u različitim zemljama: Francuska (s neprekinutim razmakom 0x00a0), Švicarska, Njemačka, Finska i Švedska.</p><p><strong>&lsaquo;</strong> i <strong>&rsaquo;</strong> (U+2039/203a, <code>&amp;lsaquo;/&amp;rsaquo;</code>) njihovi su ekvivalenti u jednostrukim navodnicima.</p><p>Pogledajte <a href=\"https://en.wikipedia.org/wiki/Guillemets\">Wikipedia:Guillemets</a></p>"

#: src/titler/unicodedialog.cpp:159
#, kde-format
msgid "En Space (width of an n)"
msgstr "Razmak en (širine slova n)"

