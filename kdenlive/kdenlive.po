#, kde-format
msgid "<b><u>Lightness</u></b> Red"
msgstr "<b><u>Svjetlina</u></b> crvene"

#: data/effects/hsl_range.xml:4
#, kde-format
msgid "HSL Range"
msgstr "HSL raspon"

#: data/effects/hsl_range.xml:5
#, kde-format
msgid ""
"Adjust Hue, Saturation and Lightness for a range of hue values. The user can "
"specify the range of the hue values to be adjusted."
msgstr "Podesite nijansu, zasićenost i svjetlinu za niz vrijednosti nijansi. Korisnik može odrediti raspon vrijednosti nijansi koje treba prilagoditi."

#: data/effects/hsl_range.xml:8
#, kde-format
msgid "Hue Center"
msgstr "Središnja nijansa"

#: data/effects/hsl_range.xml:9
#, kde-format
msgid "The center value for the hue range"
msgstr "Središnja vrijednost raspona nijanse"

#: data/effects/hsl_range.xml:12
#, kde-format
msgid "Hue Range"
msgstr "Raspon nijanse"

#: data/effects/hsl_range.xml:13
#, kde-format
msgid "The width of the hue range"
msgstr "Širina raspona nijanse"

#: data/effects/hsl_range.xml:17
#, kde-format
msgid "The amount to blend the edges of the hue range"
msgstr "Količina stapanja rubova raspona nijanse"

#: data/effects/hsl_range.xml:21
#, kde-format
msgid "The amount to shift the hue in the hue range"
msgstr "Količina pomaka nijanse unutar raspona"

#: data/effects/hsl_range.xml:24
#, kde-format
msgid "Saturation Scale"
msgstr "Mjerilo zasićenosti"

#: data/effects/hsl_range.xml:25
#, kde-format
msgid "The amount to scale the saturation in the hue range"
msgstr "Količina skaliranja zasićenosti unutar raspona nijanse"

#: data/effects/hsl_range.xml:28
#, kde-format
msgid "Lightness Scale"
msgstr "Mjerilo svjetline"

#: data/effects/hsl_range.xml:29
#, kde-format
msgid "The amount to scale the lightness in the hue range"
msgstr "Količina skaliranja svjetline unutar raspona nijanse"

#: data/effects/invert.xml:4
#, kde-format
msgctxt "Invert Effect Name"
msgid "Invert"
msgstr "Obrnuto"

#: data/effects/invert.xml:5
#, kde-format
msgid "Invert colors"
msgstr "Preokreni boje"

#: data/effects/ladspa/ladspa_1185.xml:4
#, kde-format
msgid "Diode Processor"
msgstr "Diodni procesor"

#: data/effects/ladspa/ladspa_1185.xml:6
#, kde-format
msgid ""
"Diode Processor (LADSPA 1185)<br>\n"
"   Mangles the signal as if it had been passed through a diode rectifier "
"network. You should probably follow this with a <i>DC Offset Remover</i>, "
"unless you want the offset."
msgstr "Diodni procesor (LADSPA 1185)<br>\n Ometa signal kao da je prošao kroz mrežu diodnog ispravljača. Vjerojatno biste ovo trebali slijediti s <i>DC Offset Remover</i>, osim ako ne želite pomak."

#: data/effects/ladspa/ladspa_1185.xml:11
#, kde-format
msgid ""
"The <i>Mode</i> parameter is<br>\n"
"      continuously variable from thru to half-wave (1) rectification to full-"
"wave (2) to silence (0)"
msgstr "Parametar <i>Mode</i> je<br>\n kontinuirano varijabilan od preko do poluvala (1) ispravljanja do punog vala (2) do tišine (0)"

