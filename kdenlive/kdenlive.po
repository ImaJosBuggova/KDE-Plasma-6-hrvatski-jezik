#: data/transitions/frei0r/frei0r_color_only.xml:5
#, kde-format
msgid ""
"Perform a conversion to color only of the source input1 using the hue and "
"saturation values of input2."
msgstr "Izvršite pretvorbu samo u boju izvornog ulaza1 koristeći vrijednosti nijanse i zasićenosti ulaza2."

#: data/transitions/frei0r/frei0r_darken.xml:4
#, kde-format
msgid "Darken"
msgstr "potamniti"

#: data/transitions/frei0r/frei0r_darken.xml:5
#, kde-format
msgid ""
"Perform a darken operation between two sources (minimum value of both "
"sources)."
msgstr "Izvršite operaciju zatamnjivanja između dva izvora (minimalna vrijednost oba izvora)."

#: data/transitions/frei0r/frei0r_difference.xml:4
#, kde-format
msgid "Difference"
msgstr "Razlika"

#: data/transitions/frei0r/frei0r_difference.xml:5
#, kde-format
msgid "Perform an RGB[A] difference operation between the pixel sources."
msgstr "Izvršite operaciju RGB[A] razlike između izvora piksela."

#: data/transitions/frei0r/frei0r_divide.xml:4
#, kde-format
msgid "Divide"
msgstr "Podijeli"

#: data/transitions/frei0r/frei0r_divide.xml:5
#, kde-format
msgid ""
"Perform an RGB[A] divide operation between the pixel sources: input1 is the "
"numerator, input2 the denominator."
msgstr "Izvedite RGB[A] operaciju dijeljenja između izvora piksela: input1 je brojnik, input2 nazivnik."

