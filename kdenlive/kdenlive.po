#, kde-format
msgid ""
"side by side parallel,side by side crosseye,above-below left top,above-below "
"right top,interleaved rows (left top),interleaved rows (right top),anaglyph "
"red/blue gray,anaglyph red/green gray,anaglyph red/cyan gray,anaglyph red/"
"cyan half colored,anaglyph red/cyan color,anaglyph red/cyan dubois,anaglyph "
"green/magenta gray,anaglyph green/magenta half colored,anaglyph green/"
"magenta colored,anaglyph green/magenta dubois,anaglyph yellow/blue gray,"
"anaglyph yellow/blue half colored,anaglyph yellow/blue colored,anaglyph "
"yellow/blue dubois,mono output left,mono output right,checkerboard left eye "
"first,checkerboard right eye first,interleaved columns left eye first,"
"interleaved columns right eye first,HDMI frame pack"
msgstr "jedno uz drugo paralelno, jedno uz drugo križno oko, gore-ispod lijevo gore, iznad-ispod desno gore, isprepleteni redovi (lijevo gore), isprepleteni redovi (desno gore), anaglif crveno/plavo sivo, anaglif crveno/zeleno sivo, anaglif crveno/cijan sivo, anaglif crveno/cijan pol u boji, anaglif crvena/cijan boja, anaglif crvena/cijan dubois, anaglif zelena/magenta siva, anaglif zelena/magenta polubojna, anaglif zelena/magenta boja, anaglif zelena/magenta dubois, anaglif žuta/plava siva, anaglif žuta/plava polubojna, anaglif žuta/plava boja, anaglif žuta/plava dubois, mono izlaz lijevo, mono izlaz desno, šahovnica prvo lijevo oko, šahovnica prvo desno oko, isprepleteni stupci prvo lijevo oko, isprepleteni stupci prvo desno oko, paket HDMI okvira"

#: data/effects/avfilter/avfilter_stereotools.xml:4
#, kde-format
msgid "Stereo tools"
msgstr "Stereo alati"

#: data/effects/avfilter/avfilter_stereotools.xml:5
#, kde-format
msgid ""
"This filter has some handy utilities to manage stereo signals, for "
"converting M/S stereo recordings to L/R signal while having control over the "
"parameters or spreading the stereo image of master track. "
msgstr "Ovaj filtar pruža korisne alate za obradu stereo signala, pretvorbu M/S snimki u L/D signal uz kontrolu parametara te proširenje stereo slike glavne staze. "

#: data/effects/avfilter/avfilter_stereotools.xml:8
#, kde-format
msgid "Level IN"
msgstr "Ulazna razina"

#: data/effects/avfilter/avfilter_stereotools.xml:10
#: data/effects/avfilter/avfilter_stereotools.xml:15
#, kde-format
msgid ""
"Set input level before filtering for both channels.\n"
"Allowed range is from 0.015625 to 64."
msgstr "Postavi ulaznu razinu za oba kanala prije filtriranja.\nDopušteni raspon je od 0,015625 do 64."

#: data/effects/avfilter/avfilter_stereotools.xml:13
#, kde-format
msgid "Level OUT"
msgstr "Izlazna razina"

#: data/effects/avfilter/avfilter_stereotools.xml:18
#: data/effects/avfilter/avfilter_stereotools.xml:79
#, kde-format
msgid "Balance IN"
msgstr "Ulazna ravnoteža"

#: data/effects/avfilter/avfilter_stereotools.xml:19
#: data/effects/avfilter/avfilter_stereotools.xml:23
#, kde-format
msgid ""
"Set input balance between both channels. Default is 0. Allowed range is from "
"-1 to 1."
msgstr "Postavi ulaznu ravnotežu kanala. Zadano je 0. Dopušteni raspon je od -1 do 1."

#: data/effects/avfilter/avfilter_stereotools.xml:22
#: data/effects/avfilter/avfilter_stereotools.xml:89
#, kde-format
msgid "Balance OUT"
msgstr "Izlazna ravnoteža"

#: data/effects/avfilter/avfilter_stereotools.xml:26
#, kde-format
msgid "Softclip"
msgstr "Meko odrezivanje"

#: data/effects/avfilter/avfilter_stereotools.xml:27
#, kde-format
msgid ""
"Enable softclipping. Results in analog distortion instead of harsh digital "
"0dB clipping."
msgstr "Omogući meko odrezivanje. Rezultat je analogno izobličenje umjesto grubog digitalnog odrezivanja na 0 dB."

#: data/effects/avfilter/avfilter_stereotools.xml:30
#, kde-format
msgid "Mute Left"
msgstr "Utišaj lijevi kanal"

#: data/effects/avfilter/avfilter_stereotools.xml:33
#, kde-format
msgid "Mute Right"
msgstr "Utišaj desni kanal"

#: data/effects/avfilter/avfilter_stereotools.xml:36
#, kde-format
msgid "Phase Left"
msgstr "Faza lijevog kanala"

#: data/effects/avfilter/avfilter_stereotools.xml:37
#, kde-format
msgid "Change the phase of the left channel."
msgstr "Promijeni fazu lijevog kanala."

#: data/effects/avfilter/avfilter_stereotools.xml:40
#, kde-format
msgid "Phase Right"
msgstr "Faza desnog kanala"

#: data/effects/avfilter/avfilter_stereotools.xml:41
#, kde-format
msgid "Change the phase of the right channel."
msgstr "Promijeni fazu desnog kanala."

#: data/effects/avfilter/avfilter_stereotools.xml:44
#: data/effects/ladspa/ladspa_2153.xml:21
#, kde-format
msgid "Stereo Mode"
msgstr "Stereo način"

#: data/effects/avfilter/avfilter_stereotools.xml:45
#, kde-format
msgid ""
"Left/Right to Left/Right,Left/Right to Mid/Side,Mid/Side to Left/Right,Left/"
"Right to Left/Left,Left/Right to Right/Right,Left/Right to Left + Right,Left/"
"Right to Right/Left,Mid/Side to Left/Left,Mid/Side to Right/Right,Mid/Side "
"to Right/Left,Left/Right to Left - Right"
msgstr "Lijevo/Desno u Lijevo/Desno,Lijevo/Desno u Sredina/Bočno,Sredina/Bočno u Lijevo/Desno,Lijevo/Desno u Lijevo/Lijevo,Lijevo/Desno u Desno/Desno,Lijevo/Desno u Lijevo + Desno,Lijevo/Desno u Desno/Lijevo,Sredina/Bočno u Lijevo/Lijevo,Sredina/Bočno u Desno/Desno,Sredina/Bočno u Desno/Lijevo,Lijevo/Desno u Lijevo − Desno"

#: data/effects/avfilter/avfilter_stereotools.xml:48
#, kde-format
msgid "Side Level"
msgstr "Razina bočnog signala"

#: data/effects/avfilter/avfilter_stereotools.xml:49
#, kde-format
msgid ""
"Set level of side signal. Default is 1. Allowed range is from 0.015625 to 64."
msgstr "Postavi razinu bočnog signala. Zadano je 1. Dopušteni raspon je od 0,015625 do 64."

#: data/effects/avfilter/avfilter_stereotools.xml:52
#, kde-format
msgid "Side Balance"
msgstr "Ravnoteža bočnog signala"

#: data/effects/avfilter/avfilter_stereotools.xml:53
#, kde-format
msgid ""
"Set balance of side signal. Default is 0. Allowed range is from -1 to 1."
msgstr "Postavi ravnotežu bočnog signala. Zadano je 0. Dopušteni raspon je od -1 do 1."

#: data/effects/avfilter/avfilter_stereotools.xml:56
#, kde-format
msgid "Mid Level"
msgstr "Razina srednjeg signala"

#: data/effects/avfilter/avfilter_stereotools.xml:57
#, kde-format
msgid ""
"Set level of the middle signal. Default is 1. Allowed range is from 0.015625 "
"to 64."
msgstr "Postavi razinu srednjeg signala. Zadano je 1. Dopušteni raspon je od 0,015625 do 64."

#: data/effects/avfilter/avfilter_stereotools.xml:60
#, kde-format
msgid "Mid Pan"
msgstr "Srednja posuda"

#: data/effects/avfilter/avfilter_stereotools.xml:61
#, kde-format
msgid "Set middle signal pan. Default is 0. Allowed range is from -1 to 1."
msgstr "Postavi panoramu srednjeg signala. Zadano je 0. Dopušteni raspon je od -1 do 1."

#: data/effects/avfilter/avfilter_stereotools.xml:64
#, kde-format
msgid "Stereo base"
msgstr "Stereo baza"

#: data/effects/avfilter/avfilter_stereotools.xml:65
#, kde-format
msgid ""
"Set stereo base between mono and inverted channels. Default is 0. Allowed "
"range is from -1 to 1."
msgstr "Postavi stereo bazu između mono i obrnutih kanala. Zadano je 0. Dopušteni raspon je od -1 do 1."

#: data/effects/avfilter/avfilter_stereotools.xml:69
#, kde-format
msgid ""
"Set delay in milliseconds how much to delay left from right channel and vice "
"versa. Default is 0. Allowed range is from -20 to 20."
msgstr "Postavi odgodu u milisekundama lijevog kanala u odnosu na desni i obrnuto. Zadano je 0. Dopušteni raspon je od −20 do 20."

#: data/effects/avfilter/avfilter_stereotools.xml:72
#, kde-format
msgid "S/C level"
msgstr "Razina S/C"

#: data/effects/avfilter/avfilter_stereotools.xml:75
#, kde-format
msgid "Stereo phase"
msgstr "Stereo faza"

#: data/effects/avfilter/avfilter_stereotools.xml:76
#, kde-format
msgid "Set the stereo phase in degrees."
msgstr "Postavi stereo fazu u stupnjevima."

#: data/effects/avfilter/avfilter_stereotools.xml:85
#: data/effects/avfilter/avfilter_stereotools.xml:95
#, kde-format
msgid ""
"‘balance’\n"
"Classic balance mode. Attenuate one channel at a time. Gain is raised up to "
"1.\n"
"‘amplitude’\n"
"Similar to classic mode above but gain is raised up to 2.\n"
"‘power’\n"
"Equal power distribution, from -6dB to +6dB range."
msgstr "‘balance’\nKlasični način ravnoteže. Prigušuje jedan kanal odjednom. Pojačanje se povećava do 1.\n‘amplitude’\nSlično klasičnom načinu, ali pojačanje se povećava do 2.\n‘power’\nRavnomjerna raspodjela snage u rasponu od −6 dB do +6 dB."

#: data/effects/avfilter/avfilter_stereotools.xml:86
#: data/effects/avfilter/avfilter_stereotools.xml:96
#, kde-format
msgid "balance,amplitude,power"
msgstr "balans, amplituda, snaga"

#: data/effects/avfilter/avfilter_stereowiden.xml:4
#, kde-format
msgid "Stereo widener"
msgstr "Proširenje stereo slike"

#: data/effects/avfilter/avfilter_stereowiden.xml:5
#, kde-format
msgid ""
"This filter enhance the stereo effect by suppressing signal common to both "
"channels and by delaying the signal of left into right and vice versa, "
"thereby widening the stereo effect."
msgstr "Ovaj filtar pojačava stereo efekt suzbijanjem zajedničkog signala obaju kanala i odgađanjem lijevog signala u desni i obrnuto, čime proširuje stereo sliku."

#: data/effects/avfilter/avfilter_stereowiden.xml:9
#, kde-format
msgid ""
"Time in milliseconds of the delay of left signal into right and vice versa."
msgstr "Vrijeme odgode u milisekundama pri prijenosu lijevog signala u desni i obrnuto."

#: data/effects/avfilter/avfilter_stereowiden.xml:12
#, kde-format
msgid "Feedback Gain"
msgstr "Pojačanje povratne veze"

#: data/effects/avfilter/avfilter_stereowiden.xml:14
#, kde-format
msgid ""
"Amount of gain in delayed signal into right and vice versa.\n"
"Gives a delay effect of left signal in right output and vice versa which "
"gives widening effect."
msgstr "Količina pojačanja odgođenog signala koji se šalje u desni kanal i obrnuto.\nStvara efekt odgode lijevog signala u desnom izlazu i obrnuto te proširuje stereo sliku."

#: data/effects/avfilter/avfilter_stereowiden.xml:17
#, kde-format
msgid "Cross feed"
msgstr "Unakrsno propuštanje"

#: data/effects/avfilter/avfilter_stereowiden.xml:19
#, kde-format
msgid ""
"Cross feed of left into right with inverted phase. This helps in suppressing "
"the mono.\n"
"If the value is 1 it will cancel all the signal common to both channels. "
