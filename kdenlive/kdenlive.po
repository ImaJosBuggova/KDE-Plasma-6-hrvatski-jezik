#: data/effects/gpstext.xml:28
#, kde-format
msgid ""
"If the video file is a timelapse<br>\n"
"        (or slow motion), use this value to set the speed up/slow down ratio."
"<br>\n"
"        Sample values: 30 for 30x timelapse, 0.25 for 4x slow motion footage."
msgstr "Ako je videodatoteka timelapse<br>\n (ili usporena snimka), upotrijebite ovu vrijednost za postavljanje omjera ubrzanja/usporenja.<br>\n Uzorak vrijednosti: 30 za 30x timelapse, 0,25 za 4x usporene snimke."

