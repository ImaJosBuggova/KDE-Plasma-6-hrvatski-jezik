#: data/effects/ladspa/ladspa_1190.xml:5
#, kde-format
msgid "Comb Filter (LADSPA 1190)"
msgstr "Češljasti filtar (LADSPA 1190)"

#: data/effects/ladspa/ladspa_1190.xml:8 data/effects/ladspa/ladspa_1411.xml:9
#, kde-format
msgid "Band Separation"
msgstr "Razdvajanje pojaseva"

#: data/effects/ladspa/ladspa_1190.xml:9
#, kde-format
msgid "Controls the distance between the filters peaks"
msgstr "Upravlja udaljenošću između vrhova filtra"

#: data/effects/ladspa/ladspa_1190.xml:12
#: data/effects/ladspa/ladspa_1191.xml:24
#: data/effects/ladspa/ladspa_1192.xml:12
#: data/effects/ladspa/ladspa_1219.xml:17
#: data/effects/ladspa/ladspa_1402.xml:17
#: data/effects/ladspa/ladspa_1438.xml:22
#: data/effects/ladspa/ladspa_phaser.xml:14
#, kde-format
msgid "Feedback"
msgstr "Odaziv"

#: data/effects/ladspa/ladspa_1190.xml:13
#, kde-format
msgid "Feedback level, increases the distinctive wooshy phaser sound."
msgstr "Razina povratne veze koja pojačava karakteristični zvuk fazera."

#: data/effects/ladspa/ladspa_1191.xml:6
#, kde-format
msgid ""
"Flanger (LADSPA 1191)<br>\n"
"   A digital flanger implementation. Uses a novel zero excursion, controlled "
"bandwidth modulation function, which should make the modulation less "
"repetitive and noticeable."
msgstr "Flanger (LADSPA 1191)<br>\n Digitalna implementacija flangera. Koristi novu nultu ekskurziju, kontroliranu funkciju modulacije širine pojasa, koja bi trebala učiniti modulaciju manje ponavljajućom i primjetnom."

#: data/effects/ladspa/ladspa_1191.xml:9
#, kde-format
msgid "Delay Base"
msgstr "Osnova odgode"

#: data/effects/ladspa/ladspa_1191.xml:11
#, kde-format
msgid ""
"This is the offset from<br>\n"
"      the input time that the detune delay moves around"
msgstr "Pomak u odnosu na<br>\n      ulazno vrijeme oko kojeg se kreće odgoda raštimavanja"

#: data/effects/ladspa/ladspa_1191.xml:14
#, kde-format
msgid "Max Slowdown"
msgstr "Maksimalno usporavanje"

#: data/effects/ladspa/ladspa_1191.xml:16
#, kde-format
msgid ""
"This is the maximum<br>\n"
"      delay that will be applied to the delayed signal, relative to the dry "
"signal."
msgstr "Ovo je maksimalno<br>\n kašnjenje koje će se primijeniti na odgođeni signal, u odnosu na suhi signal."

#: data/effects/ladspa/ladspa_1191.xml:19
#, kde-format
msgid "LFO Frequency"
msgstr "Frekvencija LFO-a"

#: data/effects/ladspa/ladspa_1191.xml:21
#, kde-format
msgid ""
"This is the core frequency<br>\n"
"      that the 'LFO' will move at. The LFO isn't actually an oscillator, but "
"it does vary periodically."
msgstr "Ovo je osnovna frekvencija<br>\n na kojoj će se kretati 'LFO'. LFO zapravo nije oscilator, ali povremeno varira."

#: data/effects/ladspa/ladspa_1191.xml:26
#, kde-format
msgid ""
"Feedback applied from the<br>\n"
"      output to the input, increases the depth of the effect, but makes it "
"sound less like a real flanger."
msgstr "Povratna veza primijenjena s<br>\n izlaza na ulaz, povećava dubinu efekta, ali čini da zvuči manje kao pravi flanger."

#: data/effects/ladspa/ladspa_1192.xml:4
#, kde-format
msgid "Fractionally Addressed Delay Line"
msgstr "Linija odgode s razlomljenim adresiranjem"

#: data/effects/ladspa/ladspa_1192.xml:6
#, kde-format
msgid ""
"Fractionally Addressed Delay Line (LADSPA 1192)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr "Frakcijsko adresirana linija kašnjenja (LADSPA 1192)<br>\n Automatski se prilagođava broju kanala i brzini uzorkovanja potrošača."

#: data/effects/ladspa/ladspa_1195.xml:4 data/effects/ladspa/ladspa_declipper.xml:4
#, kde-format
msgid "Declipper"
msgstr "Odsjecanje (Declipper)"

#: data/effects/ladspa/ladspa_1195.xml:6
#, kde-format
msgid ""
"Declipper (LADSPA 1195)<br>\n"
"   Removes nasty clicks from input signals, not very kind to them though."
msgstr "Uklanjanje odrezivanja (LADSPA 1195)<br>\n   Uklanja neugodne klikove iz ulaznih signala, ali ih pritom može oštetiti."

#: data/effects/ladspa/ladspa_1196.xml:4
#, kde-format
msgid "Fast Overdrive"
msgstr "Brzo overdrive izobličenje"

#: data/effects/ladspa/ladspa_1196.xml:6
#, kde-format
msgid ""
"Fast Overdrive (LADSPA 1196)<br>\n"
"   A simple overdrive. Compresses the extreme peaks to make a sound similar "
"to an overdriven amplifier."
msgstr "Fast Overdrive (LADSPA 1196)<br>\n Jednostavan overdrive. Komprimira ekstremne vršne vrijednosti kako bi dobio zvuk sličan pretjeranom pojačalu."

#: data/effects/ladspa/ladspa_1196.xml:9
#, kde-format
msgid "Drive Level"
msgstr "Razina izobličenja"

#: data/effects/ladspa/ladspa_1196.xml:11
#, kde-format
msgid ""
"Controls the point at<br>\n"
"      which the signal starts to distort, and the degree of distortion."
msgstr "Upravlja točkom u kojoj<br>\n      signal počinje izobličavati i stupnjem izobličenja."

#: data/effects/ladspa/ladspa_1202.xml:4
#, kde-format
msgid "Decimator"
msgstr "Decimator"

#: data/effects/ladspa/ladspa_1202.xml:6
#, kde-format
msgid ""
"Decimator (LADSPA 1202)<br>\n"
"   Decimates (reduces the effective sample rate), and reduces the bit depth "
"of the input signal, allows non integer values for smooth transitions "
"between clean and lo-fi signals."
msgstr "Decimator (LADSPA 1202)<br>\n Decimara (smanjuje efektivnu stopu uzorkovanja) i smanjuje dubinu bita ulaznog signala, dopušta necijele vrijednosti za glatke prijelaze između čistih i lo-fi signala."

#: data/effects/ladspa/ladspa_1202.xml:9
#, kde-format
msgid "Bit Depth"
msgstr "Dubina bita"

#: data/effects/ladspa/ladspa_1202.xml:10
#, kde-format
msgid "The bit depth that the signal will be reduced to"
msgstr "Dubina bita na koju će se signal smanjiti"

#: data/effects/ladspa/ladspa_1202.xml:13
#, kde-format
msgid "Sample Rate"
msgstr "Frekvencija uzorkovanja"

#: data/effects/ladspa/ladspa_1202.xml:14
#, kde-format
msgid "The sample rate that the signal will be resampled at"
msgstr "Frekvencija uzorkovanja na koju će se signal ponovno uzorkovati"

#: data/effects/ladspa/ladspa_1203.xml:4
#, kde-format
msgid "Single Band Parametric"
msgstr "Jednopojasni parametarski filtar"

#: data/effects/ladspa/ladspa_1203.xml:6
#, kde-format
msgid ""
"Single Band Parametric (LADSPA 1203)<br>\n"
"   A single band of a parametric filter."
msgstr "Jednopojasni parametarski filtar (LADSPA 1203)<br>\n   Jedan pojas parametarskog filtra."

#: data/effects/ladspa/ladspa_1203.xml:9
#, kde-format
msgid "Gain (dB)"
msgstr "Pojačanje (dB)"

#: data/effects/ladspa/ladspa_1203.xml:10
#, kde-format
msgid "The attenuation/gain of the eq"
msgstr "Prigušenje/pojačanje ekvilizatora"

#: data/effects/ladspa/ladspa_1203.xml:13
#, kde-format
msgid "Frequency (Hz)"
msgstr "Frekvencija (Hz)"

#: data/effects/ladspa/ladspa_1203.xml:15
#, kde-format
msgid ""
"The centre frequency (i.e. point of<br>\n"
"      most/least attenuation). Beware of high values for <i>Frequency</i> "
"and <i>Bandwidth</i>: if the high pitch (<i>Frequency</i> * 2^<i>Bandwidth</"
"i>) goes over half the sample rate, you will get aliasing."
msgstr "Središnja frekvencija (tj. točka<br>\n najvećeg/najmanjeg prigušenja). Čuvajte se visokih vrijednosti za <i>Frekvenciju</i> i <i>Bandwidth</i>: ako visoki ton (<i>Frequency</i> * 2^<i>Bandwidth</i>) prijeđe polovicu brzine uzorkovanja, dobit ćete aliasing."

#: data/effects/ladspa/ladspa_1203.xml:18
#, kde-format
msgid "Bandwidth (octaves)"
msgstr "Širina pojasa (oktave)"

#: data/effects/ladspa/ladspa_1203.xml:20
#, kde-format
msgid ""
"The pitch difference from the<br>\n"
"      centre before the attenuation has reached half the <i>Gain</i>."
msgstr "Razlika visine tona od<br>\n      središta pri kojoj prigušenje doseže polovicu <i>pojačanja</i>."

#: data/effects/ladspa/ladspa_1207.xml:4
#, kde-format
msgid "DC Offset Remover"
msgstr "Uklanjanje DC pomaka"

#: data/effects/ladspa/ladspa_1207.xml:6
#, kde-format
msgid ""
"DC Offset Remover (LADSPA 1207)<br>\n"
"   Simply removes the DC (0 Hz) component from an audio signal, uses a high "
"pass filter, so has some side effects, but they should be minimal."
msgstr "DC Offset Remover (LADSPA 1207)<br>\n Jednostavno uklanja DC (0 Hz) komponentu iz audio signala, koristi visokopropusni filtar, pa ima neke nuspojave, ali one bi trebale biti minimalne."

#: data/effects/ladspa/ladspa_1213.xml:4
#, kde-format
msgid "Foldover Distortion"
msgstr "Izobličenje preklapanjem"

#: data/effects/ladspa/ladspa_1213.xml:6
#, kde-format
msgid ""
"Foldover Distortion (LADSPA 1213)<br>\n"
"   Uses a sine wave approximation to simulate valve style foldover "
"distortion. Probably should have a <i>DC Offset Remover</i> on the output, "
"but it's not always necessary."
msgstr "Preklopna distorzija (LADSPA 1213)<br>\n Koristi aproksimaciju sinusnog vala za simulaciju preklopne distorzije u stilu ventila. Vjerojatno bi trebao imati <i>DC Offset Remover</i> na izlazu, ali nije uvijek potreban."

#: data/effects/ladspa/ladspa_1213.xml:9 data/effects/ladspa/ladspa_2158.xml:9
#, kde-format
msgid "Drive"
msgstr "Zasićenje"

#: data/effects/ladspa/ladspa_1213.xml:10
#, kde-format
msgid "Controls the degree of distortion"
msgstr "Upravlja stupnjem izobličenja"

#: data/effects/ladspa/ladspa_1213.xml:13
#, kde-format
msgid "Skew"
msgstr "Iskrivi"

#: data/effects/ladspa/ladspa_1213.xml:14
#, kde-format
msgid "Controls the asymmetry of the waveform"
msgstr "Upravlja asimetrijom valnog oblika"

#: data/effects/ladspa/ladspa_1218.xml:4
#, kde-format
msgid "4x4 Pole Allpass"
msgstr "Svepropusni filtar s 4x4 polova"

#: data/effects/ladspa/ladspa_1218.xml:6
#, kde-format
msgid ""
"4x4 Pole Allpass (LADSPA 1218)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"consumer."
msgstr "4x4 Pole Allpass (LADSPA 1218)<br>\n Automatski se prilagođava broju kanala i brzini uzorkovanja potrošača."

#: data/effects/ladspa/ladspa_1218.xml:9
#, kde-format
msgid "Frequency 1"
msgstr "Frekvencija 1"

#: data/effects/ladspa/ladspa_1218.xml:12
#, kde-format
msgid "Feedback 1"
msgstr "Povratna veza 1"

#: data/effects/ladspa/ladspa_1218.xml:15
#, kde-format
msgid "Frequency 2"
msgstr "Frekvencija 2"

#: data/effects/ladspa/ladspa_1218.xml:18
#, kde-format
msgid "Feedback 2"
msgstr "Povratna veza 2"

#: data/effects/ladspa/ladspa_1218.xml:21
#, kde-format
msgid "Frequency 3"
msgstr "Frekvencija 3"

#: data/effects/ladspa/ladspa_1218.xml:24
#, kde-format
msgid "Feedback 3"
msgstr "Povratna veza 3"

#: data/effects/ladspa/ladspa_1218.xml:27
#, kde-format
msgid "Frequency 4"
msgstr "Frekvencija 4"

#: data/effects/ladspa/ladspa_1218.xml:30
#, kde-format
msgid "Feedback 4"
msgstr "Povratna veza 4"

#: data/effects/ladspa/ladspa_1219.xml:4
#, kde-format
msgid "Auto Phaser"
msgstr "Automatski fazer"

#: data/effects/ladspa/ladspa_1219.xml:5
#, kde-format
msgid "Auto Phaser (LADSPA 1219)"
msgstr "Automatski fazer (LADSPA 1219)"

#: data/effects/ladspa/ladspa_1219.xml:8
#, kde-format
msgid "Attack Time"
msgstr "Vrijeme napada"

#: data/effects/ladspa/ladspa_1219.xml:11
#: data/effects/ladspa/ladspa_1886.xml:8 data/effects/ladspa/ladspa_1887.xml:18
#: data/effects/ladspa/ladspa_1888.xml:18
#: data/effects/ladspa/ladspa_1889.xml:18
#: data/effects/ladspa/ladspa_1895.xml:15
#: data/effects/ladspa/ladspa_1896.xml:15
#: data/effects/ladspa/ladspa_1897.xml:15
#, kde-format
msgid "Decay Time"
msgstr "Vrijeme opadanja"

#: data/effects/ladspa/ladspa_1219.xml:14
#, kde-format
msgid "Modulation Depth"
msgstr "Dubina modulacije"

#: data/effects/ladspa/ladspa_1219.xml:20
#, kde-format
msgid "Spread (octaves)"
msgstr "Raspon (oktave)"

#: data/effects/ladspa/ladspa_1402.xml:4
#, kde-format
msgid "Delayorama"
msgstr "Delayorama"

#: data/effects/ladspa/ladspa_1402.xml:5
#, kde-format
msgid "Delayorama (LADSPA 1402)"
msgstr "Delayorama (LADSPA 1402)"

#: data/effects/ladspa/ladspa_1402.xml:10
#, kde-format
msgid ""
"Controls the random numbers that<br>\n"
"      will be used to stagger the delays and amplitudes if random is turned "
"up on them. Changing this forces the random values to be recalculated."
msgstr "Kontrolira nasumične brojeve koji<br>\n će se koristiti za raspoređivanje kašnjenja i amplituda ako se na njima pojavi slučajni broj. Promjena ovoga prisiljava na ponovno izračunavanje slučajnih vrijednosti."

#: data/effects/ladspa/ladspa_1402.xml:14
#, kde-format
msgid "Controls the gain of the input signal"
msgstr "Upravlja pojačanjem ulaznog signala"

#: data/effects/ladspa/ladspa_1402.xml:18
#, kde-format
msgid "Controls the amount of output signal fed back into the input"
msgstr "Upravlja količinom izlaznog signala vraćenog na ulaz"

#: data/effects/ladspa/ladspa_1402.xml:21
#, kde-format
msgid "Number of Taps"
msgstr "Broj odvojaka"

#: data/effects/ladspa/ladspa_1402.xml:22
#, kde-format
msgid "Controls the number of taps in the delay"
msgstr "Upravlja brojem odvojaka u odgodi"

#: data/effects/ladspa/ladspa_1402.xml:25
#, kde-format
msgid "First Delay"
msgstr "Prva odgoda"

#: data/effects/ladspa/ladspa_1402.xml:26
#, kde-format
msgid "The time of the first delay"
msgstr "Trajanje prve odgode"

#: data/effects/ladspa/ladspa_1402.xml:29
#, kde-format
msgid "Delay Range"
msgstr "Raspon odgode"

#: data/effects/ladspa/ladspa_1402.xml:30
#, kde-format
msgid "The time difference between the first and last delay"
msgstr "Vremenska razlika između prve i posljednje odgode"

#: data/effects/ladspa/ladspa_1402.xml:33
#, kde-format
msgid "Delay Change"
msgstr "Promjena odgode"

#: data/effects/ladspa/ladspa_1402.xml:34
#, kde-format
msgid "The scaling factor between one delay and the next"
msgstr "Faktor skaliranja između dviju uzastopnih odgoda"

#: data/effects/ladspa/ladspa_1402.xml:37
#, kde-format
