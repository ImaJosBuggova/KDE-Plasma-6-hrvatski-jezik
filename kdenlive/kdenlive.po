msgstr "Nasumičnost odgode"

#: data/effects/ladspa/ladspa_1402.xml:38
#, kde-format
msgid "The random factor applied to the delay"
msgstr "Nasumični faktor primijenjen na odgodu"

#: data/effects/ladspa/ladspa_1402.xml:41
#, kde-format
msgid "Amplitude Change"
msgstr "Promjena amplitude"

#: data/effects/ladspa/ladspa_1402.xml:42
#, kde-format
msgid "The scaling factor between one amplitude and the next"
msgstr "Faktor skaliranja između uzastopnih amplituda"

#: data/effects/ladspa/ladspa_1402.xml:45
#, kde-format
msgid "Amplitude Random"
msgstr "Nasumičnost amplitude"

#: data/effects/ladspa/ladspa_1402.xml:46
#, kde-format
msgid "The random factor applied to the amplitude"
msgstr "Nasumični faktor primijenjen na amplitudu"

#: data/effects/ladspa/ladspa_1402.xml:49
#, kde-format
msgid "Dry/Wet Mix"
msgstr "Omjer neobrađenog/obrađenog signala"

#: data/effects/ladspa/ladspa_1402.xml:50
#, kde-format
msgid "The level of delayed sound mixed into the output"
msgstr "Razina odgođenog zvuka pomiješanog u izlazni signal"

#: data/effects/ladspa/ladspa_1403.xml:4
#, kde-format
msgid "Dyson Compressor"
msgstr "Dysonov kompresor"

#: data/effects/ladspa/ladspa_1403.xml:5
#, kde-format
msgid "Dyson Compressor (LADSPA 1403)"
msgstr "Dysonov kompresor (LADSPA 1403)"

#: data/effects/ladspa/ladspa_1403.xml:8
#, kde-format
msgid "Peak Limit"
msgstr "Ograničenje vršne razine"

#: data/effects/ladspa/ladspa_1403.xml:10
#, kde-format
msgid ""
"Controls the desired limit<br>\n"
"      of the output signal"
msgstr "Upravlja željenim ograničenjem<br>\n      izlaznog signala"

#: data/effects/ladspa/ladspa_1403.xml:13
#: data/effects/ladspa/ladspa_1913.xml:19
#, kde-format
msgid "Release Time"
msgstr "Vrijeme izdanja"

#: data/effects/ladspa/ladspa_1403.xml:15
#, kde-format
msgid ""
"Controls the time taken for<br>\n"
"      the compressor to relax its gain control over the input signal"
msgstr "Upravlja vremenom potrebnim<br>\n      da kompresor otpusti kontrolu pojačanja ulaznog signala"

#: data/effects/ladspa/ladspa_1403.xml:18
#, kde-format
msgid "Fast Compression Ratio"
msgstr "Omjer brze kompresije"

#: data/effects/ladspa/ladspa_1403.xml:21
#, kde-format
msgid "Compression Ratio"
msgstr "Omjer kompresije"

#: data/effects/ladspa/ladspa_1404.xml:4
#, kde-format
msgid "Crossover Distortion"
msgstr "Izobličenje prijelaza"

#: data/effects/ladspa/ladspa_1404.xml:6
#, kde-format
msgid ""
"Crossover Distortion (LADSPA 1404)<br>\n"
"   This is a simulation of the distortion that happens in class B and AB "
"power amps when the signal crosses 0."
msgstr "Crossover izobličenje (LADSPA 1404)<br>\n Ovo je simulacija izobličenja koje se događa u pojačalima snage klase B i AB kada signal prijeđe 0."

#: data/effects/ladspa/ladspa_1404.xml:9
#, kde-format
msgid "Crossover Amplitude"
msgstr "Amplituda prijelaza"

#: data/effects/ladspa/ladspa_1404.xml:10
#, kde-format
msgid "Controls the point at which the output signal becomes linear"
msgstr "Upravlja točkom u kojoj izlazni signal postaje linearan"

#: data/effects/ladspa/ladspa_1404.xml:14
#, kde-format
msgid "Controls degree of smoothing of the crossover point"
msgstr "Upravlja stupnjem zaglađivanja prijelazne točke"

#: data/effects/ladspa/ladspa_1407.xml:4
#, kde-format
msgid "Aliasing"
msgstr "Aliasing"

#: data/effects/ladspa/ladspa_1407.xml:6
#, kde-format
msgid ""
"Aliasing (LADSPA 1407)<br>\n"
"   Simulates aliasing using nyquist frequency modulation. Produces wacky "
"results if the blocks aren't even numbers of samples long."
msgstr "Aliasing (LADSPA 1407)<br>\n Simulira aliasing pomoću nyquista frekvencijska modulacija. Daje otkačene rezultate ako blokovi nemaju jednake brojeve uzoraka."

#: data/effects/ladspa/ladspa_1407.xml:9
#, kde-format
msgid "Aliasing Level"
msgstr "Razina aliasinga"

#: data/effects/ladspa/ladspa_1407.xml:10
#, kde-format
msgid "Controls the amount of simulated aliasing in the output."
msgstr "Upravlja količinom simuliranog aliasinga na izlazu."

#: data/effects/ladspa/ladspa_1408.xml:4
#, kde-format
msgid "Barry's Satan Maximiser"
msgstr "Barryjev Satanov maksimizator"

#: data/effects/ladspa/ladspa_1408.xml:6
#, kde-format
msgid ""
"Barry's Satan Maximiser (LADSPA 1408)<br>\n"
"   Compresses signals with a stupidly short attack and decay, infinite ratio "
"and hard knee. Not really as a compressor, but good harsh (non-musical) "
"distortion."
msgstr "Barry's Satan Maximiser (LADSPA 1408)<br>\n Sažima signale s glupo kratkim napadom i opadanjem, beskonačnim omjerom i tvrdim koljenom. Ne baš kao kompresor, ali dobra gruba (ne-glazbena) distorzija."

#: data/effects/ladspa/ladspa_1408.xml:9
#, kde-format
msgid "Decay Time (samples)"
msgstr "Vrijeme opadanja (uzorci)"

#: data/effects/ladspa/ladspa_1408.xml:10
#, kde-format
msgid "Controls the envelope decay time."
msgstr "Upravlja vremenom opadanja ovojnice."

#: data/effects/ladspa/ladspa_1408.xml:13
#, kde-format
msgid "Knee Point"
msgstr "Prijelomna točka"

#: data/effects/ladspa/ladspa_1408.xml:15
#, kde-format
msgid ""
"Controls the knee roll-off point,<br>\n"
"      ie. the point above which the compression kicks in. 0 will have no "
"effect, -90 will remove virtually all dynamic range."
msgstr "Kontrolira točku otkotrljanja koljena,<br>\n tj. točka iznad koje počinje kompresija. 0 neće imati učinka, -90 će ukloniti gotovo sav dinamički raspon."

#: data/effects/ladspa/ladspa_1410.xml:4
#, kde-format
msgid "Gate"
msgstr "Vrata"

#: data/effects/ladspa/ladspa_1410.xml:5
#, kde-format
msgid "Gate (LADSPA 1410)"
msgstr "Vrata (LADSPA 1410)"

#: data/effects/ladspa/ladspa_1410.xml:8
#, kde-format
msgid "LF Key Filter"
msgstr "Niskofrekvencijski filtar ključa"

#: data/effects/ladspa/ladspa_1410.xml:10
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the low frequency filter (highpass)"
msgstr "Upravlja graničnom frekvencijom<br>\n      niskofrekvencijskog filtra (visokopropusnog)"

#: data/effects/ladspa/ladspa_1410.xml:13
#, kde-format
msgid "HF Key Filter"
msgstr "Visokofrekvencijski filtar ključa"

#: data/effects/ladspa/ladspa_1410.xml:15
#, kde-format
msgid ""
"Controls the cutoff of<br>\n"
"      the high frequency filter (lowpass)"
msgstr "Upravlja graničnom frekvencijom<br>\n      visokofrekvencijskog filtra (niskopropusnog)"

#: data/effects/ladspa/ladspa_1410.xml:20
#, kde-format
msgid ""
"Controls the level at<br>\n"
"      which the gate will open"
msgstr "Upravlja razinom pri kojoj<br>\n      se vrata otvaraju"

#: data/effects/ladspa/ladspa_1410.xml:25
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to open fully"
msgstr "Upravlja vremenom potrebnim<br>\n      za potpuno otvaranje vrata"

#: data/effects/ladspa/ladspa_1410.xml:28
#, kde-format
msgid "Hold"
msgstr "Zadržavanje"

#: data/effects/ladspa/ladspa_1410.xml:30
#, kde-format
msgid ""
"Controls the minimum<br>\n"
"      time the gate will stay open for"
msgstr "Upravlja minimalnim<br>\n      trajanjem otvorenih vrata"

#: data/effects/ladspa/ladspa_1410.xml:35
#, kde-format
msgid ""
"Controls the time the<br>\n"
"      gate will take to close fully"
msgstr "Upravlja vremenom potrebnim<br>\n      za potpuno zatvaranje vrata"

#: data/effects/ladspa/ladspa_1410.xml:40
#, kde-format
msgid ""
"Controls the difference<br>\n"
"      between the gate's open and closed state"
msgstr "Upravlja razlikom<br>\n      između otvorenog i zatvorenog stanja vrata"

#: data/effects/ladspa/ladspa_1410.xml:43
#, kde-format
msgid "Output Monitor"
msgstr "Nadzor izlaza"

#: data/effects/ladspa/ladspa_1410.xml:44
#, kde-format
msgid "Controls output monitor"
msgstr "Upravlja nadzorom izlaza"

#: data/effects/ladspa/ladspa_1410.xml:45
#, kde-format
msgid "Key (listen),Gate (normal output),Bypass"
msgstr "Ključ (slušanje),Vrata (normalni izlaz),Zaobiđi"

#: data/effects/ladspa/ladspa_1411.xml:4
#, kde-format
msgid "Comb Splitter"
msgstr "Razdjelnik češljastog filtra"

#: data/effects/ladspa/ladspa_1411.xml:6
#, kde-format
msgid ""
"Comb Splitter (LADSPA 1411)<br>\n"
"   Divides the input up into two parts with frequency peaks at f Hz "
"intervals, skewed by f/2 Hz between the two outputs. Mixing the two outputs "
"will get you exactly the input signal."
msgstr "Comb Splitter (LADSPA 1411)<br>\n Dijeli ulaz u dva dijela s vršnim frekvencijama u intervalima od f Hz, iskrivljenim za f/2 Hz između dva izlaza. Miješanjem dvaju izlaza dobit ćete upravo ulazni signal."

#: data/effects/ladspa/ladspa_1411.xml:10
#, kde-format
msgid "The distance between the frequency peaks"
msgstr "Udaljenost između frekvencijskih vrhova"

#: data/effects/ladspa/ladspa_1415.xml:4
#, kde-format
msgid "FM Oscillator"
msgstr "FM oscilator"

#: data/effects/ladspa/ladspa_1415.xml:5
#, kde-format
msgid "FM Oscillator (LADSPA 1415)"
msgstr "FM oscilator (LADSPA 1415)"

#: data/effects/ladspa/ladspa_1415.xml:8 src/scopes/scopemanager.cpp:275
#, kde-format
msgid "Waveform"
msgstr "Valni oblik"

#: data/effects/ladspa/ladspa_1415.xml:9
#, kde-format
msgid "The shape of the waveform"
msgstr "Oblik valnog oblika"

#: data/effects/ladspa/ladspa_1415.xml:10
#, kde-format
msgid "Sine,Triangle,Square,Saw"
msgstr "Sinus,Trokut,Kvadrat,Pila"

#: data/effects/ladspa/ladspa_1423.xml:4
#, kde-format
msgid "SWH Plate Reverb"
msgstr "SWH pločasti reverb"

#: data/effects/ladspa/ladspa_1423.xml:6
#, kde-format
msgid ""
"SWH Plate Reverb (LADSPA 1423)<br>\n"
"   Automatically adapts to the number of channels and sampling rate of the "
"audio stream"
msgstr "SWH Plate Reverb (LADSPA 1423)<br>\n Automatski se prilagođava broju kanala i brzini uzorkovanja audio streama"

#: data/effects/ladspa/ladspa_1423.xml:9
#, kde-format
msgid "Reverb Time"
msgstr "Vrijeme reverberacije"

#: data/effects/ladspa/ladspa_1423.xml:12
#: data/effects/ladspa/ladspa_reverb.xml:11
#: data/effects/ladspa/ladspa_room_reverb.xml:14
#, kde-format
msgid "Damping"
msgstr "Prigušenje"

#: data/effects/ladspa/ladspa_1423.xml:15
#, kde-format
msgid "Dry/wet mix"
msgstr "Omjer neobrađenog/obrađenog signala"

#: data/effects/ladspa/ladspa_1430.xml:4
#, kde-format
msgid "Chebyshev Distortion"
msgstr "Čebiševljevo izobličenje"

#: data/effects/ladspa/ladspa_1430.xml:6
#, kde-format
msgid ""
"Chebyshev Distortion (LADSPA 1430)<br>\n"
"   This effect is seeded from incoming signal envelope. As the level of the "
"signal rises more and more harmonics will for added to the output signal. "
"The distortion control sets the sensitivity of the input."
msgstr "Chebyshev distorzija (LADSPA 1430)<br>\n Ovaj se efekt postavlja iz dolaznog signala omotnica. Kako razina signala raste, izlaznom signalu će se dodati sve više i više harmonika. Kontrola izobličenja postavlja osjetljivost ulaza."

#: data/effects/ladspa/ladspa_1430.xml:9
#, kde-format
msgid "Distortion"
msgstr "Izobličenje"

#: data/effects/ladspa/ladspa_1430.xml:10
#, kde-format
msgid "Sets the sensitivity of the input"
msgstr "Postavlja osjetljivost ulaza"

#: data/effects/ladspa/ladspa_1431.xml:4
#, kde-format
msgid "Bode Frequency Shifter"
msgstr "Bodeov pomak frekvencije"

#: data/effects/ladspa/ladspa_1431.xml:6
#, kde-format
msgid ""
"<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr "<b>Bode Frequency Shifter</b> (LADSPA 1431)<br>\n Bode/Moog Frequency Shifter popularan je analogni sintetički modul koji radi pomicanjem svih frekvencija ulaznog signala gore ili dolje za određenu frekvenciju. Ovaj se učinak pomiče u oba smjera u isto vrijeme jer gotovo da i nije dodatni posao i često je korisno imati oba smjera. Za razliku od analognog Bode/Mooga, koji kao jezgru koriste Dome filtre, on koristi Hilbertov transformator, koji je puno jednostavniji za implementaciju u digitalnim sustavima."

#: data/effects/ladspa/ladspa_1431.xml:9
#, kde-format
msgid "Frequency Shift"
msgstr "Pomak frekvencije"

#: data/effects/ladspa/ladspa_1431.xml:10
#: data/effects/ladspa/ladspa_1432.xml:20
#, kde-format
msgid "Controls the frequency shift applied to the input signal"
msgstr "Upravlja pomakom frekvencije koji se primjenjuje na ulazni signal"

#: data/effects/ladspa/ladspa_1432.xml:4
#, kde-format
msgid "Bode Frequency Shifter (CV)"
msgstr "Bodeov pomak frekvencije (CV)"

#: data/effects/ladspa/ladspa_1432.xml:6
#, kde-format
msgid ""
"<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n"
"   A Bode/Moog Frequency Shifter is a popular analogue synth module that "
"works by shifting all the frequencies of an input signal up or down by a "
"specified frequency. This effect shifts in both directions at the same time "
"as it is almost no extra work and is often useful to have both directions. "
"In contrast to the analogue Bode/Moog, which use Dome filters as the core, "
"it uses a Hilbert Transformer, which is much simpler to implement in digital "
"systems."
msgstr "<b>Bode Frequency Shifter (CV)</b> (LADSPA 1432)<br>\n Bode/Moog Frequency Shifter popularan je analogni sintetički modul koji radi pomicanjem svih frekvencija ulaznog signala gore ili dolje za određenu frekvenciju. Ovaj se učinak pomiče u oba smjera u isto vrijeme jer gotovo da i nije dodatni posao i često je korisno imati oba smjera. Za razliku od analognog Bode/Mooga, koji kao jezgru koriste Dome filtre, on koristi Hilbertov transformator, koji je puno jednostavniji za implementaciju u digitalnim sustavima."

#: data/effects/ladspa/ladspa_1432.xml:9
#, kde-format
msgid "Base Shift"
msgstr "Osnovni pomak"

#: data/effects/ladspa/ladspa_1432.xml:13
#, kde-format
msgid "Down,Both,Up"
msgstr "Dolje,Oboje,Gore"

#: data/effects/ladspa/ladspa_1432.xml:16
#, kde-format
msgid "CV Attenuation"
msgstr "Prigušenje CV-a"

#: data/effects/ladspa/ladspa_1432.xml:19
#, kde-format
msgid "Shift CV"
msgstr "Pomak CV-a"

#: data/effects/ladspa/ladspa_1433.xml:4
#, kde-format
msgid "AM Pitch Shifter"
msgstr "AM pomak visine tona"

#: data/effects/ladspa/ladspa_1433.xml:6
#, kde-format
msgid ""
"AM Pitch Shifter (LADSPA 1433)<br>\n"
"   This effect works by running a single write pointer (monotonic) and two "
"read pointers (pitchscaled) over a ringbuffer. The output is faded between "
"the two readpointers according to the sine of the distance from the write "
"pointer."
msgstr "AM Pitch Shifter (LADSPA 1433)<br>\n Ovaj efekt radi pokretanjem jednog pokazivača za pisanje (monotono) i dva pokazivača za čitanje (s visinom tona) preko međuspremnika prstena. Izlaz se mijenja između dva pokazivača čitanja prema sinusu udaljenosti od pokazivača pisanja."

#: data/effects/ladspa/ladspa_1433.xml:9 data/effects/ladspa/ladspa_pitch.xml:4
#, kde-format
msgid "Pitch Shift"
msgstr "Promjena visine tona"

#: data/effects/ladspa/ladspa_1433.xml:11
#, kde-format
msgid ""
"The multiple of the output pitch.<br>\n"
"      For example, 2.00 will increase the pitch by one octave."
msgstr "Množitelj izlazne visine tona.<br>\n      Primjerice, 2,00 povisit će ton za jednu oktavu."

#: data/effects/ladspa/ladspa_1433.xml:14
#, kde-format
msgid "Buffer Size"
msgstr "Veličina međuspremnika"

#: data/effects/ladspa/ladspa_1433.xml:16
#, kde-format
msgid ""
"The order of magnitude of the buffer size.<br>\n"
"      Small buffers will sound fluttery, large buffers will have flangy "
"sounding echos."
msgstr "Redoslijed veličine međuspremnika.<br>\n Mali međuspremnici će zvučati lepršavo, veliki međuspremnici će imati flangiranu zvučnu jeku."

#: data/effects/ladspa/ladspa_1438.xml:4
#, kde-format
msgid "DJ Flanger"
msgstr "DJ flanger"

#: data/effects/ladspa/ladspa_1438.xml:6
#, kde-format
msgid ""
"DJ Flanger (LADSPA 1438)<br>\n"
"   This is a flanger which is more or less typical of DJ mixing desks"
msgstr "DJ flanger (LADSPA 1438)<br>\n   Flanger kakav se obično nalazi na DJ mikserima"

#: data/effects/ladspa/ladspa_1438.xml:9
#, kde-format
msgid "LFO sync"
msgstr "Sinkronizacija LFO-a"

#: data/effects/ladspa/ladspa_1438.xml:11
#, kde-format
msgid ""
"When turned from off to on<br>\n"
"      it resets the phase of the LFO back to the start of the cycle. Used to "
"sync the LFO to the track."
msgstr "Kada se uključi s isključenog na<br>\n, vraća fazu LFO-a na početak ciklusa. Koristi se za sinkronizaciju LFO-a sa stazom."

#: data/effects/ladspa/ladspa_1438.xml:14
#, kde-format
msgid "LFO period"
msgstr "Razdoblje LFO-a"

#: data/effects/ladspa/ladspa_1438.xml:15
#, kde-format
msgid "The cycle period of the LFO in seconds"
msgstr "Trajanje ciklusa LFO-a u sekundama"

#: data/effects/ladspa/ladspa_1438.xml:19
#, kde-format
msgid "The maximum delay the LFO will use to flange in milliseconds"
msgstr "Maksimalna odgoda u milisekundama koju LFO koristi za flanger efekt"

#: data/effects/ladspa/ladspa_1438.xml:23
#, kde-format
msgid "The amount of the delays output that is mixed back into the delay"
msgstr "Količina odgođenog izlaznog signala koja se vraća u odgodu"

#: data/effects/ladspa/ladspa_1886.xml:4
#, kde-format
msgid "Exponential Signal Decay"
msgstr "Eksponencijalno opadanje signala"

#: data/effects/ladspa/ladspa_1886.xml:5
#, kde-format
msgid "Exponential Signal Decay (LADSPA 1886)"
msgstr "Eksponencijalno opadanje signala (LADSPA 1886)"

#: data/effects/ladspa/ladspa_1887.xml:4
#, kde-format
msgid "Comb Delay Line (linear interpolation)"
msgstr "Linija češljaste odgode (linearna interpolacija)"

#: data/effects/ladspa/ladspa_1887.xml:6
#, kde-format
msgid ""
"Comb Delay Line (linear interpolation) (LADSPA 1887)<br>\n"
"   Based on work by James McCartney in SuperCollider."
msgstr "Comb Delay Line (linearna interpolacija) (LADSPA 1887)<br>\n Temeljeno na radu Jamesa McCartneyja u SuperCollideru."

#: data/effects/ladspa/ladspa_1887.xml:9 data/effects/ladspa/ladspa_1888.xml:9
#: data/effects/ladspa/ladspa_1889.xml:9 data/effects/ladspa/ladspa_1895.xml:9
#: data/effects/ladspa/ladspa_1896.xml:9 data/effects/ladspa/ladspa_1897.xml:9
#: data/effects/ladspa/ladspa_1900.xml:9
#, kde-format
msgid "Max Delay"
msgstr "Maksimalna odgoda"

#: data/effects/ladspa/ladspa_1887.xml:11
#: data/effects/ladspa/ladspa_1888.xml:11
#: data/effects/ladspa/ladspa_1889.xml:11
#, kde-format
msgid ""
"Maximum delay.<br>\n"
"      Used to set the delay buffer size upon activation. Cannot be modulated."
msgstr "Maksimalna odgoda.<br>\n      Koristi se za postavljanje veličine međuspremnika odgode pri aktivaciji. Ne može se modulirati."

#: data/effects/ladspa/ladspa_1887.xml:14
#: data/effects/ladspa/ladspa_1888.xml:14
#: data/effects/ladspa/ladspa_1889.xml:14
#: data/effects/ladspa/ladspa_1895.xml:12
#: data/effects/ladspa/ladspa_1896.xml:12
#: data/effects/ladspa/ladspa_1897.xml:12
#: data/effects/ladspa/ladspa_1900.xml:12
#, kde-format
msgid "Delay Time"
msgstr "Vrijeme odgode"

#: data/effects/ladspa/ladspa_1887.xml:20
#: data/effects/ladspa/ladspa_1888.xml:20
#: data/effects/ladspa/ladspa_1889.xml:20
#, kde-format
msgid ""
"Time for the echoes to decay<br>\n"
"      by 60 decibels. If this time is negative then the feedback coefficient "
"will be negative, thus emphasizing only odd harmonics at an octave lower."
msgstr "Vrijeme za smanjenje odjeka<br>\n za 60 decibela. Ako je ovo vrijeme negativno tada će koeficijent povratne sprege biti negativan, čime se naglašavaju samo neparni harmonici na oktavi niže."

#: data/effects/ladspa/ladspa_1888.xml:4
#, kde-format
msgid "Comb Delay Line (cubic spline interpolation)"
msgstr "Linija češljaste odgode (kubna spline interpolacija)"

#: data/effects/ladspa/ladspa_1888.xml:6
#, kde-format
msgid ""
"Comb Delay Line (cubic spline interpolation) (LADSPA 1888)<br>\n"
"   Based on work by James McCartney in SuperCollider."
