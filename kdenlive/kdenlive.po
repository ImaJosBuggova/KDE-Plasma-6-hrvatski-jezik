#: data/effects/ladspa/ladspa_1913.xml:6
#, kde-format
msgid ""
"Fast Lookahead Limiter (LADSPA 1913)<br>\n"
"   This is a limiter with an attack time of 5ms. It adds just over 5ms of "
"latency to the input signal, but it guarantees that there will be no signals "
"over the limit, and tries to get the minimum amount of distortion."
msgstr "Fast Lookahead Limiter (LADSPA 1913)<br>\n Ovo je limiter s vremenom napada od 5ms. Dodaje nešto više od 5 ms latencije ulaznom signalu, ali jamči da neće biti signala preko granice i pokušava dobiti minimalnu količinu izobličenja."

#: data/effects/ladspa/ladspa_1913.xml:11
#, kde-format
msgid ""
"Gain that is applied<br>\n"
"      to the input stage. Can be used to trim gain to bring it roughly under "
"the limit or to push the signal against the limit."
msgstr "Pojačanje koje se primjenjuje<br>\n na ulazni stupanj. Može se koristiti za podrezivanje pojačanja kako bi se dovelo otprilike ispod granice ili za guranje signala prema granici."

#: data/effects/ladspa/ladspa_1913.xml:16
#, kde-format
msgid ""
"The maximum output amplitude.<br>\n"
"      Peaks over this level will be attenuated as smoothly as possible to "
"bring them as close as possible to this level."
msgstr "Maksimalna izlazna amplituda.<br>\n Vrhovi iznad ove razine bit će prigušeni što je glatko moguće kako bi se što više približili ovoj razini."

#: data/effects/ladspa/ladspa_1913.xml:21
#, kde-format
msgid ""
"The time taken for the<br>\n"
"      limiters attenuation to return to 0 dB"
msgstr "Vrijeme potrebno da se<br>\n      prigušenje ograničivača vrati na 0 dB"

