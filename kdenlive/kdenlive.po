#: data/effects/gpsgraphic.xml:4
#, kde-format
msgid "GPS Graphic"
msgstr "GPS grafika"

#: data/effects/gpsgraphic.xml:5
#, kde-format
msgid "Overlay GPS-related graphics onto the video."
msgstr "Prekrij videozapis grafikom povezanom s GPS-om."

#: data/effects/gpsgraphic.xml:8 data/effects/gpstext.xml:13
#, kde-format
msgid "GPS File"
msgstr "GPS datoteka"

#: data/effects/gpsgraphic.xml:9
#, kde-format
msgid ""
"The fullpath of file containing location (GPS) data. Supported extensions: ."
"gpx, .tcx."
msgstr "Puna putanja do datoteke s lokacijskim (GPS) podacima. Podržani nastavci: .gpx, .tcx."

#: data/effects/gpsgraphic.xml:12 data/effects/gpstext.xml:16
#, kde-format
msgid "Time offset in seconds"
msgstr "Vremenski pomak u sekundama"

#: data/effects/gpsgraphic.xml:14
#, kde-format
msgid ""
"An offset (in seconds) to be added to the video file to match it to the GPS "
"track.<br>\n"
"    \tMost of the time this will at least need to be set to the timezone "
"difference between the 2 files plus some seconds if the video recording "
"device isn't precisely set to correct time. GPS time is always exact and in "
"UTC. Use positive values if GPS is ahead of video and negative otherwise."
msgstr "Odmak (u sekundama) koji se dodaje video datoteci kako bi se uskladila s GPS stazom.<br>\n Većinu vremena ovo će morati biti postavljeno barem na razliku vremenske zone između 2 datoteke plus nekoliko sekundi ako uređaj za snimanje video zapisa nije točno postavljen na točno vrijeme. GPS vrijeme je uvijek točno i u UTC-u. Koristite pozitivne vrijednosti ako je GPS ispred videa, a negativne u suprotnom."

#: data/effects/gpsgraphic.xml:17 data/effects/gpstext.xml:19
#, kde-format
msgid "Smoothing level"
msgstr "Razina zaglađivanja"

#: data/effects/gpsgraphic.xml:19
#, kde-format
msgid ""
"How many GPS points to smooth in order to eliminate GPS errors.<br>\n"
"    \tA value of 1 does not smooth locations, it only calculates the extra "
"fields (speed, distance, etc), it also interpolates missing values for heart "
"rate and altitude."
msgstr "Broj GPS točaka za zaglađivanje radi uklanjanja GPS pogrešaka.<br>\n    \tVrijednost 1 ne zaglađuje lokacije, već samo izračunava dodatna polja (brzinu, udaljenost itd.) i interpolira nedostajuće vrijednosti pulsa i nadmorske visine."

#: data/effects/gpsgraphic.xml:22 data/effects/gpstext.xml:25
#, kde-format
msgid "Speed multiplier"
msgstr "Množitelj brzine"

#: data/effects/gpsgraphic.xml:24
#, kde-format
msgid ""
"If the video file is a timelapse (or slow motion), use this value to set the "
"speed up/slow down ratio.<br>\n"
"        Sample values: 30 for 30x timelapse, 0.25 for 4x slow motion footage."
msgstr "Ako je videozapis ubrzan ili usporen, ovdje postavi omjer ubrzanja/usporavanja.<br>\n        Primjeri: 30 za ubrzanje od 30 puta, 0,25 za usporenje od 4 puta."

#: data/effects/gpsgraphic.xml:27
#, kde-format
msgid "Graph data source"
msgstr "Izvor podataka grafikona"

#: data/effects/gpsgraphic.xml:28
#, kde-format
msgid "What data from the GPS file is used for drawing"
msgstr "Koji se podaci iz GPS datoteke koriste za crtanje"

#: data/effects/gpsgraphic.xml:29
#, kde-format
msgid "GPS location/track,Altitude,Heart rate,Speed"
msgstr "GPS lokacija/trasa,Nadmorska visina,Puls,Brzina"

#: data/effects/gpsgraphic.xml:40
#, kde-format
msgid ""
"<b>Speedometer</b> is available for all data sources but recommended only "
"for speed; for the map type it represents the \"percentage done\" from "
"trimmed start - end).<br>\n"
"Note: for type 1 (zoom and center, aka \"follow the dot\"):<br>\n"
"* crop values are only valid as a percentage and only the bottom (resp left) "
"values\n"
"will be taken into consideration as both values (ie: bottom/top) will need "
"to be equal to\n"
"keep the dot centered)<br>\n"
"* if data source is not GPS location, the centering will only be done for "
"horizontal axis\n"
"(time), vertical axis crop will behave just like for the basic 2D map line "
"(it will statically keep\n"
"the same min/max limit allowing the Now dot to move up and down)."
msgstr "<b>Brzinomjer</b> dostupan je za sve izvore podataka, ali se preporučuje samo za brzinu; za vrstu karte predstavlja \"postotak urađenosti\" od skraćenog početka - kraja).<br>\nNapomena: za tip 1 (zumiranje i središte, poznato i kao \"prati točku\"):<br>\n* vrijednosti izrezivanja važeće su samo kao postotak i samo donje (odnosno lijevo) vrijednosti\n će se uzeti u obzir kao obje vrijednosti (tj.: dolje/gore) morat će biti jednako\ndržati točku u sredini)<br>\n* ako izvor podataka nije GPS lokacija, centriranje će se izvršiti samo za vodoravnu os\n(vrijeme), izrezivanje okomite osi ponašat će se kao za osnovnu liniju 2D karte (statički će zadržati\nisto minimalno/maksimalno ograničenje dopuštajući Sada točka za pomicanje gore-dolje)."

#: data/effects/gpsgraphic.xml:41
#, kde-format
msgid ""
"Basic 2D map line (for location) or 1D graph per time (others),Zoom in onto "
"the map/graph centered on current location,Draw speedometer"
msgstr "Osnovna 2D linija karte (za lokaciju) ili 1D grafikon prema vremenu (ostalo),Zumiraj kartu/grafikon centriran na trenutačnoj lokaciji,Nacrtaj brzinomjer"

#: data/effects/gpsgraphic.xml:44
#, no-c-format, kde-format
msgid "Trim start (%)"
msgstr "Odreži početak (%)"

#: data/effects/gpsgraphic.xml:46
#, no-c-format, kde-format
msgid ""
"Trim data from the start of the GPS file (as a percentage of total). <br>\n"
"    \tNote: both <em>Trim start</em> and <em>Trim end</em> are computed from "
"the total file, so trimming 50% start and 50% end will result in trimming "
"the entire file."
msgstr "Odreži podatke od početka GPS datoteke (kao postotak ukupnog trajanja). <br>\n    \tNapomena: <em>Početak obrezivanja</em> i <em>Kraj obrezivanja</em> računaju se od ukupnog trajanja datoteke, pa će obrezivanje 50 % s početka i 50 % s kraja ukloniti cijelu datoteku."

#: data/effects/gpsgraphic.xml:49
#, no-c-format, kde-format
msgid "Trim end (%)"
msgstr "Odreži kraj (%)"

#: data/effects/gpsgraphic.xml:51
#, no-c-format, kde-format
msgid ""
"Trim data from the end of the gps file (as a percentage of total). <br>\n"
"    \tNote: both <em>Trim start</em> and <em>Trim end</em> are computed from "
"the total file, so trimming 50% start and 50% end will result in trimming "
"the entire file."
msgstr "Odreži podatke s kraja GPS datoteke (kao postotak ukupnog trajanja). <br>\n    \tNapomena: <em>Početak obrezivanja</em> i <em>Kraj obrezivanja</em> računaju se od ukupnog trajanja datoteke, pa će obrezivanje 50 % s početka i 50 % s kraja ukloniti cijelu datoteku."

#: data/effects/gpsgraphic.xml:54
#, kde-format
msgid "Crop mode horizontal"
msgstr "Vodoravni način obrezivanja"

#: data/effects/gpsgraphic.xml:57
#, kde-format
msgid ""
"Decides how to interpret the <em>Crop left</em> and <em>Crop right</em> "
"values.<br>\n"
"    \tNote: for the horizontal type, absolute values are the longitude (for "
"the location\n"
"source type) and time (in milliseconds since epoch) for the rest of the data "
"source types)"
msgstr "Određuje tumačenje vrijednosti <em>Obreži lijevo</em> i <em>Obreži desno</em>.<br>\n    \tNapomena: za vodoravni način apsolutne vrijednosti predstavljaju geografsku dužinu (za izvor lokacije) ili vrijeme (u milisekundama od epohe) za ostale vrste izvora podataka."

#: data/effects/gpsgraphic.xml:58 data/effects/gpsgraphic.xml:78
#, kde-format
msgid "Percentage from min..max,Absolute value"
msgstr "Postotak od min. do maks.,Apsolutna vrijednost"

#: data/effects/gpsgraphic.xml:61
#, kde-format
msgid "Crop left"
msgstr "Obreži lijevo"

#: data/effects/gpsgraphic.xml:63
#, no-c-format, kde-format
msgid ""
"Crops data from the left side of the graph (effectively zooming in). <br>\n"
"    \tThe value is interpreted either as a percentage of total or an "
"absolute value depending on crop_mode_h. In percentage mode, the values are "
"not restricted to 0-100 to allow for \"zoom out\" behaviour (ie: cropping "
"-50 left will add an extra half of the total horizontal distance). Values "
"over 100 (in % mode) will effectively not display anything. If <em>Graph "
"Type</em> is set to <b>Speedometer</b>, all crop left/right values are "
"ignored."
msgstr "Obrezuje podatke s lijeve strane grafikona (učinkovito povećavajući). <br>\n Vrijednost se tumači ili kao postotak ukupnog iznosa ili kao apsolutna vrijednost ovisno o crop_mode_h. U postotnom načinu, vrijednosti nisu ograničene na 0-100 kako bi se omogućilo ponašanje \"smanjivanja\" (tj.: obrezivanje -50 lijevo će dodati dodatnu polovicu ukupne vodoravne udaljenosti). Vrijednosti veće od 100 (u % modu) zapravo neće prikazati ništa. Ako je <em>Vrsta grafikona</em> postavljena na <b>Brzinomjer</b>, sve vrijednosti obrezivanja lijevo/desno se zanemaruju."

#: data/effects/gpsgraphic.xml:66
#, kde-format
msgid "Crop right"
msgstr "Obreži desno"

#: data/effects/gpsgraphic.xml:67
#, kde-format
msgid ""
"Same as <em>Crop left</em> but for the right side, and percentage type is "
"interpreted as an inverse percentage (ie: 100 = do not crop anything). "
"Values under 0 will effectively not display anything."
msgstr "Isto kao <em>Obreži lijevo</em>, ali za desnu stranu. Postotak se tumači obrnuto (100 = bez obrezivanja). Vrijednosti manje od 0 neće prikazati ništa."

#: data/effects/gpsgraphic.xml:70
#, kde-format
msgid "Crop mode vertical"
msgstr "Okomiti način obrezivanja"

#: data/effects/gpsgraphic.xml:77
#, kde-format
msgid ""
"Decides how to interpret the <em>Crop bottom</em> and <em>Crop top</em> "
"values.<br/>\n"
"    \tWith an absolute value, it can zoom in to between 100 and 150m of "
"altitude to show\n"
"small changes in altitude between those 2 values better.<br/>\n"
"Note: for the vertical type, absolute values are latitude degrees (for the "
"location\n"
"source type) and altitude, heart rate, speed for the others interpreted as "
"the <em>Legend unit</em>\n"
"type where applicable (ie: a value of 10 for altitude will be considered "
"meters by default\n"
"but if changing <em>Legend unit</em> to feet it will mean 10 feet)."
msgstr "Odlučuje kako protumačiti vrijednosti <em>Obreži dno</em> i <em>Obreći vrh</em>.<br/>\n Uz apsolutnu vrijednost, može zumirati između 100 i 150 m nadmorske visine kako bi bolje prikazao \nmale promjene u visini između te 2 vrijednosti.<br/>\nNapomena: za okomito tip, apsolutne vrijednosti su stupnjevi zemljopisne širine (za tip izvora lokacije\n) i nadmorska visina, broj otkucaja srca, brzina za ostale koji se tumače kao <em>Legenda jedinica</em>\ntip gdje je primjenjivo (tj.: vrijednost od 10 za nadmorsku visinu prema zadanim postavkama smatrat će se metrima\n, ali ako se <em>Legenda jedinica</em> promijeni u stope, to će značiti 10 stopala)."

#: data/effects/gpsgraphic.xml:81
#, kde-format
msgid "Crop bottom"
msgstr "Obreži dolje"

#: data/effects/gpsgraphic.xml:83
#, no-c-format, kde-format
msgid ""
"Crops data from the bottom side of the graph (effectively zooming in). <br>\n"
"    \tThe value is interpreted either as a percentage of total or an "
"absolute value depending on crop_mode_v. In percentage mode the values are "
"not restricted to 0-100 to allow for \"zoom out\" behaviour (ie: cropping "
"-50 bot will add an extra half of the total vertical distance to the "
"bottom). Values over 100 (in % mode) will effectively not display anything. "
"If <em>Graph type</em> is <b>Speedometer</b>, this will set the minimum "
"needle position which will clamp all values that are lower."
msgstr "Izrezuje podatke s donje strane grafikona (učinkovito povećavajući). <br>\n Vrijednost se tumači ili kao postotak ukupnog iznosa ili kao apsolutna vrijednost ovisno o crop_mode_v. U postotnom načinu rada vrijednosti nisu ograničene na 0-100 kako bi se omogućilo ponašanje \"umanjivanja\" (tj.: obrezivanje -50 bot će dodati dodatnu polovicu ukupne okomite udaljenosti na dno). Vrijednosti veće od 100 (u % modu) zapravo neće prikazati ništa. Ako je <em>vrsta grafikona</em> <b>Brzinomjer</b>, ovo će postaviti minimalni položaj igle koji će pričvrstiti sve vrijednosti koje su niže."

#: data/effects/gpsgraphic.xml:86
#, kde-format
msgid "Crop top"
msgstr "Obreži gore"

#: data/effects/gpsgraphic.xml:88
#, kde-format
msgid ""
"Same as <em>Crop bottom</em> but for the top side, and percentage type is "
"interpreted as an inverse percentage (ie: 100 = do not crop anything).<br>\n"
"    \tValues under 0 will effectively not display anything."
msgstr "Isto kao <em>Obreži dolje</em>, ali za gornju stranu. Postotak se tumači obrnuto (100 = bez obrezivanja).<br>\n    \tVrijednosti manje od 0 neće prikazati ništa."

#: data/effects/gpsgraphic.xml:91
#, kde-format
msgid "Graph color style"
msgstr "Stil boja grafikona"

#: data/effects/gpsgraphic.xml:92
#, kde-format
msgid "See the documentation about the various styles available"
msgstr "Pogledajte dokumentaciju za dostupne stilove"

#: data/effects/gpsgraphic.xml:93
#, kde-format
msgid ""
"One color,Two colors,Solid past - thin future,Solid future - thin past,"
"Vertical gradient,Horizontal gradient,Color by duration,Color by altitude,"
"Color by heart rate,Color by Speed,Color by Speed (max 100km/h),Color by "
"grade (max 90 degrees),Color by grade (max 20 degrees)"
msgstr "Jedna boja,Dvije boje,Puna prošlost – tanka budućnost,Puna budućnost – tanka prošlost,Okomiti gradijent,Vodoravni gradijent,Boja prema trajanju,Boja prema nadmorskoj visini,Boja prema pulsu,Boja prema brzini,Boja prema brzini (maks. 100 km/h),Boja prema nagibu (maks. 90 stupnjeva),Boja prema nagibu (maks. 20 stupnjeva)"

#: data/effects/gpsgraphic.xml:97
#, kde-format
msgid "Sets the color #1 for the graph line"
msgstr "Postavlja boju #1 linije grafikona"

