#. (itstool) path: component/name
#: org.kde.massif_visualizer.appdata.xml:12
msgid "Massif-Visualizer"
msgstr "Massif-Visualizer"

#. (itstool) path: component/summary
#: org.kde.massif_visualizer.appdata.xml:13
msgid "A visualizer for Valgrind Massif data files"
msgstr "Alat za vizualizaciju datoteka s podacima Valgrindova Massifa"

#. (itstool) path: description/p
#: org.kde.massif_visualizer.appdata.xml:15
msgid "Massif Visualizer is a tool that - who'd guess that - visualizes massif data. You run your application in Valgrind with --tool=massif and then open the generated massif.out.%pid in the visualizer. Gzip or Bzip2 compressed massif files can also be opened transparently."
msgstr "Massif Visualizer je alat koji — tko bi rekao — vizualizira podatke programa Massif. Pokrenite aplikaciju u Valgrindu s opcijom --tool=massif, a zatim u vizualizatoru otvorite generiranu datoteku massif.out.%pid. Datoteke Massifa komprimirane gzipom ili bzipom2 mogu se otvoriti i izravno."

