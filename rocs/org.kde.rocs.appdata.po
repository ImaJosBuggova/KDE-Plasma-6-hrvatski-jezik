#. (itstool) path: component/summary
#: org.kde.rocs.appdata.xml:11
msgid "Rocs Graph Theory"
msgstr "Teorija grafova Rocs"

#. (itstool) path: description/p
#: org.kde.rocs.appdata.xml:13
msgid "Rocs is a Graph Theory IDE for designing and analyzing graph algorithms. It provides an easy to use visual editor for creating graphs, a scripting engine to execute algorithms, and several helper tools for simulations and experiments. Algorithms are specified in JavaScript."
msgstr "Rocs je IDE za teoriju grafova namijenjen osmišljavanju i analizi algoritama na grafovima. Nudi jednostavan vizualni uređivač za izradu grafova, skriptni mehanizam za izvršavanje algoritama i nekoliko pomoćnih alata za simulacije i eksperimente. Algoritmi se zadaju u JavaScriptu."

