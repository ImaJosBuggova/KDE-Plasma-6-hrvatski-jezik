#: PowerProfileItem.qml:307
#, kde-format
msgctxt "Power profiles are not supported on your device."
msgid "Power profiles suprotno…"
msgstr "Profili napajanja nisu podržani na vašem uređaju."

#: PowerProfileItem.qml:308
#, kde-kuit-format
msgid ""
"Power profiles may be supported on your device.<nl/>Try installing the "
"<command>power-profiles-daemon</command> package using your distribution's "
"package manager and restarting the system."
msgstr ""
"Profili napajanja možda su podržani na vašem uređaju.<nl/>Pokušajte instalirati "
"paket <command>power-profiles-daemon</command> pomoću upravitelja paketa vaše "
"distribucije i ponovno pokrenuti sustav."