#: powerdevilcore.cpp:611
#, kde-format
msgid ""
"Ensure that the power cord is plugged in all the way and provides enough "
"power."
msgstr ""
"Provjerite je li kabel za napajanje do kraja ukopčan i isporučuje li dovoljno "
"energije."

#: powerdevilcore.cpp:613
#, kde-format
msgid "Plug in the power cord."
msgstr "Ukopčajte kabel za napajanje."

#: powerdevilcore.cpp:633
#, kde-format
msgid "The system will shut down in 60 seconds."
msgstr "Sustav će se isključiti za 60 sekundi."

#: powerdevilcore.cpp:635
#, kde-format
msgctxt ""
"@action:button Shut down without waiting for the battery critical timer"
msgid "Shut Down Now"
msgstr "Isključi odmah"

#: powerdevilcore.cpp:641
#, kde-format
msgid "The system will hibernate in 60 seconds."
msgstr "Sustav će hibernirati za 60 sekundi."

