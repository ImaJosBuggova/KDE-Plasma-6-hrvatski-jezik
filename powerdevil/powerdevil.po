msgstr "Hiberniraj odmah"

#: powerdevilcore.cpp:649
#, kde-format
msgid "The system will go to sleep in 60 seconds."
msgstr "Sustav će preći u stanje spavanja za 60 sekundi."

#: powerdevilcore.cpp:651
#, kde-format
msgctxt ""
"@action:button Suspend to ram without waiting for the battery critical timer"
