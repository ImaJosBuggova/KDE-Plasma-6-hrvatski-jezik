#. (itstool) path: component/name
#: org.kde.umbrello.appdata.xml:9
msgid "Umbrello"
msgstr "Umbrello"

#. (itstool) path: component/summary
#: org.kde.umbrello.appdata.xml:10
msgid "UML Modeller"
msgstr "Alat za modeliranje UML-a"

#. (itstool) path: description/p
#: org.kde.umbrello.appdata.xml:12
msgid "Umbrello is a Unified Modelling Language (UML) modelling tool and code generator. It can create diagrams of software and other systems in the industry-standard UML format, and can also generate code from UML diagrams in a variety of programming languages."
msgstr "Umbrello je alat za modeliranje pomoću objedinjenog jezika modeliranja (UML) i generator koda. Može stvarati dijagrame softvera i drugih sustava u industrijskom standardnom formatu UML te generirati kôd iz UML dijagrama na raznim programskim jezicima."

#. (itstool) path: description/p
