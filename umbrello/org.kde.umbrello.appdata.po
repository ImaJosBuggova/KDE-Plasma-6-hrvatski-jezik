msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.umbrello.appdata.xml:19
msgid "Supported formats: XMI"
msgstr "Podržani formati: XMI"

#. (itstool) path: ul/li
#: org.kde.umbrello.appdata.xml:20
msgid "Several type of diagrams supported: use case, class, sequence, communication, state, activity, component, deployment, entity relationship"
msgstr "Podržane su razne vrste dijagrama: slučajevi upotrebe, klase, slijed, komunikacija, stanja, aktivnosti, komponente, razmještaj i odnosi entiteta"

