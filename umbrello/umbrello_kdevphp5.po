msgstr "Uporaba %1 iz %2<br />"

#: duchain/navigation/declarationnavigationcontext.cpp:136
#, kde-format
msgid "Broken member alias trait."
msgstr "Neispravno svojstvo pseudonima člana."

#: duchain/navigation/declarationnavigationcontext.cpp:151
#, kde-format
msgid "PHP internal"
msgstr "Interni element PHP-a"

#: duchain/navigation/declarationnavigationcontext.cpp:161
