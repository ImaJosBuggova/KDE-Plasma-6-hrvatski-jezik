#. i18n: ectx: property (whatsThis), widget (QWidget, CSSCustomDialog)
#: css/cssconfig.ui:14 css/csscustom.ui:13
#, kde-format
msgid ""
"<b>Stylesheets</b><p>See http://www.w3.org/Style/CSS for further information "
"on cascading style sheets.</p>"
msgstr "<b>Stilski listovi</b><p>Dodatne informacije o kaskadnim stilskim listovima potražite na http://www.w3.org/Style/CSS.</p>"

#. i18n: ectx: property (whatsThis), widget (QGroupBox, ButtonGroup1)
#: css/cssconfig.ui:26
#, kde-format
msgid ""
"<b>Stylesheets</b><p>Use this groupbox to determine how Konqueror will "
"render style sheets.</p>"
msgstr "<b>Stilski listovi</b><p>Ovim okvirom određujete kako će Konqueror prikazivati stilske listove.</p>"

#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup1)
#: css/cssconfig.ui:29
#, kde-format
msgid "Stylesheets"
msgstr "Stilski listovi"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useDefault)
#: css/cssconfig.ui:35
#, kde-format
msgid ""
"<b>Use default stylesheet</b><p>Select this option to use the default "
"stylesheet.</p>"
msgstr "<b>Koristi zadani stilski list</b><p>Odaberite ovu mogućnost za uporabu zadanog stilskog lista.</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useDefault)
#: css/cssconfig.ui:38
#, kde-format
msgid "Us&e default stylesheet"
msgstr "Koristi &zadani stilski list"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useUser)
#: css/cssconfig.ui:48
#, kde-format
msgid ""
"<b>Use user-defined stylesheet</b><p>If this box is checked, Konqueror will "
"try to load a user-defined style sheet as specified in the location below. "
"The style sheet allows you to completely override the way web pages are "
"rendered in your browser. The file specified should contain a valid style "
"sheet (see http://www.w3.org/Style/CSS for further information on cascading "
"style sheets).</p>"
msgstr "<b>Koristi korisnički definirani stilski list</b><p>Ako je ova kućica označena, Konqueror će pokušati učitati korisnički definirani stilski list naveden u nastavku. Stilski list omogućuje vam da u potpunosti nadjačate način prikaza web-stranica u pregledniku. Navedena datoteka mora sadržavati valjan stilski list (dodatne informacije o kaskadnim stilskim listovima potražite na http://www.w3.org/Style/CSS).</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useUser)
#: css/cssconfig.ui:51
#, kde-format
msgid "Use &user-defined stylesheet"
msgstr "Koristi &korisnički definirani stilski list"

#. i18n: ectx: property (whatsThis), widget (QRadioButton, useAccess)
#: css/cssconfig.ui:103
#, kde-format
msgid ""
"<b>Use accessibility stylesheet</b><p>Selecting this option will allow you "
"to define a default font, font size, and font color with a few simple clicks "
"of the mouse. Simply wander over to the Customize... dialog and pick out "
"your desired options.</p>"
msgstr "<b>Koristi stilski list pristupačnosti</b><p>Odabirom ove mogućnosti možete s nekoliko klikova mišem definirati zadani font, veličinu fonta i boju fonta. Otvorite dijaloški okvir „Prilagodi...” i odaberite željene mogućnosti.</p>"

#. i18n: ectx: property (text), widget (QRadioButton, useAccess)
#: css/cssconfig.ui:106
#, kde-format
msgid "U&se accessibility stylesheet"
msgstr "Koristi stilski list &pristupačnosti"

#. i18n: ectx: property (text), widget (QPushButton, customize)
#: css/cssconfig.ui:146
#, kde-format
msgid "Custom&ize..."
msgstr "&Prilagodi..."

#. i18n: ectx: property (title), widget (QGroupBox, customPageBackgroundBox)
#: css/cssconfig.ui:177
#, kde-format
msgid "Custom Page Background"
msgstr "Prilagođena pozadina stranice"

#. i18n: ectx: property (toolTip), widget (QCheckBox, useCustomBackgroundColor)
#: css/cssconfig.ui:183
#, kde-format
msgid ""
"<html><head/><body><p align=\"justify\">Use a custom background color for "
"web pages. This color is used:</p><ul style=\"margin-top: 0px; margin-"
"bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li "
"align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">when the "
"background color isn't explicitly set by the page or by a custom stylesheet</"
"li><li align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">before a "
"web page is loaded</li></ul><p align=\"justify\">Setting a custom background "
"color is mostly useful if you use a custom stylesheet which sets a "
"background color for the page (especially a dark color), to avoid a white "
"flash before the page is loaded</p></body></html>"
msgstr "<html><head/><body><p align=\"justify\">Koristi prilagođenu boju pozadine za web-stranice. Ta se boja koristi:</p><ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">kada stranica ili prilagođeni stilski list izričito ne postavlja boju pozadine</li><li align=\"justify\" style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">prije učitavanja web-stranice</li></ul><p align=\"justify\">Postavljanje prilagođene boje pozadine osobito je korisno ako koristite prilagođeni stilski list koji određuje boju pozadine stranice (posebno tamnu boju), kako biste izbjegli bljesak bijele boje prije učitavanja stranice.</p></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, useCustomBackgroundColor)
#: css/cssconfig.ui:186
#, kde-format
msgid "Use custom &background color"
msgstr "Koristi prilagođenu &boju pozadine"

#. i18n: ectx: property (toolTip), widget (KColorButton, customBackgroundColor)
#: css/cssconfig.ui:196
#, kde-format
msgid ""
"<html><head/><body><p>The custom background color to use for web pages</p></"
"body></html>"
msgstr "<html><head/><body><p>Prilagođena boja pozadine za web-stranice</p></body></html>"

#. i18n: ectx: property (toolTip), widget (QCheckBox, addCustomBackgroundToStyleSheet)
#: css/cssconfig.ui:206
#, kde-format
msgid ""
"<html><head/><body><p align=\"justify\">Add to your custom stylesheet "
"(including the accessibility stylesheet) a rule to set all background colors "
"to the custom color you chose above. This avoids the need of setting the "
"background color both in the stylesheet and in the configuration dialog.</"
"p><p align=\"justify\"><span style=\" font-weight:600;\">Notes:</span></"
"p><ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-"
"right: 0px; -qt-list-indent: 1;\"><li align=\"justify\" style=\" margin-"
"top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-"
"indent:0; text-indent:0px;\">the rule will be overridden by other rules for "
"background colors in your custom stylesheet following the usual CSS rules</"
"li><li align=\"justify\" style=\" margin-top:0px; margin-bottom:12px; margin-"
"left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">the rule "
"isn't actually added to the file containing your custom stylesheet; it's "
"only inserted in the copy Konqueror keeps in memory. This means that if you "
"use the stylesheet in other browsers, you'll need to manually add the rule "
"to it.</li></ul></body></html>"
msgstr "<html><head/><body><p align=\"justify\">Dodaje pravilo u vaš prilagođeni stilski list (uključujući stilski list pristupačnosti) koje postavlja sve boje pozadine na prilagođenu boju odabranu iznad. Time se izbjegava potreba za postavljanjem boje pozadine i u stilskom listu i u dijaloškom okviru konfiguracije.</p><p align=\"justify\"><span style=\" font-weight:600;\">Napomene:</span></p><ul style=\"margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;\"><li align=\"justify\" style=\" margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">pravilo će nadjačati druga pravila za boje pozadine u prilagođenom stilskom listu u skladu s uobičajenim pravilima CSS-a</li><li align=\"justify\" style=\" margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">pravilo se zapravo ne dodaje u datoteku prilagođenog stilskog lista, nego samo u njegovu kopiju koju Konqueror čuva u memoriji. Zato ćete ga morati ručno dodati ako taj stilski list koristite u drugim preglednicima.</li></ul></body></html>"

#. i18n: ectx: property (text), widget (QCheckBox, addCustomBackgroundToStyleSheet)
#: css/cssconfig.ui:209
#, kde-format
msgid "Add custom background color to stylesheet"
msgstr "Dodaj prilagođenu boju pozadine u stilski list"

