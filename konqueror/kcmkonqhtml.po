#. i18n: ectx: property (title), widget (QGroupBox, GroupBox3_2)
#: appearance.cpp:48 css/csscustom.ui:296
#, kde-format
msgid "Images"
msgstr "Slike"

#: appearance.cpp:52
#, kde-format
msgid "A&utomatically load images"
msgstr "A&utomatski učitavaj slike"

#: appearance.cpp:53
#, kde-format
msgid ""
"<html>If this box is checked, Konqueror will automatically load any images "
"that are embedded in a web page. Otherwise, it will display placeholders for "
"the images, and you can then manually load the images by clicking on the "
"image button.<br />Unless you have a very slow network connection, you will "
"probably want to check this box to enhance your browsing experience.</html>"
msgstr "<html>Ako je ova kućica označena, Konqueror će automatski učitavati sve slike ugrađene u web-stranicu. U suprotnom će prikazivati rezervirana mjesta za slike, a slike ćete moći ručno učitati klikom na gumb slike.<br />Ako nemate vrlo sporu mrežnu vezu, vjerojatno ćete označiti ovu kućicu radi ugodnijeg pregledavanja.</html>"

#: appearance.cpp:63
#, kde-format
msgid "Dra&w frame around not completely loaded images"
msgstr "Nacrtaj &okvir oko nepotpuno učitanih slika"

#: appearance.cpp:64
#, kde-format
msgid ""
"<html>If this box is checked, Konqueror will draw a frame as a placeholder "
"around images embedded in a web page that are not yet fully loaded.<br />You "
"will probably want to check this box to enhance your browsing experience, "
"especially if have a slow network connection.</html>"
msgstr "<html>Ako je ova kućica označena, Konqueror će oko slika ugrađenih u web-stranicu koje još nisu potpuno učitane nacrtati okvir kao rezervirano mjesto.<br />Vjerojatno ćete označiti ovu kućicu radi ugodnijeg pregledavanja, osobito ako imate sporu mrežnu vezu.</html>"

#: appearance.cpp:74
#, kde-format
msgctxt "animations"
msgid "Enabled"
msgstr "Omogućeno"

#: appearance.cpp:75
#, kde-format
msgctxt "animations"
msgid "Disabled"
msgstr "Onemogućeno"

#: appearance.cpp:76
#, kde-format
msgid "Show Only Once"
msgstr "Prikaži samo jednom"

#: appearance.cpp:77
#, kde-format
msgid ""
"<html>Controls how Konqueror shows animated images:<br /><ul><li><b>Enabled</"
"b>: Show all animations completely.</li><li><b>Disabled</b>: Never show "
"animations, show the starting image only.</li><li><b>Show only once</b>: "
"Show all animations completely but do not repeat them.</li></ul></html>"
msgstr "<html>Određuje kako Konqueror prikazuje animirane slike:<br /><ul><li><b>Omogućeno</b>: potpuno prikazuje sve animacije.</li><li><b>Onemogućeno</b>: nikad ne prikazuje animacije, nego samo početnu sliku.</li><li><b>Prikaži samo jednom</b>: potpuno prikazuje sve animacije, ali ih ne ponavlja.</li></ul></html>"

#: appearance.cpp:82
#, kde-format
msgid "A&nimations:"
msgstr "A&nimacije:"

#: appearance.cpp:85 htmlopts.cpp:108
#, kde-format
msgctxt "@title:group"
msgid "Miscellaneous"
msgstr "Razno"

#: appearance.cpp:90
#, kde-format
msgctxt "underline"
msgid "Enabled"
msgstr "Omogućeno"

#: appearance.cpp:91
#, kde-format
msgctxt "underline"
msgid "Disabled"
msgstr "Onemogućeno"

#: appearance.cpp:92
#, kde-format
msgid "Only on Hover"
msgstr "Samo pri prelasku pokazivača"

#: appearance.cpp:93
#, kde-format
msgid "Und&erline links:"
msgstr "Pod&crtaj poveznice:"

#: appearance.cpp:96
#, kde-format
msgid ""
"<html>Controls how Konqueror handles underlining hyperlinks:<br /"
"><ul><li><b>Enabled</b>: Always underline links</li><li><b>Disabled</b>: "
"Never underline links</li><li><b>Only on Hover</b>: Underline when the mouse "
"is moved over the link</li></ul><br /><i>Note: The site's CSS definitions "
"can override this value.</i></html>"
msgstr "<html>Određuje kako Konqueror podcrtava hiperpoveznice:<br /><ul><li><b>Omogućeno</b>: uvijek podcrtava poveznice</li><li><b>Onemogućeno</b>: nikad ne podcrtava poveznice</li><li><b>Samo pri prelasku pokazivača</b>: podcrtava kada se pokazivač miša pomakne preko poveznice</li></ul><br /><i>Napomena: CSS definicije stranice mogu nadjačati ovu vrijednost.</i></html>"

#: appearance.cpp:105
#, kde-format
msgid "When Efficient"
msgstr "Kad je učinkovito"

#: appearance.cpp:106
#, kde-format
msgctxt "smooth scrolling"
msgid "Always"
msgstr "Uvijek"

#: appearance.cpp:107
#, kde-format
msgctxt "soft scrolling"
msgid "Never"
msgstr "Nikad"

#: appearance.cpp:108
#, kde-format
msgid "S&mooth scrolling:"
msgstr "&Glasno pomicanje:"

#: appearance.cpp:110
#, kde-format
msgid ""
"<html>Determines whether Konqueror should use smooth steps to scroll HTML "
"pages, or whole steps:<br /><ul><li><b>Always</b>: Always use smooth steps "
"when scrolling.</li><li><b>Never</b>: Never use smooth scrolling, scroll "
"with whole steps instead.</li><li><b>When Efficient</b>: Only use smooth "
"scrolling on pages where it can be achieved with moderate usage of system "
"resources.</li></ul></html>"
msgstr "<html>Određuje treba li Konqueror pri pomicanju HTML stranica koristiti glatke korake ili pomake u cjelini:<br /><ul><li><b>Uvijek</b>: uvijek koristi glatke korake pri pomicanju.</li><li><b>Nikad</b>: ne koristi glatko pomicanje, nego pomiče u cjelini.</li><li><b>Kad je učinkovito</b>: glatko pomicanje koristi samo na stranicama na kojima se može postići uz umjerenu potrošnju sistemskih resursa.</li></ul></html>"

