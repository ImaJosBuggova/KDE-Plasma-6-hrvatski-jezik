#: htmlopts.cpp:97
#, kde-format
msgid "Right click goes &back in history"
msgstr "Desni klik vraća se &natrag u povijesti"

#: htmlopts.cpp:100
#, kde-format
msgid ""
"If this box is checked, you can go back in history by right clicking on a "
"Konqueror view. To access the context menu, press the right mouse button and "
"move."
msgstr "Ako je ova kućica označena, desnim klikom na prikaz Konquerora možete se vratiti u povijesti. Za pristup kontekstnom izborniku pritisnite desnu tipku miša i pomaknite pokazivač."

#: htmlopts.cpp:115
#, kde-format
msgid "Enable Access Ke&y activation with Ctrl key"
msgstr "Omogući aktiviranje pristupnih &tipki tipkom Ctrl"

#: htmlopts.cpp:116
#, kde-format
msgid ""
"Pressing the Ctrl key when viewing webpages activates Access Keys. "
"Unchecking this box will disable this accessibility feature. (Konqueror "
"needs to be restarted for this change to take effect.)"
msgstr "Pritiskom tipke Ctrl pri pregledavanju web-stranica aktiviraju se pristupne tipke. Poništavanjem ove kućice onemogućuje se ta značajka pristupačnosti. (Konqueror je potrebno ponovno pokrenuti da bi se promjena primijenila.)"

#: htmlopts.cpp:121
#, kde-format
msgid "Send the DNT header to tell web sites you do not want to be tracked"
msgstr "Šalji zaglavlje DNT kako biste web-stranicama poručili da ne želite praćenje"

#: htmlopts.cpp:122
#, kde-format
msgid ""
"<p>Check this box if you want to inform a web site that you do not want your "
"web browsing habits tracked.</p><p><strong>Warning:</strong> this header is "
"considered obsolete, so it will likely be ignored by most web pages.</p>"
msgstr "<p>Označite ovu kućicu ako želite obavijestiti web-stranicu da ne želite da se prate vaše navike pregledavanja.</p><p><strong>Upozorenje:</strong> ovo se zaglavlje smatra zastarjelim pa će ga većina web-stranica vjerojatno zanemariti.</p>"

#: htmlopts.cpp:126
#, kde-format
msgid "Offer to save website passwords"
msgstr "Ponudi spremanje lozinki web-stranica"

#: htmlopts.cpp:127
#, kde-format
msgid "Uncheck this box to prevent being prompted to save website passwords"
msgstr "Poništite ovu kućicu kako se ne bi prikazivao upit za spremanje lozinki web-stranica"

#: htmlopts.cpp:131
#, kde-format
msgid "Display online PDF files using WebEngine"
msgstr "Prikaži PDF datoteke s mreže pomoću WebEnginea"

#: htmlopts.cpp:132
#, kde-format
