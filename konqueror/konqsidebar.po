#: history_module/kcmhistory.cpp:54
#, kde-format
msgid ""
"Action to carry out when opening an URL from history:<dl><dl><dt>Auto:</"
"dt><dd>opens the URL in a new tab unless the current tab is empty or an "
"intro page</dd><dt>Open URL in a new tab:</dt><dd>always opens the URL in a "
"new tab</dd><dt>Open URL in current tab:</dt><dd>always opens the URL in the "
"current tab</dd><dt>Open URL in new window:</dt><dd>always opens the URL in "
"a new window</dd></dl>"
msgstr "Radnja koju treba izvršiti pri otvaranju URL-a iz povijesti:<dl><dl><dt>Automatski:</dt><dd>otvara URL u novoj kartici, osim ako je trenutačna kartica prazna ili prikazuje uvodnu stranicu</dd><dt>Otvori URL u novoj kartici:</dt><dd>uvijek otvara URL u novoj kartici</dd><dt>Otvori URL u trenutačnoj kartici:</dt><dd>uvijek otvara URL u trenutačnoj kartici</dd><dt>Otvori URL u novom prozoru:</dt><dd>uvijek otvara URL u novom prozoru</dd></dl>"

