#. (itstool) path: component/name
#: org.kde.konqueror.appdata.xml:9
msgid "Konqueror"
msgstr "Konqueror"

#. (itstool) path: component/summary
#: org.kde.konqueror.appdata.xml:10
msgid "KDE File Manager &amp; Web Browser"
msgstr "KDE-ov upravitelj datoteka &amp; web-preglednik"

#. (itstool) path: description/p
#: org.kde.konqueror.appdata.xml:12
msgid "Konqueror is KDE's Webbrowser and swiss-army-knife for any kind of file-management and file previewing."
msgstr "Konqueror je KDE-ov web-preglednik i višenamjenski alat za upravljanje datotekama i njihov pregled."

#. (itstool) path: description/p
#: org.kde.konqueror.appdata.xml:13
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:15
msgid "Webbrowsing using Qt WebEngine as rendering engine"
msgstr "Pregledavanje weba pomoću Qt WebEnginea kao mehanizma za iscrtavanje"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:16
msgid "File management using most of Dolphin's features (including version-control, service menus and the basic UI)"
msgstr "Upravljanje datotekama uz većinu Dolphinovih značajki (uključujući upravljanje verzijama, izbornike servisa i osnovno korisničko sučelje)"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:17
msgid "File management on ftp and sftp servers"
msgstr "Upravljanje datotekama na FTP i SFTP poslužiteljima"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:18
msgid "Full featured FTP-client (you can split views to display local and remote folders and previews in the same window)"
msgstr "Potpuno opremljen FTP klijent (prikaze možete podijeliti kako biste u istom prozoru vidjeli lokalne i udaljene mape te preglede)"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:19
msgid "Embedded applications to preview files (e.g. Okular and Calligra for documents, Gwenview for pictures, KTextEditor for text-files)"
msgstr "Ugrađene aplikacije za pregled datoteka (npr. Okular i Calligra za dokumente, Gwenview za slike, KTextEditor za tekstualne datoteke)"

#. (itstool) path: ul/li
#: org.kde.konqueror.appdata.xml:20
msgid "Different kinds of plugins: Service-menus, KParts (embedded applications), KIO (accessing files using special protocols like http or ftp) and KPart-plugins (like AdBlocker...)"
msgstr "Razne vrste dodataka: servisni izbornici, KParts (ugrađene aplikacije), KIO (pristup datotekama posebnim protokolima poput HTTP-a ili FTP-a) i dodaci KPart (poput blokatora oglasa...)"
