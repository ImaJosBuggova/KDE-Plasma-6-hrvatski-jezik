#: behaviour.cpp:47
#, kde-format
msgid "Open folders in separate &windows"
msgstr "Otvori mape u zasebnim &prozorima"

#: behaviour.cpp:48
#, kde-format
msgid ""
"If this option is checked, Konqueror will open a new window when you open a "
"folder, rather than showing that folder's contents in the current window."
msgstr "Ako je ova mogućnost označena, Konqueror će pri otvaranju mape otvoriti novi prozor umjesto da prikaže njezin sadržaj u trenutačnom prozoru."

#: behaviour.cpp:72
#, kde-format
msgid "Show 'Delete' me&nu entries which bypass the trashcan"
msgstr "Prikaži stavke izbornika „Izbriši” koje zaobilaze smeće"

#: behaviour.cpp:76
#, kde-format
msgid ""
"Check this if you want 'Delete' menu commands to be displayed on the desktop "
"and in the file manager's menus and context menus. You can always delete "
"files by holding the Shift key while calling 'Move to Trash'."
msgstr "Označite ovo ako želite da se naredbe izbornika „Izbriši” prikazuju na radnoj površini te u izbornicima upravitelja datoteka i kontekstnim izbornicima. Datoteke uvijek možete izbrisati tako da držite tipku Shift dok odabirete „Premjesti u smeće”."
