#: kfmclient.cpp:57
#, kde-format
msgid "kfmclient"
msgstr "kfmclient"

#: kfmclient.cpp:58
#, kde-format
msgid "KDE tool for opening URLs from the command line"
msgstr "KDE-ov alat za otvaranje URL-ova iz naredbenog retka"

#: kfmclient.cpp:66
#, kde-format
msgid "Non interactive use: no message boxes"
msgstr "Neinteraktivna uporaba: bez dijaloških okvira"

#: kfmclient.cpp:68
#, kde-format
msgid "Show available commands"
msgstr "Prikaži dostupne naredbe"

#: kfmclient.cpp:77
#, kde-format
msgid ""
"The mimetype of the URL. Allows Konqueror to determine in advance which "
"component to use, making it start faster."
msgstr "MIME vrsta URL-a. Omogućuje Konqueroru da unaprijed odredi koju komponentu koristiti, čime se brže pokreće."

#: kfmclient.cpp:78
#, kde-format
msgctxt "the name for a the value of an option on the command line help"
msgid "type"
msgstr "vrsta"

#: kfmclient.cpp:80
#, kde-format
msgid "Command (see --commands)"
msgstr "Naredba (pogledajte --commands)"

#: kfmclient.cpp:82
#, kde-format
msgid "Arguments for command"
msgstr "Argumenti naredbe"

#: kfmclient.cpp:84
#, kde-format
msgid "The files/URLs opened by the application will be deleted after use"
msgstr "Datoteke/URL-ovi koje aplikacija otvori izbrisat će se nakon uporabe"

#: kfmclient.cpp:93
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintaksa:\n"

#: kfmclient.cpp:94
#, kde-format
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, the start page is shown.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Otvara prozor s prikazom 'url'.\n"
"            #  'url' može biti relativna putanja\n"
"            #   ili naziv datoteke, primjerice . ili podmapa/\n"
"            #   Ako se 'url' izostavi, prikazuje se početna stranica.\n"
"\n"

#: kfmclient.cpp:99
#, kde-format
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it "
"to\n"
"            #   text/html for a web page, to make it appear faster\n"
"            # Note: this way of specifying mimetype is deprecated.\n"
"            #   Please use the --mimetype option\n"
"\n"
msgstr ""
"            # Ako je navedena 'mimetype', koristit će se za određivanje\n"
"            #   komponente koju Konqueror treba koristiti. Primjerice, "
"postavite je na\n"
"            #   text/html za web-stranicu kako bi se brže prikazala.\n"
"            # Napomena: ovaj je način navođenja MIME vrste zastario.\n"
"            #   Koristite mogućnost --mimetype\n"
"\n"

#: kfmclient.cpp:104
#, kde-format
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing "
"Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Isto kao gore, ali otvara novu karticu s 'url' u postojećem\n"
"            #   prozoru Konquerora na trenutačnoj aktivnoj radnoj površini "
"ako je moguće.\n"
"\n"

#: kfmclient.cpp:280
#, kde-format
msgid "Syntax error, not enough arguments\n"
msgstr "Pogreška sintakse: nema dovoljno argumenata\n"

#: kfmclient.cpp:284
#, kde-format
msgid "Syntax error, too many arguments\n"
msgstr "Pogreška sintakse: previše argumenata\n"

#: kfmclient.cpp:339
#, kde-format
msgid "Syntax error, unknown command '%1'\n"
msgstr "Pogreška sintakse: nepoznata naredba „%1”\n"
