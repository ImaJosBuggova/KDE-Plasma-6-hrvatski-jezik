#: daemon/kup-daemon.desktop:2
msgctxt "Name"
msgid "Backup Scheduler"
msgstr "Planer sigurnosnih kopija"

#: daemon/kup-daemon.desktop:33
msgctxt "GenericName"
msgid "Backup Monitor"
msgstr "Nadzornik sigurnosnih kopija"

#: daemon/kupdaemon.notifyrc:3
msgctxt "Name"
msgid "Kup Backup System"
msgstr "Kup — sustav sigurnosnih kopija"

#: daemon/kupdaemon.notifyrc:42
msgctxt "Comment"
msgid "Kup Backup System"
msgstr "Sustav sigurnosnog kopiranja Kup"

#: daemon/kupdaemon.notifyrc:85
msgctxt "Name"
msgid "Start Saving Backup"
msgstr "Započni izradu sigurnosne kopije"

#: daemon/kupdaemon.notifyrc:124
msgctxt "Comment"
msgid "A question if user wants to start saving a backup"
msgstr "Pitanje želi li korisnik započeti izradu sigurnosne kopije"

#: daemon/kupdaemon.notifyrc:166
msgctxt "Name"
msgid "Backup Succeeded"
msgstr "Sigurnosna kopija uspješno izrađena"

#: daemon/kupdaemon.notifyrc:205
msgctxt "Comment"
msgid "Saving of backup successfully completed"
msgstr "Izrada sigurnosne kopije uspješno je dovršena"

#: daemon/kupdaemon.notifyrc:249
msgctxt "Name"
msgid "Backup Failed"
msgstr "Izrada sigurnosne kopije nije uspjela"

#: daemon/kupdaemon.notifyrc:288
msgctxt "Comment"
msgid "Saving of backup failed, offer user to see log file"
msgstr "Izrada sigurnosne kopije nije uspjela; ponudi korisniku pregled zapisnika"

#: daemon/kupdaemon.notifyrc:331
msgctxt "Name"
msgid "Integrity Check Completed"
msgstr "Provjera cjelovitosti dovršena"

#: daemon/kupdaemon.notifyrc:370
msgctxt "Comment"
msgid "Finished checking integrity of backup archive"
msgstr "Provjera cjelovitosti arhive sigurnosne kopije dovršena"

#: daemon/kupdaemon.notifyrc:414
msgctxt "Name"
msgid "Repair Completed"
msgstr "Popravak dovršen"

#: daemon/kupdaemon.notifyrc:453
msgctxt "Comment"
msgid "Finished repairing backup archive"
msgstr "Popravak arhive sigurnosne kopije dovršen"
