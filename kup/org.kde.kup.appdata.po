msgid "Kup"
msgstr "Kup"

#. (itstool) path: component/summary
#: org.kde.kup.appdata.xml:9
msgid "Backup scheduler for KDE's Plasma desktop"
msgstr "Planer sigurnosnih kopija za KDE-ovu radnu površinu Plasma"

#. (itstool) path: description/p
#: org.kde.kup.appdata.xml:11
msgid "Kup can help you remember to keep up-to-date backups of your personal files. It provides:"
msgstr "Kup vam pomaže da ne zaboravite redovito ažurirati sigurnosne kopije osobnih datoteka. Nudi:"

#. (itstool) path: ul/li
#: org.kde.kup.appdata.xml:13
msgid "Incremental backup archive with the use of \"bup\"."
msgstr "Inkrementalnu arhivu sigurnosne kopije pomoću programa „bup”."

#. (itstool) path: ul/li
#: org.kde.kup.appdata.xml:14
msgid "Synchronized folders with the use of \"rsync\"."
msgstr "Sinkronizirane mape pomoću programa „rsync”."

#. (itstool) path: ul/li
#: org.kde.kup.appdata.xml:15
msgid "Support for local filesystem or external usb storage."
msgstr "Podršku za lokalni datotečni sustav ili vanjsku USB pohranu."

#. (itstool) path: ul/li
#: org.kde.kup.appdata.xml:16
msgid "Monitor availability of backup destinations, like for example a mounted network storage."
msgstr "Nadzor dostupnosti odredišta sigurnosnih kopija, primjerice montirane mrežne pohrane."

#. (itstool) path: ul/li
#: org.kde.kup.appdata.xml:17
msgid "Integration into KDE's Plasma desktop."
msgstr "Integraciju u KDE-ovu radnu površinu Plasma."

