#: src/appactions.cpp:236
msgctxt "ghostwriter::AppActions|"
msgid "Shows the document outline."
msgstr "Prikazuje strukturu dokumenta."

#: src/appactions.cpp:238
msgctxt "ghostwriter::AppActions|"
msgid ""
"<p>Shows the document outline.</p><p>Use the mouse plus left click on a "
"heading in the document, or else the up and down arrows on the keyboard plus "
"the ENTER key, to jump to different locations within the current "
"document.</p>"
msgstr "<p>Prikazuje strukturu dokumenta.</p><p>Da biste skočili na drugo mjesto u dokumentu, kliknite lijevom tipkom miša naslov u dokumentu ili se krećite tipkama sa strelicama gore i dolje na tipkovnici te pritisnite ENTER.</p>"

