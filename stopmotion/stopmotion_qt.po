#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:560
msgctxt "MainWindowGUI|"
msgid "<h4>New</h4> <p>Creates a <em>new</em> project.</p>"
msgstr "<h4>Novo</h4> <p>Stvara <em>novi</em> projekt.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:565
msgctxt "MainWindowGUI|"
msgid "New project"
msgstr "Novi projekt"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:569
msgctxt "MainWindowGUI|"
msgid "<h4>Open</h4> <p><em>Opens</em> a Stopmotion project file.</p>"
msgstr "<h4>Otvori</h4> <p><em>Otvara</em> datoteku projekta Stopmotion.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:573
msgctxt "MainWindowGUI|"
msgid "Open project"
msgstr "Otvori projekt"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:577
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Save</h4> <p><em>Saves</em> the current animation as a Stopmotion "
"project file. <BR>If this project has been saved before it will "
"automatically be saved to the previously selected file.</p>"
msgstr ""
"<h4>Spremi</h4> <p><em>Sprema</em> trenutačnu animaciju kao datoteku projekta "
"Stopmotion. <BR>Ako je ovaj projekt već bio spremljen, automatski će se "
"spremiti u prethodno odabranu datoteku.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:583
msgctxt "MainWindowGUI|"
msgid "Save project"
msgstr "Spremi projekt"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:587
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Save As</h4> <p><em>Saves</em> the current animation as a Stopmotion "
"project file.</p>"
msgstr ""
"<h4>Spremi kao</h4> <p><em>Sprema</em> trenutačnu animaciju kao datoteku "
"projekta Stopmotion.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:592
msgctxt "MainWindowGUI|"
msgid "Save project As"
msgstr "Spremi projekt kao"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:596
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Video</h4> <p>Exports the current project as <em>video</em>.</p>You will "
"be given a wizard to guide you."
msgstr ""
"<h4>Videozapis</h4> <p>Izvozi trenutačni projekt kao <em>videozapis</em>.</p>"
"Čarobnjak će vas voditi kroz postupak."

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:603
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Cinerella</h4> <p>Exports the current animation as a <em>Cinerella</em> "
"project.</p>You will be given a wizard to guide you."
msgstr ""
"<h4>Cinerella</h4> <p>Izvozi trenutačnu animaciju kao projekt "
"<em>Cinerella</em>.</p>Čarobnjak će vas voditi kroz postupak."

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:610
msgctxt "MainWindowGUI|"
msgid "<h4>Quit</h4> <p><em>Quits</em> the program.</p>"
msgstr "<h4>Izlaz</h4> <p><em>Zatvara</em> program.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:614
msgctxt "MainWindowGUI|"
msgid "Quit"
msgstr "Izađi"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:620
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Undo</h4> <p><em>Undoes</em> your last operation. You can press undo "
"several time to undo earlier operations.</p>"
msgstr ""
"<h4>Poništi</h4> <p><em>Poništava</em> vašu posljednju radnju. Poništi možete "
"pritisnuti više puta kako biste poništili ranije radnje.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:625
msgctxt "MainWindowGUI|"
msgid "Undo"
msgstr "Poništi"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:629
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Redo</h4> <p><em>Redoes</em> your last operation. You can press redo "
"several times to redo several operations.</p>"
msgstr ""
"<h4>Ponovi</h4> <p><em>Ponavlja</em> vašu posljednju radnju. Možete "
"pritisnuti Ponovi više puta kako biste ponovili više radnji.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:634
msgctxt "MainWindowGUI|"
msgid "Redo"
msgstr "Ponovi"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:638
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Cut</h4> <p><em>Cuts</em> the selected frames out of the animation and "
"adds them to the clipboard so that you can paste them in somewhere else.</p>"
msgstr ""
"<h4>Izreži</h4> <p><em>Izrezuje</em> odabrane kadrove iz animacije i dodaje "
"ih u međuspremnik kako biste ih mogli zalijepiti negdje drugdje.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:643
msgctxt "MainWindowGUI|"
msgid "Cut"
msgstr "Izreži"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:647
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Copy</h4> <p><em>Copies</em> the selected frames to the clipboard. You "
"can then paste them in another place.</p>"
msgstr ""
"<h4>Kopiraj</h4> <p><em>Kopira</em> odabrane kadrove u međuspremnik. Zatim "
"ih možete zalijepiti na drugo mjesto.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:652
msgctxt "MainWindowGUI|"
msgid "Copy"
msgstr "Kopiraj"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:656
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Paste</h4> <p><em>Pastes</em> the frames which are currently in the "
"clipboard into the selected location.</p> <p>You can copy/cut images from "
"another programs and then use this option to paste them into this "
"animation.</p>"
msgstr ""
"<h4>Zalijepi</h4> <p><em>Zalijepi</em> kadrove iz međuspremnika na odabrano "
"mjesto.</p> <p>Slike možete kopirati ili izrezati iz drugih programa, a "
"zatim ih ovom mogućnošću zalijepiti u animaciju.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:662
msgctxt "MainWindowGUI|"
msgid "Paste"
msgstr "Zalijepi"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:666
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Go to frame</h4> <p>This will bring up a popup-menu at the bottom where "
"you can choose a frame you want to <em>go to</em>.</p>"
msgstr ""
"<h4>Idi na kadar</h4> <p>Pri dnu će se otvoriti skočni izbornik u kojem "
"možete odabrati kadar na koji želite <em>prijeći</em>.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:671
msgctxt "MainWindowGUI|"
msgid "Go to frame"
msgstr "Idi na kadar"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:675
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Configure Stopmotion</h4> <p>This will open a window where you can "
"<em>configure</em> Stopmotion with various input and output devices.</p>"
msgstr ""
"<h4>Konfiguriraj Stopmotion</h4> <p>Otvara se prozor u kojem možete "
"<em>konfigurirati</em> Stopmotion za razne ulazne i izlazne uređaje.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:680
msgctxt "MainWindowGUI|"
msgid "Configure Stopmotion"
msgstr "Konfiguriraj Stopmotion"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:686
msgctxt "MainWindowGUI|"
msgid ""
"<h4>What's This</h4> <p>This will give you a WhatsThis mouse cursor which "
"can be used to bring up helpful information like this.</p>"
msgstr ""
"<h4>Što je ovo</h4> <p>Pokazivač miša promijenit će se u pokazivač „Što je "
"ovo”, kojim možete prikazati korisne informacije poput ove.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:691
msgctxt "MainWindowGUI|"
msgid "What's This"
msgstr "Što je ovo"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:695
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Help</h4> <p>This button will bring up a dialog with the Stopmotion "
"manual</p>"
msgstr "<h4>Pomoć</h4> <p>Ovaj gumb otvara dijalog s priručnikom za Stopmotion.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:699
msgctxt "MainWindowGUI|"
msgid "Help"
msgstr "Pomoć"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:703
msgctxt "MainWindowGUI|"
msgid ""
"<h4>About</h4> <p>This will display a small information box where you can "
"read general information as well as the names of the developers behind this "
"excellent piece of software.</p>"
msgstr ""
"<h4>O programu</h4> <p>Prikazuje se mali prozor s općim informacijama i "
"imenima razvojnih programera koji stoje iza ovog izvrsnog softvera.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:709
msgctxt "MainWindowGUI|"
msgid "About"
msgstr "O programu"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:715
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Frame number</h4><p>This area displays the number of the currently "
"selected frame</p>"
msgstr "<h4>Broj kadra</h4><p>Ovo područje prikazuje broj trenutačno odabranog kadra.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:722
msgctxt "MainWindowGUI|"
msgid ""
"<h4>FrameView</h4><p> In this area you can see the selected frame. You can "
"also play animations in this window by pressing the <b>Play</b> button.</p>"
msgstr ""
"<h4>Prikaz kadra</h4><p>U ovom području možete vidjeti odabrani kadar. "
"Animaciju možete reproducirati i u ovom prozoru pritiskom gumba "
"<b>Reproduciraj</b>.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:729
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Go to frame menu</h4> <p>Here you can specify a framenumber and the "
"program will jump to the specified frame</p> "
msgstr ""
"<h4>Izbornik za prelazak na kadar</h4> <p>Ovdje možete navesti broj kadra, a "
"program će prijeći na navedeni kadar.</p> "

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:735
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Frame preferences menu</h4> <p>In this menu you can set preferences for "
"the selected frame/frames, such as <b>subtitles</b>, <b>sound effects</b>, "
"etc.</p>"
msgstr ""
"<h4>Izbornik postavki kadra</h4> <p>U ovom izborniku možete postaviti "
"mogućnosti za odabrani kadar ili kadrove, kao što su <b>podnaslovi</b>, "
"<b>zvučni efekti</b> itd.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:742
msgctxt "MainWindowGUI|"
msgid ""
"<h4>Tool menu</h4> <p>This is the tool menu where most of the buttons and "
"widgets you will need when working on stop motion animations are located.</p>"
msgstr ""
"<h4>Izbornik alata</h4> <p>Ovo je izbornik alata s većinom gumba i kontrola "
"koje će vam trebati za izradu animacija tehnikom stop-kadra.</p>"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:748
msgctxt "MainWindowGUI|"
msgid ""
"<h4>FrameBar</h4> <p>In this area you can see the frames and scenes in the "
"animations and build the animation by moving the them around.</p><p>You can "
"switch to the next and the previous frame using the <b>arrow buttons</b> or "
"<b>x</b> and <b>z</b></p> "
msgstr ""
"<h4>Traka kadrova</h4> <p>U ovom području možete vidjeti kadrove i scene u "
"animaciji te je sastavljati premještanjem kadrova.</p><p>Na sljedeći ili "
"prethodni kadar možete prijeći pomoću <b>gumba sa strelicama</b> ili tipki "
"<b>x</b> i <b>z</b>.</p> "

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:762
msgctxt "MainWindowGUI|"
msgid "Unsaved changes"
msgstr "Nespremljene promjene"

#: src/presentation/frontends/qtfrontend/mainwindowgui.cpp:763
