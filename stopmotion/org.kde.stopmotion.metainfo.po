#. (itstool) path: component/name
#: org.kde.stopmotion.metainfo.xml:10
msgid "Stopmotion"
msgstr "Stopmotion"

#. (itstool) path: component/summary
#: org.kde.stopmotion.metainfo.xml:11
msgid "Create stop-motion animations"
msgstr "Stvaranje animacija tehnikom stop-animacije"

#. (itstool) path: description/p
#: org.kde.stopmotion.metainfo.xml:13
msgid "Stopmotion is a program to create stop-motion animations. It captures the frames from a camera, shows the previous frames on top of the live image to place the objects, and plays the animation back."
msgstr "Stopmotion je program za stvaranje animacija tehnikom stop-animacije. Snima kadrove kamerom, prikazuje prethodne kadrove preko slike uživo kako bi se postavili objekti te reproducira animaciju."

#. (itstool) path: ul/li
#: org.kde.stopmotion.metainfo.xml:19
msgid "Capture frames from a webcam or import existing images"
msgstr "Snimanje kadrova web-kamerom ili uvoz postojećih slika"

#. (itstool) path: ul/li
#: org.kde.stopmotion.metainfo.xml:20
msgid "Onion skinning, differentiation and playback modes"
msgstr "Načini prikaza prethodnih kadrova, diferencijacije i reprodukcije"

#. (itstool) path: ul/li
#: org.kde.stopmotion.metainfo.xml:21
msgid "Organize the animation in scenes and add sounds to frames"
msgstr "Organiziranje animacije u prizore i dodavanje zvukova kadrovima"

#. (itstool) path: ul/li
#: org.kde.stopmotion.metainfo.xml:22
msgid "Export the animation to a video file"
msgstr "Izvoz animacije u videodatoteku"
