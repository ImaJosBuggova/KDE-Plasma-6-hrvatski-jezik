#. (itstool) path: component/name
#: org.kde.ktechlab.appdata.xml:11
msgid "KTechlab"
msgstr "KTechlab"

#. (itstool) path: component/summary
#: org.kde.ktechlab.appdata.xml:12
msgid "IDE for microcontrollers and electronics"
msgstr "Integrirano razvojno okruženje za mikrokontrolere i elektroniku"

#. (itstool) path: description/p
#: org.kde.ktechlab.appdata.xml:14
msgid "KTechlab is an IDE for microcontrollers and electronics designed to be as easy to use and unintrusive as possible."
msgstr "KTechlab je integrirano razvojno okruženje za mikrokontrolere i elektroniku, osmišljeno da bude što jednostavnije za uporabu i nenametljivo."

#. (itstool) path: description/p
#: org.kde.ktechlab.appdata.xml:17
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:19
msgid "Wide range of components with editable characteristics"
msgstr "Širok izbor komponenti s mogućnošću uređivanja svojstava"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:20
msgid "Visual editor for circuits"
msgstr "Vizualni uređivač električnih krugova"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:21
msgid "Context help for the components"
msgstr "Kontekstna pomoć za komponente"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:22
msgid "Two modes of connector routing: automatic and manual"
msgstr "Dva načina usmjeravanja veza: automatski i ručni"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:23
msgid "Several ways to define the PIC logic: assembly code, Microbe (own high level programming language) code, C code, and visual FlowCode"
msgstr "Više načina definiranja logike PIC-a: asemblerski kod, kod u Microbeu (vlastitom programskom jeziku visoke razine), kod u jeziku C i vizualni FlowCode"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:24
msgid "Interconversion of the programming code between supported languages"
msgstr "Pretvorba programskog koda između podržanih jezika"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:25
msgid "Inbuilt debugger"
msgstr "Ugrađeni ispravljač pogrešaka"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:26
msgid "Simulation with oscilloscope and probes"
msgstr "Simulacija uz osciloskop i sonde"

#. (itstool) path: ul/li
#: org.kde.ktechlab.appdata.xml:27
msgid "Uploading the assembly code to PIC using hardware programmer"
msgstr "Učitavanje asemblerskog koda u PIC pomoću hardverskog programatora"

#. (itstool) path: description/p
#: org.kde.ktechlab.appdata.xml:41
msgid "This release should compile and run on systems where KDELibs4Support libraries are not available."
msgstr "Ovo bi se izdanje trebalo moći prevesti i pokrenuti na sustavima na kojima biblioteke KDELibs4Support nisu dostupne."
