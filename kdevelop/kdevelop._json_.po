#: plugins/astyle/kdevastyle.json
msgctxt "Description"
msgid ""
"A plugin for formatting of sourcecode according to a specified set of rules"
msgstr "Dodatak za oblikovanje izvornog koda prema zadanom skupu pravila"

#: plugins/bazaar/kdevbazaar.json
msgctxt "Description"
msgid "This plugin integrates Bazaar to KDevelop"
msgstr "Ovaj dodatak integrira Bazaar u KDevelop"

#: plugins/clang/kdevclangsupport.json
msgctxt "Description"
msgid "C/C++ Language Support (Clang-based)"
msgstr "Podrška za jezike C/C++ (temeljena na Clangu)"

#: plugins/clangtidy/kdevclangtidy.json
msgctxt "Description"
msgid ""
"clang-tidy provides an extensible framework for diagnosing and fixing "
"typical programming errors, like style violations, interface misuse, or bugs "
"that can be deduced via static analysis. https://clang.llvm.org/extra/clang-"
"tidy/"
msgstr "clang-tidy nudi proširiv okvir za otkrivanje i ispravljanje uobičajenih pogrešaka u programiranju, poput kršenja stilskih pravila, pogrešne upotrebe sučelja ili grešaka koje se mogu otkriti statičkom analizom. https://clang.llvm.org/extra/clang-tidy/"

#: plugins/classbrowser/kdevclassbrowser.json
msgctxt "Description"
msgid ""
"This plugin provides a browsable model of the currently parsed classes and "
"other items."
msgstr "Ovaj dodatak nudi pregledni model trenutačno raščlanjenih klasa i drugih stavki."

#: plugins/clazy/kdevclazy.json
msgctxt "Description"
msgid "This plugin integrates Clazy to KDevelop"
msgstr "Ovaj dodatak integrira Clazy u KDevelop"

#: plugins/cmakebuilder/kdevcmakebuilder.json
msgctxt "Description"
msgid "Builds CMake Projects"
msgstr "Izgrađuje projekte CMake"

#: plugins/cmake/kdevcmakedocumentation.json
msgctxt "Description"
msgid "Allows KDevelop to provide CMake documentation"
msgstr "Omogućuje KDevelopu pružanje dokumentacije za CMake"

#: plugins/cmake/kdevcmakemanager.json
msgctxt "Description"
msgid "Allows KDevelop to manage CMake-based projects"
msgstr "Omogućuje KDevelopu upravljanje projektima temeljenima na CMakeu"

#: plugins/codeutils/kdevcodeutils.json
msgctxt "Description"
msgid ""
"Collection of various utilities that increase productivity while programming."
msgstr "Zbirka raznih pomoćnih alata koji povećavaju produktivnost pri programiranju."

#: plugins/contextbrowser/kdevcontextbrowser.json
msgctxt "Description"
msgid ""
"This plugin shows information about the current language context in a side "
"view, and highlights relevant declarations and uses."
msgstr "Ovaj dodatak prikazuje informacije o trenutačnom jezičnom kontekstu u bočnom prikazu te ističe relevantne deklaracije i upotrebe."

#: plugins/cppcheck/kdevcppcheck.json
msgctxt "Description"
msgid "This plugin integrates Cppcheck (static analysis tool) to KDevelop"
msgstr "Ovaj dodatak integrira alat za statičku analizu Cppcheck u KDevelop"

#: plugins/craft/kdevcraft.json
msgctxt "Description"
msgid "Exposes KDE Craft environment as a runtime"
msgstr "Omogućuje korištenje okruženja KDE Craft kao okruženja za izvođenje"

#: plugins/custom-buildsystem/kdevcustombuildsystem.json
msgctxt "Description"
msgid "Allows to use custom buildsystems for KDevelop projects"
msgstr "Omogućuje upotrebu prilagođenih sustava izgradnje za projekte KDevelopa"

#: plugins/custom-definesandincludes/kdevdefinesandincludesmanager.json
msgctxt "Description"
msgid ""
"Configure which macros and include directories/files will be added to the "
"parser during project parsing."
msgstr "Konfigurira makronaredbe i uključene direktorije/datoteke koje će se dodati u raščlanjivač tijekom raščlambe projekta."

#: plugins/custommake/kdevcustommakemanager.json
msgctxt "Description"
msgid "Imports and edits custom make projects"
msgstr "Uvozi i uređuje prilagođene projekte Make"

#: plugins/customscript/kdevcustomscript.json
msgctxt "Description"
msgid "A plugin for formatting C files using custom scripts"
msgstr "Dodatak za oblikovanje datoteka C pomoću prilagođenih skripti"

#: plugins/docker/kdevdocker.json
msgctxt "Description"
msgid "Exposes Docker runtimes"
msgstr "Omogućuje korištenje Dockerovih okruženja"

#: plugins/documentswitcher/kdevdocumentswitcher.json
msgctxt "Description"
msgid "A most-recently-used document switcher for KDevPlatform."
msgstr "Prebacivač najčešće korištenih dokumenata za KDevPlatform."

#: plugins/documentview/kdevdocumentview.json
msgctxt "Description"
msgid ""
"This plugin displays a graphical view of all documents currently loaded and "
"separates them by mimetype."
msgstr "Ovaj dodatak prikazuje grafički prikaz svih trenutačno učitanih dokumenata i razvrstava ih prema MIME vrsti."

#: plugins/execute/kdevexecute.json
msgctxt "Description"
msgid ""
"This plugin allows running of programs with no instrumentor, ie. natively by "
"the current host."
msgstr "Ovaj dodatak omogućuje pokretanje programa bez instrumentacije, odnosno izvorno na trenutačnom računalu."

#: plugins/executeplasmoid/kdevexecuteplasmoid.json
msgctxt "Description"
msgid "Lets you view a plasmoid"
msgstr "Omogućuje pregled plazmoida"

#: plugins/executescript/kdevexecutescript.json
msgctxt "Description"
msgid "This plugin allows running of scripts."
msgstr "Ovaj dodatak omogućuje pokretanje skripti."

#: plugins/externalscript/kdevexternalscript.json
msgctxt "Description"
msgid ""
"Run external scripts or applications to manipulate the editor contents or do "
"other arbitrary actions."
msgstr "Pokreće vanjske skripte ili aplikacije za obradu sadržaja uređivača ili izvođenje drugih radnji."

#: plugins/filemanager/kdevfilemanager.json
msgctxt "Description"
msgid "This plugin brings a filemanager to KDevelop."
msgstr "Ovaj dodatak donosi upravitelj datoteka u KDevelop."

#: plugins/filetemplates/kdevfiletemplates.json
msgctxt "Description"
msgid "Manages templates for source files"
msgstr "Upravlja predlošcima datoteka izvornog koda"

#: plugins/flatpak/kdevflatpak.json
msgctxt "Description"
msgid "Exposes Flatpak runtimes"
msgstr "Omogućuje korištenje Flatpakovih okruženja"

#: plugins/gdb/kdevgdb.json
msgctxt "Description"
msgid ""
"This plugin provides a frontend for GDB, a source-level debugger for C, C++ "
"and more."
msgstr "Ovaj dodatak pruža sučelje za GDB, program za uklanjanje pogrešaka na razini izvornog koda za C, C++ i druge jezike."

#: plugins/genericprojectmanager/kdevgenericmanager.json
msgctxt "Description"
msgid "Allow KDevelop to manage generic projects"
msgstr "Omogućuje KDevelopu upravljanje općim projektima"

#: plugins/ghprovider/kdevghprovider.json
msgctxt "Description"
msgid "This plugin helps to obtain projects from GitHub"
msgstr "Ovaj dodatak pomaže pri dohvaćanju projekata s GitHuba"

#: plugins/git/kdevgit.json
msgctxt "Description"
msgid "This plugin integrates Git to KDevelop"
msgstr "Ovaj dodatak integrira Git u KDevelop"

#: plugins/grepview/kdevgrepview.json
msgctxt "Description"
msgid ""
"Allows fast searching of multiple files using patterns or regular "
"expressions. And allow to replace it too."
msgstr "Omogućuje brzo pretraživanje više datoteka pomoću uzoraka ili regularnih izraza te njihovu zamjenu."

#: plugins/heaptrack/kdevheaptrack.json
msgctxt "Description"
msgid "This plugin integrates Heaptrack to KDevelop"
msgstr "Ovaj dodatak integrira Heaptrack u KDevelop"

#: plugins/konsole/kdevkonsoleview.json
msgctxt "Description"
msgid ""
"This plugin provides KDevelop with an embedded konsole for quick and easy "
"command line access."
msgstr "Ovaj dodatak ugrađuje konzolu u KDevelop radi brzog i jednostavnog pristupa naredbenom retku."

#: plugins/lldb/kdevlldb.json
msgctxt "Description"
msgid ""
"This plugin provides a frontend for LLDB, a next generation, high-"
"performance C/Obj-C/C++ debugger."
msgstr "Ovaj dodatak pruža sučelje za LLDB, napredni program za uklanjanje pogrešaka visokih performansi za C, Objective-C i C++."

#: plugins/makebuilder/kdevmakebuilder.json
msgctxt "Description"
msgid "KDevelop Make Builder"
msgstr "Alat za izgradnju Make za KDevelop"

#: plugins/manpage/kdevmanpage.json
msgctxt "Description"
msgid "This plugin provides Manual Pages integration"
msgstr "Ovaj dodatak integrira stranice priručnika"

#: plugins/meson/kdevmesonmanager.json
msgctxt "Description"
msgid "Imports and edits Meson projects"
msgstr "Uvozi i uređuje projekte Meson"

#: plugins/ninjabuilder/kdevninja.json
msgctxt "Description"
msgid "KDevelop Ninja Builder"
msgstr "Alat za izgradnju Ninja za KDevelop"

#: plugins/okteta/kdevokteta.json
msgctxt "Description"
msgid "Enables viewing and editing of the raw data of files (Okteta-based)"
msgstr "Omogućuje pregled i uređivanje sirovih podataka datoteka (temeljeno na Okteti)"

#: plugins/openwith/kdevopenwith.json
msgctxt "Description"
msgid ""
"This plugin allows one to open files with associated external applications."
msgstr "Ovaj dodatak omogućuje otvaranje datoteka u povezanim vanjskim aplikacijama."

#: plugins/outlineview/kdevoutlineview.json
msgctxt "Description"
msgid ""
"This plugin provides a view to show the outline of the currently open "
"document."
msgstr "Ovaj dodatak prikazuje strukturu trenutačno otvorenog dokumenta."

#: plugins/patchreview/kdevpatchreview.json
msgctxt "Description"
msgid "This plugin allows reviewing patches directly in the editor."
msgstr "Ovaj dodatak omogućuje pregled zakrpa izravno u uređivaču."

#: plugins/perforce/kdevperforce.json
msgctxt "Description"
msgid "Provides Integration with Perforce Version Control System"
msgstr "Pruža integraciju sa sustavom za upravljanje inačicama Perforce"

#: plugins/problemreporter/kdevproblemreporter.json
msgctxt "Description"
msgid "This plugin shows errors in source code."
msgstr "Ovaj dodatak prikazuje pogreške u izvornom kodu."

#: plugins/projectfilter/kdevprojectfilter.json
msgctxt "Description"
msgid ""
"Configure which files and folders inside the project folder should be "
"included or excluded."
msgstr "Konfigurira koje datoteke i mape unutar mape projekta treba uključiti ili izuzeti."

#: plugins/projectmanagerview/kdevprojectmanagerview.json
msgctxt "Description"
msgid "Lets you manage the project contents."
msgstr "Omogućuje upravljanje sadržajem projekta."

#: plugins/qmakebuilder/kdevqmakebuilder.json
msgctxt "Description"
msgid "Builds QMake Projects"
msgstr "Izgrađuje projekte QMake"

#: plugins/qmakemanager/kdevqmakemanager.json
msgctxt "Description"
msgid "Imports and edits QMake projects"
msgstr "Uvozi i uređuje projekte QMake"

#: plugins/qmljs/kdevqmljs.json
msgctxt "Description"
msgid "QML/JS language support (based on qmljs from QtCreator)"
msgstr "Podrška za jezike QML/JS (temeljena na qmljsu iz Qt Creatora)"

#: plugins/qthelp/kdevqthelp.json
msgctxt "Description"
msgid "This plugin provides QtHelp integration"
msgstr "Ovaj dodatak integrira QtHelp"

#: plugins/quickopen/kdevquickopen.json
msgctxt "Description"
msgid ""
"This plugin allows quick access to project files and language-items like "
"classes/functions."
msgstr "Ovaj dodatak omogućuje brz pristup datotekama projekta i jezičnim stavkama poput klasa i funkcija."

#: plugins/scratchpad/scratchpad.json
msgctxt "Description"
msgid ""
"Scratchpad lets you quickly run and experiment with code without a full "
"project, and even store todos."
msgstr "Ploča za bilješke omogućuje brzo pokretanje i isprobavanje koda bez cijelog projekta te spremanje popisa zadataka."

#: plugins/sourceformatter/kdevsourceformatter.json
msgctxt "Description"
msgid ""
"Configure which style should be used for formatting of the sourcecode in a "
"project."
msgstr "Konfigurira stil koji se koristi za oblikovanje izvornog koda projekta."

#: plugins/standardoutputview/kdevstandardoutputview.json
msgctxt "Description"
msgid ""
"Provides a text output tool view for other plugins to use, to show things "
"like compiler messages."
msgstr "Pruža prikaz tekstnog izlaza koji drugi dodaci mogu koristiti za prikaz poruka prevoditelja i sličnog."

#: plugins/subversion/kdevsubversion.json
msgctxt "Description"
msgid "This plugin integrates Subversion to KDevelop."
msgstr "Ovaj dodatak integrira Subversion u KDevelop."

#: plugins/switchtobuddy/kdevswitchtobuddy.json
msgctxt "Description"
msgid ""
"Allows switching between buddy documents like implementation and header file."
msgstr "Omogućuje prebacivanje između povezanih dokumenata, primjerice implementacijske datoteke i datoteke zaglavlja."

#: plugins/testview/kdevtestview.json
msgctxt "Description"
msgid "Lets you see and run unit tests."
msgstr "Omogućuje pregled i pokretanje jediničnih testova."

#: plugins/vcschangesview/kdevvcschangesview.json
msgctxt "Description"
msgid ""
"This plugin provides integration between the projects and their VCS "
"infrastructure"
msgstr "Ovaj dodatak povezuje projekte s infrastrukturom sustava za upravljanje inačicama."

#: plugins/welcomepage/kdevwelcomepage.json
msgctxt "Description"
msgid "Provides the welcome page visible in an empty session"
msgstr "Pruža pozdravnu stranicu koja se prikazuje u praznoj sesiji"

