#: checksdb.cpp:37
#, kde-format
msgid ""
"Very stable checks, 99.99% safe, mostly no false-positives, very desirable."
msgstr "Vrlo stabilne provjere, 99,99 % sigurne, uglavnom bez lažno pozitivnih rezultata i vrlo poželjne."

#: checksdb.cpp:40
#, kde-format
msgid ""
"The default level. Very similar to level 0, slightly more false-positives "
"but very few."
msgstr "Zadana razina. Vrlo je slična razini 0, s nešto više lažno pozitivnih rezultata, ali ih je i dalje vrlo malo."

#: checksdb.cpp:43
#, kde-format
msgid ""
"Also very few false-positives, but contains noisy checks which not everyone "
"agree should be default."
msgstr "Također ima vrlo malo lažno pozitivnih rezultata, ali sadrži bučne provjere za koje se ne slažu svi da bi trebale biti zadane."

#: checksdb.cpp:46
#, kde-format
msgid "Contains checks with high rate of false-positives."
msgstr "Sadrži provjere s velikim udjelom lažno pozitivnih rezultata."

#: checksdb.cpp:49
#, kde-format
msgid ""
"Checks here need to be enabled explicitly, as they don't belong to any "
"level. Checks here are very stable and have very few false-positives."
msgstr "Ove provjere treba izričito uključiti jer ne pripadaju nijednoj razini. Vrlo su stabilne i imaju vrlo malo lažno pozitivnih rezultata."

