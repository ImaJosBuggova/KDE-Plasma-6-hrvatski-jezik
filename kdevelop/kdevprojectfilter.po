msgstr "Isključi"

#: projectfilterconfigpage.cpp:172
#, kde-format
msgid ""
"A filter with an empty pattern will match all items. Use <code>\"*\"</code> "
"to make this explicit."
msgstr "Filtar s praznim uzorkom podudara se sa svim stavkama. Koristite <code>\"*\"</code> kako biste to izričito naveli."

#: projectfilterconfigpage.cpp:175
#, kde-format
msgid "A filter ending on <code>\"/\"</code> can never match a file."
msgstr "Filtar koji završava s <code>\"/\"</code> nikad se ne može podudarati s datotekom."

