#: editexternalscript.cpp:30
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines the command that should be executed when this script is run. "
"Basic shell features of your platform should be available.</p>\n"
"<p>There are a few placeholders you can use in the command:</p>\n"
"<dl>\n"
"  <dt><code>%u</code></dt>\n"
"  <dd>Gets replaced by the URL of the active document.</dd>\n"
"  <dt><code>%f</code></dt>\n"
"  <dd>Gets replaced by the local filepath to the active document.</dd>\n"
"  <dt><code>%n</code></dt>\n"
"  <dd>Gets replaced by the name of the active document, including its "
"extension.</dd>\n"
"  <dt><code>%b</code></dt>\n"
"  <dd>Gets replaced by the name of the active document without its extension."
"</dd>\n"
"  <dt><code>%d</code></dt>\n"
"  <dd>Gets replaced by the path to the directory of the active document.</"
"dd>\n"
"  <dt><code>%p</code></dt>\n"
"  <dd>Gets replaced by the URL to the project of the active document.</dd>\n"
"  <dt><code>%s</code></dt>\n"
"  <dd>Gets replaced with the shell escaped contents of the selection in the "
"active document.</dd>\n"
"  <dt><code>%i</code></dt>\n"
"  <dd>Gets replaced with the PID of the currently running KDevelop process.</"
"dd>\n"
"</dl>\n"
"<p><b>NOTE:</b>  It is your responsibility to prevent running hazardous "
"commands that could lead to data loss.</p>\n"
msgstr ""
"<p>Određuje naredbu koja će se izvršiti pri pokretanju ove skripte. Trebale "
"bi biti dostupne osnovne značajke ljuske vašeg sustava.</p>\n"
"<p>U naredbi možete koristiti nekoliko rezerviranih mjesta:</p>\n"
"<dl>\n"
"  <dt><code>%u</code></dt>\n"
"  <dd>Zamjenjuje se URL-om aktivnog dokumenta.</dd>\n"
"  <dt><code>%f</code></dt>\n"
"  <dd>Zamjenjuje se lokalnom putanjom datoteke aktivnog dokumenta.</dd>\n"
"  <dt><code>%n</code></dt>\n"
"  <dd>Zamjenjuje se nazivom aktivnog dokumenta, uključujući datotečni "
"nastavak.</dd>\n"
"  <dt><code>%b</code></dt>\n"
"  <dd>Zamjenjuje se nazivom aktivnog dokumenta bez datotečnog nastavka.</dd>\n"
"  <dt><code>%d</code></dt>\n"
"  <dd>Zamjenjuje se putanjom do direktorija aktivnog dokumenta.</dd>\n"
"  <dt><code>%p</code></dt>\n"
"  <dd>Zamjenjuje se URL-om projekta aktivnog dokumenta.</dd>\n"
"  <dt><code>%s</code></dt>\n"
"  <dd>Zamjenjuje se sadržajem odabira u aktivnom dokumentu, uz escapiranje "
"posebnih znakova ljuske.</dd>\n"
"  <dt><code>%i</code></dt>\n"
"  <dd>Zamjenjuje se PID-om trenutačno pokrenutog procesa KDevelopa.</dd>\n"
"</dl>\n"
"<p><b>NAPOMENA:</b> Vaša je odgovornost spriječiti pokretanje opasnih naredbi "
"koje bi mogle dovesti do gubitka podataka.</p>\n"

#: editexternalscript.cpp:56
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines what the external script should get as input (via <code>STDIN</"
"code>).</p>"
msgstr "<p>Određuje što će vanjska skripta primiti kao ulaz (putem <code>STDIN</code>).</p>"

#: editexternalscript.cpp:62
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines what should be done with the output (i.e. <code>STDOUT</code>) of "
"the script.</p>"
msgstr "<p>Određuje što će se učiniti s izlazom skripte (tj. <code>STDOUT</code>).</p>"

#: editexternalscript.cpp:68
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines what should be done with the errors (i.e. <code>STDERR</code>) of "
"the script.</p><p>Note: if the action is the same as that chosen for the "
"output, the channels will be merged and handled together.</p>"
msgstr "<p>Određuje što će se učiniti s pogreškama skripte (tj. <code>STDERR</code>).</p>"
"<p>Napomena: ako je odabrana ista radnja kao za izlaz, kanali će se spojiti i obraditi zajedno.</p>"

#: editexternalscript.cpp:76
#, kde-format
msgctxt "@info:tooltip"
msgid "<p>Defines the name of the script. Just for displaying purposes.</p>"
msgstr "<p>Određuje naziv skripte. Služi samo za prikaz.</p>"

#: editexternalscript.cpp:82
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines the shortcut(s) you can use to execute this external script.</p>"
msgstr "<p>Određuje tipkovne prečace za pokretanje ove vanjske skripte.</p>"

#: editexternalscript.cpp:88
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines whether documents should be saved before the script gets executed."
"</p>"
msgstr "<p>Određuje treba li spremiti dokumente prije pokretanja skripte.</p>"

#: editexternalscript.cpp:94
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines whether the output of the script should be shown in a tool view.</"
"p>"
msgstr "<p>Određuje treba li prikazati izlaz skripte u prikazu alata.</p>"

#: editexternalscript.cpp:98
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<p>Defines what type of filtering should be applied to the output. E.g. to "
"indicate errors by red text.</p>"
msgstr "<p>Određuje vrstu filtra za izlaz, primjerice za označavanje pogrešaka crvenim tekstom.</p>"

