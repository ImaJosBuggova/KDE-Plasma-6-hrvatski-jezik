#: midebugger.cpp:319
#, kde-format
msgctxt "<b>Internal debugger error</b>"
msgid ""
"<p>The debugger component encountered an internal error while processing the "
"reply from the debugger. Please submit a bug report. The debug session will "
"now end to prevent potential crash"
msgstr ""
"<p>Komponenta programa za ispravljanje pogrešaka naišla je na internu "
"pogrešku tijekom obrade odgovora programa za ispravljanje pogrešaka. "
"Pošaljite izvješće o grešci. Sesija ispravljanja pogrešaka sada će završiti "
"kako bi se spriječilo moguće rušenje."

#: midebugger.cpp:322
#, kde-format
msgid ""
"The exception is: %1\n"
"The MI response is: %2"
msgstr ""
"Iznimka: %1\n"
"Odgovor MI-ja: %2"

