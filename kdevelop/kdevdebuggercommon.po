#: stty.cpp:269
#, kde-format
msgid ""
"Cannot use the tty* or pty* devices.\n"
"Check the settings on /dev/tty* and /dev/pty*\n"
"As root you may need to \"chmod ug+rw\" tty* and pty* devices and/or add the "
"user to the tty group using \"usermod -aG tty username\"."
msgstr ""
"Nije moguće koristiti uređaje tty* ili pty*.\n"
"Provjerite postavke za /dev/tty* i /dev/pty*.\n"
"Kao administrator možda ćete trebati pokrenuti „chmod ug+rw” za uređaje tty* "
"i pty* i/ili dodati korisnika u grupu tty naredbom "
"„usermod -aG tty korisničko_ime”."

