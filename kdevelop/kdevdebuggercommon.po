#: widgets/debuggerconsoleview.cpp:50
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<b>Debugger Console</b><p>Shows all debugger commands being executed. You "
"can also issue any other debugger command while debugging.</p>"
msgstr ""
"<b>Konzola programa za ispravljanje pogrešaka</b><p>Prikazuje sve naredbe "
"koje se izvršavaju u programu za ispravljanje pogrešaka. Tijekom ispravljanja "
"možete zadati i bilo koju drugu naredbu.</p>"

#: widgets/debuggerconsoleview.cpp:59
#, kde-format
msgctxt "@info:tooltip"
msgid "Repeat last command when hit Return"
msgstr "Ponovi posljednju naredbu pritiskom na Enter"

