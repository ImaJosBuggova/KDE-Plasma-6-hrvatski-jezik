#. i18n: ectx: property (whatsThis), widget (QGroupBox, groupBox)
#: gdbconfigpage.ui:178
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"This script is intended for the actual commands needed to connect to a "
"remotely running executable.\n"
"\tshell sleep 5\twait for remote program to start\n"
"\ttarget remote ...\tconnect to the remote debugger\n"
"\tcontinue\t[optional] run debugging to the first breakpoint"
msgstr "Ova skripta sadrži naredbe potrebne za povezivanje s udaljeno pokrenutom izvršnom datotekom.\n"
"\tshell sleep 5\tpričekaj pokretanje udaljenog programa\n"
"\ttarget remote ...\tpoveži se s udaljenim programom za uklanjanje pogrešaka\n"
"\tcontinue\t[neobavezno] nastavi izvođenje do prve prijelomne točke"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: gdbconfigpage.ui:181
#, kde-format
msgctxt "@title:group"
msgid "Remote Debugging"
msgstr "Udaljeno uklanjanje pogrešaka"

#. i18n: ectx: property (toolTip), widget (QLabel, runShellScript_label)
#. i18n: ectx: property (toolTip), widget (KUrlRequester, kcfg_runShellScript)
#: gdbconfigpage.ui:187 gdbconfigpage.ui:203
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<html><head/><body><p>Script to start remote application</p><p></p><p>This "
"shell script is run after the Gdb Config script has been sourced by gdb.</"
"p><p>It's purpose is to actually start the remote process.</p><p>1) Find a "
"way to execute a command remotely - rsh, ssh, telnet, ...</p><p>2a) Execute "
"&quot;gdbserver ... application&quot; on target.</p><p>or if your executable "
"contains the gdb stub:</p><p>2b) Execute &quot;application&quot; on target.</"
"p></body></html>"
msgstr ""
"<html><head/><body><p>Skripta za pokretanje udaljene aplikacije</p><p></p>"
"<p>Ova se skripta ljuske pokreće nakon što GDB učita konfiguracijsku skriptu. "
"Služi za pokretanje udaljenog procesa.</p><p>1) Pronađite način za udaljeno "
"izvršavanje naredbe — rsh, ssh, telnet...</p><p>2a) Na ciljnom sustavu "
"izvršite &quot;gdbserver ... application&quot;.</p><p>Ako izvršna datoteka "
"sadrži GDB poslužitelj:</p><p>2b) Na ciljnom sustavu izvršite "
"&quot;application&quot;.</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, runShellScript_label)
#: gdbconfigpage.ui:190
#, kde-format
msgctxt "@label:chooser Shell script to be executed at run time"
msgid "R&un shell script:"
msgstr "Pokreni skriptu &ljuske:"

#. i18n: ectx: property (toolTip), widget (QLabel, configGdbScript_label)
#. i18n: ectx: property (toolTip), widget (KUrlRequester, kcfg_configGdbScript)
#: gdbconfigpage.ui:210 gdbconfigpage.ui:249
#, kde-format
msgctxt "@info:tooltip"
msgid "This script is sourced by gdb when the debugging starts."
msgstr "GDB učitava ovu skriptu pri početku uklanjanja pogrešaka."

#. i18n: ectx: property (text), widget (QLabel, configGdbScript_label)
#: gdbconfigpage.ui:213
#, kde-format
msgctxt "@label:chooser"
msgid "Gdb &config script:"
msgstr "Kon&figuracijska skripta GDB-a:"

#. i18n: ectx: property (toolTip), widget (KUrlRequester, kcfg_runGdbScript)
#. i18n: ectx: property (toolTip), widget (QLabel, runGdbScript_label)
#: gdbconfigpage.ui:226 gdbconfigpage.ui:233
#, kde-format
msgctxt "@info:tooltip"
msgid ""
"<html><head/><body><p>Script to connect with remote application</p><p>For "
"example:</p><p>\tshell sleep 5\t #wait for remote program to start</p><p>"
"\ttarget remote ...\t#connect to the remote debugger</p><p>\tcontinue"
"\t#[optional] run debugging to the first breakpoint.</p></body></html>"
msgstr ""
"<html><head/><body><p>Skripta za povezivanje s udaljenom aplikacijom</p>"
"<p>Primjer:</p><p>\tshell sleep 5\t #pričekaj pokretanje udaljenog programa</p>"
"<p>\ttarget remote ...\t#poveži se s udaljenim programom za uklanjanje pogrešaka</p>"
"<p>\tcontinue\t#[neobavezno] nastavi do prve prijelomne točke.</p></body></html>"

#. i18n: ectx: property (text), widget (QLabel, runGdbScript_label)
#: gdbconfigpage.ui:236
#, kde-format
msgctxt "@label:chooser Gdb script to be executed at run time."
msgid "Run &gdb script:"
msgstr "Pokreni skriptu &GDB-a:"

