#: debugger/breakpoint/breakpointdetails.cpp:142
#, kde-format
msgid ""
"<b>Breakpoint is pending</b><p>Pending breakpoints are those that have been "
"passed to GDB, but which are not yet installed in the target, because GDB "
"cannot find the function or file to which the breakpoint refers. The most "
"common case is a breakpoint in a shared library: GDB will insert this "
"breakpoint only when the library is loaded.</p>"
msgstr ""
"<b>Prijelomna točka je na čekanju</b><p>Prijelomne točke na čekanju predane "
"su GDB-u, ali još nisu postavljene u ciljnom programu jer GDB ne može "
"pronaći funkciju ili datoteku na koju se prijelomna točka odnosi. Najčešći "
"je slučaj prijelomna točka u dijeljenoj biblioteci: GDB će je umetnuti tek "
"kada se biblioteka učita.</p>"

#: debugger/breakpoint/breakpointdetails.cpp:155
#, kde-format
msgid ""
"<b>Breakpoint is dirty</b><p>The breakpoint has not yet been passed to the "
"debugger.</p>"
msgstr "<b>Prijelomna točka je izmijenjena</b><p>Prijelomna točka još nije predana programu za ispravljanje pogrešaka.</p>"

