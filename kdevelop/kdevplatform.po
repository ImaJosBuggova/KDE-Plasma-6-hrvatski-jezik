#: debugger/variable/variablewidget.cpp:121
#, kde-format
msgid ""
"<b>Variable tree</b>The variable tree allows you to see the values of local "
"variables and arbitrary expressions.<br />Local variables are displayed "
"automatically and are updated as you step through your program. For each "
"expression you enter, you can either evaluate it once, or \"watch\" it (make "
"it auto-updated). Expressions that are not auto-updated can be updated "
"manually from the context menu. Expressions can be renamed to more "
"descriptive names by clicking on the name column.<br />To change the value "
"of a variable or an expression, click on the value.<br />"
msgstr "<b>Stablo varijabli</b>Stablo varijabli omogućuje pregled vrijednosti lokalnih varijabli i proizvoljnih izraza.<br />Lokalne se varijable prikazuju automatski i ažuriraju dok prolazite kroz program. Za svaki uneseni izraz možete ga jednom izračunati ili ga pratiti (automatski ažurirati). Izrazi koji se ne ažuriraju automatski mogu se ručno ažurirati iz kontekstnog izbornika. Izraze možete preimenovati u opisnije nazive klikom na stupac s nazivima.<br />Za promjenu vrijednosti varijable ili izraza kliknite vrijednost.<br />"

#: debugger/variable/variablewidget.cpp:135
#, kde-format
msgid "<b>Expression entry</b>Type in expression to watch."
msgstr "<b>Unos izraza</b>Upišite izraz koji želite pratiti."

