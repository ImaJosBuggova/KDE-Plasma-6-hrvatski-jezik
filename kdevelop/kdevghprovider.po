#, kde-format
msgid "Waiting for response"
msgstr "Čeka se odgovor"

#: ghdialog.cpp:126
#, kde-format
msgid ""
"Authentication failed. Please try again.\n"
"\n"
"Could not create token: \"%1\"\n"
"%2"
msgstr ""
"Provjera autentičnosti nije uspjela. Pokušajte ponovno.\n"
"\n"
"Nije moguće stvoriti token: „%1”\n"
"%2"

#: ghdialog.cpp:129
#, kde-format
msgctxt "@title:window"
msgid "GitHub Authorization Failed"
msgstr "Ovlašćivanje za GitHub nije uspjelo"

#: ghdialog.cpp:133
#, kde-format
msgid ""
"Authentication succeeded.\n"
"\n"
"Created token: \"%1\"\n"
"%2"
msgstr ""
"Provjera autentičnosti uspjela je.\n"
"\n"
"Stvoren je token: „%1”\n"
"%2"

