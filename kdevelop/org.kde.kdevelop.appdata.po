#. (itstool) path: component/name
#: org.kde.kdevelop.appdata.xml:9
msgid "KDevelop"
msgstr "KDevelop"

#. (itstool) path: component/summary
#: org.kde.kdevelop.appdata.xml:10
msgid "Featureful, plugin-extensible IDE for C/C++ and other programming languages"
msgstr "Bogata, proširiva dodatcima IDE platforma za C/C++ i druge programske jezike"

#. (itstool) path: description/p
#: org.kde.kdevelop.appdata.xml:12
msgid "KDevelop is a Free and Open Source integrated development environment (IDE)."
msgstr "KDevelop je slobodno integrirano razvojno okruženje otvorenog koda (IDE)."

#. (itstool) path: description/p
#: org.kde.kdevelop.appdata.xml:13
msgid "It provides editing, navigation and debugging features for several programming languages, as well as integration with multiple build systems and version-control systems, using a plugin-based architecture."
msgstr "Pruža značajke uređivanja, navigacije i uklanjanja pogrešaka za nekoliko programskih jezika, kao i integraciju s više sustava za izgradnju i sustava za kontrolu verzija, koristeći arhitekturu temeljenu na dodacima."

#. (itstool) path: description/p
#: org.kde.kdevelop.appdata.xml:14
msgid "KDevelop has parser backends for C, C++ and Javascript/QML, with further external plugins supporting e.g. PHP or Python."
msgstr "KDevelop ima pozadinske analizatore za C, C++ i JavaScript/QML, a dodatni vanjski dodaci pružaju podršku, primjerice za PHP ili Python."

#. (itstool) path: screenshot/caption
#: org.kde.kdevelop.appdata.xml:23
msgid "Main window with code editor, terminal integration and project files"
msgstr "Glavni prozor s uređivačem koda, integriranim terminalom i datotekama projekta"
