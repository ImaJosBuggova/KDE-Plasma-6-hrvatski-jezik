#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "Ažuriranje softvera:"

#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "Ručno"

#: kcm/ui/main.qml:56
#, kde-format
msgid "Automatically"
msgstr "Automatski"

#: kcm/ui/main.qml:68
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Software updates will be downloaded automatically when they become "
"available. Updates for applications will be installed immediately, while "
"updates for the system will be installed the next time it’s restarted."
msgstr "Ažuriranja softvera automatski će se preuzimati čim postanu dostupna. Ažuriranja aplikacija instalirat će se odmah, dok će se ažuriranja sustava instalirati pri sljedećem ponovnom pokretanju."

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "Učestalost ažuriranja:"

#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "Učestalost obavijesti:"

#: kcm/ui/main.qml:79
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "Dnevno"

#: kcm/ui/main.qml:80
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "Tjedno"

#: kcm/ui/main.qml:81
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "Mjesečno"

#: kcm/ui/main.qml:82
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "Nikad"

#: kcm/ui/main.qml:120
#, kde-format
msgid "Apply system updates:"
msgstr "Primijeni ažuriranja sustava:"

#: kcm/ui/main.qml:127
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates after "
"rebooting'"
msgid "After rebooting"
msgstr "Nakon ponovnog pokretanja"

#: kcm/ui/main.qml:139
#, kde-format
msgctxt ""
"@label The thing being recommended is to use the 'apply updates when "
"rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "Preporučeno za najveću stabilnost sustava"

#: kcm/ui/main.qml:145
#, kde-format
msgctxt ""
"@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "Odmah"
