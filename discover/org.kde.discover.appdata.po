#. (itstool) path: component/name
#: org.kde.discover.appdata.xml:10
msgid "Discover"
msgstr "Discover"

#. (itstool) path: component/summary
#: org.kde.discover.appdata.xml:11
msgid "Install and remove apps and add-ons"
msgstr "Instalirajte i uklanjajte aplikacije i dodatke"

#. (itstool) path: description/p
#: org.kde.discover.appdata.xml:13
msgid "Discover helps you find and install applications, games, and tools. You can search or browse by category, and look at screenshots and read reviews to help you pick the perfect app."
msgstr "Discover vam pomaže pronaći i instalirati aplikacije, igre i alate. Možete pretraživati ili pregledavati kategorije te pogledati snimke zaslona i pročitati recenzije kako biste odabrali odgovarajuću aplikaciju."

#. (itstool) path: description/p
#: org.kde.discover.appdata.xml:14
msgid "With Discover, you can manage software from multiple sources, including your operating system's software repository, Flatpak repos, the Snap store, or even AppImages from store.kde.org."
msgstr "U Discoveru možete upravljati softverom iz više izvora, uključujući repozitorij softvera vašeg operacijskog sustava, repozitorije Flatpaka, trgovinu Snap ili čak AppImage pakete sa stranice store.kde.org."

#. (itstool) path: description/p
#: org.kde.discover.appdata.xml:15
msgid "Finally, Discover also allows you to find, install, and manage add-ons for Plasma and all your favorite KDE apps!"
msgstr "Discover vam također omogućuje pronalaženje, instaliranje i upravljanje dodacima za Plasmu i sve vaše omiljene KDE aplikacije!"

#. (itstool) path: screenshot/caption
#: org.kde.discover.appdata.xml:22
msgid "Plasma Discover"
msgstr "Plasma Discover"
