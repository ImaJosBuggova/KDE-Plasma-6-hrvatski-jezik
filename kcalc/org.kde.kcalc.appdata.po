msgid "KCalc"
msgstr "KCalc"

#. (itstool) path: component/summary
#: org.kde.kcalc.appdata.xml:7
msgid "Scientific calculator"
msgstr "Scientific calculator"

#. (itstool) path: description/p
#: org.kde.kcalc.appdata.xml:12
msgid "KCalc has everything you would expect from a scientific calculator, plus:"
msgstr "KCalc nudi sve što očekujete od znanstvenog kalkulatora, a uz to:"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:14
msgid "Trigonometric functions, logic operations and statistical calculations"
msgstr "Trigonometrijske funkcije, logičke operacije i statistički izračuni"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:15
msgid "A results stack which enables convenient recall of previous calculation results"
msgstr "Stog rezultata koji omogućuje jednostavno dohvaćanje prethodnih rezultata izračuna"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:16
msgid "Precision is user-definable"
msgstr "Preciznost može odrediti korisnik"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:17
msgid "The display allows cut and paste of numbers"
msgstr "Prikaz omogućuje izrezivanje i lijepljenje brojeva"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:18
msgid "The display colors and font are configurable, aiding usability"
msgstr "Boje i font prikaza mogu se prilagoditi radi lakšeg korištenja"

#. (itstool) path: ul/li
#: org.kde.kcalc.appdata.xml:19
msgid "The use of key-bindings make it easy to use without a pointing device"
msgstr "Tipkovnički prečaci olakšavaju korištenje bez pokazivačkog uređaja"

