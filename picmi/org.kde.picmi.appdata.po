msgid "Picmi"
msgstr "Picmi"

#. (itstool) path: component/summary
#: org.kde.picmi.appdata.xml:15
msgid "Puzzle game based on number logic"
msgstr "Zagonetka temeljena na logici brojeva"

#. (itstool) path: description/p
#: org.kde.picmi.appdata.xml:17
msgid "The goal is to reveal the hidden pattern in the board by coloring or leaving blank the cells in a grid according to numbers given at the side of the grid. This is a single player game."
msgstr "Cilj je otkriti skriveni uzorak na ploči bojanjem ili ostavljanjem praznih ćelija u mreži prema brojevima navedenima uz njezine rubove. Ovo je igra za jednog igrača."
