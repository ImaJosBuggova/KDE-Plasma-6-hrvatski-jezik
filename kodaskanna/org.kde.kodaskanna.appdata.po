#: org.kde.kodaskanna.appdata.xml:14
msgid "A multi-format 1D/2D code scanner"
msgstr "Višeformatni čitač 1D/2D kodova"

#. (itstool) path: description/p
#: org.kde.kodaskanna.appdata.xml:16
msgid "Kodaskanna is a utility for reading data from 1D/2D codes (e.g. QR codes or bar codes) and making the data available for further processing."
msgstr "Kodaskanna je alat za čitanje podataka iz 1D/2D kodova (npr. QR kodova ili barkodova) i njihovu pripremu za daljnju obradu."
