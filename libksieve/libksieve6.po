#, kde-format
msgctxt "@label:textbox"
msgid "In variable:"
msgstr "U varijablu:"

#: ksieveui/autocreatescripts/sieveactions/sieveactionsetvariable.cpp:107
#, kde-format
msgid "Script needs regex support, but server does not have it."
msgstr "Skripta zahtijeva podršku za regularne izraze, ali je poslužitelj nema."

#: ksieveui/autocreatescripts/sieveactions/sieveactionsetvariable.cpp:170
#, kde-format
msgid ""
"The \"set\" action stores the specified value in the variable identified by "
"name."
msgstr "Radnja „set” pohranjuje navedenu vrijednost u varijablu određenu nazivom."

#: ksieveui/autocreatescripts/sieveactions/sieveactionsetvariable.cpp:173
#, kde-format
msgid ""
"This modifier adds the necessary quoting to ensure that the expanded text "
"will only match a literal occurrence if used as a parameter to :regex.  "
"Every character with special meaning (. , *, ? , etc.) is prefixed with \\ "
"in the expansion"
msgstr "Ovaj modifikator dodaje potrebne navodnike kako bi prošireni tekst, kada se koristi kao parametar za :regex, odgovarao samo doslovnom pojavljivanju. Svakom znaku s posebnim značenjem (. , *, ? itd.) u proširenju prethodi \\."

#: ksieveui/autocreatescripts/sieveactions/sieveactionstop.cpp:16
#, kde-format
msgid "Stop"
msgstr "Zaustavi"

#: ksieveui/autocreatescripts/sieveactions/sieveactionstop.cpp:27
#, kde-format
msgid ""
"The \"stop\" action ends all processing.  If the implicit keep has not been "
"cancelled, then it is taken."
msgstr "Radnja „stop” završava svu obradu. Ako implicitno zadržavanje nije poništeno, poruka će se zadržati."

#: ksieveui/autocreatescripts/sieveactions/sieveactionvacation.cpp:28
#, kde-format
msgid "Vacation"
msgstr "Odsutnost"

#: ksieveui/autocreatescripts/sieveactions/sieveactionvacation.cpp:47
