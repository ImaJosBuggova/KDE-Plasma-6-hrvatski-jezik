#: kmanagesieve/session.cpp:91
#, kde-format
msgid "Cannot use TLS since the underlying Qt library does not support it."
msgstr "Nije moguće koristiti TLS jer ga temeljna biblioteka Qt ne podržava."

#: kmanagesieve/session.cpp:98
#, kde-format
msgid ""
"TLS encryption was requested, but your Sieve server does not advertise TLS "
"in its capabilities.\n"
"You can choose to try to initiate TLS negotiations nonetheless, or cancel "
"the operation."
msgstr ""
"Zatraženo je TLS šifriranje, no vaš poslužitelj Sieve ne navodi TLS među "
"svojim mogućnostima.\n"
"Ipak možete pokušati započeti TLS pregovaranje ili otkazati radnju."

#: kmanagesieve/session.cpp:100
#, kde-format
msgctxt "@title:window"
msgid "Sieve Server Does Not Advertise TLS"
msgstr "Poslužitelj Sieve ne podržava TLS"

#: kmanagesieve/session.cpp:101
#, kde-format
msgctxt "@action:button"
msgid "&Start TLS nonetheless"
msgstr "Ipak &pokreni TLS"

#: kmanagesieve/session.cpp:105
#, kde-format
msgid "TLS encryption requested, but not supported by server."
msgstr "Zatraženo je TLS šifriranje, ali ga poslužitelj ne podržava."

#: kmanagesieve/session.cpp:147
#, kde-format
msgid ""
"The server does not seem to support TLS. Disable TLS if you want to connect "
"without encryption."
msgstr ""
"Čini se da poslužitelj ne podržava TLS. Onemogućite TLS ako se želite "
"povezati bez šifriranja."

#: kmanagesieve/session.cpp:259
#, kde-format
msgid "Sieve Authentication Details"
msgstr "Pojedinosti provjere autentičnosti za Sieve"

#: kmanagesieve/session.cpp:261
#, kde-format
msgid ""
"Please enter your authentication details for your sieve account "
"\"%1\" (usually the same as your email password):"
msgstr ""
"Unesite podatke za provjeru autentičnosti računa Sieve „%1” (obično su "
"jednaki lozinci e-pošte):"

#: kmanagesieve/session.cpp:322
#, kde-format
msgid ""
"The Sieve server on %1 has reported an error:\n"
"%2"
msgstr ""
"Poslužitelj Sieve na adresi %1 prijavio je pogrešku:\n"
"%2"

#: kmanagesieve/session.cpp:322
#, kde-format
msgctxt "@title:window"
msgid "Sieve Manager"
msgstr "Upravitelj Sievea"

#: kmanagesieve/sessionthread.cpp:300
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Provjera autentičnosti nije uspjela.\n"
"Lozinka je najvjerojatnije pogrešna.\n"
"Odgovor poslužitelja:\n"
"%1"

#: kmanagesieve/sievejob.cpp:143 kmanagesieve/sievejob.cpp:150
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"Skripta nije uspješno prenesena.\n"
"Uzrok su vjerojatno pogreške u skripti.\n"
"Odgovor poslužitelja:\n"
"%1"

#: kmanagesieve/sievejob.cpp:155
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"Skripta nije uspješno prenesena.\n"
"Skripta možda sadrži pogreške."

#: ksieve/error.cpp:91
#, kde-format
msgid "Parse error: Carriage Return (CR) without Line Feed (LF)"
msgstr "Pogreška raščlambe: povratak na početak retka (CR) bez novog retka (LF)"

#: ksieve/error.cpp:95
#, kde-format
msgid ""
"Parse error: Unquoted Slash ('/') without Asterisk ('*'). Broken Comment?"
msgstr "Pogreška raščlambe: nezaštićena kosa crta („/”) bez zvjezdice („*”). Neispravan komentar?"

#: ksieve/error.cpp:99
#, kde-format
msgid "Parse error: Illegal Character"
msgstr "Pogreška raščlambe: nedopušten znak"

#: ksieve/error.cpp:102
#, kde-format
msgid "Parse error: Unexpected Character, probably a missing space?"
msgstr "Pogreška raščlambe: neočekivan znak; možda nedostaje razmak?"

#: ksieve/error.cpp:105
#, kde-format
msgid "Parse error: Tag Name has leading Digits"
msgstr "Pogreška raščlambe: naziv oznake počinje znamenkama"

#: ksieve/error.cpp:109
#, kde-format
msgid ""
"Parse error: Only whitespace and #comments may follow \"text:\" on the same "
"line"
msgstr "Pogreška raščlambe: nakon „text:” u istom retku smiju slijediti samo bjeline i komentari #"

#: ksieve/error.cpp:113
#, kde-format
msgid "Parse error: Number out of Range (must be smaller than %1)"
msgstr "Pogreška raščlambe: broj je izvan raspona (mora biti manji od %1)"

#: ksieve/error.cpp:116
#, kde-format
msgid "Parse error: Invalid UTF-8 sequence"
msgstr "Pogreška raščlambe: nevaljan niz UTF-8"

#: ksieve/error.cpp:119
#, kde-format
msgid ""
"Parse error: Premature end of Multiline String (did you forget the '.'?)"
msgstr "Pogreška raščlambe: višeredni niz neočekivano je završio (jeste li zaboravili „.”?)"

#: ksieve/error.cpp:122
#, kde-format
msgid "Parse error: Premature end of Quoted String (missing closing '\"')"
msgstr "Pogreška raščlambe: citirani niz neočekivano je završio (nedostaje završni „\"”)"

#: ksieve/error.cpp:125
#, kde-format
msgid "Parse error: Premature end of String List (missing closing ']')"
msgstr "Pogreška raščlambe: popis nizova neočekivano je završio (nedostaje završna „]”)"

#: ksieve/error.cpp:128
#, kde-format
msgid "Parse error: Premature end of Test List (missing closing ')')"
msgstr "Pogreška raščlambe: popis testova neočekivano je završio (nedostaje završna „)”)"

#: ksieve/error.cpp:131
#, kde-format
msgid "Parse error: Premature end of Block (missing closing '}')"
msgstr "Pogreška raščlambe: blok je neočekivano završio (nedostaje završna „}”)"

#: ksieve/error.cpp:134
#, kde-format
msgid "Parse error: Missing Whitespace"
msgstr "Pogreška raščlambe: nedostaje bjelina"

#: ksieve/error.cpp:137
#, kde-format
msgid "Parse error: Missing ';' or Block"
msgstr "Pogreška raščlambe: nedostaje „;” ili blok"

#: ksieve/error.cpp:140
#, kde-format
msgid "Parse error: Expected ';' or '{', got something else"
msgstr "Pogreška raščlambe: očekivan je „;” ili „{”, dobiveno je nešto drugo"

#: ksieve/error.cpp:143 ksieve/error.cpp:158
#, kde-format
msgid "Parse error: Expected Command, got something else"
msgstr "Pogreška raščlambe: očekivana je naredba, dobiveno je nešto drugo"

#: ksieve/error.cpp:146
#, kde-format
msgid "Parse error: Trailing, Leading or Duplicate Commas in String List"
msgstr "Pogreška raščlambe: zarez na početku ili kraju ili ponovljeni zarezi u popisu nizova"

#: ksieve/error.cpp:149
#, kde-format
msgid "Parse error: Trailing, Leading or Duplicate Commas in Test List"
msgstr "Pogreška raščlambe: zarez na početku ili kraju ili ponovljeni zarezi u popisu testova"

#: ksieve/error.cpp:152
#, kde-format
msgid "Parse error: Missing ',' between Strings in String List"
msgstr "Pogreška raščlambe: nedostaje „,” između nizova u popisu"

#: ksieve/error.cpp:155
#, kde-format
msgid "Parse error: Missing ',' between Tests in Test List"
msgstr "Pogreška raščlambe: nedostaje „,” između testova u popisu"

#: ksieve/error.cpp:161
#, kde-format
msgid "Parse error: Only Strings allowed in String Lists"
msgstr "Pogreška raščlambe: u popisima nizova dopušteni su samo nizovi"

#: ksieve/error.cpp:164
#, kde-format
msgid "Parse error: Only Tests allowed in Test Lists"
msgstr "Pogreška raščlambe: u popisima testova dopušteni su samo testovi"

#: ksieve/error.cpp:169
#, kde-format
msgid "\"require\" must be first command"
msgstr "„require” mora biti prva naredba"

#: ksieve/error.cpp:172
#, kde-format
msgid "\"require\" missing for command \"%1\""
msgstr "Za naredbu „%1” nedostaje „require”"

#: ksieve/error.cpp:175
#, kde-format
msgid "\"require\" missing for test \"%1\""
msgstr "Za test „%1” nedostaje „require”"

#: ksieve/error.cpp:178
#, kde-format
msgid "\"require\" missing for comparator \"%1\""
msgstr "Za usporednik „%1” nedostaje „require”"

#: ksieve/error.cpp:181
#, kde-format
msgid "Command \"%1\" not supported"
msgstr "Naredba „%1” nije podržana"

#: ksieve/error.cpp:184
#, kde-format
msgid "Test \"%1\" not supported"
msgstr "Test „%1” nije podržan"

#: ksieve/error.cpp:187
#, kde-format
msgid "Comparator \"%1\" not supported"
msgstr "Usporednik „%1” nije podržan"

#: ksieve/error.cpp:190
#, kde-format
msgid "Site Policy Limit Violation: Test nesting too deep (max. %1)"
msgstr "Prekoračeno je ograničenje pravila web-mjesta: testovi su previše ugniježđeni (najviše %1)"

#: ksieve/error.cpp:193
#, kde-format
msgid "Site Policy Limit Violation: Block nesting too deep (max. %1)"
msgstr "Prekoračeno je ograničenje pravila web-mjesta: blokovi su previše ugniježđeni (najviše %1)"

#: ksieve/error.cpp:196
#, kde-format
msgid "Invalid Argument \"%1\" to \"%2\""
msgstr "Nevaljan argument „%1” za „%2”"

#: ksieve/error.cpp:199
#, kde-format
msgid "Conflicting Arguments: \"%1\" and \"%2\""
msgstr "Sukobljeni argumenti: „%1” i „%2”"

#: ksieve/error.cpp:202
#, kde-format
msgid "Argument \"%1\" Repeated"
msgstr "Argument „%1” ponovljen je"

#: ksieve/error.cpp:205
#, kde-format
msgid "Command \"%1\" violates command ordering constraints"
msgstr "Naredba „%1” krši ograničenja redoslijeda naredbi"

#: ksieve/error.cpp:210
#, kde-format
msgid "Incompatible Actions \"%1\" and \"%2\" requested"
msgstr "Zatražene su nespojive radnje „%1” i „%2”"

#: ksieve/error.cpp:213
#, kde-format
msgid "Mail Loop detected"
msgstr "Otkrivena je petlja e-pošte"

#: ksieve/error.cpp:216
#, kde-format
msgid "Site Policy Limit Violation: Too many Actions requested (max. %1)"
msgstr "Prekoračeno je ograničenje pravila web-mjesta: zatraženo je previše radnji (najviše %1)"

#: ksieve/error.cpp:219
#, kde-format
msgid "Unknown error"
msgstr "Nepoznata pogreška"

