#: ksieveui/autocreatescripts/sieveactions/sieveactionereject.cpp:88
#, kde-format
msgid ""
" The \"ereject\" action cancels the implicit keep and refuses delivery of a "
"message."
msgstr "Radnja „ereject” poništava implicitno zadržavanje i odbija isporuku poruke."

#: ksieveui/autocreatescripts/sieveactions/sieveactionextracttext.cpp:23
