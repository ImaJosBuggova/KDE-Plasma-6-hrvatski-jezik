#: kemailaddress.cpp:508
msgctxt "QObject|"
msgid ""
"The email address you entered is not valid because it contains more than one @.\n"
"You will not create valid messages if you do not change your address."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži više znakova @.\nNećete moći slati valjane poruke ako ne promijenite adresu."

#: kemailaddress.cpp:514
msgctxt "QObject|"
msgid ""
"The email address you entered is not valid because it does not contain a @.\n"
"You will not create valid messages if you do not change your address."
msgstr "Unesena adresa e-pošte nije valjana jer ne sadrži znak @.\nNećete moći slati valjane poruke ako ne promijenite adresu."

#: kemailaddress.cpp:520
msgctxt "QObject|"
msgid "You have to enter something in the email address field."
msgstr "Morate unijeti nešto u polje adrese e-pošte."

#: kemailaddress.cpp:522
msgctxt "QObject|"
msgid "The email address you entered is not valid because it does not contain a local part."
msgstr "Unesena adresa e-pošte nije valjana jer ne sadrži lokalni dio."

#: kemailaddress.cpp:526
msgctxt "QObject|"
msgid "The email address you entered is not valid because it does not contain a domain part."
msgstr "Unesena adresa e-pošte nije valjana jer ne sadrži dio s domenom."

#: kemailaddress.cpp:530
msgctxt "QObject|"
msgid "The email address you entered is not valid because it contains unclosed comments/brackets."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži nezatvorene komentare/zagrade."

#: kemailaddress.cpp:534
msgctxt "QObject|"
msgid "The email address you entered is valid."
msgstr "Unesena adresa e-pošte valjana je."

#: kemailaddress.cpp:536
msgctxt "QObject|"
msgid "The email address you entered is not valid because it contains an unclosed angle bracket."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži nezatvorenu kutnu zagradu."

#: kemailaddress.cpp:540
msgctxt "QObject|"
msgid "The email address you entered is not valid because it contains too many closing angle brackets."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži previše zatvarajućih kutnih zagrada."

#: kemailaddress.cpp:544
msgctxt "QObject|"
msgid "The email address you have entered is not valid because it contains an unexpected comma."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži neočekivani zarez."

#: kemailaddress.cpp:548
msgctxt "QObject|"
msgid ""
"The email address you entered is not valid because it ended unexpectedly.\n"
"This probably means you have used an escaping type character like a '\\' as the last character in your email address."
msgstr "Unesena adresa e-pošte nije valjana jer neočekivano završava.\nVjerojatno ste kao zadnji znak adrese upotrijebili znak za izbjegavanje poput '\\'."

#: kemailaddress.cpp:554
msgctxt "QObject|"
msgid "The email address you entered is not valid because it contains quoted text which does not end."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži nezavršeni tekst pod navodnicima."

#: kemailaddress.cpp:558
msgctxt "QObject|"
msgid "The email address you entered is not valid because it does not seem to contain an actual email address, i.e. something of the form joe@example.org."
msgstr "Unesena adresa e-pošte nije valjana jer ne sadrži stvarnu adresu e-pošte, npr. joe@example.org."

#: kemailaddress.cpp:563
msgctxt "QObject|"
msgid "The email address you entered is not valid because it contains an illegal character."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži nedopušten znak."

#: kemailaddress.cpp:567
msgctxt "QObject|"
msgid "The email address you have entered is not valid because it contains an invalid display name."
msgstr "Unesena adresa e-pošte nije valjana jer sadrži nevaljano prikazno ime."

#: kemailaddress.cpp:571
msgctxt "QObject|"
msgid ""
"The email address you entered is not valid because it does not contain a '.'.\n"
"You will not create valid messages if you do not change your address."
msgstr "Unesena adresa e-pošte nije valjana jer ne sadrži točku.\nNećete moći slati valjane poruke ako ne promijenite adresu."

#: kemailaddress.cpp:577
msgctxt "QObject|"
msgid "Unknown problem with email address"
msgstr "Nepoznat problem s adresom e-pošte"

#: kemailaddress.cpp:637
msgctxt "QObject|"
msgid ""
"The email address you entered is not valid.\n"
"It does not seem to contain an actual email address, i.e. something of the form joe@example.org."
msgstr "Unesena adresa e-pošte nije valjana.\nČini se da ne sadrži stvarnu adresu e-pošte, npr. joe@example.org."

