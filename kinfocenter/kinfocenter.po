msgctxt "@info"
msgid "Could not load page content"
msgstr "Nije moguće učitati sadržaj stranice"

#: CommandOutputContext.cpp:129
#, kde-kuit-format
msgctxt "@info"
msgid "Technical details: The <command>%1</command> tool is required to display this page, but could not be found. You may be able to install it using your package manager; either way, please report this packaging issue to %2."
msgstr "Tehnički detalji: za prikaz ove stranice potreban je alat <command>%1</command>, ali nije pronađen. Možda ga možete instalirati pomoću upravitelja paketa; u svakom slučaju prijavite ovaj problem s paketom na %2."

#: CommandOutputContext.cpp:150
#, kde-kuit-format
msgctxt "@Info"
msgid "Technical details: the <command>%1</command> tool crashed while generating page content."
msgstr "Tehnički detalji: alat <command>%1</command> srušio se pri stvaranju sadržaja stranice."

