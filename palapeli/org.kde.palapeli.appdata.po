#. (itstool) path: component/name
#: org.kde.palapeli.appdata.xml:9
msgid "Palapeli"
msgstr "Palapeli"

#. (itstool) path: component/summary
#: org.kde.palapeli.appdata.xml:10
msgid "Jigsaw puzzle game"
msgstr "Igra slaganja slagalica"

#. (itstool) path: description/p
#: org.kde.palapeli.appdata.xml:12
msgid "Palapeli is a single-player jigsaw puzzle game. Unlike other games in that genre, you are not limited to aligning pieces on imaginary grids. The pieces are freely moveable. Also, Palapeli features real persistency, i.e. everything you do is saved on your disk immediately."
msgstr "Palapeli je igra slaganja slagalica za jednog igrača. Za razliku od drugih igara tog žanra, niste ograničeni slaganjem dijelova na zamišljenu mrežu. Dijelove možete slobodno pomicati. Osim toga, Palapeli zaista trajno sprema napredak, odnosno sve što napravite odmah se sprema na disk."

#. (itstool) path: description/p
#: org.kde.palapeli.appdata.xml:18
msgid "Features:"
msgstr "Značajke:"

#. (itstool) path: ul/li
#: org.kde.palapeli.appdata.xml:20
msgid "Create and play puzzles ranging from 4 to 10,000 pieces"
msgstr "Stvaranje i slaganje slagalica s 4 do 10 000 dijelova"

#. (itstool) path: ul/li
#: org.kde.palapeli.appdata.xml:21
msgid "Piece-holders for helping solve large puzzles"
msgstr "Ploče za odlaganje dijelova koje pomažu pri slaganju velikih slagalica"
