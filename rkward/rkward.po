#: rkward/settings/rksettingsmoduler.cpp:576
#, kde-format
msgid "Unversioned library location"
msgstr "Lokacija biblioteke bez oznake verzije"

#: rkward/settings/rksettingsmoduler.cpp:576
#, kde-format
msgid ""
"The configured library locations (where R packages will be installed on this "
"system) contains the directory '%1', which was suggested as a default "
"library location in earlier versions of RKWard. Use of this directory is no "
"longer recommended, as it is not accessible to R sessions outside of RKWard "
"(unless configured, explicitly). Also due to the lack of an R version number "
"in the directory name, it offers no protection against using packages built "
"for an incompatible version of R."
msgstr "Konfigurirane lokacije biblioteka (na koje će se instalirati paketi R-a na ovom sustavu) sadržavaju mapu '%1', koja je u ranijim verzijama RKWarda predložena kao zadana lokacija biblioteke. Više se ne preporučuje upotrebljavati tu mapu jer nije dostupna sesijama R-a izvan RKWarda (osim ako se izričito ne konfigurira). Budući da naziv mape ne sadrži ni broj verzije R-a, ne štiti od upotrebe paketa izgrađenih za nekompatibilnu verziju R-a."

