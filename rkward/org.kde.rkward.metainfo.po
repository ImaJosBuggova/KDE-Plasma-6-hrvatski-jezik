#. (itstool) path: component/name
#: org.kde.rkward.metainfo.xml:11
msgid "RKWard"
msgstr "RKWard"

#. (itstool) path: component/summary
#: org.kde.rkward.metainfo.xml:12
msgid "KDE frontend to the R statistics language"
msgstr "KDE sučelje za statistički jezik R"

#. (itstool) path: description/p
#: org.kde.rkward.metainfo.xml:14
msgid "RKWard aims to become an easy to use, transparent frontend to R, a powerful system for statistical computation and graphics. Besides a convenient GUI for the most important statistical functions, future versions will also provide seamless integration with an office-suite."
msgstr "RKWard želi postati jednostavno i pregledno sučelje za R, moćan sustav za statističke izračune i grafiku. Uz praktično grafičko sučelje za najvažnije statističke funkcije, buduće inačice pružit će i besprijekornu integraciju s uredskim paketom."

#. (itstool) path: screenshot/caption
#: org.kde.rkward.metainfo.xml:29
msgid "Main window, with data editor, object browser, interactive R console, and further tool windows."
msgstr "Glavni prozor s uređivačem podataka, preglednikom objekata, interaktivnom konzolom R-a i dodatnim alatnim prozorima."

#. (itstool) path: screenshot/caption
#: org.kde.rkward.metainfo.xml:33
msgid "Script editor with active preview"
msgstr "Uređivač skripti s aktivnim pretpregledom"

#. (itstool) path: screenshot/caption
#: org.kde.rkward.metainfo.xml:37
msgid "Working with data in RKWard"
msgstr "Rad s podacima u RKWardu"

#. (itstool) path: screenshot/caption
