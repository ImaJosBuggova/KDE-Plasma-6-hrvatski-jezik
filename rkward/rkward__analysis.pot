#. i18n: ectx: (Loaded from Fitting Linear Models) <usage>
#: rkward/plugins/analysis/regression/linear_regression.rkh:12
#, kde-format
msgid ""
"Select the variable to be predicted (dependent), and one or more independent "
"variables."
msgstr "Odaberite varijablu koju treba predvidjeti (zavisnu) i jednu ili više nezavisnih varijabli."

