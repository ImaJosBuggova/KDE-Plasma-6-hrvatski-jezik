#: selftest.cpp:34
#, kde-format
msgid "The operation timed out."
msgstr "Isteklo je vrijeme za operaciju."

#: selftest.cpp:59
#, kde-format
msgid "Push notification self-test."
msgstr "Samoprovjera push obavijesti."

#: selftest.cpp:73
#, kde-format
msgid "Could not obtain push notification endpoint."
msgstr "Nije moguće dohvatiti krajnju točku push obavijesti."

#: selftest.cpp:126
#, kde-format
msgid "Received notification does not have the expected content."
msgstr "Primljena obavijest nema očekivani sadržaj."

#: ui/main.qml:28
#, kde-format
msgid "There is no push notification service running!"
msgstr "Usluga push obavijesti nije pokrenuta!"

#: ui/main.qml:37
#, kde-format
msgid ""
"There is a 3rd party push notification service running. Push notifications "
"are available, but cannot be configured here."
msgstr "Pokrenuta je usluga push obavijesti treće strane. Push obavijesti su dostupne, ali ih ovdje nije moguće konfigurirati."

#: ui/main.qml:46
#, kde-format
msgid ""
"<b>Online</b><br>Connected to the push notification server and operational."
msgstr "<b>Na mreži</b><br>Povezano s poslužiteljem push obavijesti i radi."

#: ui/main.qml:55
#, kde-format
msgid "<b>Idle</b><br>There are no applications using push notifications."
msgstr "<b>Neaktivno</b><br>Nijedna aplikacija ne koristi push obavijesti."

#: ui/main.qml:65
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established "
"(%1)."
msgstr "<b>Izvan mreže</b><br>Nije moguće uspostaviti mrežnu vezu s poslužiteljem (%1)."

#: ui/main.qml:66
#, kde-format
msgid ""
"<b>Offline</b><br>Network connection to the server could not be established."
msgstr "<b>Izvan mreže</b><br>Nije moguće uspostaviti mrežnu vezu s poslužiteljem."

#: ui/main.qml:76
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server (%1)."
msgstr "<b>Izvan mreže</b><br>Nije moguća provjera autentičnosti na poslužitelju (%1)."

#: ui/main.qml:77
#, kde-format
msgid "<b>Offline</b><br>Could not authenticate at the server."
msgstr "<b>Izvan mreže</b><br>Nije moguća provjera autentičnosti na poslužitelju."

#: ui/main.qml:86
#, kde-format
msgid "<b>Offline</b><br>Push notifications are not set up yet."
msgstr "<b>Izvan mreže</b><br>Push obavijesti još nisu postavljene."

