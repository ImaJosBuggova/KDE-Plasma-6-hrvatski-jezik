#. (itstool) path: component/summary
#: org.kde.kdf.appdata.xml:10
msgid "View Disk Usage"
msgstr "Prikaz zauzeća diska"

#. (itstool) path: description/p
#: org.kde.kdf.appdata.xml:12
msgid "KDiskFree displays the available file devices (hard drive partitions, floppy and CD drives, etc.) along with information on their capacity, free space, type and mount point. It also allows you to mount and unmount drives and view them in a file manager."
msgstr "KDiskFree prikazuje dostupne datotečne uređaje (particije tvrdog diska, diskete, CD pogone itd.) te podatke o njihovu kapacitetu, slobodnom prostoru, vrsti i točki montiranja. Omogućuje i montiranje i demontiranje pogona te njihovo pregledavanje u upravitelju datoteka."

