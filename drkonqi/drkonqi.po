msgid "Waiting for data…"
msgstr "Čekanje podataka…"

#: qml/RatingItem.qml:43
msgctxt "@info"
msgid "The generated crash information is useful."
msgstr "Prikupljeni podaci o rušenju korisni su."

#: qml/RatingItem.qml:45
