msgstr "KDE Platforma prevedena je iz izvornog koda"

#: qml/ReportPage.qml:152
msgctxt "@info"
msgid ""
"<note>The crash and system information will be automatically added to the "
"bug report.</note>"
msgstr "<note>Podaci o rušenju i sustavu automatski će se dodati izvješću o grešci.</note>"

#: qml/ReportPage.qml:161
msgctxt "@action:button"
msgid "Preview Report"
msgstr "Pregledaj izvješće"

#: qml/SendingPage.qml:45
msgctxt "@action:button"
msgid "Save Report to File"
msgstr "Spremi izvješće u datoteku"

#: qml/SendingPage.qml:46
