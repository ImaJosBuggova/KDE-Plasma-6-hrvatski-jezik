msgid "Retry Submission"
msgstr "Pokušaj ponovno poslati"

#: qml/SendingPage.qml:81
msgctxt "@info"
msgid "Submitting bug report…"
msgstr "Slanje izvješća o grešci…"

#: qml/SentPage.qml:12
