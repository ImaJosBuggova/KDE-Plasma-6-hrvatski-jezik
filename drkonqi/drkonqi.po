msgid "Tell us more about the crash…"
msgstr "Recite nam više o rušenju…"

#: qml/SentryPage.qml:106
msgctxt "@action:button"
msgid "Send Message"
msgstr "Pošalji poruku"

#: qml/SentryPage.qml:124
msgctxt "@action:button"
msgid "Finish"
msgstr "Završi"

#: qml/WelcomePage.qml:14
msgctxt "@title:window"
msgid "Reporting Assistant"
msgstr "Pomoćnik za prijavu"

#: qml/WelcomePage.qml:19
msgctxt "@info/rich"
msgid ""
"This assistant will analyze the crash information and guide you through the "
"bug reporting process."
msgstr "Ovaj će pomoćnik analizirati podatke o rušenju i voditi vas kroz postupak prijave greške."

#: qml/WelcomePage.qml:32
msgctxt "@info/rich note before starting the bug reporting process"
msgid ""
"<para><note>Since communication between you and the developers is required "
"for effective debugging,\n"
"to continue reporting this bug it is <emphasis strong='true'>required for "
"you to agree that developers may contact you</emphasis>.\n"
"</note></para><para>Feel free to close this dialog if you do not wish to "
"accept this.</para>"
msgstr "<para><note>Budući da je za učinkovito otklanjanje pogrešaka potrebna komunikacija između vas i razvojnih inženjera,\nza nastavak prijave ove greške <emphasis strong='true'>morate pristati da vas razvojni inženjeri mogu kontaktirati</emphasis>.\n</note></para><para>Slobodno zatvorite ovaj dijaloški okvir ako ne želite pristati.</para>"

#: qml/WelcomePage.qml:45
msgctxt "@action:button"
msgid "I Agree to be Contacted"
msgstr "Pristajem na kontaktiranje"

