msgid "Thank you for being a part of KDE. You may now close this window."
msgstr "Hvala vam što ste dio KDE-a. Sada možete zatvoriti ovaj prozor."

#: qml/SentryPage.qml:12
msgctxt "@title"
msgid "Automatic Report"
msgstr "Automatsko izvješće"

#: qml/SentryPage.qml:32
msgctxt "@label submitting as crash report"
msgid ""
"Collecting crash data. This window can be closed. The collected data will "
"automatically be submitted in the background."
msgstr "Prikupljanje podataka o rušenju. Ovaj prozor možete zatvoriti. Prikupljeni podaci automatski će se poslati u pozadini."

#: qml/SentryPage.qml:55
msgctxt "@label"
msgid "Crash Report Sent"
msgstr "Izvješće o rušenju poslano"

#: qml/SentryPage.qml:67
msgctxt ""
"@label other side of row 'in the future: [x] submit stuff automatically"
msgid "In the future:"
msgstr "Ubuduće:"

#: qml/SentryPage.qml:70
msgctxt "@label"
msgid "Automatically report crashes"
msgstr "Automatski prijavljuj rušenja"

#: qml/SentryPage.qml:79
msgctxt "@info:tooltip"
msgid ""
"Always automatically submit a crash report to KDE's crash tracking system, "
"with no manual input required.\n"
"You will not receive any more crash notifications."
msgstr "Uvijek automatski šalji izvješća o rušenju u KDE-ov sustav za praćenje rušenja, bez potrebe za ručnim unosom.\nViše nećete primati obavijesti o rušenjima."

#: qml/SentryPage.qml:95
