#. (itstool) path: component/name
#: org.kde.kbruch.appdata.xml:13
msgid "KBruch"
msgstr "KBruch"

#. (itstool) path: component/summary
#: org.kde.kbruch.appdata.xml:15
msgid "Exercise Fractions"
msgstr "Vježbe s razlomcima"

#. (itstool) path: description/p
#: org.kde.kbruch.appdata.xml:17
msgid "KBruch is a small program to practice calculating with fractions and percentages. Different exercises are provided for this purpose and you can use the learning mode to practice with fractions. The program checks the user's input and gives feedback."
msgstr "KBruch je mali program za vježbanje računanja s razlomcima i postotcima. Nudi različite vježbe, a u načinu učenja možete vježbati rad s razlomcima. Program provjerava unesene odgovore i daje povratne informacije."

#. (itstool) path: description/p
#: org.kde.kbruch.appdata.xml:18
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kbruch.appdata.xml:20
msgid "Arithmetic exercise - in this exercise you have to solve a given fraction task. You have to enter the numerator and the denominator. This is the main exercise."
msgstr "Aritmetička vježba – rješavate zadani zadatak s razlomcima unosom brojnika i nazivnika. To je glavna vježba."

#. (itstool) path: ul/li
#: org.kde.kbruch.appdata.xml:21
msgid "Comparison exercise - in this exercise you have to compare the size of 2 given fractions, using the symbols &gt;, &lt; or =."
msgstr "Vježba uspoređivanja – uspoređujete vrijednosti dvaju zadanih razlomaka pomoću znakova &gt;, &lt; ili =."

#. (itstool) path: ul/li
#: org.kde.kbruch.appdata.xml:22
msgid "Conversion exercise - in this exercise you have to convert a given number into a fraction."
msgstr "Vježba pretvaranja – zadani broj pretvarate u razlomak."

#. (itstool) path: ul/li
#: org.kde.kbruch.appdata.xml:23
msgid "Factorization exercise - in this exercise you have to factorize a given number into its prime factors."
msgstr "Vježba rastavljanja na faktore – zadani broj rastavljate na proste faktore."

#. (itstool) path: ul/li
#: org.kde.kbruch.appdata.xml:24
msgid "Percentage exercise - in this exercise you have to calculate percentages."
msgstr "Vježba s postotcima – računate postotke."

#. (itstool) path: screenshot/caption
#: org.kde.kbruch.appdata.xml:38
msgid "Exercising fractions with KBruch"
msgstr "Vježbanje razlomaka u programu KBruch"