#: app/caputil.cpp:86
msgid "Take shelter in place or per instructions."
msgstr "Sklonite se na mjestu ili postupite prema uputama."

#: app/caputil.cpp:87
msgid "Relocate as instructed."
msgstr "Premjestite se prema uputama."

#: app/caputil.cpp:88
msgid "Make preparations as per the instructions."
msgstr "Pripremite se prema uputama."

#: app/caputil.cpp:89
msgid "Execute activities identified in the instructions."
msgstr "Provedite aktivnosti navedene u uputama."

#: app/caputil.cpp:90
msgid "Avoid the subject event as per the instructions."
msgstr "Izbjegavajte opisani događaj prema uputama."

#: app/caputil.cpp:91
msgid "Attend to information sources as described in the instructions."
msgstr "Pratite izvore informacija navedene u uputama."

#: app/caputil.cpp:92
msgid "Evaluate the information in this message."
msgstr "Procijenite informacije u ovoj poruci."

#: app/caputil.cpp:93
msgid ""
"The subject event no longer poses a threat or concern and any follow on "
"action is described in the instructions."
msgstr "Opisani događaj više ne predstavlja prijetnju ni razlog za zabrinutost; daljnje postupanje navedeno je u uputama."

#: app/caputil.cpp:94
msgid "No action recommended."
msgstr "Ne preporučuje se poduzimanje radnji."

