msgid "KDialog"
msgstr "KDialog"

#. (itstool) path: component/summary
#: org.kde.kdialog.metainfo.xml:7
msgid "Display dialog boxes from shell scripts"
msgstr "Prikaz dijaloških okvira iz skripti ljuske"

#. (itstool) path: description/p
#: org.kde.kdialog.metainfo.xml:9
msgid "KDialog allows you to display dialog boxes from shell scripts. The syntax is very much inspired from the \"dialog\" command (which shows text mode dialogs)."
msgstr "KDialog omogućuje prikaz dijaloških okvira iz skripti ljuske. Sintaksa je uvelike nadahnuta naredbom „dialog” (koja prikazuje dijaloške okvire u tekstualnom načinu rada)."
