msgid "Built-in network (PERT) based scheduler"
msgstr "Ugrađeni raspoređivač temeljen na mrežnoj metodi PERT"

#: kptbuiltinschedulerplugin.cpp:46
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Network (PERT) Scheduler</title><para>The network scheduler generally "
"schedules tasks according to their dependencies. When a task is scheduled it "
"is scheduled in full, booking the allocated resources if available. If "
"overbooking is not allowed, subsequent tasks that requests the same resource "
"will be scheduled later in time.</para><para>Tasks with time constraints "
"will be scheduled first to minimize the problem with resource conflicts</"
"para><para><note>This scheduler does not handle resource conflicts well.<nl/"
">You can try a different scheduler if available. You may also change "
"resource allocations or add dummy dependencies to avoid the conflicts.</"
"note></para>"
msgstr ""
"<title>Mrežni raspoređivač (PERT)</title><para>Mrežni raspoređivač u pravilu "
"raspoređuje zadatke prema njihovim međuovisnostima. Zadatak se raspoređuje u "
"cijelosti, uz rezerviranje dodijeljenih resursa ako su dostupni. Ako "
"prekomjerno dodjeljivanje nije dopušteno, kasniji zadaci koji traže isti "
"resurs rasporedit će se za kasnije vrijeme.</para><para>Zadaci s vremenskim "
"ograničenjima raspoređuju se prvi kako bi se umanjili problemi sukoba resursa"
"</para><para><note>Ovaj raspoređivač ne upravlja dobro sukobima resursa.<nl/>"
"Ako je dostupan, možete pokušati s drugim raspoređivačem. Sukobe možete "
"izbjeći i promjenom dodjela resursa ili dodavanjem pomoćnih "
"međuovisnosti.</note></para>"

