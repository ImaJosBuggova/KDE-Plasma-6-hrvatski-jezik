#: SharedResourcesDialog.cpp:84
#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"<title>Shared Resource Dialog</title><para>Enables you to decide how to "
"treat shared resources, shared resource groups and shared calendars when "
"they have been deleted from the shared resources file.</para><para>You can "
"select if an item shall be:<list><item><emphasis>Removed:</emphasis> Removes "
"the item from your project too.</item><item><emphasis>Converted:</emphasis> "
"Converts the item to local item.</item><item><emphasis>Kept:</emphasis> "
"Keeps the item as a shared item.</item></list><nl/><link url='%1'>More...</"
"link></para>"
msgstr ""
"<title>Dijalog zajedničkih resursa</title><para>Omogućuje vam odabir načina "
"postupanja sa zajedničkim resursima, grupama resursa i kalendarima nakon što "
"su izbrisani iz datoteke zajedničkih resursa.</para><para>Možete odabrati "
"hoće li se stavka:<list><item><emphasis>Ukloniti:</emphasis> Uklonit će se i "
"iz vašeg projekta.</item><item><emphasis>Pretvoriti:</emphasis> Pretvorit "
"će se u lokalnu stavku.</item><item><emphasis>Zadržati:</emphasis> Zadržat "
"će se kao zajednička stavka.</item></list><nl/><link url='%1'>Više...</link>"
"</para>"

