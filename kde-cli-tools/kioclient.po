#: kioclient.cpp:56
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintaksa:\n"

#: kioclient.cpp:58
#, kde-format
msgctxt "The argument is the command \"kioclient openProperties\""
msgid ""
"  %1 'url'\n"
"            # Opens a properties dialog of 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Otvara dijalog svojstava za 'url'\n"
"\n"

#: kioclient.cpp:65
#, kde-format
msgctxt "The argument is the command \"kioclient exec\""
msgid ""
"  %1 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            # associated with it in KDE. You may omit 'mimetype'.\n"
"            # In that case the mimetype is determined automatically.\n"
"            # 'url' can be the URL of a document, a *.desktop file,\n"
"            # or an executable.\n"
msgstr ""
"  %1 'url' ['mimetype']\n"
"            # Pokušava otvoriti dokument na koji ukazuje 'url', u aplikaciji\n"
"            # povezanoj s njim u KDE-u. Možete izostaviti 'mimetype'.\n"
"            # U tom se slučaju vrsta MIME određuje automatski.\n"
"            # 'url' može biti URL dokumenta, *.desktop datoteka\n"
"            # ili izvršna datoteka.\n"

#: kioclient.cpp:76
#, kde-format
msgctxt "The argument is the command \"kioclient move\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   'dest' may be \"trash:/\" to move the files to the trash.\n"
"            #   The short version 'kioclient mv' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odredište'\n"
"            # Premješta URL 'izvor' na 'odredište'.\n"
"            #   'izvor' može biti popis URL-ova.\n"
"            #   'odredište' može biti \"trash:/\" za premještanje datoteka u smeće.\n"
"            #   Dostupna je i kratka verzija 'kioclient mv'.\n"
"\n"

#: kioclient.cpp:86
#, kde-format
msgctxt "The argument is the command \"kioclient download\""
msgid ""
"  %1 ['src']\n"
"            # Copies the URL 'src' to a user-specified location.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  %1 ['izvor']\n"
"            # Kopira URL 'izvor' na lokaciju koju je odredio korisnik.\n"
"            #   'izvor' može biti popis URL-ova, a ako nije prisutan,\n"
"            #   zatražit će se URL.\n"
"\n"

#: kioclient.cpp:95
#, kde-format
msgctxt "The argument is the command \"kioclient copy\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   The short version 'kioclient cp' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odredište'\n"
"            # Kopira URL 'izvor' na 'odredište'.\n"
"            #   'izvor' može biti popis URL-ova.\n"
"            #   Dostupna je i kratka verzija 'kioclient cp'.\n"
"\n"

#: kioclient.cpp:104
#, kde-format
msgctxt "The argument is the command \"kioclient cat\""
msgid ""
"  %1 'url'\n"
"            # Prints the contents of the file 'url' to the standard output\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Ispisuje sadržaj datoteke 'url' na standardni izlaz\n"
"\n"

#: kioclient.cpp:111
#, kde-format
msgctxt "The argument is the command \"kioclient ls\""
msgid ""
"  %1 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Ispisuje sadržaj direktorija 'url' na stdout\n"
"\n"

#: kioclient.cpp:118
#, kde-format
msgctxt "The argument is the command \"kioclient remove\""
msgid ""
"  %1 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
"            #   The short version 'kioclient rm' is also available.\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Uklanja URL\n"
"            #   'url' može biti popis URL-ova.\n"
"            #   Dostupna je i kratka verzija 'kioclient rm'.\n"
"\n"

#: kioclient.cpp:127
#, kde-format
msgctxt "The argument is the command \"kioclient mkdir\""
msgid ""
"  %1 'url'\n"
"            # Creates a directory at 'url'\n"
msgstr ""
"  %1 'url'\n"
"            # Stvara direktorij na lokaciji 'url'\n"

#: kioclient.cpp:134
#, kde-format
msgctxt "The argument is the command \"kioclient stat\""
msgid ""
"  %1 'url'\n"
"            # Shows all of the available information for 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Prikazuje sve dostupne informacije za 'url'\n"
"\n"

#: kioclient.cpp:141
#, kde-format
msgctxt "The argument is the command \"kioclient appmenu\""
msgid ""
"  %1\n"
"            # Opens a basic application launcher\n"
"\n"
msgstr ""
"  %1\n"
"            # Otvara osnovni pokretač aplikacija\n"
"\n"

#: kioclient.cpp:147
#, kde-format
msgid "*** Examples:\n"
msgstr "*** Primjeri:\n"

#: kioclient.cpp:148
#, kde-format
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with the default application associated\n"
"             // with this MimeType\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Otvara datoteku s pomoću zadane aplikacije povezane\n"
"             // s ovom vrstom MIME\n"
"\n"

#: kioclient.cpp:153
#, kde-format
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens URL with the default handler for ftp:// scheme\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // Otvara URL sa zadanim rukovateljem za ftp:// shemu\n"
"\n"

#: kioclient.cpp:157
#, kde-format
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Pokreće emacs\n"
"\n"

#: kioclient.cpp:161
#, kde-format
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory in the default\n"
"             // file manager. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // Otvara trenutni direktorij u zadanom\n"
"             // upravitelju datoteka. Vrlo praktično.\n"
"\n"

