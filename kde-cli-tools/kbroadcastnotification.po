#: main.cpp:22
#, kde-format
msgid "Broadcast Notifications"
msgstr "Emitiranje obavijesti"

#: main.cpp:24
#, kde-format
msgid ""
"A tool that emits a notification for all users by sending it on the system "
"DBus"
msgstr ""
"Alat koji odašilje obavijest za sve korisnike slanjem iste preko sustava "
"DBus"

#: main.cpp:26
#, kde-format
msgid "(c) 2016 Kai Uwe Broulik"
msgstr "(c) 2016. Kai Uwe Broulik"

#: main.cpp:33
#, kde-format
msgid ""
"Name of the application that should be associated with this notification"
msgstr "Naziv aplikacije koja bi trebala biti povezana s ovom obavijesti"

#: main.cpp:36
#, kde-format
msgid "A brief one-line summary of the notification"
msgstr "Kratak sažetak obavijesti u jednom retku"

#: main.cpp:38
#, kde-format
msgid "Icon for the notification"
msgstr "Ikona za obavijest"

#: main.cpp:42
#, kde-format
msgid ""
"A comma-separated list of user IDs this notification should be sent to. If "
"omitted, the notification will be sent to all users."
msgstr ""
"Popis ID-jeva korisnika odvojenih zarezom kojima se ova obavijest treba "
"poslati. Ako se izostavi, obavijest će biti poslana svim korisnicima."

#: main.cpp:45
#, kde-format
msgid "Timeout for the notification"
msgstr "Vremensko ograničenje za obavijest"

#: main.cpp:47
#, kde-format
msgid "Keep the notification in the history until the user closes it"
msgstr "Zadrži obavijest u povijesti dok ju korisnik ne zatvori"

#: main.cpp:50
#, kde-format
msgid "The actual notification body text"
msgstr "Stvarni tekst tijela obavijesti"