#: kdesu.cpp:92
#, kde-format
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:94
#, kde-format
msgid "Runs a program with elevated privileges."
msgstr "Pokreće program s povišenim ovlastima."

#: kdesu.cpp:96
#, kde-format
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr "Autorska prava (c) 1998.–2000. Geert Jansen, Pietro Iglio"

#: kdesu.cpp:97
#, kde-format
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdesu.cpp:97
#, kde-format
msgid "Maintainer"
msgstr "Održavatelj"

#: kdesu.cpp:98
#, kde-format
msgid "Pietro Iglio"
msgstr "Pietro Iglio"

#: kdesu.cpp:98
#, kde-format
msgid "Original author"
msgstr "Izvorni autor"

#: kdesu.cpp:107
#, kde-format
msgid "Specifies the command to run as separate arguments"
msgstr "Određuje naredbu za izvođenje kao odvojene argumente"

#: kdesu.cpp:108
#, kde-format
msgid "Specifies the command to run as one string"
msgstr "Određuje naredbu za izvođenje kao jedan niz znakova"

#: kdesu.cpp:109
#, kde-format
msgid "Run command under target uid if <file> is not writable"
msgstr "Pokreni naredbu pod ciljnim UID-om ako se u <datoteku> ne može pisati"

#: kdesu.cpp:110
#, kde-format
msgid "Specifies the target uid"
msgstr "Određuje ciljni UID"

#: kdesu.cpp:111
#, kde-format
msgid "Do not keep password"
msgstr "Nemoj zadržati zaporku"

#: kdesu.cpp:112
#, kde-format
msgid "Stop the daemon (forgets all passwords)"
msgstr "Zaustavi pozadinsku uslugu (zaboravlja sve zaporke)"

#: kdesu.cpp:113
#, kde-format
msgid "Enable terminal output (no password keeping)"
msgstr "Omogući izlaz u terminalu (bez zadržavanja zaporke)"

#: kdesu.cpp:115
#, kde-format
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Postavi vrijednost prioriteta: 0 <= prioritet <= 100, 0 je najniži"

#: kdesu.cpp:116
#, kde-format
msgid "Use realtime scheduling"
msgstr "Upotrijebi raspoređivanje u stvarnom vremenu"

#: kdesu.cpp:117
#, kde-format
msgid "Do not display ignore button"
msgstr "Prikazuj gumb „Zanemari”"

#: kdesu.cpp:118
#, kde-format
msgid "Specify icon to use in the password dialog"
msgstr "Odredi ikonu za upotrebu u dijalogu za zaporku"

#: kdesu.cpp:119
#, kde-format
msgid "Do not show the command to be run in the dialog"
msgstr "Nemoj prikazati naredbu za izvođenje u dijalogu"

#: kdesu.cpp:126
#, kde-format
msgctxt ""
"Transient means that the kdesu app will be attached to the app specified by "
"the winid so that it is like a dialog box rather than some separate program"
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Čini dijalog prolaznim za X aplikaciju određenu s winid"

#: kdesu.cpp:128
#, kde-format
msgid "Embed into a window"
msgstr "Ugradi u prozor"

#: kdesu.cpp:155
#, kde-format
msgid "Cannot execute command '%1'."
msgstr "Nije moguće izvršiti naredbu „%1”."

#: kdesu.cpp:158
#, kde-format
msgid "Cannot execute command '%1'. It contains invalid characters."
msgstr "Nije moguće izvršiti naredbu „%1”. Sadrži nevaljane znakove."

#: kdesu.cpp:232
#, kde-format
msgid "Illegal priority: %1"
msgstr "Nedopušteni prioritet: %1"

#: kdesu.cpp:253
#, kde-format
msgid "No command specified."
msgstr "Nije navedena nijedna naredba."

#: kdesu.cpp:356
#, kde-format
msgid "Su returned with an error.\n"
msgstr "Naredba su se vratila s pogreškom.\n"

#: kdesu.cpp:384
#, kde-format
msgid "Command:"
msgstr "Naredba:"

#: kdesu.cpp:393
#, kde-format
msgid "realtime: "
msgstr "stvarno vrijeme: "

#: kdesu.cpp:397
#, kde-format
msgid "Priority:"
msgstr "Prioritet:"

#: sudlg.cpp:27
#, kde-format
msgid "Run as %1"
msgstr "Pokreni kao %1"

#: sudlg.cpp:31
#, kde-format
msgid "Please enter your password below."
msgstr "Molimo unesite svoju zaporku u nastavku."

#: sudlg.cpp:36
#, kde-format
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Radnja koju ste zatražili zahtijeva <b>korijenske ovlasti (root)</b>. Molimo "
"unesite zaporku za <b>root</b> u nastavku ili kliknite „Zanemari” kako biste "
"nastavili sa svojim trenutačnim ovlastima."

#: sudlg.cpp:42
#, kde-format
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below."
msgstr ""
"Radnja koju ste zatražili zahtijeva <b>korijenske ovlasti (root)</b>. Molimo "
"unesite zaporku za <b>root</b> u nastavku."

#: sudlg.cpp:49
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Radnja koju ste zatražili zahtijeva dodatne ovlasti. Molimo unesite zaporku "
"za <b>%1</b> u nastavku ili kliknite „Zanemari” kako biste nastavili sa "
"svojim trenutačnim ovlastima."

#: sudlg.cpp:56
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below."
msgstr ""
"Radnja koju ste zatražili zahtijeva dodatne ovlasti. Molimo unesite zaporku "
"za <b>%1</b> u nastavku."

#: sudlg.cpp:79
#, kde-format
msgid "Conversation with su failed."
msgstr "Komunikacija s naredbom su nije uspjela."

#: sudlg.cpp:86
#, kde-format
msgid ""
"The program 'su' could not be found.<br />Ensure your PATH is set correctly."
msgstr ""
"Program „su” nije pronađen.<br />Provjerite je li vaša varijabla PATH "
"ispravno postavljena."

#: sudlg.cpp:97
#, kde-format
msgid ""
"Permission denied.<br />Possibly incorrect password, please try again.<br /"
">On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Pristup odbijen.<br />Možda je zaporka neispravna, pokušajte ponovno.<br />Na "
"nekim sustavima morate biti u posebnoj grupi (često: wheel) za korištenje ovog "
"programa."

#: sudlg.cpp:105
#, kde-format
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Unutarnja pogreška: nedopušteni povratak iz SuProcess::checkInstall()"