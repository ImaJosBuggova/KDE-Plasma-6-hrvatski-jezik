#. (itstool) path: component/name
#: org.kde.kaddressbook.appdata.xml:9
msgid "KAddressBook"
msgstr "KAddressBook"

#. (itstool) path: component/summary
#: org.kde.kaddressbook.appdata.xml:10
msgid "An address book manager"
msgstr "Upravitelj adresara"

#. (itstool) path: description/p
#: org.kde.kaddressbook.appdata.xml:12
msgid "KAddressBook stores all the personal details of your family, friends and other contacts. It supports large variety of services, including NextCloud, Kolab, Google Contacts, Microsoft Exchange (EWS) or any standard CalDAV server."
msgstr "KAddressBook pohranjuje sve osobne podatke o vašoj obitelji, prijateljima i drugim kontaktima. Podržava velik broj usluga, uključujući Nextcloud, Kolab, Google kontakte, Microsoft Exchange (EWS) i sve standardne poslužitelje CalDAV."

#. (itstool) path: description/p
#: org.kde.kaddressbook.appdata.xml:13
msgid "Features:"
msgstr "Mogućnosti:"

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:15
msgid "Powerful search - KAddressBook has configurable filters and powerful search capabilities."
msgstr "Moćno pretraživanje – KAddressBook ima prilagodljive filtre i napredne mogućnosti pretraživanja."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:16
msgid "Duplicate detection and merging - KAddressBook can find duplicated contacts from multiple sources and can merge them into a single contact."
msgstr "Otkrivanje i spajanje duplikata – KAddressBook može pronaći duplicirane kontakte iz više izvora i spojiti ih u jedan kontakt."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:17
msgid "Good standard support - KAddressBook can import and export from and to nearly every address book standard."
msgstr "Dobra podrška za standardne formate – KAddressBook može uvoziti i izvoziti podatke u gotovo svim uobičajenim formatima adresara."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:18
msgid "LDAP integration - Can connect to multiple LDAP servers, which can then be used for contact autocompletion when composing emails in KMail."
msgstr "Integracija s LDAP-om – Može se povezati s više LDAP poslužitelja, koji se zatim mogu upotrebljavati za automatsko dovršavanje kontakata pri sastavljanju e-pošte u KMailu."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:19
msgid "Integration - Integrates with other Kontact components, e.g. exporting birthday reminders to KOrganizer"
msgstr "Integracija – Povezuje se s drugim komponentama Kontacta, primjerice izvozi podsjetnike za rođendane u KOrganizer."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:20
msgid "QR codes - KAddressBook can display a QR code for each contact to quickly scan it into your phone or send to someone."
msgstr "QR kodovi – KAddressBook može prikazati QR kod za svaki kontakt kako biste ga brzo skenirali telefonom ili poslali nekome."

#. (itstool) path: screenshot/caption
#: org.kde.kaddressbook.appdata.xml:36
msgid "KAddressBook embedded into Kontact"
msgstr "KAddressBook ugrađen u Kontact"

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:49
msgid "Add plasma activities support."
msgstr "Dodana je podrška za Plasma aktivnosti."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:78
msgid "Add new whatsnew widget."
msgstr "Dodan je novi dodatak „Što je novo”."

#. (itstool) path: ul/li
#: org.kde.kaddressbook.appdata.xml:79
msgid "Restore configure dialog size."
msgstr "Vraćena je veličina dijaloškog okvira za konfiguraciju."
