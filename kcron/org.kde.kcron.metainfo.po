msgid "Task Scheduler"
msgstr "Raspoređivač zadataka"

#. (itstool) path: description/p
#: org.kde.kcron.metainfo.xml:10
msgid "Task Scheduler is a graphical front end to the standard \"cron\" utility. With it, commands (or \"tasks\") can be run at specific times, on a certain day or date, or at specific intervals (time between execution)."
msgstr "Raspoređivač zadataka grafičko je sučelje za standardni alat \"cron\". Pomoću njega naredbe (odnosno \"zadaci\") mogu se pokretati u određeno vrijeme, na određeni dan ili datum ili u određenim vremenskim razmacima (vrijeme između pokretanja)."

