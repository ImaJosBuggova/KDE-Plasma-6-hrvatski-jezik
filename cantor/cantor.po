msgid "https://cran.r-project.org/manuals.html"
msgstr "https://cran.r-project.org/manuals.html"

#: backends/R/rbackend.cpp:101
#, kde-format
msgid ""
"<div style=\"line-height: 1.4;\"><h3 style=\"color: #2277dd; margin: 12px 0 "
"6px 0;\"><b>R Help System</b></h3><p style=\"margin: 4px 0;\">The "
"<code>help()</code> function and <code>?</code> help operator in R provide "
"access to the documentation pages for R functions, data sets, and other "
"objects.</p><h4 style=\"color: #2277dd; margin: 12px 0 6px 0;\"><b>Examples</"
"b></h4><pre style=\"background-color: #d0d0d0; color: #000000; padding: 8px; "
"border-radius: 4px;\">help(lm)      # help for linear model function\n"
"?lm           # same as above\n"
"?\"?\"          # help for the ? operator\n"
"example(lm)   # run examples for lm</pre><h4 style=\"color: #2277dd; margin: "
"12px 0 6px 0;\"><b>Package Help</b></h4><p style=\"margin: 4px 0;\">To "
"access help for a function in a package that’s not currently loaded, specify "
"the package name:</p><pre style=\"background-color: #d0d0d0; color: #000000; "
"padding: 8px; border-radius: 4px;\">help(rlm, package=\"MASS\")\n"
"help(package=\"MASS\")       # package index</pre></div>"
msgstr "<div style=\"line-height: 1.4;\"><h3 style=\"color: #2277dd; margin: 12px 0 6px 0;\"><b>Sustav pomoći za R</b></h3><p style=\"margin: 4px 0;\">Funkcija <code>help()</code> i operator pomoći <code>?</code> u R-u omogućuju pristup stranicama dokumentacije za funkcije, skupove podataka i druge objekte u R-u.</p><h4 style=\"color: #2277dd; margin: 12px 0 6px 0;\"><b>Primjeri</b></h4><pre style=\"background-color: #d0d0d0; color: #000000; padding: 8px; border-radius: 4px;\">help(lm)      # help for linear model function\n?lm           # same as above\n?\"?\"          # help for the ? operator\nexample(lm)   # run examples for lm</pre><h4 style=\"color: #2277dd; margin: 12px 0 6px 0;\"><b>Pomoć za pakete</b></h4><p style=\"margin: 4px 0;\">Za pristup pomoći za funkciju iz paketa koji trenutačno nije učitan navedite naziv paketa:</p><pre style=\"background-color: #d0d0d0; color: #000000; padding: 8px; border-radius: 4px;\">help(rlm, package=\"MASS\")\nhelp(package=\"MASS\")       # package index</pre></div>"

#: backends/R/rbackend.cpp:120
#, kde-format
msgid ""
"<b>R</b> is a language and environment for statistical computing and "
"graphics, similar to the S language and environment. <br/>It provides a wide "
"variety of statistical (linear and nonlinear modelling, classical "
"statistical tests, time-series analysis, classification, clustering, ...) "
"and graphical techniques, and is highly extensible. The S language is often "
"the vehicle of choice for research in statistical methodology, and R "
"provides an Open Source route to participation in that activity."
msgstr "<b>R</b> je jezik i okruženje za statističko računanje i grafiku, slično jeziku i okruženju S. <br/>Nudi širok raspon statističkih (linearno i nelinearno modeliranje, klasični statistički testovi, analiza vremenskih nizova, klasifikacija, grupiranje…) i grafičkih tehnika te je vrlo proširiv. Jezik S često je prvi izbor za istraživanja statističke metodologije, a R pruža otvoren put za sudjelovanje u toj djelatnosti."

#: backends/R/rexpression.cpp:104
#, kde-format
msgid ""
"help.start() is not supported in embedded R mode. Use help(topic) or ?topic "
"instead."
msgstr "help.start() nije podržan u ugrađenom načinu rada R-a. Umjesto toga upotrijebite help(topic) ili ?topic."

