#: backends/julia/juliabackend.cpp:55
#, kde-format
msgid ""
"<b>Julia</b> is a high-level, high-performance dynamic programming language "
"for technical computing, with syntax that is familiar to users of other "
"technical computing environments. It provides a sophisticated compiler, "
"distributed parallel execution, numerical accuracy, and an extensive "
"mathematical function library."
msgstr "<b>Julia</b> je dinamički programski jezik visoke razine i visokih performansi, namijenjen tehničkom računanju. Sintaksa mu je poznata korisnicima drugih okruženja za tehničko računanje. Nudi napredni prevoditelj, distribuirano paralelno izvođenje, numeričku točnost i opsežnu biblioteku matematičkih funkcija."

#: backends/julia/juliabackend.cpp:68
