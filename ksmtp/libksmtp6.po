#: job.cpp:60
#, kde-format
msgid "Service not available"
msgstr "Usluga nije dostupna"

#: job.cpp:62
#, kde-format
msgid "Mailbox unavailable. The server said: %1"
msgstr "Poštanski sandučić nije dostupan. Poslužitelj je odgovorio: %1"

#: job.cpp:64
#, kde-format
msgid "Insufficient storage space on server. The server said: %1"
msgstr "Nema dovoljno prostora za pohranu na poslužitelju. Poslužitelj je odgovorio: %1"

#: job.cpp:66
#, kde-format
msgid "Server error: %1"
msgstr "Pogreška poslužitelja: %1"

#: job.cpp:75
#, kde-format
msgid "Connection to server lost."
msgstr "Veza s poslužiteljem je izgubljena."

#: loginjob.cpp:78
#, kde-format
msgid "Login"
msgstr "Prijava"

#: loginjob.cpp:169
#, kde-format
msgid ""
"Could not authenticate to the SMTP server because no matching authentication "
"method has been found"
msgstr "Autentifikacija na poslužitelju SMTP nije uspjela jer nije pronađen odgovarajući način autentifikacije"

#: loginjob.cpp:228
#, kde-format
msgid "Token expired"
msgstr "Token je istekao"

#: loginjob.cpp:272
#, kde-format
msgid "Login failed, cannot initialize the SASL library"
msgstr "Prijava nije uspjela; nije moguće inicijalizirati biblioteku SASL"

#: sendjob.cpp:58
#, kde-format
msgid "SendJob"
msgstr "SendJob"

#: sendjob.cpp:107
#, kde-format
msgid ""
"Could not send the message because either the sender or recipient field is "
"missing or invalid"
msgstr "Slanje poruke nije uspjelo jer nedostaje polje pošiljatelja ili primatelja, odnosno nije valjano"

#: sendjob.cpp:115
#, kde-format
msgid ""
"Could not send the message because it exceeds the maximum allowed size of %1 "
"bytes. (Message size: %2 bytes.)"
msgstr "Slanje poruke nije uspjelo jer premašuje najveću dopuštenu veličinu od %1 bajtova. (Veličina poruke: %2 bajtova.)"

#: sendjob.cpp:124
#, kde-format
msgid ""
"The message requires UTF-8 email addresses, which the server does not "
"support."
msgstr "Poruka zahtijeva adrese e-pošte u UTF-8 formatu, koji poslužitelj ne podržava."
