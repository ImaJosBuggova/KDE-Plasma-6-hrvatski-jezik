#: org.kde.sweeper.desktop:142
msgctxt "Comment"
msgid ""
"Helps to clean unwanted traces the user leaves on the system and to regain "
"disk space removing unused temporary files"
msgstr "Pomaže ukloniti neželjene tragove koje korisnik ostavlja u sustavu i osloboditi prostor na disku uklanjanjem nekorištenih privremenih datoteka."
