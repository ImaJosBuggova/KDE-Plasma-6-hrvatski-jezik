#: privacyfunctions.h:149
#, kde-format
msgid "Clears the FavIcons cached from visited websites"
msgstr "Briše ikone web-stranica iz predmemorije posjećenih web-stranica"

#: privacyfunctions.h:163
#, kde-format
msgid "Recent Applications"
msgstr "Nedavne aplikacije"

#: privacyfunctions.h:163
#, kde-format
msgid "Clears the list of recently used applications from KDE menu"
msgstr "Briše popis nedavno korištenih aplikacija iz KDE-ova izbornika"

