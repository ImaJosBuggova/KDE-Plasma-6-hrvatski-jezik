msgid "System cleaning utility"
msgstr "Alat za čišćenje sustava"

#. (itstool) path: description/p
#: org.kde.sweeper.appdata.xml:13
msgid "Sweeper helps to clean unwanted traces the user leaves on the system. It can remove cookies and clean out caches, for example."
msgstr "Sweeper pomaže ukloniti neželjene tragove koje korisnik ostavlja u sustavu. Primjerice, može ukloniti kolačiće i očistiti predmemoriju."
