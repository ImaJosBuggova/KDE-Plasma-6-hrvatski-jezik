#: qml/478BreathingPage.qml:10
#, kde-format
msgctxt "@title"
msgid "4-7-8 Breathing"
msgstr "Disanje 4-7-8"

#: qml/478BreathingPage.qml:11
#, kde-format
msgid ""
"4-7-8 Breathing puts the body into a deep relaxation state, e.g. to better "
"fall asleep on a flight.                    <br>                    "
"<ul>                    <li>Breathe in through your nose (4s).</"
"li>                    <li>Hold (7s).</li>                    <li>Breathe "
"out through your mouth making a whooshing sound (8s).</"
"li>                    </ul>                    <br>                    "
"Repeat at least 4 times."
msgstr ""
"Tehnika disanja 4-7-8 dovodi tijelo u stanje duboke opuštenosti, primjerice "
"kako biste lakše zaspali tijekom leta.                    <br>                    "
"<ul>                    <li>Udahnite kroz nos (4 s).</li>                    "
"<li>Zadržite dah (7 s).</li>                    <li>Izdahnite kroz usta "
"uz šištav zvuk (8 s).</li>                    </ul>                    "
"<br>                    Ponovite najmanje 4 puta."

