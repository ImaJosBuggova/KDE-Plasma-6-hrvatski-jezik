#: qml/BoxBreathingPage.qml:10
#, kde-format
msgctxt "@title"
msgid "Box Breathing"
msgstr "Kvadratno disanje"

#: qml/BoxBreathingPage.qml:11
#, kde-format
msgid ""
"Box Breathing is used by the Navy SEALs to quickly and effectively reduce "
"stress.                    <br>                    <ul>                    "
"<li>Breathe in through your nose (4s).</li>                    <li>Hold (4s)."
"</li>                    <li>Breathe out through your nose (4s).</"
"li>                    <li>Hold (4s).</li>                    </"
"ul>                    <br>                    Repeat for at least 5-10 "
"minutes."
msgstr ""
"Pripadnici Navy SEAL-a koriste kvadratno disanje za brzo i učinkovito "
"smanjenje stresa.                    <br>                    <ul>                    "
"<li>Udahnite kroz nos (4 s).</li>                    <li>Zadržite dah (4 s)."
"</li>                    <li>Izdahnite kroz nos (4 s).</"
"li>                    <li>Zadržite dah (4 s).</li>                    </"
"ul>                    <br>                    Ponavljajte najmanje 5–10 "
"minuta."

#: qml/BoxBreathingSleepPage.qml:10
#, kde-format
msgctxt "@title"
msgid "Box Breathing (sleep)"
msgstr "Kvadratno disanje (spavanje)"

#: qml/BoxBreathingSleepPage.qml:11
#, kde-format
msgid ""
"A Box Breathing variant with a longer breathe-out phase helps to relax "
"before going to sleep.                    <br>                    "
"<ul>                    <li>Breathe in through your nose (4s).</"
"li>                    <li>Hold (4s).</li>                    <li>Breathe "
"out through your nose (6s).</li>                    <li>Hold (2s).</"
"li>                    </ul>                    <br>                    "
"Repeat at least 6 times."
msgstr ""
"Varijanta kvadratnog disanja s duljim izdisajem pomaže vam da se opustite "
"prije spavanja.                    <br>                    "
"<ul>                    <li>Udahnite kroz nos (4 s).</"
"li>                    <li>Zadržite dah (4 s).</li>                    <li>Izdahnite "
"kroz nos (6 s).</li>                    <li>Zadržite dah (2 s).</"
"li>                    </ul>                    <br>                    "
"Ponovite najmanje 6 puta."

